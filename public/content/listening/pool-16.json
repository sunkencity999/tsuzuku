{
  "schema": "tsuzuku.pool/1",
  "station": 16,
  "refs": [
    { "ref": "s-09-4#L3", "ids": [ "v-n5-0030", "v-n4-0007", "v-n5-0113", "g-n5-043" ], "kana": "そうですか。おとなにまいください。", "morae": 15 },
    { "ref": "s-09-4#L4", "ids": [ "v-n5-0001", "v-n4-0007", "v-n5-0118", "v-n5-0113", "v-n5-0115", "v-n5-0132" ], "kana": "はい。おとなはいちまいごひゃくえんです。", "morae": 17 },
    { "ref": "s-16-1#L0", "ids": [ "v-n5-0218", "v-n5-0211", "v-n5-0595", "v-n5-0154", "v-n5-0156", "v-n5-0121", "v-n5-0288", "v-n5-0439", "v-n5-0118", "v-n5-0135" ], "kana": "しちがつにじゅうごにち、はれ。ごじはんにおきました。あさごはんはろくじでした。", "morae": 34 },
    { "ref": "s-16-1#L1", "ids": [ "v-n5-0674", "v-n5-0369", "v-n5-0132", "v-n5-0119", "v-n5-0137", "v-n5-0118", "v-n5-0548", "v-n5-0121", "v-n5-0339", "v-n5-0750", "v-n5-0356", "v-n5-0654", "v-n5-0139", "v-n5-0328", "v-n5-0565", "v-n5-0680", "v-n5-0735", "v-n5-0273" ], "kana": "すこしはやいですが、きょうはやまにのぼるので、ちょうどいいです。あらしはきのうおわりました。そらはよくはれています。", "morae": 51 },
    { "ref": "s-16-1#L2", "ids": [ "v-n5-0330", "g-n5-033", "v-n5-0712", "v-n5-0120", "v-n5-0271", "v-n5-0298", "v-n5-0239", "v-n5-0121", "v-n5-0406", "v-n5-0114", "v-n5-0310" ], "kana": "でかけるまえに、じゅんびをしておきました。にもつにみずをにほんいれておきました。", "morae": 36 },
    { "ref": "s-16-1#L3", "ids": [ "v-n5-0243", "v-n5-0118", "v-n5-0361", "v-n5-0406", "v-n5-0121", "v-n5-0310", "v-n5-0272", "v-n5-0437", "v-n5-0125", "v-n5-0276", "v-n5-0298" ], "kana": "ハンカチはつめたいみずにいれてあります。ちずもみておきました。", "morae": 29 },
    { "ref": "s-16-1#L5", "ids": [ "v-n5-0355", "v-n5-0178", "v-n5-0118", "v-n5-0377", "v-n5-0760", "v-n5-0309", "v-n5-0124", "v-n5-0096", "v-n5-0122", "v-n5-0307" ], "kana": "ふるいまどはおもくて、なかなかしまりません。わたなべさんとふたりでしめました。", "morae": 36 },
    { "ref": "s-16-1#L6", "ids": [ "v-n5-0118", "v-n5-0549", "v-n5-0124", "v-n5-0548", "v-n5-0126", "v-n5-0187", "v-n5-0351", "v-n5-0386", "v-n5-0425", "v-n5-0132", "v-n5-0417", "v-n5-0152", "v-n5-0121", "v-n5-0623", "v-n5-0119", "v-n5-0673", "v-n5-0272" ], "kana": "ゆいはうみとやまのあいだの、ちいさくてしずかなまちです。みせのまえにさくらえびのえがたくさんありました。", "morae": 49 },
    { "ref": "s-16-1#L7", "ids": [ "v-n5-0126", "v-n5-0438", "v-n5-0118", "v-n5-0132", "v-n5-0654", "v-n5-0211", "v-n5-0229", "v-n5-0122", "v-n5-0120", "v-n5-0271", "v-n5-0342" ], "kana": "ゆいのりょうりはさくらえびです。あらしのふつか、ケンはわたなべさんのだいどころでりょうりをして、さくらえびをもらいました。", "morae": 55 },
    { "ref": "s-16-1#L8", "ids": [ "v-n5-0154", "v-n5-0121", "v-n5-0339", "v-n5-0424", "v-n5-0118", "v-n5-0376", "v-n5-0186", "v-n5-0537", "v-n5-0126", "v-n5-0568", "v-n5-0119", "v-n5-0673", "v-n5-0272" ], "kana": "くじにさったとうげにのぼりはじめました。みちはせまくて、よこにみかんのきがたくさんありました。", "morae": 44 },
    { "ref": "s-16-1#L9", "ids": [ "v-n5-0358", "v-n5-0684", "v-n5-0657", "v-n5-0119", "v-n5-0293", "v-n5-0118", "v-n5-0239", "v-n5-0378", "v-n5-0124", "v-n5-0279", "v-n5-0692", "v-n5-0573", "v-n5-0165", "v-n5-0132" ], "kana": "あつくて、すぐあせがでました。ケンは「にもつはかるい」といいました。でも、かおはあかかったです。", "morae": 41 },
    { "ref": "s-16-1#L11", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0054", "v-n5-0125", "v-n5-0279", "v-n5-0686", "v-n5-0301" ], "kana": "わたしはなにもいいませんでした。ケンもなにもいわないで、またあるきはじめました。", "morae": 37 },
    { "ref": "s-16-1#L13", "ids": [ "v-n5-0549", "v-n5-0124", "v-n5-0548", "v-n5-0126", "v-n5-0187", "v-n5-0121", "v-n5-0420", "v-n5-0424", "v-n5-0422", "v-n5-0119", "v-n5-0272", "v-n5-0518", "v-n5-0118", "v-n5-0167", "v-n5-0671", "v-n5-0351", "v-n5-0132" ], "kana": "うみとやまのあいだに、でんしゃのみちとくるまのみちがありました。ふねはしろくて、とてもちいさかったです。", "morae": 47 },
    { "ref": "s-16-1#L14", "ids": [ "v-n5-0691", "v-n5-0549", "v-n5-0126", "v-n5-0188", "v-n5-0121", "v-n5-0119", "v-n5-0272", "v-n5-0654", "v-n5-0565", "v-n5-0120", "v-n5-0312", "v-n5-0132", "v-n5-0566", "v-n5-0118", "v-n5-0676" ], "kana": "そして、うみのむこうにふじさんがありました。あらしがそらをあらったのでしょう。ゆきはもうありませんでした。", "morae": 48 },
    { "ref": "s-16-1#L15", "ids": [ "v-n5-0154", "g-n5-015", "v-n5-0093", "v-n5-0119", "v-n5-0423", "v-n5-0122", "v-n5-0339", "v-n5-0275", "v-n5-0126", "v-n4-0014", "v-n5-0135" ], "kana": "じゅういちじごろ、おとこのこがじてんしゃでのぼってきました。わたなべさんのむすこのユウくんでした。", "morae": 44 },
    { "ref": "s-16-1#L17", "ids": [ "v-n5-0118", "v-n5-0406", "v-n5-0120", "v-n5-0278", "v-n5-0684", "v-n5-0287", "v-n5-0041", "v-n5-0100", "v-n5-0121", "v-n5-0282", "v-n5-0351", "v-n5-0398", "v-n5-0111" ], "kana": "ユウくんはみずをのんで、すぐかえりました。わたしはノートにかきました。ちいさなしんせつ、ひとつ。", "morae": 43 },
    { "ref": "s-16-1#L19", "ids": [ "v-n5-0118", "v-n5-0686", "v-n5-0424", "v-n5-0126", "v-n5-0183", "v-n5-0121", "v-n5-0272", "v-n5-0041", "v-n5-0153", "v-n5-0120", "v-n5-0301", "v-n5-0275", "v-n5-0132", "v-n5-0127" ], "kana": "ふじさんはまたみちのみぎにありました。わたしたちのうしろをあるいて、みぎにきたのでしょうか。", "morae": 42 },
    { "ref": "s-16-2#L0", "ids": [ "v-n5-0774", "v-n5-0357", "v-n5-0126", "v-n5-0229", "v-n5-0121", "v-n5-0298", "v-n5-0275" ], "kana": "あっ。わるい。さくらえび、わたなべさんのだいどころにおいてきた。", "morae": 28 },
    { "ref": "s-16-2#L1", "ids": [ "v-n5-0688", "v-n5-0298", "v-n5-0275", "v-n5-0126" ], "kana": "ほんとうに？おいてきたの？", "morae": 11 },
    { "ref": "s-16-2#L2", "ids": [ "v-n5-0298", "v-n5-0275", "v-n5-0176", "v-n5-0126", "v-n5-0148", "v-n5-0121", "g-n4-006" ], "kana": "おいてきた。つくえのうえにおいたまま。", "morae": 17 },
    { "ref": "s-16-2#L3", "ids": [ "v-n5-0139", "v-n5-0121", "v-n5-0342" ], "kana": "きのう、わたなべさんにもらったのに。", "morae": 16 },
    { "ref": "s-16-2#L4", "ids": [ "v-n5-0285", "v-n5-0129", "v-n5-0178", "v-n5-0120", "v-n5-0307", "v-n5-0325", "v-n5-0406", "v-n5-0118", "v-n5-0272" ], "kana": "わかってるよ。まどをしめてて、わすれちゃった。みずはある？", "morae": 24 },
    { "ref": "s-16-2#L5", "ids": [ "v-n4-0027", "v-n5-0128", "v-n5-0406", "v-n5-0676", "v-n5-0310", "v-n5-0298", "v-n5-0141", "v-n5-0114" ], "kana": "しかたないね。みずならもういれておいた。あさ、にほん。", "morae": 23 },
    { "ref": "s-16-2#L6", "ids": [ "v-n5-0276", "v-n5-0549", "v-n5-0166", "v-n5-0565" ], "kana": "みて。うみ、あおいな。そらよりあおい。", "morae": 15 },
    { "ref": "s-16-2#L8", "ids": [ "v-n5-0686", "v-n5-0183", "v-n5-0127", "v-n5-0050", "v-n5-0548", "v-n5-0301", "v-n5-0126", "v-n5-0369" ], "kana": "またみぎか。あのやま、あるくのはやいな。", "morae": 17 },
    { "ref": "s-16-2#L9", "ids": [ "v-n5-0013", "v-n5-0126", "v-n4-0014", "v-n5-0132" ], "kana": "すみません！かんばらのわたなべのむすこです。ユウです。", "morae": 24 },
    { "ref": "s-16-2#L10", "ids": [ "v-n5-0423", "v-n5-0122", "v-n5-0275", "v-n5-0126" ], "kana": "さくらえび！じてんしゃできたの？", "morae": 13 },
    { "ref": "s-16-2#L11", "ids": [ "v-n5-0001", "v-n5-0082", "v-n5-0119", "v-n5-0296", "v-n5-0274", "v-n5-0155", "v-n5-0135" ], "kana": "はい。ははが「もっていって」って。よんじゅっぷんでした。", "morae": 22 },
    { "ref": "s-16-2#L12", "ids": [ "v-n5-0011", "v-n5-0358", "v-n5-0132", "v-n5-0406", "v-n5-0278" ], "kana": "ありがとう。あつかったでしょう？みず、のんで。", "morae": 18 },
    { "ref": "s-16-2#L13", "ids": [ "v-n5-0403", "v-n5-0132", "v-n5-0287", "v-n5-0118", "v-n5-0369", "v-n5-0130" ], "kana": "だいじょうぶです。かえりははやいから。", "morae": 16 },
    { "ref": "s-16-2#L14", "ids": [ "v-n4-0037" ], "kana": "ユウくん、きをつけて。", "morae": 9 },
    { "ref": "s-16-2#L16", "ids": [ "v-n5-0041", "v-n5-0121", "v-n5-0125", "v-n5-0111" ], "kana": "わたしにもひとつ。", "morae": 8 },
    { "ref": "s-16-2#L17", "ids": [ "v-n5-0356", "v-n5-0129", "v-n5-0111" ], "kana": "いいよ。ひとつだけな。", "morae": 9 },
    { "ref": "s-16-2#L18", "ids": [ "v-n5-0351", "v-n5-0398", "v-n5-0111" ], "kana": "ちいさなしんせつ、ひとつ。", "morae": 11 },
    { "ref": "s-16-2#L19", "ids": [ "v-n5-0686", "v-n5-0282" ], "kana": "またかいてる。", "morae": 6 },
    { "ref": "s-16-3#L0", "ids": [ "v-n5-0083", "v-n5-0084", "v-n5-0123" ], "kana": "おとうさん、おかあさんへ。", "morae": 11 },
    { "ref": "s-16-3#L1", "ids": [ "v-n5-0137", "v-n5-0118", "v-n5-0126", "v-n5-0548", "v-n5-0148", "v-n5-0130", "v-n5-0282", "v-n5-0273" ], "kana": "きょうはゆいのやまのうえからかいています。", "morae": 19 },
    { "ref": "s-16-3#L2", "ids": [ "v-n5-0654", "v-n5-0118", "v-n5-0328", "v-n5-0565", "v-n5-0397", "v-n5-0735", "v-n5-0273", "v-n5-0549", "v-n5-0166", "v-n5-0132" ], "kana": "あらしはおわりました。そらはきれいにはれていて、うみはそらよりあおいです。", "morae": 34 },
    { "ref": "s-16-3#L4", "ids": [ "v-n5-0358", "v-n5-0657", "v-n5-0119", "v-n5-0673", "v-n5-0293", "v-n5-0692", "v-n5-0148", "v-n5-0126", "v-n5-0567", "v-n5-0118", "v-n5-0563", "v-n5-0132" ], "kana": "あつくて、あせがたくさんでました。でも、うえのかぜはすずしいです。", "morae": 29 },
    { "ref": "s-16-3#L8", "ids": [ "v-n5-0126", "v-n5-0438", "v-n5-0118", "v-n5-0132", "v-n5-0351", "v-n5-0653", "v-n5-0160" ], "kana": "ゆいのりょうりはさくらえびです。ちいさくて、さくらのいろです。", "morae": 27 },
    { "ref": "s-16-3#L9", "ids": [ "v-n5-0118", "v-n5-0548", "v-n5-0126", "v-n5-0148", "v-n5-0122", "v-n5-0111", "v-n5-0277", "v-n5-0339", "g-n5-068", "v-n5-0124", "v-n5-0279" ], "kana": "ケンはやまのうえでひとつたべて、「のぼってよかった」といいました。", "morae": 29 },
    { "ref": "s-16-3#L10", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0330", "g-n5-033", "v-n5-0712", "v-n5-0120", "v-n5-0271", "v-n5-0298", "v-n5-0324" ], "kana": "わたしは、でかけるまえにじゅんびをしておくことをおぼえました。", "morae": 28 },
    { "ref": "s-16-3#L11", "ids": [ "v-n5-0691", "v-n5-0066", "v-n5-0126", "v-n5-0398", "v-n5-0125", "v-n5-0324", "v-n5-0273", "v-n5-0100", "v-n5-0121", "v-n5-0282", "v-n5-0272" ], "kana": "そして、ひとのしんせつもおぼえています。ノートにかいてあります。", "morae": 29 },
    { "ref": "s-16-3#L12", "ids": [ "v-n5-0126", "v-n5-0239", "v-n5-0118", "v-n5-0686", "v-n5-0674", "v-n5-0377", "v-n5-0132", "v-n5-0692", "v-n5-0378", "v-n5-0124", "v-n5-0279", "v-n5-0273" ], "kana": "ケンのにもつはまたすこしおもいです。でも、ケンは「かるい」といっています。", "morae": 32 },
    { "ref": "s-16-3#L13", "ids": [ "v-n5-0118", "v-n5-0358", "v-n5-0132", "v-n5-0127", "v-n5-0559", "v-n5-0121", "v-n4-0037", "g-n5-051" ], "kana": "よこはまはあついですか。からだにきをつけてください。", "morae": 24 },
    { "ref": "s-16-3#L14", "ids": [ "v-n5-0138", "v-n5-0118", "v-n5-0131", "v-n5-0301", "v-n5-0549", "v-n5-0126", "v-n5-0185", "v-n5-0424", "v-n5-0132" ], "kana": "あしたはおきつまであるきます。うみのちかくのみちです。", "morae": 25 },
    { "ref": "s-16-3#L15", "ids": [ "v-n5-0548", "v-n5-0119", "v-n5-0111", "v-n5-0328", "v-n5-0118", "v-n5-0136", "v-n5-0041", "v-n5-0126", "v-n5-0153", "v-n5-0121", "v-n5-0272" ], "kana": "やまがひとつおわりました。ふじさんはいま、わたしたちのうしろにあります。", "morae": 33 },
    { "ref": "s-16-3#L16", "ids": [ "v-n5-0218", "v-n5-0211", "v-n5-0122" ], "kana": "しちがつにじゅうごにち、さったとうげで。ハナより。", "morae": 21 },
    { "ref": "s-16-4#L0", "ids": [ "v-n5-0004", "v-n5-0218", "v-n5-0211", "v-n5-0141", "v-n5-0154", "v-n5-0126", "v-n5-0605", "v-n5-0132" ], "kana": "おはようございます。しちがつにじゅうごにち、あさしちじのてんきよほうです。", "morae": 33 },
    { "ref": "s-16-4#L1", "ids": [ "v-n5-0126", "v-n5-0137", "v-n5-0547", "v-n5-0118", "v-n5-0248", "v-n5-0680", "v-n5-0735", "v-n5-0132" ], "kana": "ゆいのきょうのてんきは、いちにちよくはれるでしょう。", "morae": 22 },
    { "ref": "s-16-4#L2", "ids": [ "v-n5-0654", "v-n5-0118", "v-n5-0143", "v-n5-0126", "v-n5-0187", "v-n5-0121", "v-n5-0549", "v-n5-0188", "v-n5-0123", "v-n5-0274", "v-n5-0309" ], "kana": "あらしは、よるのあいだにうみのむこうへいってしまいました。", "morae": 27 },
    { "ref": "s-16-4#L3", "ids": [ "v-n5-0565", "v-n5-0118", "v-n5-0680", "v-n5-0735", "v-n5-0273", "v-n5-0236", "v-n5-0671", "v-n5-0166", "v-n5-0132" ], "kana": "そらはよくはれていて、するがわんはけさ、とてもあおいです。", "morae": 26 },
    { "ref": "s-16-4#L4", "ids": [ "v-n5-0130", "v-n5-0118", "v-n5-0137", "v-n5-0125", "v-n5-0680", "v-n5-0276", "v-n5-0132" ], "kana": "さったとうげからは、きょうはふじさんもよくみられるでしょう。", "morae": 26 },
    { "ref": "s-16-4#L7", "ids": [ "v-n5-0141", "v-n5-0118", "v-n5-0567", "v-n5-0119", "v-n5-0381", "v-n5-0159", "v-n5-0154", "g-n5-015", "v-n5-0130", "v-n5-0270", "v-n5-0126", "v-n5-0380", "v-n5-0732", "v-n5-0132" ], "kana": "あさはかぜがよわく、ごごさんじごろからきたのかぜがつよくふくでしょう。", "morae": 32 },
    { "ref": "s-16-4#L8", "ids": [ "v-n5-0549", "v-n5-0126", "v-n5-0424", "v-n5-0548", "g-n4-010", "v-n5-0674", "v-n5-0563", "v-n5-0132" ], "kana": "うみのみちよりやまのみちのほうが、すこしすずしいでしょう。", "morae": 26 },
    { "ref": "s-16-4#L9", "ids": [ "v-n5-0549", "v-n5-0118", "v-n5-0677", "v-n5-0386", "v-n5-0132", "v-n5-0130", "v-n5-0137", "v-n5-0320", "g-n5-051" ], "kana": "うみはまだしずかではありませんから、きょうはおよがないでください。", "morae": 30 },
    { "ref": "s-16-4#L10", "ids": [ "v-n5-0654", "v-n5-0122", "v-n5-0721", "v-n5-0273", "v-n5-0420", "v-n5-0118", "v-n5-0236", "v-n5-0130", "v-n5-0302" ], "kana": "あらしでとまっていたでんしゃは、けさからはしっています。", "morae": 25 },
    { "ref": "s-16-4#L11", "ids": [ "v-n5-0421", "v-n5-0125", "v-n5-0678", "v-n5-0126", "v-n5-0157", "v-n5-0121", "v-n5-0302", "v-n5-0273" ], "kana": "バスも、いつものじかんにはしっています。", "morae": 18 },
    { "ref": "s-16-4#L12", "ids": [ "v-n5-0602", "v-n5-0126", "v-n5-0424", "v-n5-0125", "v-n5-0676", "v-n5-0422", "v-n5-0119", "v-n5-0302" ], "kana": "かいがんのみちも、もうくるまがはしれます。", "morae": 19 },
    { "ref": "s-16-4#L13", "ids": [ "v-n5-0126", "v-n5-0520", "v-n5-0361", "v-n5-0408", "v-n5-0119", "v-n5-0298", "v-n5-0272" ], "kana": "ゆいのえきまえには、つめたいおちゃがおいてあります。", "morae": 23 },
    { "ref": "s-16-4#L14", "ids": [ "v-n5-0548", "v-n5-0121", "v-n5-0339", "v-n5-0066", "v-n5-0118", "v-n5-0805", "v-n5-0278", "v-n5-0130", "v-n5-0330", "g-n5-051" ], "kana": "やまにのぼるひとは、どうぞのんでからでかけてください。", "morae": 25 },
    { "ref": "s-16-4#L15", "ids": [ "v-n5-0330", "v-n5-0152", "v-n5-0121", "v-n5-0239", "v-n5-0406", "v-n5-0120", "v-n5-0673", "v-n5-0310", "v-n5-0298", "g-n5-051", "v-n5-0253", "v-n5-0125", "v-n5-0325" ], "kana": "でかけるまえに、にもつにみずをたくさんいれておいてください。ぼうしもわすれないでください。", "morae": 42 },
    { "ref": "s-16-4#L16", "ids": [ "v-n5-0358", "v-n5-0768", "v-n4-0031", "v-n5-0120", "g-n4-007", "v-n5-0679", "v-n5-0318", "g-n5-051" ], "kana": "あついですから、むりをしないで、ときどきやすんでください。", "morae": 26 },
    { "ref": "s-16-4#L18", "ids": [ "v-n5-0234", "v-n5-0125", "v-n5-0358", "v-n5-0132", "v-n5-0178", "v-n5-0120", "v-n5-0306", "g-n4-006", "v-n5-0289", "v-n5-0066", "v-n5-0118", "v-n5-0576", "v-n5-0121", "v-n4-0037", "g-n5-051" ], "kana": "こんばんもあついでしょう。まどをあけたままねるひとは、かぜにきをつけてください。", "morae": 36 },
    { "ref": "s-16-4#L19", "ids": [ "v-n5-0073", "v-n5-0137", "v-n5-0125", "v-n4-0037", "v-n5-0356", "v-n5-0248", "v-n5-0120" ], "kana": "みなさん、きょうもきをつけて、いいいちにちを。", "morae": 19 },
    { "ref": "s-16-4#L20", "ids": [ "v-n5-0218", "v-n5-0211", "v-n5-0126", "v-n5-0605", "v-n5-0135" ], "kana": "しちがつにじゅうごにち、ゆいのてんきよほうでした。", "morae": 22 },
    { "ref": "s-16-5#L0", "ids": [ "v-n5-0001", "v-n5-0126", "v-n5-0132" ], "kana": "はい、かんばらのわたなべりょかんです。", "morae": 16 },
    { "ref": "s-16-5#L2", "ids": [ "v-n5-0702", "v-n5-0004", "v-n5-0060", "v-n5-0271", "v-n5-0127" ], "kana": "ああ、ケンさん。おはようございます。どうしましたか。", "morae": 22 },
    { "ref": "s-16-5#L3", "ids": [ "v-n5-0013", "v-n5-0120", "v-n5-0229", "v-n5-0121", "v-n5-0298", "v-n5-0275", "v-n5-0309" ], "kana": "すみません。さくらえびを、だいどころにおいてきてしまいました。", "morae": 28 },
    { "ref": "s-16-5#L5", "ids": [ "v-n5-0702", "g-n5-068" ], "kana": "ああ、よかった。", "morae": 6 },
    { "ref": "s-16-5#L6", "ids": [ "v-n5-0013", "v-n5-0119", "g-n4-006", "v-n5-0297", "v-n5-0298", "g-n5-051" ], "kana": "すみませんが、そのままとっておいてください。", "morae": 20 },
    { "ref": "s-16-5#L7", "ids": [ "v-n5-0001", "v-n5-0692", "v-n5-0358", "v-n5-0768", "v-n5-0563", "v-n5-0498", "v-n5-0121", "v-n5-0298", "v-n5-0128" ], "kana": "はい。でもあついですから、すずしいところにおいておきますね。", "morae": 27 },
    { "ref": "s-16-5#L8", "ids": [ "v-n5-0010", "v-n5-0692", "v-n5-0138", "v-n5-0118", "v-n5-0131", "v-n5-0301", "v-n5-0287" ], "kana": "ありがとうございます。でも、あしたはおきつまであるくので、かんばらにはかえれません。", "morae": 38 },
    { "ref": "s-16-5#L9", "ids": [ "v-n5-0030", "v-n5-0136", "v-n5-0118", "v-n5-0056", "v-n5-0121", "v-n5-0273", "v-n5-0127" ], "kana": "そうですか。いまは、どこにいますか。", "morae": 15 },
    { "ref": "s-16-5#L10", "ids": [ "v-n5-0126", "v-n5-0148", "v-n5-0132", "v-n5-0154", "g-n5-015", "v-n5-0131", "v-n5-0318", "v-n5-0130", "v-n5-0121", "v-n5-0304" ], "kana": "さったとうげのうえです。じゅういちじごろまでやすんでから、ゆいにおります。", "morae": 33 },
    { "ref": "s-16-5#L11", "ids": [ "v-n5-0285", "v-n5-0695", "v-n5-0118", "v-n5-0041", "v-n5-0119", "v-n4-0021", "v-n5-0298", "v-n5-0128" ], "kana": "わかりました。じゃあ、さくらえびは、わたしがかんがえておきますね。", "morae": 28 },
    { "ref": "s-16-5#L12", "ids": [ "v-n5-0001", "v-n5-0013", "v-n5-0019" ], "kana": "はい。すみません、おねがいします。", "morae": 14 },
    { "ref": "s-16-5#L13", "ids": [ "v-n5-0548", "v-n5-0126", "v-n5-0148", "v-n5-0130", "v-n5-0549", "v-n5-0118", "v-n5-0060", "v-n5-0132", "v-n5-0127", "v-n5-0137", "v-n5-0397" ], "kana": "やまのうえから、うみはどうですか。きょうはきれいでしょう。", "morae": 24 },
    { "ref": "s-16-5#L14", "ids": [ "v-n5-0003", "v-n5-0671", "v-n5-0397", "v-n5-0132", "v-n5-0129", "v-n5-0565", "v-n5-0549", "g-n4-010", "v-n5-0166" ], "kana": "ええ、とてもきれいですよ。そらよりうみのほうがあおいです。", "morae": 26 },
    { "ref": "s-16-5#L15", "ids": [ "v-n5-0132", "v-n5-0654", "v-n5-0119", "v-n5-0565", "v-n5-0120", "v-n5-0312", "v-n5-0343", "v-n5-0130", "v-n5-0128" ], "kana": "そうでしょう。あらしがそらをあらってくれましたからね。", "morae": 24 },
    { "ref": "s-16-5#L16", "ids": [ "v-n5-0023", "v-n5-0125", "v-n5-0137", "v-n5-0118", "v-n5-0549", "v-n5-0126", "v-n5-0188", "v-n5-0121", "v-n5-0680", "v-n5-0293", "v-n5-0273", "v-n5-0129" ], "kana": "そうですね。ふじさんも、きょうはうみのむこうによくでていますよ。", "morae": 28 },
    { "ref": "s-16-5#L17", "ids": [ "v-n5-0693", "v-n5-0236", "v-n5-0118", "v-n5-0178", "v-n5-0119", "v-n5-0760", "v-n5-0309", "v-n5-0013", "v-n5-0135" ], "kana": "それから、けさはまどがなかなかしまらなくて、すみませんでした。", "morae": 28 },
    { "ref": "s-16-5#L18", "ids": [ "v-n5-0002", "v-n5-0050", "v-n5-0178", "v-n5-0118", "v-n5-0355", "v-n5-0768", "v-n5-0678", "v-n5-0760", "v-n5-0309", "v-n5-0129" ], "kana": "いいえ。あのまどはふるいですから、いつもなかなかしまりませんよ。", "morae": 29 },
    { "ref": "s-16-5#L19", "ids": [ "v-n5-0030" ], "kana": "そうですか。", "morae": 5 },
    { "ref": "s-16-5#L20", "ids": [ "v-n5-0136", "v-n5-0118", "v-n5-0764", "v-n5-0307", "v-n5-0272", "v-n5-0403", "v-n5-0132", "v-n5-0129" ], "kana": "いまはちゃんとしめてあります。だいじょうぶですよ。", "morae": 21 },
    { "ref": "s-16-5#L21", "ids": [ "g-n5-068", "v-n5-0688", "v-n5-0405", "v-n5-0010" ], "kana": "よかった。ほんとうに、いろいろありがとうございます。", "morae": 23 },
    { "ref": "s-16-5#L22", "ids": [ "v-n4-0037", "v-n5-0274", "g-n5-051", "v-n5-0128", "v-n5-0406", "v-n5-0120", "v-n5-0673", "v-n5-0278" ], "kana": "きをつけていってくださいね。みずをたくさんのんでください。", "morae": 27 },
    { "ref": "s-16-5#L23", "ids": [ "v-n5-0001", "v-n5-0698", "v-n5-0028" ], "kana": "はい。それでは、しつれいします。", "morae": 13 },
    { "ref": "g-n4-001#ex0", "ids": [ "g-n4-001", "v-n5-0567", "v-n5-0122", "v-n5-0179", "v-n5-0119", "v-n5-0308" ], "kana": "かぜでドアがあきました。", "morae": 11 },
    { "ref": "g-n4-001#ex1", "ids": [ "g-n4-001", "v-n5-0358", "v-n5-0178", "v-n5-0120", "v-n5-0306", "g-n5-051" ], "kana": "あついので、まどをあけてください。", "morae": 15 },
    { "ref": "g-n4-001#ex4", "ids": [ "g-n4-001", "v-n5-0417", "v-n5-0118", "v-n5-0154", "v-n5-0121", "v-n5-0309" ], "kana": "みせはじゅうじにしまります。", "morae": 12 },
    { "ref": "g-n4-002#ex0", "ids": [ "g-n4-002", "v-n5-0178", "v-n5-0119", "v-n5-0308", "v-n5-0273", "v-n5-0129", "v-n5-0359", "v-n5-0132", "v-n5-0127" ], "kana": "まどがあいていますよ。さむくないですか。", "morae": 18 },
    { "ref": "g-n4-002#ex1", "ids": [ "g-n4-002", "v-n5-0520", "v-n5-0126", "v-n5-0453", "v-n5-0118", "v-n5-0676", "v-n5-0309", "v-n5-0273" ], "kana": "えきまえのコンビニはもうしまっていた。", "morae": 18 },
    { "ref": "g-n4-002#ex4", "ids": [ "g-n4-002", "v-n5-0118", "v-n5-0708", "v-n5-0271", "v-n5-0273" ], "kana": "たなかさんはけっこんしています。", "morae": 15 },
    { "ref": "g-n4-003#ex4", "ids": [ "g-n4-003", "v-n5-0485", "v-n5-0118", "v-n5-0676", "v-n5-0284", "v-n5-0272" ], "kana": "きっぷはもうかってあります。", "morae": 13 },
    { "ref": "g-n4-004#ex0", "ids": [ "g-n4-004", "v-n5-0420", "v-n5-0126", "g-n5-033", "v-n5-0171", "v-n5-0120", "v-n5-0325", "v-n5-0309" ], "kana": "でんしゃのなかにかさをわすれてしまいました。", "morae": 20 },
    { "ref": "g-n4-004#ex1", "ids": [ "g-n4-004", "v-n5-0481", "v-n5-0681", "v-n5-0277", "v-n5-0126" ], "kana": "ケーキ、ぜんぶたべちゃったの？", "morae": 12 },
    { "ref": "g-n4-004#ex2", "ids": [ "g-n4-004", "v-n5-0105", "v-n5-0118", "v-n5-0676", "v-n5-0130", "v-n5-0319", "v-n5-0129" ], "kana": "しゅくだいはもうやってしまったから、あそべるよ。", "morae": 21 },
    { "ref": "g-n4-004#ex4", "ids": [ "g-n4-004", "v-n5-0141", "v-n5-0370", "v-n5-0288", "v-n5-0579", "v-n5-0121", "v-n5-0309" ], "kana": "あさ、おそくおきて、かいぎにおくれてしまいました。", "morae": 22 },
    { "ref": "g-n4-005#ex0", "ids": [ "g-n4-005", "v-n5-0579", "v-n5-0126", "g-n5-033", "v-n5-0147", "v-n5-0120", "v-n5-0706", "v-n5-0271", "v-n5-0298" ], "kana": "かいぎのまえにへやをそうじしておきます。", "morae": 19 },
    { "ref": "g-n4-005#ex3", "ids": [ "g-n4-005", "v-n5-0178", "v-n5-0118", "v-n5-0049", "g-n4-006", "v-n5-0306", "v-n5-0298", "g-n5-051" ], "kana": "まどはそのままあけておいてください。", "morae": 17 },
    { "ref": "g-n4-006#ex0", "ids": [ "g-n4-006", "v-n5-0583", "v-n5-0120", "v-n5-0720", "v-n5-0289" ], "kana": "テレビをつけたままねてしまった。", "morae": 15 },
    { "ref": "g-n4-006#ex1", "ids": [ "g-n4-006", "v-n5-0434", "v-n5-0696", "v-n5-0170", "v-n5-0145", "v-n5-0121", "v-n5-0292", "g-n5-051" ], "kana": "にほんではくつのままいえにはいらないでください。", "morae": 23 },
    { "ref": "g-n4-006#ex2", "ids": [ "g-n4-006", "v-n5-0178", "v-n5-0120", "v-n5-0306", "v-n5-0330", "v-n5-0147", "v-n5-0119", "v-n5-0359" ], "kana": "まどをあけたままでかけたので、へやがさむい。", "morae": 20 },
    { "ref": "g-n4-006#ex3", "ids": [ "g-n4-006", "v-n5-0049", "v-n5-0425", "v-n5-0118", "v-n5-0040", "v-n5-0203", "v-n5-0152", "v-n5-0135" ], "kana": "そのまちはじゅうねんまえのままでした。", "morae": 17 },
    { "ref": "g-n4-006#ex4", "ids": [ "g-n4-006", "v-n5-0054", "v-n5-0125", "v-n5-0279", "v-n4-0002", "v-n5-0118", "v-n5-0287", "v-n5-0274" ], "kana": "なにもいわないまま、かれはかえっていった。", "morae": 19 },
    { "ref": "g-n4-007#ex0", "ids": [ "g-n4-007", "v-n5-0236", "v-n5-0118", "v-n5-0439", "v-n5-0120", "v-n5-0277", "v-n5-0427", "v-n5-0121", "v-n5-0275" ], "kana": "けさはあさごはんをたべないでかいしゃにきました。", "morae": 22 },
    { "ref": "g-n4-007#ex2", "ids": [ "g-n4-007", "v-n5-0139", "v-n5-0118", "v-n5-0421", "v-n5-0121", "v-n5-0303", "v-n5-0145", "v-n5-0131", "v-n5-0301" ], "kana": "きのうはバスにのらないで、いえまであるいた。", "morae": 20 },
    { "ref": "g-n4-008#ex0", "ids": [ "g-n4-008", "v-n4-0002", "v-n5-0118", "v-n5-0054", "v-n5-0125", "v-n5-0279", "v-n5-0147", "v-n5-0120", "v-n5-0293" ], "kana": "かれはなにもいわずにへやをでた。", "morae": 15 },
    { "ref": "g-n4-008#ex1", "ids": [ "g-n4-008", "v-n5-0139", "v-n5-0118", "v-n5-0054", "v-n5-0125", "v-n5-0277", "v-n5-0289", "v-n5-0309" ], "kana": "きのうはなにもたべずにねてしまいました。", "morae": 19 },
    { "ref": "g-n4-008#ex2", "ids": [ "g-n4-008", "v-n5-0105", "v-n5-0120", "v-n5-0593", "v-n5-0319", "v-n5-0121", "v-n5-0274" ], "kana": "しゅくだいをせずにあそびにいってはいけません。", "morae": 21 },
    { "ref": "g-n4-009#ex0", "ids": [ "g-n4-009", "v-n5-0141", "v-n5-0421", "v-n5-0119", "v-n5-0275", "v-n5-0097", "v-n5-0121", "v-n5-0370" ], "kana": "あさ、バスがこなくて、がっこうにおくれました。", "morae": 20 },
    { "ref": "g-n4-010#ex0", "ids": [ "g-n4-010", "v-n5-0137", "v-n5-0118", "v-n5-0139", "v-n5-0358", "v-n5-0132", "v-n5-0128" ], "kana": "きょうはきのうよりあついですね。", "morae": 14 },
    { "ref": "g-n4-010#ex1", "ids": [ "g-n4-010", "v-n5-0420", "v-n5-0421", "v-n5-0353", "v-n5-0129" ], "kana": "でんしゃよりバスのほうがやすいよ。", "morae": 15 },
    { "ref": "g-n4-010#ex2", "ids": [ "g-n4-010", "v-n5-0434", "v-n5-0126", "v-n5-0442", "v-n5-0150", "v-n5-0122", "v-n5-0054", "v-n5-0119", "v-n5-0751", "v-n5-0392", "v-n5-0132", "v-n5-0127" ], "kana": "にほんのたべもののなかで、なにがいちばんすきですか。", "morae": 24 },
    { "ref": "g-n4-010#ex3", "ids": [ "g-n4-010", "v-n5-0031", "v-n5-0203", "v-n5-0126", "v-n5-0150", "v-n5-0122", "v-n5-0219", "v-n5-0119", "v-n5-0751", "v-n5-0358" ], "kana": "いちねんのなかではちがつがいちばんあつい。", "morae": 20 },
    { "ref": "g-n4-010#ex4", "ids": [ "g-n4-010", "v-n5-0077", "v-n5-0126", "v-n5-0150", "v-n5-0122", "v-n5-0081", "v-n5-0119", "v-n5-0751", "v-n5-0369", "v-n5-0288" ], "kana": "かぞくのなかでちちがいちばんはやくおきます。", "morae": 21 },
    { "ref": "v-n4-0001#ex1", "ids": [ "v-n4-0001", "v-n5-0087", "v-n5-0118", "v-n5-0122", "v-n5-0441", "v-n5-0120", "v-n5-0294" ], "kana": "おとうとはじぶんでばんごはんをつくりました。", "morae": 21 },
    { "ref": "v-n4-0002#ex0", "ids": [ "v-n4-0002", "v-n5-0118", "v-n5-0228", "v-n5-0154", "v-n5-0121", "v-n5-0288", "v-n5-0022" ], "kana": "かれはまいあさろくじにおきるそうです。", "morae": 18 },
    { "ref": "v-n4-0002#ex1", "ids": [ "v-n4-0002", "v-n5-0124", "v-n5-0118", "v-n5-0206", "v-n5-0126", "v-n5-0225", "v-n5-0121", "v-n4-0061" ], "kana": "かれとはきょねんのなつにわかれた。", "morae": 15 },
    { "ref": "v-n4-0003#ex1", "ids": [ "v-n4-0003", "v-n5-0118", "v-n5-0139", "v-n5-0354", "v-n5-0170", "v-n5-0120", "v-n5-0284" ], "kana": "かのじょはきのう、あたらしいくつをかいました。", "morae": 20 },
    { "ref": "v-n4-0004#ex0", "ids": [ "v-n4-0004", "v-n5-0122", "v-n5-0436", "v-n5-0120", "v-n5-0726" ], "kana": "みんなでしゃしんをとりましょう。", "morae": 13 },
    { "ref": "v-n4-0004#ex1", "ids": [ "v-n4-0004", "v-n5-0139", "v-n5-0126", "v-n5-0740", "v-n5-0121", "v-n5-0118", "v-n5-0275", "v-n5-0343" ], "kana": "きのうのパーティーには、みんなきてくれた。", "morae": 18 },
