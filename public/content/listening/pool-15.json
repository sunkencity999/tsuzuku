{
  "schema": "tsuzuku.pool/1",
  "station": 15,
  "refs": [
    { "ref": "s-11-3#L0", "ids": [ "v-n5-0073", "v-n5-0123", "v-n5-0130", "v-n5-0126", "v-n5-0785", "v-n5-0132" ], "kana": "みなさんへ。みしまたいしゃからのおねがいです。", "morae": 20 },
    { "ref": "s-11-4#L4", "ids": [ "v-n5-0499", "v-n5-0120", "v-n5-0293", "v-n5-0753", "v-n5-0274", "g-n5-051" ], "kana": "いりぐちをでて、まっすぐいってください。", "morae": 18 },
    { "ref": "s-12-3#L3", "ids": [ "v-n5-0051", "v-n5-0126", "v-n5-0412", "v-n5-0118", "v-n5-0136", "v-n5-0131", "v-n5-0122", "v-n5-0751", "v-n5-0379", "v-n5-0124", "v-n5-0801" ], "kana": "ここのさかなは、いままででいちばんおいしいとおもう。", "morae": 24 },
    { "ref": "s-12-5#L5", "ids": [ "v-n5-0356", "v-n5-0129", "v-n5-0048", "v-n5-0424", "v-n5-0120", "v-n5-0753", "v-n5-0274", "g-n5-051" ], "kana": "いいよ。このみちをまっすぐいってください。", "morae": 19 },
    { "ref": "s-12-5#L6", "ids": [ "v-n5-0001", "v-n5-0753", "v-n5-0132", "v-n5-0128" ], "kana": "はい。まっすぐですね。", "morae": 9 },
    { "ref": "s-14-4#L0", "ids": [ "v-n5-0774", "v-n5-0090", "v-n5-0600", "v-n5-0126", "v-n5-0498", "v-n5-0066" ], "kana": "あ、おねえさん！いしのところのひとだ！", "morae": 16 },
    { "ref": "s-14-4#L21", "ids": [ "v-n5-0774", "v-n5-0084", "v-n5-0119", "v-n5-0731", "v-n5-0676", "v-n5-0274" ], "kana": "あ、おかあさんがよんでる。もういく。", "morae": 15 },
    { "ref": "s-14-5#L0", "ids": [ "v-n5-0774" ], "kana": "あ、ハナ？ケンだけど。", "morae": 8 },
    { "ref": "s-15-1#L0", "ids": [ "v-n5-0218", "v-n5-0211", "v-n5-0550", "v-n5-0439", "v-n5-0118", "v-n5-0154", "v-n5-0135" ], "kana": "しちがつにじゅうににち、あめ。あさごはんはしちじでした。", "morae": 24 },
    { "ref": "s-15-1#L2", "ids": [ "v-n5-0350", "v-n5-0654", "v-n5-0119", "v-n5-0275", "v-n5-0273", "v-n5-0567", "v-n5-0380", "v-n5-0178", "v-n5-0674", "v-n5-0639", "v-n5-0132" ], "kana": "おおきいあらしがきています。かぜがつよくて、まどがすこしうるさいです。", "morae": 32 },
    { "ref": "s-15-1#L3", "ids": [ "v-n5-0147", "v-n5-0121", "v-n5-0391", "v-n5-0623", "v-n5-0119", "v-n5-0272", "v-n5-0566", "v-n5-0126", "v-n5-0143", "v-n5-0132" ], "kana": "へやにゆうめいなえがあります。ゆきのよるのかんばらです。", "morae": 26 },
    { "ref": "s-15-1#L4", "ids": [ "v-n5-0119", "v-n5-0279", "v-n5-0051", "v-n5-0696", "v-n5-0566", "v-n5-0118", "v-n5-0304", "v-n5-0129", "v-n5-0752", "v-n5-0125" ], "kana": "わたなべさんがいいました。「ここではゆきはふりませんよ。いちども。」", "morae": 29 },
    { "ref": "s-15-1#L5", "ids": [ "v-n5-0566", "v-n5-0119", "v-n5-0340", "v-n5-0178", "v-n5-0126", "v-n5-0151", "v-n5-0118", "v-n5-0050", "v-n5-0623", "v-n5-0132", "v-n5-0137", "v-n5-0550" ], "kana": "ゆきがふったら、まどのそとはあのえです。きょうはあめです。", "morae": 25 },
    { "ref": "s-15-1#L6", "ids": [ "v-n5-0138", "v-n5-0125", "v-n5-0550", "g-n5-068", "v-n5-0676", "v-n5-0248", "v-n5-0051", "v-n5-0121", "g-n5-086", "v-n5-0806" ], "kana": "あしたもあめだったら、もういちにちここにいなければなりません。", "morae": 29 },
    { "ref": "s-15-1#L7", "ids": [ "v-n5-0118", "v-n5-0398", "v-n5-0132", "v-n5-0141", "v-n5-0369", "v-n5-0293", "g-n5-089", "v-n5-0129" ], "kana": "わたなべさんはしんせつです。「さったとうげなら、あさはやくでたほうがいいですよ。」", "morae": 36 },
    { "ref": "s-15-1#L8", "ids": [ "v-n5-0183", "v-n5-0121", "v-n5-0722", "v-n5-0124", "v-n5-0549", "v-n5-0119", "v-n5-0272", "v-n5-0753", "v-n5-0274", "v-n5-0132" ], "kana": "「みぎにまがると、うみがあります。まっすぐいくと、さったとうげです。」", "morae": 29 },
    { "ref": "s-15-1#L9", "ids": [ "v-n5-0126", "v-n5-0152", "v-n5-0121", "v-n5-0271", "v-n5-0119", "v-n5-0111", "v-n5-0272" ], "kana": "さったとうげのまえに、することがみっつあります。", "morae": 22 },
    { "ref": "s-15-1#L10", "ids": [ "v-n5-0749", "v-n5-0406", "v-n5-0120", "v-n5-0284", "v-n5-0806", "v-n5-0548", "v-n5-0126", "v-n5-0424", "v-n5-0417", "v-n5-0119" ], "kana": "まず、みずをかわなければなりません。やまのみちにはみせがないので。", "morae": 30 },
    { "ref": "s-15-1#L12", "ids": [ "v-n5-0118", "v-n5-0678", "v-n5-0378", "v-n5-0124", "v-n5-0279", "v-n5-0119", "v-n5-0377", "v-n5-0132" ], "kana": "ケンはいつも「かるい」といいますが、おもいです。", "morae": 20 },
    { "ref": "s-15-1#L13", "ids": [ "v-n5-0691", "v-n5-0605", "v-n5-0120", "v-n5-0764", "v-n5-0276", "v-n5-0806" ], "kana": "そして、てんきよほうをちゃんとみなければなりません。", "morae": 23 },
    { "ref": "s-15-1#L14", "ids": [ "v-n5-0142", "v-n5-0152", "v-n5-0121", "v-n5-0067", "v-n5-0130", "v-n5-0543", "v-n5-0119", "v-n5-0272", "v-n5-0154", "v-n5-0735", "v-n5-0129" ], "kana": "ひるまえに、たなかさんからでんわがありました。「じゅうにじにははれますよ。」", "morae": 32 },
    { "ref": "s-15-1#L15", "ids": [ "v-n5-0154", "v-n5-0550", "v-n5-0677", "v-n5-0135" ], "kana": "じゅうにじ、あめ。いちじ、あめ。さんじ、まだあめでした。", "morae": 21 },
    { "ref": "s-15-1#L16", "ids": [ "v-n5-0067", "v-n5-0126", "v-n5-0605", "v-n5-0118", "v-n5-0678", "v-n5-0338", "v-n5-0692", "v-n5-0388", "v-n5-0132" ], "kana": "たなかさんのてんきよほうは、いつもちがいます。でも、たなかさんはいつもげんきです。", "morae": 37 },
    { "ref": "s-15-1#L17", "ids": [ "v-n5-0154", "v-n5-0595", "v-n5-0178", "v-n5-0120", "v-n5-0306", "v-n5-0124", "v-n5-0549", "v-n5-0126", "v-n5-0148", "v-n5-0121", "v-n5-0166", "v-n5-0565", "v-n5-0119", "v-n5-0272" ], "kana": "よじ、はれ。まどをあけると、うみのうえにあおいそらがありました。", "morae": 28 },
    { "ref": "s-15-1#L18", "ids": [ "v-n5-0138", "v-n5-0125", "v-n5-0048", "v-n5-0565", "g-n5-068", "v-n5-0548", "v-n5-0121", "v-n5-0339" ], "kana": "あしたもこのそらだったら、やまにのぼります。", "morae": 20 },
    { "ref": "s-15-2#L0", "ids": [ "v-n5-0550", "v-n5-0677", "v-n5-0340" ], "kana": "ケン、あめ、まだふってる。", "morae": 10 },
    { "ref": "s-15-2#L1", "ids": [ "v-n5-0286", "v-n5-0141", "v-n5-0130", "v-n5-0276", "v-n5-0129" ], "kana": "しってる。あさからみてるよ。", "morae": 12 },
    { "ref": "s-15-2#L2", "ids": [ "v-n5-0735", "v-n5-0274" ], "kana": "はれたら、いく？", "morae": 6 },
    { "ref": "s-15-2#L3", "ids": [ "v-n5-0735", "v-n5-0274", "v-n5-0131" ], "kana": "はれたら、いく。さったとうげまで。", "morae": 14 },
    { "ref": "s-15-2#L4", "ids": [ "v-n5-0735" ], "kana": "はれなかったら？", "morae": 7 },
    { "ref": "s-15-2#L5", "ids": [ "v-n5-0771", "v-n5-0277" ], "kana": "それなら、たべる。", "morae": 7 },
    { "ref": "s-15-2#L6", "ids": [ "v-n5-0054", "v-n5-0120", "v-n5-0277", "v-n5-0126" ], "kana": "なにをたべるの？", "morae": 7 },
    { "ref": "s-15-2#L7", "ids": [ "v-n5-0126", "v-n5-0229", "v-n5-0345", "v-n5-0137", "v-n5-0412", "v-n5-0122", "v-n5-0054", "v-n5-0127", "v-n5-0294" ], "kana": "わたなべさんのだいどころ、かりた。きょうのさかなでなにかつくる。", "morae": 28 },
    { "ref": "s-15-2#L8", "ids": [ "v-n5-0686", "v-n5-0066", "v-n5-0126", "v-n5-0229" ], "kana": "またひとのだいどころ？", "morae": 10 },
    { "ref": "s-15-2#L9", "ids": [ "v-n5-0550", "v-n5-0438", "v-n5-0735", "v-n5-0548" ], "kana": "あめならりょうり。はれたらやま。", "morae": 13 },
    { "ref": "s-15-2#L10", "ids": [ "v-n5-0399", "v-n5-0128" ], "kana": "かんたんだね。", "morae": 6 },
    { "ref": "s-15-2#L11", "ids": [ "v-n5-0122", "v-n5-0067", "v-n5-0118" ], "kana": "で、たなかさんはなんて？", "morae": 10 },
    { "ref": "s-15-2#L12", "ids": [ "v-n5-0154", "v-n5-0735" ], "kana": "「じゅうにじにははれる」って。", "morae": 11 },
    { "ref": "s-15-2#L13", "ids": [ "v-n5-0695", "v-n5-0242", "v-n5-0131", "v-n5-0340" ], "kana": "じゃ、ゆうがたまでふるな。", "morae": 10 },
    { "ref": "s-15-2#L14", "ids": [ "v-n5-0154", "g-n5-068", "v-n5-0138", "v-n5-0118", "v-n5-0274" ], "kana": "よじだったら、あしたはいける？", "morae": 13 },
    { "ref": "s-15-2#L15", "ids": [ "v-n5-0274", "v-n5-0406", "v-n5-0284" ], "kana": "いける。みず、かっといて。", "morae": 10 },
    { "ref": "s-15-2#L16", "ids": [ "v-n5-0285", "v-n5-0126", "v-n5-0239", "v-n5-0118" ], "kana": "わかった。ケンのにもつは？", "morae": 11 },
    { "ref": "s-15-2#L17", "ids": [ "v-n5-0239", "v-n5-0118", "v-n5-0403", "v-n5-0378", "v-n5-0129" ], "kana": "にもつはだいじょうぶ。かるいよ。", "morae": 13 },
    { "ref": "s-15-2#L18", "ids": [ "v-n5-0773", "v-n5-0377", "v-n5-0139" ], "kana": "いや、おもい。きのうよりおもい。", "morae": 13 },
    { "ref": "s-15-3#L1", "ids": [ "v-n5-0137", "v-n5-0126", "v-n5-0143", "v-n5-0130", "v-n5-0141", "v-n5-0131", "v-n5-0550", "v-n5-0124", "v-n5-0567", "v-n5-0119", "v-n5-0671", "v-n5-0380", "v-n5-0132" ], "kana": "きょうのよるからあさまで、あめとかぜがとてもつよいです。", "morae": 25 },
    { "ref": "s-15-3#L2", "ids": [ "v-n5-0550", "v-n5-0124", "v-n5-0567", "v-n5-0119", "v-n5-0380", "v-n5-0151", "v-n5-0121", "v-n5-0293", "g-n5-051" ], "kana": "あめとかぜがつよかったら、そとにでないでください。", "morae": 23 },
    { "ref": "s-15-3#L4", "ids": [ "v-n5-0178", "v-n5-0118", "v-n5-0307", "g-n5-051", "v-n5-0567", "v-n5-0119", "v-n5-0380", "v-n5-0124", "v-n5-0308" ], "kana": "まどはしめてください。かぜがつよいと、まどがあきます。", "morae": 24 },
    { "ref": "s-15-3#L6", "ids": [ "v-n5-0154", "v-n5-0370", "v-n5-0543", "v-n5-0120", "v-n5-0271", "g-n5-051" ], "kana": "はちじよりおそかったら、でんわをしてください。", "morae": 21 },
    { "ref": "s-15-3#L8", "ids": [ "v-n5-0230", "v-n5-0122", "v-n5-0541", "v-n5-0120", "v-n5-0279", "g-n5-051", "v-n5-0073", "v-n5-0126", "v-n5-0241", "v-n5-0121", "v-n5-0282" ], "kana": "げんかんで、なまえをいってください。みなさんのなまえをかみにかきます。", "morae": 32 },
    { "ref": "s-15-3#L9", "ids": [ "v-n5-0406", "v-n5-0124", "v-n5-0410", "v-n5-0118", "v-n5-0229", "v-n5-0121", "v-n5-0272", "v-n5-0277", "v-n5-0356", "v-n5-0132" ], "kana": "みずとパンはだいどころにあります。たべてもいいです。", "morae": 24 },
    { "ref": "s-15-3#L11", "ids": [ "v-n5-0138", "v-n5-0287", "v-n5-0066", "v-n5-0118", "v-n5-0141", "v-n5-0605", "v-n5-0120", "v-n5-0276", "v-n5-0130", "v-n5-0293", "g-n5-089", "v-n5-0132" ], "kana": "あしたかえるひとは、あさ、てんきよほうをみてからでたほうがいいです。", "morae": 31 },
    { "ref": "s-15-3#L13", "ids": [ "v-n5-0285", "v-n5-0119", "g-n5-084", "v-n5-0121", "v-n5-0280", "g-n5-051" ], "kana": "わからないことがあったら、わたなべにきいてください。", "morae": 24 },
    { "ref": "s-15-3#L15", "ids": [ "v-n5-0046", "v-n5-0131", "v-n5-0685", "v-n5-0318", "g-n5-051" ], "kana": "それまで、ゆっくりやすんでください。", "morae": 16 },
    { "ref": "s-15-3#L16", "ids": [ "v-n5-0218", "v-n5-0211" ], "kana": "しちがつにじゅうににち、わたなべりょかんより。", "morae": 19 },
    { "ref": "s-15-4#L0", "ids": [ "v-n5-0675", "v-n5-0356", "v-n5-0132", "v-n5-0127" ], "kana": "ハナさん、ケンさん、ちょっといいですか。", "morae": 16 },
    { "ref": "s-15-4#L1", "ids": [ "v-n5-0001", "v-n5-0054", "v-n5-0132", "v-n5-0127" ], "kana": "はい、わたなべさん。なんでしょうか。", "morae": 14 },
    { "ref": "s-15-4#L2", "ids": [ "v-n5-0138", "v-n5-0118", "v-n5-0421", "v-n5-0125", "v-n5-0420", "v-n5-0721", "v-n5-0124", "v-n5-0801" ], "kana": "あしたは、バスもでんしゃもとまるとおもいます。", "morae": 20 },
    { "ref": "s-15-4#L3", "ids": [ "v-n5-0774", "v-n5-0695", "v-n5-0138", "v-n5-0118", "v-n5-0293", "v-n5-0128" ], "kana": "あっ、じゃあ、あしたはでられませんね。", "morae": 15 },
    { "ref": "s-15-4#L4", "ids": [ "v-n5-0567", "v-n5-0119", "v-n5-0380", "v-n5-0548", "v-n5-0125", "v-n5-0301", "v-n5-0129" ], "kana": "かぜがつよかったら、やまもあるけませんよ。", "morae": 19 },
    { "ref": "s-15-4#L5", "ids": [ "v-n5-0138", "v-n5-0125", "v-n5-0051", "v-n5-0121", "g-n5-086", "v-n5-0806", "v-n5-0128" ], "kana": "あしたもここにいなければなりませんね。", "morae": 18 },
    { "ref": "s-15-4#L6", "ids": [ "v-n5-0003", "v-n5-0138", "v-n5-0125", "v-n5-0340", "v-n5-0806", "v-n5-0128" ], "kana": "ええ。あしたもふったら、そうなりますね。", "morae": 17 },
    { "ref": "s-15-4#L7", "ids": [ "v-n5-0771", "v-n5-0676", "v-n5-0031", "v-n5-0144", "v-n5-0019" ], "kana": "それなら、もうひとばん、おねがいします。", "morae": 17 },
    { "ref": "s-15-4#L8", "ids": [ "v-n5-0001", "v-n5-0772", "v-n5-0137", "v-n5-0124", "v-n5-0138", "v-n5-0122", "v-n5-0032", "v-n5-0144", "v-n5-0132", "v-n5-0128" ], "kana": "はい。それじゃ、きょうとあしたでふたばんですね。", "morae": 19 },
    { "ref": "s-15-4#L9", "ids": [ "v-n5-0681", "v-n5-0122", "v-n5-0061", "v-n5-0121", "v-n5-0806", "v-n5-0127" ], "kana": "ぜんぶで、いくらになりますか。", "morae": 13 },
    { "ref": "s-15-4#L10", "ids": [ "v-n5-0096", "v-n5-0122", "v-n5-0115", "v-n5-0132", "v-n5-0439", "v-n5-0125", "v-n5-0272" ], "kana": "ふたりで、にまんえんです。あさごはんもあります。", "morae": 21 },
    { "ref": "s-15-4#L11", "ids": [ "v-n5-0138", "v-n5-0126", "v-n5-0441", "v-n5-0294", "v-n5-0127" ], "kana": "あしたのばんごはん、つくりましょうか。", "morae": 16 },
    { "ref": "s-15-4#L12", "ids": [ "v-n5-0119", "v-n5-0294", "v-n5-0561", "v-n5-0132", "v-n5-0129" ], "kana": "ケンさんがつくるなら、うれしいですよ。", "morae": 17 },
    { "ref": "s-15-4#L13", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0054", "v-n5-0120", "v-n5-0271", "v-n5-0356", "v-n5-0132", "v-n5-0127" ], "kana": "わたしたちは、なにをすればいいですか。", "morae": 17 },
    { "ref": "s-15-4#L14", "ids": [ "v-n5-0785", "v-n5-0119", "v-n5-0111", "v-n5-0749", "v-n5-0178", "v-n5-0120", "v-n5-0307", "g-n5-051" ], "kana": "おねがいがみっつ。まず、まどをしめてください。", "morae": 20 },
    { "ref": "s-15-4#L15", "ids": [ "v-n5-0693", "v-n5-0171", "v-n5-0118", "v-n5-0151", "v-n5-0121", "v-n5-0298", "g-n5-051" ], "kana": "それから、かさはそとにおかないでください。", "morae": 19 },
    { "ref": "s-15-4#L16", "ids": [ "v-n5-0001", "v-n5-0676", "v-n5-0111", "v-n5-0118" ], "kana": "はい。もうひとつは？", "morae": 8 },
    { "ref": "s-15-4#L17", "ids": [ "v-n5-0233", "v-n5-0118", "v-n5-0154", "v-n5-0131", "v-n5-0121", "v-n5-0292", "g-n5-051" ], "kana": "おふろは、くじまでにはいってください。", "morae": 17 },
    { "ref": "s-15-4#L18", "ids": [ "v-n5-0154", "v-n5-0675", "v-n5-0369", "v-n5-0132", "v-n5-0128" ], "kana": "くじ？ちょっとはやいですね。", "morae": 11 },
    { "ref": "s-15-4#L19", "ids": [ "v-n5-0654", "v-n5-0126", "v-n5-0143", "v-n5-0118", "v-n5-0536", "v-n5-0119", "v-n5-0684", "v-n5-0361", "v-n5-0806" ], "kana": "あらしのよるは、おゆがすぐつめたくなるので。", "morae": 20 },
    { "ref": "s-15-4#L20", "ids": [ "v-n5-0699", "v-n5-0147", "v-n5-0126", "v-n5-0623", "v-n5-0118", "v-n5-0566", "v-n5-0132", "v-n5-0128" ], "kana": "あのう、へやのえは、ゆきのかんばらですね。", "morae": 18 },
