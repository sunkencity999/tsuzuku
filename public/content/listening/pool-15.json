    { "ref": "s-15-5#L3", "ids": [ "v-n5-0136", "v-n5-0750", "v-n5-0154", "v-n5-0132" ], "kana": "いま、ちょうどしちじです。", "morae": 10 },
    { "ref": "s-15-5#L4", "ids": [ "v-n5-0419", "v-n5-0126", "v-n5-0172", "v-n5-0118", "v-n5-0155", "v-n5-0370", "v-n5-0132" ], "kana": "えきのとけいは、いっぷんおそいです。", "morae": 16 },
    { "ref": "s-15-5#L5", "ids": [ "v-n5-0118", "v-n5-0550", "v-n5-0119", "v-n5-0677", "v-n5-0380", "v-n5-0132", "v-n5-0128" ], "kana": "かんばらは、あめがまだつよいでしょうね。", "morae": 17 },
    { "ref": "s-15-5#L6", "ids": [ "v-n5-0125", "v-n5-0567", "v-n5-0119", "v-n5-0671", "v-n5-0380", "v-n5-0132" ], "kana": "ゆいも、かぜがとてもつよいです。", "morae": 14 },
    { "ref": "s-15-5#L7", "ids": [ "v-n5-0692", "v-n5-0715", "g-n5-063", "g-n5-051" ], "kana": "でも、しんぱいしないでください。", "morae": 14 },
