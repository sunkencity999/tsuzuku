    { "ref": "s-15-5#L14", "ids": [ "v-n5-0137", "v-n5-0118", "v-n5-0122", "v-n5-0412", "v-n5-0126", "v-n5-0438", "v-n5-0120", "v-n5-0277" ], "kana": "きょうは、ゆいでさかなのりょうりをたべました。", "morae": 19 },
