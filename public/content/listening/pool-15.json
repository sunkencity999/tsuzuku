    { "ref": "v-n5-0769#ex0", "ids": [ "v-n5-0769", "v-n5-0274", "v-n5-0418", "v-n5-0119" ], "kana": "いきたい。だけど、おかねがない。", "morae": 13 },
    { "ref": "v-n5-0769#ex1", "ids": [ "v-n5-0769", "v-n5-0630", "v-n5-0105", "v-n5-0119", "v-n5-0677", "v-n5-0328" ], "kana": "ねむい。だけど、しゅくだいがまだおわらない。", "morae": 18 },
    { "ref": "v-n5-0770#ex0", "ids": [ "v-n5-0770", "v-n5-0420", "v-n5-0122", "v-n5-0274", "v-n5-0127", "v-n5-0421", "v-n5-0132" ], "kana": "でんしゃでいきますか。それともバスですか。", "morae": 18 },
    { "ref": "v-n5-0770#ex1", "ids": [ "v-n5-0770", "v-n5-0409", "v-n5-0119", "v-n5-0356", "v-n5-0471" ], "kana": "コーヒーがいい？それともこうちゃ？", "morae": 14 },
    { "ref": "v-n5-0771#ex0", "ids": [ "v-n5-0771", "v-n5-0041", "v-n5-0125", "v-n5-0274" ], "kana": "それなら、わたしもいきます。", "morae": 12 },
    { "ref": "v-n5-0771#ex1", "ids": [ "v-n5-0771", "v-n5-0352", "v-n5-0284" ], "kana": "たかい？それなら、かわない。", "morae": 11 },
    { "ref": "v-n5-0772#ex0", "ids": [ "v-n5-0772", "v-n5-0686", "v-n5-0138" ], "kana": "それじゃ、またあした。", "morae": 8 },
    { "ref": "v-n5-0772#ex1", "ids": [ "v-n5-0772", "v-n5-0041", "v-n5-0118", "v-n5-0676", "v-n5-0287", "v-n5-0128" ], "kana": "それじゃ、わたしはもうかえるね。", "morae": 13 },
    { "ref": "v-n5-0773#ex0", "ids": [ "v-n5-0773", "v-n5-0338", "v-n5-0045", "v-n5-0118", "v-n5-0041", "v-n5-0126", "v-n5-0132" ], "kana": "いや、ちがう。これはわたしのじゃない。", "morae": 15 },
    { "ref": "v-n5-0773#ex1", "ids": [ "v-n5-0773", "v-n5-0677", "v-n5-0277", "v-n5-0273", "v-n5-0129" ], "kana": "いや、まだたべていないよ。", "morae": 11 },
    { "ref": "v-n5-0774#ex0", "ids": [ "v-n5-0774", "v-n5-0174", "v-n5-0120", "v-n5-0325" ], "kana": "あっ、さいふをわすれた！", "morae": 10 },
    { "ref": "v-n5-0774#ex1", "ids": [ "v-n5-0774", "v-n5-0420", "v-n5-0119", "v-n5-0275", "v-n5-0129" ], "kana": "あっ、でんしゃがきましたよ。", "morae": 11 },
    { "ref": "v-n5-0775#ex0", "ids": [ "v-n5-0775", "v-n5-0138", "v-n5-0118", "v-n5-0578" ], "kana": "やった！あしたはやすみだ！", "morae": 11 },
    { "ref": "v-n5-0775#ex1", "ids": [ "v-n5-0775", "v-n5-0746", "v-n5-0119", "v-n5-0681", "v-n5-0328" ], "kana": "やった！テストがぜんぶおわった！", "morae": 14 },
    { "ref": "v-n5-0776#ex0", "ids": [ "v-n5-0776", "v-n5-0397", "v-n5-0551", "v-n5-0132", "v-n5-0128" ], "kana": "わあ、きれいなはなですね。", "morae": 11 },
    { "ref": "v-n5-0776#ex1", "ids": [ "v-n5-0776", "v-n5-0048", "v-n5-0482", "v-n5-0350" ], "kana": "わあ、このすし、おおきい！", "morae": 10 },
    { "ref": "v-n5-0777#ex0", "ids": [ "v-n5-0777", "v-n5-0403", "v-n5-0132" ], "kana": "いえ、だいじょうぶです。", "morae": 9 },
    { "ref": "v-n5-0777#ex1", "ids": [ "v-n5-0777", "v-n5-0041", "v-n5-0118", "v-n5-0069", "v-n5-0132" ], "kana": "いえ、わたしはがくせいではありません。", "morae": 17 },
    { "ref": "v-n5-0778#ex1", "ids": [ "v-n5-0778", "v-n5-0708", "v-n5-0688", "v-n5-0129", "g-n5-042", "v-n5-0128" ], "kana": "けっこんおめでとう！ほんとうによかったね。", "morae": 19 },
    { "ref": "v-n5-0779#ex1", "ids": [ "v-n5-0779", "v-n5-0126", "v-n5-0627", "v-n5-0118", "v-n5-0132" ], "kana": "ハナのしゅみはどくしょです。", "morae": 11 },
    { "ref": "v-n5-0780#ex0", "ids": [ "v-n5-0780", "v-n5-0690", "v-n5-0126", "v-n5-0747", "v-n5-0122", "v-n5-0120", "v-n5-0271" ], "kana": "はじめてのクラスでじこしょうかいをした。", "morae": 18 },
    { "ref": "v-n5-0780#ex1", "ids": [ "v-n5-0780", "v-n5-0696", "v-n5-0080", "v-n5-0122", "v-n5-0120", "v-n5-0271", "g-n5-051" ], "kana": "では、にほんごでじこしょうかいをしてください。", "morae": 20 },
    { "ref": "v-n5-0781#ex1", "ids": [ "v-n5-0781", "v-n5-0138", "v-n5-0118", "v-n5-0070", "v-n5-0124", "v-n5-0670", "v-n5-0120", "v-n5-0271" ], "kana": "あしたはともだちとはなびをけんぶつします。", "morae": 20 },
    { "ref": "v-n5-0782#ex0", "ids": [ "v-n5-0782", "v-n5-0138", "v-n5-0118", "g-n5-088", "v-n5-0806" ], "kana": "あしたははやおきしなければなりません。", "morae": 18 },
    { "ref": "v-n5-0782#ex1", "ids": [ "v-n5-0782", "v-n5-0118", "v-n5-0140", "v-n5-0132" ], "kana": "ケンはまいにちはやおきです。", "morae": 13 },
    { "ref": "v-n5-0783#ex0", "ids": [ "v-n5-0783", "v-n5-0140", "v-n5-0154", "g-n5-015", "v-n5-0271" ], "kana": "まいにちしちじごろきたくします。", "morae": 15 },
    { "ref": "v-n5-0783#ex1", "ids": [ "v-n5-0783", "v-n5-0139", "v-n5-0118", "v-n5-0154", "v-n5-0121", "v-n5-0271" ], "kana": "きのうはじゅうじにきたくした。", "morae": 13 },
    { "ref": "v-n5-0784#ex0", "ids": [ "v-n5-0784", "v-n5-0419", "v-n5-0126", "v-n5-0152", "v-n5-0122", "v-n5-0070", "v-n5-0124", "v-n5-0120", "v-n5-0271" ], "kana": "えきのまえでともだちとまちあわせをした。", "morae": 19 },
    { "ref": "v-n5-0784#ex1", "ids": [ "v-n5-0784", "v-n5-0118", "v-n5-0154", "v-n5-0121", "v-n5-0520", "v-n5-0122", "v-n5-0356", "v-n5-0132", "v-n5-0127" ], "kana": "まちあわせはさんじにえきまえでいいですか。", "morae": 20 },
    { "ref": "v-n5-0785#ex0", "ids": [ "v-n5-0785", "v-n5-0111", "v-n5-0119", "v-n5-0272" ], "kana": "ひとつおねがいがあります。", "morae": 12 },
    { "ref": "v-n5-0785#ex1", "ids": [ "v-n5-0785", "v-n5-0121", "v-n5-0120", "g-n5-084", "v-n5-0684", "v-n5-0275", "v-n5-0343" ], "kana": "ケンにおねがいをしたら、すぐきてくれた。", "morae": 18 },
    { "ref": "v-n5-0786#ex0", "ids": [ "v-n5-0786", "v-n5-0140", "v-n5-0420", "v-n5-0120", "v-n5-0271", "v-n5-0273" ], "kana": "まいにちでんしゃをりようしています。", "morae": 16 },
    { "ref": "v-n5-0786#ex1", "ids": [ "v-n5-0786", "v-n5-0198", "v-n5-0118", "v-n5-0680", "v-n5-0432", "v-n5-0120", "v-n5-0271" ], "kana": "にちようびはよくとしょかんをりようします。", "morae": 19 },
    { "ref": "v-n5-0787#ex0", "ids": [ "v-n5-0787", "v-n5-0081", "v-n5-0118", "v-n5-0136", "v-n5-0271", "v-n5-0273" ], "kana": "ちちはいまがいしゅつしています。", "morae": 14 },
    { "ref": "v-n5-0787#ex1", "ids": [ "v-n5-0787", "v-n5-0550", "v-n5-0697", "v-n5-0137", "v-n5-0118", "v-n5-0271" ], "kana": "あめだから、きょうはがいしゅつしない。", "morae": 15 },
    { "ref": "v-n5-0788#ex0", "ids": [ "v-n5-0788", "v-n5-0198", "v-n5-0126", "v-n5-0159", "v-n5-0118", "v-n5-0142", "v-n5-0289" ], "kana": "にちようびのごごはひるねをした。", "morae": 15 },
    { "ref": "v-n5-0788#ex1", "ids": [ "v-n5-0788", "v-n5-0118", "v-n5-0140", "v-n5-0599", "v-n5-0122", "v-n5-0142", "v-n5-0289" ], "kana": "アオはまいにちにわでひるねをします。", "morae": 17 },
    { "ref": "v-n5-0789#ex1", "ids": [ "v-n5-0789", "v-n5-0126", "g-n5-033", "v-n5-0147", "v-n5-0120", "v-n5-0706", "v-n5-0271" ], "kana": "ひっこしのまえに、へやをそうじしました。", "morae": 18 },
    { "ref": "v-n5-0790#ex0", "ids": [ "v-n5-0790", "v-n5-0695", "v-n5-0271" ], "kana": "じゃあ、かんぱいしましょう。", "morae": 10 },
    { "ref": "v-n5-0790#ex1", "ids": [ "v-n5-0790", "v-n5-0126", "v-n5-0354", "v-n5-0542", "v-n5-0121" ], "kana": "ケンのあたらしいしごとにかんぱい！", "morae": 16 },
    { "ref": "v-n5-0791#ex0", "ids": [ "v-n5-0791", "v-n5-0137", "v-n5-0118", "v-n5-0717", "v-n5-0130", "v-n5-0271" ], "kana": "きょうはつかれたから、がいしょくした。", "morae": 15 },
    { "ref": "v-n5-0791#ex1", "ids": [ "v-n5-0791", "v-n5-0199", "v-n5-0121", "v-n5-0752", "v-n5-0077", "v-n5-0122", "v-n5-0271" ], "kana": "しゅうにいちど、かぞくでがいしょくします。", "morae": 17 },
    { "ref": "v-n5-0792#ex0", "ids": [ "v-n5-0792", "v-n5-0225", "v-n5-0578", "v-n5-0121", "v-n5-0271" ], "kana": "なつやすみにきこくします。", "morae": 12 },
    { "ref": "v-n5-0792#ex1", "ids": [ "v-n5-0792", "v-n5-0610", "v-n5-0126", "v-n5-0070", "v-n5-0119", "v-n5-0209", "v-n5-0271" ], "kana": "りゅうがくせいのともだちがせんげつきこくしました。", "morae": 23 },
    { "ref": "v-n5-0793#ex0", "ids": [ "v-n5-0793", "v-n5-0440", "v-n5-0121", "v-n5-0120", "v-n5-0277" ], "kana": "ひるごはんにハンバーガーをたべた。", "morae": 16 },
    { "ref": "v-n5-0793#ex1", "ids": [ "v-n5-0793", "v-n5-0048", "v-n5-0417", "v-n5-0126", "v-n5-0118", "v-n5-0350", "v-n5-0353", "v-n5-0132" ], "kana": "このみせのハンバーガーはおおきくてやすいです。", "morae": 22 },
    { "ref": "v-n5-0794#ex0", "ids": [ "v-n5-0794", "v-n5-0126", "v-n5-0552", "v-n5-0124", "v-n5-0228", "v-n5-0704", "v-n5-0271" ], "kana": "ペットのいぬとまいあささんぽします。", "morae": 17 },
    { "ref": "v-n5-0794#ex1", "ids": [ "v-n5-0794", "v-n5-0088", "v-n5-0118", "v-n5-0119", "v-n5-0384", "v-n5-0124", "v-n5-0279", "v-n5-0273" ], "kana": "いもうとはペットがほしいといっている。", "morae": 18 },
    { "ref": "v-n5-0795#ex0", "ids": [ "v-n5-0795", "v-n5-0542", "v-n5-0126", "g-n5-033", "v-n5-0155", "v-n5-0271" ], "kana": "しごとのまえにさんじゅっぷんジョギングする。", "morae": 19 },
    { "ref": "v-n5-0795#ex1", "ids": [ "v-n5-0795", "v-n5-0139", "v-n5-0118", "v-n5-0602", "v-n5-0122", "v-n5-0120", "v-n5-0271" ], "kana": "きのうはかいがんでジョギングをしました。", "morae": 18 },
    { "ref": "v-n5-0796#ex0", "ids": [ "v-n5-0796", "v-n5-0121", "v-n5-0300", "v-n5-0583", "v-n5-0120", "v-n5-0276" ], "kana": "ソファにすわってテレビをみます。", "morae": 14 },
    { "ref": "v-n5-0796#ex1", "ids": [ "v-n5-0796", "v-n5-0118", "v-n5-0126", "v-n5-0148", "v-n5-0122", "v-n5-0289", "v-n5-0273" ], "kana": "アオはソファのうえでねています。", "morae": 14 },
    { "ref": "v-n5-0797#ex0", "ids": [ "v-n5-0797", "v-n5-0225", "v-n5-0578", "v-n5-0121", "v-n5-0548", "v-n5-0122", "v-n5-0120", "v-n5-0271" ], "kana": "なつやすみにやまでキャンプをしました。", "morae": 17 },
    { "ref": "v-n5-0797#ex1", "ids": [ "v-n5-0797", "v-n5-0126", "v-n5-0143", "v-n5-0118", "v-n5-0603", "v-n5-0119", "v-n5-0397" ], "kana": "キャンプのよるはほしぞらがきれいだった。", "morae": 18 },
    { "ref": "v-n5-0798#ex0", "ids": [ "v-n5-0798", "v-n5-0085", "v-n5-0118", "v-n5-0122", "v-n5-0427", "v-n5-0121", "v-n5-0274" ], "kana": "あにはバイクでかいしゃにいく。", "morae": 13 },
    { "ref": "v-n5-0798#ex1", "ids": [ "v-n5-0798", "v-n5-0354", "v-n5-0119", "v-n5-0384", "v-n5-0132" ], "kana": "あたらしいバイクがほしいです。", "morae": 14 },
    { "ref": "v-n5-0799#ex0", "ids": [ "v-n5-0799", "v-n5-0666", "v-n5-0126", "v-n5-0120", "v-n5-0113", "v-n5-0284" ], "kana": "コンサートのチケットをにまいかいました。", "morae": 19 },
    { "ref": "v-n5-0799#ex1", "ids": [ "v-n5-0799", "v-n5-0554", "v-n5-0126", "v-n5-0118", "v-n5-0676", "v-n5-0296", "v-n5-0273" ], "kana": "えいがのチケットはもうもっている？", "morae": 16 },
    { "ref": "v-n5-0800#ex0", "ids": [ "v-n5-0800", "v-n5-0198", "v-n5-0121", "v-n5-0549", "v-n5-0131", "v-n5-0271" ], "kana": "にちようびにうみまでドライブした。", "morae": 16 },
    { "ref": "v-n5-0801#ex1", "ids": [ "v-n5-0801", "v-n5-0048", "v-n5-0412", "v-n5-0118", "v-n5-0751", "v-n5-0379", "v-n5-0124" ], "kana": "このさかなはいちばんおいしいとおもう。", "morae": 18 },
    { "ref": "v-n5-0803#ex0", "ids": [ "v-n5-0803", "v-n5-0041", "v-n5-0124", "v-n5-0118", "v-n5-0097", "v-n5-0132" ], "kana": "わたしとケンはおなじがっこうです。", "morae": 16 },
    { "ref": "v-n5-0803#ex1", "ids": [ "v-n5-0803", "v-n5-0139", "v-n5-0124", "v-n5-0417", "v-n5-0122", "v-n5-0409", "v-n5-0120", "v-n5-0278" ], "kana": "きのうとおなじみせでコーヒーをのんだ。", "morae": 18 },
    { "ref": "v-n5-0804#ex0", "ids": [ "v-n5-0804", "v-n5-0151", "v-n5-0122", "v-n5-0350", "v-n5-0119", "v-n5-0271" ], "kana": "そとでおおきいおとがしました。", "morae": 14 },
    { "ref": "v-n5-0804#ex1", "ids": [ "v-n5-0804", "v-n5-0143", "v-n5-0550", "v-n5-0126", "v-n5-0120", "v-n5-0280" ], "kana": "よる、あめのおとをきいた。", "morae": 11 },
    { "ref": "v-n5-0805#ex0", "ids": [ "v-n5-0805", "v-n5-0189", "v-n5-0121", "v-n5-0300", "g-n5-051" ], "kana": "どうぞ、こちらにすわってください。", "morae": 15 },
    { "ref": "v-n5-0805#ex1", "ids": [ "v-n5-0805", "v-n5-0045", "v-n5-0295", "v-n5-0125", "v-n5-0356" ], "kana": "「これ、つかってもいい？」「どうぞ。」", "morae": 12 },
    { "ref": "v-n5-0806#ex1", "ids": [ "v-n5-0806", "v-n5-0565", "v-n5-0119", "v-n5-0643" ], "kana": "そらがくらくなった。", "morae": 9 }
  ]
}
