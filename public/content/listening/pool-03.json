    { "ref": "s-01-3#L5", "ids": [ "v-n5-0006", "v-n5-0035", "v-n5-0076", "v-n5-0066" ], "kana": "「こんにちは。」ご。おんなのひとです。", "morae": 14 },
    { "ref": "s-01-3#L6", "ids": [ "v-n5-0006", "v-n5-0036", "v-n5-0075", "v-n5-0066" ], "kana": "「こんにちは。」ろく。おとこのひとです。", "morae": 15 },
    { "ref": "s-01-3#L7", "ids": [ "v-n5-0006", "v-n5-0037", "v-n5-0069" ], "kana": "「こんにちは。」なな。がくせいです。", "morae": 13 },
    { "ref": "s-02-1#L9", "ids": [ "v-n5-0061" ], "kana": "「いくらですか。」", "morae": 6 },
    { "ref": "s-02-1#L15", "ids": [ "v-n5-0056" ], "kana": "たなかさんは、どこへ？", "morae": 9 },
