  "refs": [
    { "ref": "s-01-1#L4", "ids": [ "v-n5-0068", "v-n5-0069", "v-n5-0070" ], "kana": "「せんせいです。」「がくせいです。」「ともだちです。」", "morae": 18 },
    { "ref": "s-01-2#L1", "ids": [ "v-n5-0006", "v-n5-0051" ], "kana": "こんにちは。ここは、しながわですか。", "morae": 15 },
    { "ref": "s-01-2#L4", "ids": [ "v-n5-0074" ], "kana": "どちらからですか。", "morae": 8 },
    { "ref": "s-01-2#L6", "ids": [ "v-n5-0030", "v-n5-0041" ], "kana": "そうですか。わたしは、みやです。", "morae": 13 },
    { "ref": "s-01-2#L10", "ids": [ "v-n5-0053", "v-n5-0001", "v-n5-0045" ], "kana": "あそこです。はい、これ。", "morae": 9 },
    { "ref": "s-01-2#L11", "ids": [ "v-n5-0045" ], "kana": "これは、なんですか。", "morae": 8 },
    { "ref": "s-01-3#L2", "ids": [ "v-n5-0006", "v-n5-0031", "v-n5-0043" ], "kana": "「こんにちは。」いち。おじさんです。", "morae": 13 },
    { "ref": "s-01-3#L3", "ids": [ "v-n5-0006", "v-n5-0032", "v-n5-0044" ], "kana": "「こんにちは。」に。おばさんです。", "morae": 12 },
