    { "ref": "s-02-3#L9", "ids": [ "v-n5-0066", "v-n5-0040" ], "kana": "ひとは、じゅうまでです。", "morae": 9 },
    { "ref": "s-03-1#L0", "ids": [ "v-n5-0004" ], "kana": "おはようございます、よこはま。", "morae": 13 },
    { "ref": "s-03-1#L1", "ids": [ "v-n5-0041", "v-n5-0066" ], "kana": "わたしは、よこはまのひとです。", "morae": 13 },
    { "ref": "s-03-1#L2", "ids": [ "v-n5-0077", "v-n5-0053", "v-n5-0051" ], "kana": "かぞくは、あそこ。でも、ここです。", "morae": 13 },
    { "ref": "s-03-1#L3", "ids": [ "v-n5-0029" ], "kana": "「いらっしゃいませ。」タカギさんです。", "morae": 14 },
