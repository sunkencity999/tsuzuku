    { "ref": "s-03-2#L0", "ids": [ "v-n5-0029" ], "kana": "いらっしゃいませ。", "morae": 7 },
    { "ref": "s-03-2#L11", "ids": [ "v-n5-0046" ], "kana": "では、それを。", "morae": 5 },
    { "ref": "s-03-2#L13", "ids": [ "v-n5-0001", "v-n5-0019" ], "kana": "はい、おねがいします。", "morae": 9 },
    { "ref": "s-03-2#L15", "ids": [ "v-n5-0001", "v-n5-0010" ], "kana": "はい。タカギさん、ありがとうございます。", "morae": 17 },
