{
  "schema": "tsuzuku.pool/1",
  "station": 8,
  "refs": [
    { "ref": "s-01-1#L5", "ids": [ "v-n5-0073", "v-n5-0356" ], "kana": "「みなさん、いいですか。」", "morae": 9 },
    { "ref": "s-05-4#L2", "ids": [ "v-n5-0154", "v-n5-0156", "v-n5-0132", "v-n5-0127", "v-n5-0141", "v-n5-0118", "v-n5-0359", "v-n5-0128" ], "kana": "よじはんですか。あさはさむいですね。", "morae": 16 },
    { "ref": "s-06-5#L9", "ids": [ "v-n5-0361", "v-n5-0126", "v-n5-0120", "v-n5-0114", "v-n5-0019" ], "kana": "つめたいのを、にほん、おねがいします。", "morae": 16 },
    { "ref": "s-07-1#L11", "ids": [ "v-n5-0131", "v-n5-0301", "v-n5-0030", "v-n5-0356", "v-n5-0132", "v-n5-0128" ], "kana": "「きょうとまであるきます。」「そうですか。いいですね。」", "morae": 20 },
    { "ref": "s-07-1#L17", "ids": [ "v-n5-0356", "v-n5-0132", "v-n5-0128", "v-n5-0138", "v-n5-0118", "v-n5-0175", "v-n5-0121", "v-n5-0293", "v-n5-0127" ], "kana": "「いいですね。あしたはなんじにでますか。」", "morae": 17 },
    { "ref": "s-07-2#L3", "ids": [ "g-n5-028", "v-n5-0350", "v-n5-0132", "v-n5-0373", "v-n5-0128" ], "kana": "とてもおおきいです。とてもながいですね。", "morae": 18 },
    { "ref": "s-07-2#L5", "ids": [ "v-n5-0030", "v-n5-0097", "v-n5-0126", "v-n5-0132", "v-n5-0127", "v-n5-0356", "v-n5-0128" ], "kana": "そうですか。がっこうのですか。いいですね。", "morae": 18 },
    { "ref": "s-07-2#L16", "ids": [ "v-n5-0356", "v-n5-0132", "v-n5-0128", "v-n5-0143", "v-n5-0051", "v-n5-0122", "v-n5-0290", "v-n5-0129" ], "kana": "いいですね。よる、ここでまちますよ。", "morae": 15 },
    { "ref": "s-07-3#L6", "ids": [ "v-n5-0093", "v-n5-0225", "v-n5-0140", "v-n5-0320" ], "kana": "おとこのこ。「なつ、まいにちおよぎます。」", "morae": 16 },
    { "ref": "s-07-4#L6", "ids": [ "v-n5-0350", "v-n5-0132", "v-n5-0128", "v-n5-0373", "v-n5-0126", "v-n5-0118", "v-n5-0058", "v-n5-0127" ], "kana": "おおきいですね。ながいのはどれですか。", "morae": 17 },
    { "ref": "s-07-4#L7", "ids": [ "v-n5-0262", "v-n5-0126", "v-n5-0132", "v-n5-0149", "v-n5-0131", "v-n5-0373", "v-n5-0128" ], "kana": "きいろいのです。したまでながいですね。", "morae": 17 },
    { "ref": "s-07-4#L8", "ids": [ "v-n5-0001", "v-n5-0167", "v-n5-0126", "v-n5-0118", "g-n5-028", "v-n5-0373", "v-n5-0132" ], "kana": "はい。しろいのはあまりながくないです。", "morae": 17 },
    { "ref": "s-08-1#L0", "ids": [ "v-n5-0218", "v-n5-0211", "v-n5-0236", "v-n5-0118", "v-n5-0154", "v-n5-0156", "v-n5-0121", "v-n5-0277", "v-n5-0369", "v-n5-0132" ], "kana": "しちがつむいか。けさはろくじはんにたべました。はやいです。", "morae": 26 },
    { "ref": "s-08-1#L1", "ids": [ "v-n5-0242", "v-n5-0124", "v-n5-0120", "v-n5-0301", "v-n5-0125", "v-n5-0358", "v-n5-0132" ], "kana": "ゆうがた、ケンとおおいそをあるきました。ゆうがたもあついです。", "morae": 28 },
    { "ref": "s-08-1#L3", "ids": [ "v-n5-0066", "v-n5-0118", "v-n5-0371", "v-n5-0132", "v-n5-0112" ], "kana": "ひとはおおくないです。さんにんだけです。", "morae": 18 },
    { "ref": "s-08-1#L4", "ids": [ "v-n5-0093", "v-n5-0119", "v-n5-0096", "v-n5-0076", "v-n5-0126", "v-n5-0066", "v-n5-0095", "v-n5-0273" ], "kana": "おとこのこがふたり、おんなのひとがひとりいます。", "morae": 22 },
    { "ref": "s-08-1#L7", "ids": [ "v-n5-0132", "v-n5-0129", "v-n5-0124", "v-n5-0041", "v-n5-0118", "v-n5-0279" ], "kana": "「アオですよ」とわたしはいいました。", "morae": 15 },
    { "ref": "s-08-1#L8", "ids": [ "v-n5-0338", "v-n5-0129", "v-n5-0124", "v-n5-0118", "v-n5-0279" ], "kana": "「ちがいますよ」とケンはいいました。", "morae": 15 },
    { "ref": "s-08-1#L12", "ids": [ "v-n5-0114", "v-n5-0118", "v-n5-0041", "v-n5-0126", "v-n5-0132", "v-n5-0356", "v-n5-0066" ], "kana": "いっぽんはわたしの、いっぽんはケンのです。いいひとです。", "morae": 25 },
    { "ref": "s-08-1#L13", "ids": [ "v-n5-0100", "v-n5-0126", "v-n5-0153", "v-n5-0121", "v-n5-0351", "v-n5-0266", "v-n5-0120", "v-n5-0111", "v-n5-0282" ], "kana": "ノートのうしろに、ちいさいまるをひとつかきました。", "morae": 23 },
    { "ref": "s-08-1#L14", "ids": [ "v-n5-0266", "v-n5-0111", "v-n5-0118", "v-n5-0356", "v-n5-0066", "v-n5-0095", "v-n5-0132", "v-n5-0137", "v-n5-0122" ], "kana": "まるひとつは、いいひとひとりです。きょうでみっつです。", "morae": 23 },
    { "ref": "s-08-2#L0", "ids": [ "v-n5-0006", "v-n5-0358", "v-n5-0132", "v-n5-0128" ], "kana": "こんにちは。あついですね。", "morae": 11 },
    { "ref": "s-08-2#L1", "ids": [ "v-n5-0003", "v-n5-0137", "v-n5-0118", "g-n5-028", "v-n5-0358", "v-n5-0132", "v-n5-0128" ], "kana": "ええ、きょうはとてもあついですね。", "morae": 14 },
    { "ref": "s-08-2#L2", "ids": [ "v-n5-0137", "v-n5-0118", "v-n5-0066", "v-n5-0119", "v-n5-0371", "v-n5-0132", "v-n5-0127" ], "kana": "きょうはひとがおおいですか。", "morae": 12 },
    { "ref": "s-08-2#L3", "ids": [ "v-n5-0002", "v-n5-0371", "v-n5-0132", "v-n5-0129", "v-n5-0225", "v-n5-0126", "v-n5-0242", "v-n5-0118", "v-n5-0372" ], "kana": "いいえ、おおくないですよ。なつのゆうがたはすくないです。", "morae": 25 },
    { "ref": "s-08-2#L5", "ids": [ "v-n5-0145", "v-n5-0126", "v-n5-0132", "v-n5-0129", "v-n5-0041", "v-n5-0118" ], "kana": "うちのですよ。わたしはかとうです。", "morae": 15 },
    { "ref": "s-08-2#L8", "ids": [ "v-n5-0001", "v-n5-0278", "v-n5-0010" ], "kana": "はい、のみます。ありがとうございます。", "morae": 16 },
    { "ref": "s-08-2#L10", "ids": [ "v-n5-0240", "v-n5-0126", "v-n5-0150", "v-n5-0121", "v-n5-0114", "v-n5-0272", "v-n5-0129", "v-n5-0001" ], "kana": "はこのなかにごほんありますよ。はい、にほん。", "morae": 19 },
    { "ref": "s-08-2#L11", "ids": [ "v-n5-0010", "v-n5-0361", "v-n5-0132", "v-n5-0128" ], "kana": "ありがとうございます。つめたいですね。", "morae": 17 },
    { "ref": "s-08-2#L15", "ids": [ "v-n5-0003", "v-n5-0166", "v-n5-0132", "v-n5-0129", "v-n5-0136", "v-n5-0125", "v-n5-0149", "v-n5-0121", "v-n5-0273" ], "kana": "ええ、あおいですよ。いまもしたにいますよ。", "morae": 18 },
    { "ref": "s-08-2#L16", "ids": [ "v-n5-0132", "v-n5-0129" ], "kana": "アオですよ、ケン。", "morae": 7 },
    { "ref": "s-08-2#L17", "ids": [ "v-n5-0338", "v-n5-0129" ], "kana": "ちがいますよ。", "morae": 6 },
    { "ref": "s-08-3#L0", "ids": [ "v-n5-0073", "v-n5-0123", "v-n5-0054", "v-n5-0127", "v-n5-0325" ], "kana": "みなさんへ。なにかわすれましたか。", "morae": 15 },
    { "ref": "s-08-3#L1", "ids": [ "v-n5-0240", "v-n5-0126", "v-n5-0150", "v-n5-0121", "v-n5-0137", "v-n5-0118", "v-n5-0045", "v-n5-0119", "v-n5-0272" ], "kana": "はこのなかに、きょうはこれがあります。", "morae": 16 },
    { "ref": "s-08-3#L2", "ids": [ "v-n5-0168", "v-n5-0171", "v-n5-0119", "v-n5-0114", "v-n5-0272" ], "kana": "くろいかさがいっぽんあります。", "morae": 14 },
    { "ref": "s-08-3#L3", "ids": [ "v-n5-0167", "v-n5-0253", "v-n5-0119", "v-n5-0111", "v-n5-0272", "v-n5-0350", "v-n5-0126", "v-n5-0124", "v-n5-0351", "v-n5-0132" ], "kana": "しろいぼうしがふたつあります。おおきいのとちいさいのです。", "morae": 27 },
    { "ref": "s-08-3#L4", "ids": [ "v-n5-0243", "v-n5-0119", "v-n5-0113", "v-n5-0272", "v-n5-0166", "v-n5-0126", "v-n5-0165", "v-n5-0132" ], "kana": "ハンカチがさんまいあります。あおいのがにまい、あかいのがいちまいです。", "morae": 32 },
    { "ref": "s-08-3#L5", "ids": [ "v-n5-0071", "v-n5-0126", "v-n5-0170", "v-n5-0119", "v-n5-0111", "v-n5-0272", "v-n5-0183", "v-n5-0132" ], "kana": "こどものくつがひとつだけあります。みぎのくつです。", "morae": 23 },
    { "ref": "s-08-3#L6", "ids": [ "v-n5-0237", "v-n5-0119", "v-n5-0111", "v-n5-0172", "v-n5-0272" ], "kana": "めがねがひとつ、とけいがひとつあります。", "morae": 18 },
    { "ref": "s-08-3#L7", "ids": [ "v-n5-0099", "v-n5-0125", "v-n5-0104", "v-n5-0272", "v-n5-0365", "v-n5-0132" ], "kana": "ほんもいっさつあります。むずかしいほんです。", "morae": 20 },
    { "ref": "s-08-3#L8", "ids": [ "v-n5-0174", "v-n5-0125", "v-n5-0173", "v-n5-0272" ], "kana": "さいふもかぎもありません。", "morae": 12 },
    { "ref": "s-08-3#L10", "ids": [ "v-n5-0140", "v-n5-0242", "v-n5-0154", "v-n5-0130", "v-n5-0131", "v-n5-0041", "v-n5-0118", "v-n5-0051", "v-n5-0121", "v-n5-0273" ], "kana": "まいにち、ゆうがたごじからろくじまでわたしはここにいます。", "morae": 27 },
    { "ref": "s-08-3#L13", "ids": [], "kana": "おおいそ、かとう", "morae": 7 },
    { "ref": "s-08-4#L1", "ids": [ "v-n5-0001", "v-n5-0234", "v-n5-0190", "v-n5-0121", "v-n5-0096", "v-n5-0122", "v-n5-0274" ], "kana": "はい。こんばん、そちらにふたりでいきます。", "morae": 18 },
    { "ref": "s-08-4#L4", "ids": [ "v-n5-0155", "v-n5-0132", "v-n5-0128", "v-n5-0367" ], "kana": "じゅっぷんぐらいですね。ちかいですね。", "morae": 16 },
    { "ref": "s-08-4#L6", "ids": [ "v-n5-0233", "v-n5-0118", "v-n5-0175", "v-n5-0130", "v-n5-0131", "v-n5-0132", "v-n5-0127" ], "kana": "おふろはなんじからなんじまでですか。", "morae": 17 },
    { "ref": "s-08-4#L7", "ids": [ "v-n5-0154", "v-n5-0130", "v-n5-0131", "v-n5-0132", "v-n5-0128", "v-n5-0285" ], "kana": "ろくじからじゅうじまでですね。わかりました。", "morae": 19 },
    { "ref": "s-08-4#L8", "ids": [ "v-n5-0141", "v-n5-0118", "v-n5-0154", "v-n5-0156", "v-n5-0121", "v-n5-0019" ], "kana": "あさはろくじはんにおねがいします。", "morae": 16 },
    { "ref": "s-08-4#L9", "ids": [ "v-n5-0001", "v-n5-0147", "v-n5-0118", "v-n5-0111", "v-n5-0132", "v-n5-0096", "v-n5-0122" ], "kana": "はい、へやはひとつです。ふたりでひとつです。", "morae": 19 },
    { "ref": "s-08-4#L10", "ids": [ "v-n5-0239", "v-n5-0132", "v-n5-0127", "v-n5-0371", "v-n5-0111" ], "kana": "にもつですか。おおくないです。ふたつだけです。", "morae": 20 },
    { "ref": "s-08-4#L11", "ids": [ "v-n5-0003", "v-n5-0358", "v-n5-0132", "v-n5-0066", "v-n5-0118", "v-n5-0372", "v-n5-0129" ], "kana": "ええ、あついです。ひとはすくないですよ。", "morae": 17 },
    { "ref": "s-08-4#L14", "ids": [ "v-n5-0001", "v-n5-0154", "v-n5-0121", "v-n5-0274" ], "kana": "はい。では、ろくじにいきます。", "morae": 12 },
    { "ref": "s-08-4#L15", "ids": [ "v-n5-0018", "v-n5-0028" ], "kana": "よろしくおねがいします。しつれいします。", "morae": 18 },
    { "ref": "s-08-5#L0", "ids": [ "v-n5-0007", "v-n5-0051", "v-n5-0118", "v-n5-0126", "v-n5-0146", "v-n5-0132", "v-n5-0127" ], "kana": "こんばんは。ここはかとうさんのうちですか。", "morae": 19 },
    { "ref": "s-08-5#L1", "ids": [ "v-n5-0003", "v-n5-0132", "v-n5-0129", "v-n5-0234", "v-n5-0118", "v-n5-0096" ], "kana": "ええ、そうですよ。こんばんはふたりだけです。", "morae": 19 },
    { "ref": "s-08-5#L2", "ids": [ "v-n5-0233", "v-n5-0118", "v-n5-0272", "v-n5-0127", "v-n5-0175", "v-n5-0130", "v-n5-0132" ], "kana": "おふろはありますか。なんじからですか。", "morae": 17 },
    { "ref": "s-08-5#L3", "ids": [ "v-n5-0151", "v-n5-0121", "v-n5-0272", "v-n5-0129", "v-n5-0154", "v-n5-0130", "v-n5-0131", "v-n5-0132" ], "kana": "そとにありますよ。ろくじからじゅうじまでです。", "morae": 20 },
    { "ref": "s-08-5#L6", "ids": [ "v-n5-0113", "v-n5-0019" ], "kana": "さんまい、おねがいします。", "morae": 11 },
    { "ref": "s-08-5#L8", "ids": [ "v-n5-0361", "v-n5-0126", "v-n5-0132", "v-n5-0127", "v-n5-0114", "v-n5-0019" ], "kana": "つめたいのですか。にほん、おねがいします。", "morae": 18 },
    { "ref": "s-08-5#L9", "ids": [ "v-n5-0003", "v-n5-0361", "v-n5-0132", "v-n5-0129", "v-n5-0114", "v-n5-0115" ], "kana": "ええ、つめたいですよ。いっぽん、ひゃくえんです。", "morae": 19 },
    { "ref": "s-08-5#L10", "ids": [ "v-n5-0114", "v-n5-0122", "v-n5-0115", "v-n5-0132", "v-n5-0128", "v-n5-0001" ], "kana": "にほんでにひゃくえんですね。はい。", "morae": 14 },
    { "ref": "s-08-5#L11", "ids": [ "v-n5-0010", "v-n5-0118", "v-n5-0056", "v-n5-0132", "v-n5-0127" ], "kana": "ありがとうございます。ケンさんはどこですか。", "morae": 20 },
    { "ref": "s-08-5#L12", "ids": [ "v-n5-0147", "v-n5-0121", "v-n5-0273", "v-n5-0118", "v-n5-0056", "v-n5-0127" ], "kana": "へやにいます。アオはどこにいますか。", "morae": 16 },
    { "ref": "s-08-5#L14", "ids": [ "v-n5-0132", "v-n5-0129", "v-n5-0118", "v-n5-0338", "v-n5-0124", "v-n5-0279" ], "kana": "アオですよ。ケンは「ちがいます」といいますよ。", "morae": 19 },
    { "ref": "s-08-5#L15", "ids": [ "v-n5-0030", "v-n5-0132", "v-n5-0128", "v-n5-0234", "v-n5-0125", "v-n5-0273", "v-n5-0129" ], "kana": "そうですか。アオですね。こんばんもいますよ。", "morae": 19 },
    { "ref": "g-n5-002#ex2", "ids": [ "g-n5-002", "v-n5-0137", "v-n5-0118", "v-n5-0318" ], "kana": "きょうはやすみじゃありません。", "morae": 12 },
    { "ref": "g-n5-012#ex1", "ids": [ "g-n5-012", "v-n5-0202", "v-n5-0118", "v-n5-0318" ], "kana": "せんしゅうはやすみでした。", "morae": 11 },
    { "ref": "g-n5-017#ex1", "ids": [ "g-n5-017", "v-n5-0137", "v-n5-0118", "v-n5-0317" ], "kana": "きょうははたらきません。", "morae": 10 },
    { "ref": "g-n5-026#ex1", "ids": [ "g-n5-026", "v-n5-0137", "v-n5-0118", "v-n5-0359", "v-n5-0132", "v-n5-0128" ], "kana": "きょうはさむくないですね。", "morae": 11 },
    { "ref": "g-n5-032#ex0", "ids": [ "g-n5-032", "v-n5-0137", "v-n5-0118", "v-n5-0157", "v-n5-0119", "v-n5-0272" ], "kana": "きょうはじかんがあります。", "morae": 11 },
    { "ref": "g-n5-032#ex1", "ids": [ "g-n5-032", "v-n5-0041", "v-n5-0118", "v-n5-0088", "v-n5-0119", "v-n5-0273" ], "kana": "わたしはいもうとがいます。", "morae": 12 },
    { "ref": "g-n5-033#ex0", "ids": [ "g-n5-033", "v-n5-0176", "v-n5-0126", "v-n5-0339", "v-n5-0099", "v-n5-0119", "v-n5-0272" ], "kana": "つくえのうえにほんがあります。", "morae": 14 },
    { "ref": "g-n5-033#ex3", "ids": [ "g-n5-033", "v-n5-0147", "v-n5-0121", "v-n5-0055", "v-n5-0119", "v-n5-0273", "v-n5-0127" ], "kana": "へやにだれがいますか。", "morae": 10 },
    { "ref": "g-n5-033#ex4", "ids": [ "g-n5-033", "v-n5-0127", "v-n5-0144", "v-n5-0126", "v-n5-0054", "v-n5-0119", "v-n5-0272" ], "kana": "かばんのなかになにがありますか。", "morae": 15 },
    { "ref": "g-n5-034#ex1", "ids": [ "g-n5-034", "v-n5-0098", "v-n5-0121", "v-n5-0069", "v-n5-0119", "v-n5-0112", "v-n5-0273" ], "kana": "きょうしつにがくせいがごにんいます。", "morae": 16 },
