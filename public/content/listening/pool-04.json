{
  "schema": "tsuzuku.pool/1",
  "station": 4,
  "refs": [
    { "ref": "s-01-1#L10", "ids": [ "v-n5-0111" ], "kana": "しながわです。ひとつです。", "morae": 11 },
    { "ref": "s-01-1#L15", "ids": [ "v-n5-0111", "v-n5-0040" ], "kana": "ふたつ。じゅうです。", "morae": 7 },
    { "ref": "s-02-1#L4", "ids": [ "v-n5-0091" ], "kana": "おじいさんがいます。", "morae": 9 },
    { "ref": "s-02-1#L10", "ids": [ "v-n5-0115" ], "kana": "「ごひゃくえんです。」", "morae": 7 },
    { "ref": "s-02-2#L2", "ids": [ "v-n5-0096" ], "kana": "ふたりですか。", "morae": 6 },
    { "ref": "s-02-2#L3", "ids": [ "v-n5-0001", "v-n5-0096" ], "kana": "はい、ふたりです。", "morae": 7 },
    { "ref": "s-02-2#L6", "ids": [ "v-n5-0001", "v-n5-0031", "v-n5-0032", "v-n5-0033", "v-n5-0112" ], "kana": "はい。いち、に、さん。さんにんですね。", "morae": 14 },
    { "ref": "s-02-3#L2", "ids": [ "v-n5-0115" ], "kana": "ごひゃくえんです。", "morae": 7 },
    { "ref": "s-02-3#L3", "ids": [ "v-n5-0069", "v-n5-0115" ], "kana": "がくせいは、さんびゃくえんです。", "morae": 13 },
    { "ref": "s-02-3#L4", "ids": [ "v-n5-0071", "v-n5-0115" ], "kana": "こどもは、ひゃくえんです。", "morae": 10 },
    { "ref": "s-02-3#L10", "ids": [ "v-n5-0041", "v-n5-0115" ], "kana": "わたしは、ごひゃくえんです。", "morae": 11 },
    { "ref": "s-02-3#L11", "ids": [ "v-n5-0115" ], "kana": "ケンも、ごひゃくえんです。", "morae": 10 },
    { "ref": "s-02-3#L12", "ids": [ "v-n5-0115" ], "kana": "たなかさんも、ごひゃくえんです。", "morae": 13 },
    { "ref": "s-02-3#L13", "ids": [ "v-n5-0031", "v-n5-0032", "v-n5-0033", "v-n5-0115" ], "kana": "いち、に、さん。せんごひゃくえんです。", "morae": 14 },
    { "ref": "s-03-2#L6", "ids": [ "v-n5-0111", "v-n5-0019" ], "kana": "ひとつ、おねがいします。", "morae": 10 },
    { "ref": "s-03-2#L8", "ids": [ "v-n5-0001", "v-n5-0111" ], "kana": "はい。では、ふたつですね。", "morae": 10 },
    { "ref": "s-03-2#L12", "ids": [ "v-n5-0001", "v-n5-0115" ], "kana": "はい、せんきゅうひゃくえんです。", "morae": 12 },
    { "ref": "s-03-3#L11", "ids": [ "v-n5-0115" ], "kana": "せんきゅうひゃくえんです。", "morae": 10 },
    { "ref": "s-04-1#L4", "ids": [ "v-n5-0118", "v-n5-0051", "v-n5-0126", "v-n5-0029", "v-n5-0066", "v-n5-0132" ], "kana": "もりさんは、ここの「いらっしゃいませ」のひとです。", "morae": 20 },
    { "ref": "s-04-1#L6", "ids": [ "v-n5-0045", "v-n5-0118", "v-n5-0054", "v-n5-0132", "v-n5-0127", "v-n5-0046", "v-n5-0100", "v-n5-0129", "v-n5-0073", "v-n5-0126" ], "kana": "「これはなんですか。」「それはノートですよ。みなさんのノートです。」", "morae": 27 },
    { "ref": "s-04-1#L7", "ids": [ "v-n5-0041", "v-n5-0125", "v-n5-0132", "v-n5-0127", "v-n5-0003", "v-n5-0129" ], "kana": "「わたしもですか。」「ええ、ハナさんもですよ。」", "morae": 17 },
    { "ref": "s-04-1#L8", "ids": [ "v-n5-0047", "v-n5-0118", "v-n5-0054", "v-n5-0132", "v-n5-0127", "v-n5-0129" ], "kana": "「あれはなんですか。」「あれはごんたざかですよ。」", "morae": 19 },
    { "ref": "s-04-1#L9", "ids": [ "v-n5-0050", "v-n5-0066", "v-n5-0118", "v-n5-0064", "v-n5-0132", "v-n5-0127", "v-n5-0082", "v-n5-0116", "v-n5-0129" ], "kana": "「あのひとはどなたですか。」「ははです。きゅうじゅっさいですよ。」", "morae": 24 },
    { "ref": "s-04-1#L10", "ids": [ "v-n5-0045", "v-n5-0118", "v-n5-0041", "v-n5-0126", "v-n5-0100", "v-n5-0132", "v-n5-0137", "v-n5-0130" ], "kana": "これはわたしのノートです。きょうからです。", "morae": 18 },
    { "ref": "s-04-1#L11", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0132", "v-n5-0116", "v-n5-0126", "v-n5-0066" ], "kana": "わたしはハナです。にじゅうよんさいです。よこはまのひとです。", "morae": 26 },
    { "ref": "s-04-1#L12", "ids": [ "v-n5-0118", "v-n5-0085", "v-n5-0132", "v-n5-0082", "v-n5-0126", "v-n5-0086", "v-n5-0071" ], "kana": "ケンはあにではありません。ははのあねのこどもです。", "morae": 23 },
    { "ref": "s-04-1#L14", "ids": [ "v-n5-0047", "v-n5-0118", "v-n5-0054", "v-n5-0132", "v-n5-0127" ], "kana": "「もりさん、あれはなんですか。」", "morae": 12 },
    { "ref": "s-04-1#L17", "ids": [ "v-n5-0046", "v-n5-0125", "v-n5-0137", "v-n5-0126", "v-n5-0100", "v-n5-0121" ], "kana": "それも、きょうのノートに。", "morae": 10 },
    { "ref": "s-04-2#L1", "ids": [ "v-n5-0010", "v-n5-0017", "v-n5-0041", "v-n5-0118", "v-n5-0132" ], "kana": "ありがとうございます。はじめまして、わたしはハナです。", "morae": 24 },
    { "ref": "s-04-2#L2", "ids": [ "v-n5-0132", "v-n5-0018", "v-n5-0096", "v-n5-0127" ], "kana": "もりです。よろしくおねがいします。ふたりですか。", "morae": 21 },
    { "ref": "s-04-2#L3", "ids": [ "v-n5-0001", "v-n5-0096", "v-n5-0132", "v-n5-0041", "v-n5-0124", "v-n5-0130" ], "kana": "はい、ふたりです。わたしとケンです。よこはまからです。", "morae": 23 },
    { "ref": "s-04-2#L4", "ids": [ "v-n5-0130", "v-n5-0132", "v-n5-0127", "v-n5-0050", "v-n5-0118", "v-n5-0060", "v-n5-0135" ], "kana": "よこはまからですか。あのごんたざかは、どうでしたか。", "morae": 23 },
    { "ref": "s-04-2#L5", "ids": [ "v-n5-0132", "v-n5-0128" ], "kana": "……ごんたざかですね。", "morae": 8 },
    { "ref": "s-04-2#L6", "ids": [ "v-n5-0118", "v-n5-0089", "v-n5-0132", "v-n5-0127" ], "kana": "ケンさんは、おにいさんですか。", "morae": 13 },
    { "ref": "s-04-2#L7", "ids": [ "v-n5-0002", "v-n5-0085", "v-n5-0132", "v-n5-0082", "v-n5-0126", "v-n5-0086", "v-n5-0071" ], "kana": "いいえ、あにではありません。ははのあねのこどもです。", "morae": 23 },
    { "ref": "s-04-2#L9", "ids": [ "v-n5-0045", "v-n5-0118", "v-n5-0054", "v-n5-0132", "v-n5-0127" ], "kana": "もりさん、これはなんですか。", "morae": 12 },
    { "ref": "s-04-2#L10", "ids": [ "v-n5-0046", "v-n5-0118", "v-n5-0100", "v-n5-0132", "v-n5-0129", "v-n5-0073", "v-n5-0126" ], "kana": "それはノートですよ。みなさんのノートです。", "morae": 19 },
    { "ref": "s-04-2#L11", "ids": [ "v-n5-0041", "v-n5-0125", "v-n5-0132", "v-n5-0127" ], "kana": "わたしもですか。", "morae": 7 },
    { "ref": "s-04-2#L12", "ids": [ "v-n5-0003", "v-n5-0125", "v-n5-0132", "v-n5-0129" ], "kana": "ええ、ハナさんもケンさんもですよ。", "morae": 15 },
    { "ref": "s-04-2#L19", "ids": [ "v-n5-0012", "v-n5-0137", "v-n5-0130", "v-n5-0096", "v-n5-0118", "v-n5-0051", "v-n5-0126", "v-n5-0077", "v-n5-0132", "v-n5-0129" ], "kana": "どういたしまして。きょうから、ふたりはここのかぞくですよ。", "morae": 25 },
    { "ref": "s-04-3#L0", "ids": [ "v-n5-0084", "v-n5-0123", "v-n5-0020" ], "kana": "おかあさんへ。おげんきですか。", "morae": 13 },
    { "ref": "s-04-3#L1", "ids": [ "v-n5-0041", "v-n5-0124", "v-n5-0118", "v-n5-0137", "v-n5-0132" ], "kana": "わたしとケンは、きょう、ほどがやです。", "morae": 15 },
    { "ref": "s-04-3#L4", "ids": [ "v-n5-0126", "v-n5-0084", "v-n5-0118", "v-n5-0116", "v-n5-0132" ], "kana": "もりさんのおかあさんは、きゅうじゅっさいです。", "morae": 19 },
    { "ref": "s-04-3#L8", "ids": [ "v-n5-0041", "v-n5-0126", "v-n5-0100", "v-n5-0118", "v-n5-0137", "v-n5-0130", "v-n5-0132" ], "kana": "わたしのノートは、きょうからです。", "morae": 14 },
    { "ref": "s-04-3#L9", "ids": [ "v-n5-0140", "v-n5-0126", "v-n5-0100", "v-n5-0132", "v-n5-0105", "v-n5-0129" ], "kana": "まいにちのノートです。しゅくだいではありませんよ。", "morae": 22 },
    { "ref": "s-04-3#L10", "ids": [ "v-n5-0138", "v-n5-0118", "v-n5-0131", "v-n5-0132" ], "kana": "あしたはとつかまでです。", "morae": 11 },
    { "ref": "s-04-3#L11", "ids": [ "v-n5-0083", "v-n5-0125", "v-n5-0020" ], "kana": "おとうさんも、おげんきですか。", "morae": 13 },
    { "ref": "s-04-3#L12", "ids": [ "v-n5-0009" ], "kana": "では、おやすみなさい。ハナより。", "morae": 13 },
    { "ref": "s-04-4#L0", "ids": [ "v-n5-0013", "v-n5-0045", "v-n5-0118", "v-n5-0054", "v-n5-0132", "v-n5-0127" ], "kana": "もりさん、すみません。これはなんですか。", "morae": 17 },
    { "ref": "s-04-4#L6", "ids": [ "v-n5-0111", "v-n5-0132", "v-n5-0127", "v-n5-0074", "v-n5-0119", "v-n5-0041", "v-n5-0126" ], "kana": "ふたつですか。どちらがわたしのですか。", "morae": 17 },
    { "ref": "s-04-4#L14", "ids": [ "v-n5-0001", "v-n5-0010" ], "kana": "はい。ありがとうございます、もりさん。", "morae": 16 },
    { "ref": "s-04-4#L15", "ids": [ "v-n5-0012", "v-n5-0041", "v-n5-0118", "v-n5-0053", "v-n5-0132", "v-n5-0129" ], "kana": "どういたしまして。わたしは、あそこですよ。", "morae": 18 },
    { "ref": "s-04-5#L0", "ids": [ "v-n5-0007", "v-n5-0041", "v-n5-0118", "v-n5-0132" ], "kana": "こんばんは、もりさん。わたしはケンです。", "morae": 17 },
    { "ref": "s-04-5#L2", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0116", "v-n5-0132" ], "kana": "わたしはさんじゅういっさいです。", "morae": 14 },
    { "ref": "s-04-5#L3", "ids": [ "v-n5-0118", "v-n5-0116", "v-n5-0132", "v-n5-0129" ], "kana": "ハナはにじゅうよんさいですよ。", "morae": 13 },
    { "ref": "s-04-5#L4", "ids": [ "v-n5-0126", "v-n5-0066", "v-n5-0132", "v-n5-0125" ], "kana": "よこはまのひとです。ハナもよこはまです。", "morae": 18 },
    { "ref": "s-04-5#L5", "ids": [ "v-n5-0126", "v-n5-0084", "v-n5-0118", "v-n5-0041", "v-n5-0044", "v-n5-0132" ], "kana": "ハナのおかあさんは、わたしのおばさんです。", "morae": 19 },
    { "ref": "s-04-5#L11", "ids": [ "v-n5-0136", "v-n5-0118", "v-n5-0124", "v-n5-0096", "v-n5-0126", "v-n5-0077", "v-n5-0132" ], "kana": "いまは、ハナとふたりのかぞくです。", "morae": 15 },
