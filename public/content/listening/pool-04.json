    { "ref": "s-04-5#L13", "ids": [ "v-n5-0137", "v-n5-0118", "v-n5-0010" ], "kana": "きょうは、ありがとうございます。", "morae": 13 },
    { "ref": "s-04-5#L14", "ids": [ "v-n5-0018" ], "kana": "もりさん、よろしくおねがいします。", "morae": 15 },
    { "ref": "s-04-5#L15", "ids": [ "v-n5-0118", "v-n5-0051", "v-n5-0126", "v-n5-0066", "v-n5-0132", "v-n5-0127" ], "kana": "もりさんは？もりさんは、ここのひとですか。", "morae": 18 },
