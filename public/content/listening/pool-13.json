{
  "schema": "tsuzuku.pool/1",
  "station": 13,
  "refs": [
    { "ref": "s-01-1#L1", "ids": [ "v-n5-0653", "v-n5-0004" ], "kana": "さくらです。「おはようございます。」", "morae": 14 },
    { "ref": "s-02-1#L0", "ids": [ "v-n5-0653" ], "kana": "かわさきです。さくらです。", "morae": 11 },
    { "ref": "s-02-1#L13", "ids": [ "v-n5-0653" ], "kana": "たまがわのさくらです。", "morae": 10 },
    { "ref": "s-02-2#L14", "ids": [ "v-n5-0653" ], "kana": "さくらですね。", "morae": 6 },
    { "ref": "s-06-4#L11", "ids": [ "v-n5-0137", "v-n5-0118", "v-n5-0141", "v-n5-0130", "v-n5-0673", "g-n5-017", "v-n5-0129" ], "kana": "きょうは、あさから、たくさんとりましたよ。", "morae": 17 },
    { "ref": "s-11-2#L16", "ids": [ "v-n5-0675", "v-n5-0290", "g-n5-061", "v-n5-0293" ], "kana": "ちょっとまって。まだでたくない。", "morae": 13 },
    { "ref": "s-11-5#L12", "ids": [ "v-n5-0154", "v-n5-0675", "v-n5-0369", "v-n5-0129", "g-n5-061", "v-n5-0143" ], "kana": "よじ？ちょっとはやいよ。まだよるだよ。", "morae": 15 },
    { "ref": "s-13-1#L0", "ids": [ "v-n5-0218", "v-n5-0211", "v-n5-0595", "v-n5-0439", "v-n5-0118", "v-n5-0154", "v-n5-0156", "v-n5-0135", "v-n5-0369", "v-n5-0132" ], "kana": "しちがつじゅうしちにち、はれ。あさごはんはろくじはんでした。はやいです。", "morae": 31 },
    { "ref": "s-13-1#L2", "ids": [ "v-n5-0439", "v-n5-0126", "g-n5-033", "v-n5-0647", "v-n5-0131", "v-n5-0302" ], "kana": "あさごはんのまえに、たんぼまではしりました。", "morae": 20 },
    { "ref": "s-13-1#L4", "ids": [ "v-n5-0671", "v-n5-0350", "v-n5-0132", "v-n5-0565", "v-n5-0118", "v-n5-0166", "v-n5-0642" ], "kana": "とてもおおきかったです。そらはあおくて、あかるかったです。", "morae": 26 },
    { "ref": "s-13-1#L5", "ids": [ "v-n5-0548", "v-n5-0126", "v-n5-0148", "v-n5-0121", "v-n5-0566", "v-n5-0119", "v-n5-0677", "v-n5-0674", "v-n5-0272" ], "kana": "やまのうえに、ゆきがまだすこしありました。", "morae": 19 },
    { "ref": "s-13-1#L6", "ids": [ "v-n5-0652", "v-n5-0119", "v-n5-0361", "v-n5-0648", "v-n5-0673", "v-n5-0334", "v-n5-0273" ], "kana": "くうきがつめたくて、ことりがたくさんとんでいました。", "morae": 24 },
    { "ref": "s-13-1#L7", "ids": [ "v-n5-0647", "v-n5-0126", "v-n5-0600", "v-n5-0148", "v-n5-0121", "v-n5-0166", "v-n5-0553", "v-n5-0119", "v-n5-0300", "v-n5-0273" ], "kana": "たんぼのいしのうえに、あおいねこがすわっていました。", "morae": 24 },
    { "ref": "s-13-1#L8", "ids": [ "v-n5-0553", "v-n5-0125", "v-n5-0548", "v-n5-0120", "v-n5-0276", "v-n5-0273", "v-n5-0132", "v-n5-0118", "v-n5-0338", "v-n5-0124", "v-n5-0279" ], "kana": "ねこもやまをみていました。アオです。ケンは「ちがう」というでしょう。", "morae": 28 },
    { "ref": "s-13-1#L9", "ids": [ "v-n5-0439", "v-n5-0120", "v-n5-0277", "v-n5-0126", "v-n5-0544", "v-n5-0280", "v-n5-0041", "v-n5-0118", "v-n5-0339", "v-n5-0119", "v-n5-0272" ], "kana": "あさごはんをたべながら、ふじさんのはなしをききました。わたしはのぼったことがありません。", "morae": 41 },
    { "ref": "s-13-1#L10", "ids": [ "v-n5-0118", "v-n5-0116", "v-n5-0126", "v-n5-0225", "v-n5-0121", "v-n5-0106", "v-n5-0339", "v-n5-0676", "v-n5-0124", "v-n5-0279" ], "kana": "ケンはじゅうきゅうさいのなつに、いっかいのぼりました。「もうのぼらない」といいました。", "morae": 36 },
    { "ref": "s-13-1#L11", "ids": [ "v-n5-0118", "v-n5-0106", "v-n5-0125", "v-n5-0339", "v-n5-0119", "v-n5-0272", "v-n5-0651", "v-n5-0627", "v-n5-0132" ], "kana": "すずきさんはじゅういっかいものぼったことがあります。やまのぼりがしゅみです。", "morae": 34 },
    { "ref": "s-13-1#L12", "ids": [ "v-n5-0629", "v-n5-0132", "v-n5-0127", "v-n5-0124", "v-n5-0280", "v-n5-0548", "v-n5-0118", "v-n5-0633", "v-n5-0129", "v-n5-0279" ], "kana": "「こわくないですか」とききました。「やまはやさしいよ」といいました。", "morae": 28 },
    { "ref": "s-13-1#L13", "ids": [ "v-n5-0277", "g-n5-070", "v-n5-0239", "v-n5-0120", "v-n5-0296", "v-n5-0147", "v-n5-0293" ], "kana": "たべたあとで、にもつをもって、へやをでました。", "morae": 20 },
    { "ref": "s-13-1#L14", "ids": [ "v-n5-0118", "v-n5-0548", "v-n5-0120", "v-n5-0276", "v-n5-0230", "v-n5-0122", "v-n5-0409", "v-n5-0278" ], "kana": "ケンはやまをみながら、げんかんでコーヒーをのみました。", "morae": 25 },
    { "ref": "s-13-1#L15", "ids": [ "v-n5-0121", "v-n5-0418", "v-n5-0120", "v-n5-0347", "v-n5-0130", "v-n5-0096", "v-n5-0122", "v-n5-0293" ], "kana": "すずきさんにおかねをはらってから、ふたりででました。", "morae": 24 },
    { "ref": "s-13-1#L16", "ids": [ "v-n5-0120", "v-n5-0293", "v-n5-0130", "v-n5-0125", "v-n5-0118", "v-n5-0678", "v-n5-0183", "v-n5-0121", "v-n5-0272" ], "kana": "はらをでてからも、ふじさんはいつもみぎにありました。", "morae": 24 },
    { "ref": "s-13-1#L18", "ids": [ "v-n5-0049", "v-n5-0149", "v-n5-0121", "v-n5-0351", "v-n5-0282", "v-n5-0339", "v-n5-0119", "v-n5-0677" ], "kana": "そのしたに、ちいさくかきました。「のぼったことがない。まだ？」", "morae": 25 },
    { "ref": "s-13-2#L1", "ids": [ "v-n5-0276", "v-n5-0129", "g-n5-033", "v-n5-0277", "v-n5-0412", "v-n5-0119", "v-n5-0290" ], "kana": "みたよ。みるまえにたべて。さかながまってるよ。", "morae": 20 },
    { "ref": "s-13-2#L2", "ids": [ "v-n5-0001", "v-n5-0277", "v-n5-0276" ], "kana": "はい、はい。たべながらみる。", "morae": 11 },
    { "ref": "s-13-2#L4", "ids": [ "v-n5-0003", "v-n5-0548", "v-n5-0126", "v-n5-0148", "v-n5-0121", "v-n5-0118", "v-n5-0339", "v-n5-0119", "v-n5-0272", "v-n5-0127" ], "kana": "ええ、やまのうえに。すずきさんはのぼったことがありますか。", "morae": 26 },
    { "ref": "s-13-2#L6", "ids": [ "v-n5-0106", "v-n5-0629", "v-n5-0132", "v-n5-0127" ], "kana": "じゅういっかい！こわくないですか。", "morae": 14 },
    { "ref": "s-13-2#L7", "ids": [ "v-n5-0629", "v-n5-0129", "v-n5-0548", "v-n5-0118", "v-n5-0633", "v-n5-0339", "g-n5-033", "v-n5-0680", "v-n5-0289" ], "kana": "こわくないよ。やまはやさしい。でも、のぼるまえによくねなさい。", "morae": 27 },
    { "ref": "s-13-2#L8", "ids": [ "v-n5-0118", "v-n5-0339", "v-n5-0272" ], "kana": "ケンは？のぼったことある？", "morae": 11 },
    { "ref": "s-13-2#L9", "ids": [ "v-n5-0106", "v-n5-0128", "v-n5-0116", "v-n5-0126", "v-n5-0225", "v-n5-0359", "v-n5-0630", "v-n5-0400", "v-n5-0676", "v-n5-0339" ], "kana": "いっかいね。じゅうきゅうさいのなつ。さむくて、ねむくて、たいへんだった。もうのぼらない。", "morae": 36 },
    { "ref": "s-13-2#L10", "ids": [ "v-n5-0003", "v-n5-0548", "v-n5-0118", "v-n5-0633" ], "kana": "ええ？でもやまはやさしいって。", "morae": 13 },
    { "ref": "s-13-2#L11", "ids": [ "v-n5-0128", "v-n5-0548", "v-n5-0126", "v-n5-0148", "v-n5-0118", "v-n5-0527", "v-n5-0125", "v-n5-0361" ], "kana": "すずきさんにはね。やまのうえはラーメンもつめたかった。", "morae": 25 },
    { "ref": "s-13-2#L12", "ids": [ "v-n5-0001", "v-n5-0073", "v-n5-0277", "g-n5-070", "v-n5-0239", "v-n5-0293", "g-n5-033", "v-n5-0502" ], "kana": "はい、みなさん。たべたあとでにもつ。でるまえにトイレ。", "morae": 23 },
    { "ref": "s-13-2#L13", "ids": [ "v-n5-0285", "v-n5-0647", "v-n5-0121", "v-n5-0119", "v-n5-0273", "v-n5-0129" ], "kana": "わかりました。ケン、たんぼにアオがいたよ。", "morae": 18 },
    { "ref": "s-13-2#L14", "ids": [ "v-n5-0338", "v-n5-0553", "v-n5-0118", "v-n5-0130", "v-n5-0301", "v-n5-0129" ], "kana": "ちがうって。ねこはおおいそからあるかないよ。", "morae": 20 },
    { "ref": "s-13-2#L15", "ids": [ "v-n5-0301", "v-n5-0129", "v-n5-0118", "v-n5-0140", "v-n5-0679", "v-n5-0420", "v-n5-0121", "v-n5-0303" ], "kana": "あるくよ。アオはまいにちあるいて、ときどきでんしゃにのる。", "morae": 25 },
    { "ref": "s-13-2#L16", "ids": [ "v-n5-0132", "v-n5-0129", "v-n5-0001", "v-n5-0277" ], "kana": "たなかさんじゃないよ。はい、たべて。", "morae": 14 },
    { "ref": "s-13-2#L17", "ids": [ "v-n5-0154", "v-n5-0121", "v-n5-0293", "v-n5-0132", "v-n5-0548", "v-n5-0118", "v-n5-0138", "v-n5-0125", "v-n5-0272", "v-n5-0129" ], "kana": "しちじにでるでしょう？やまはあしたもあるよ。", "morae": 19 },
    { "ref": "s-13-2#L18", "ids": [ "v-n5-0001", "v-n5-0137", "v-n5-0126", "v-n5-0548", "v-n5-0118", "v-n5-0132" ], "kana": "はい。でも、きょうのやまはきょうだけです。", "morae": 16 },
    { "ref": "s-13-2#L19", "ids": [ "v-n5-0285", "v-n5-0277", "v-n5-0130", "v-n5-0276", "v-n5-0409", "v-n5-0120", "v-n5-0278" ], "kana": "わかった。たべてからみる。コーヒーをのみながら。", "morae": 21 },
    { "ref": "s-13-3#L0", "ids": [ "v-n5-0126", "v-n5-0073", "v-n5-0123", "v-n5-0425", "v-n5-0130", "v-n5-0006" ], "kana": "よこはまのみなさんへ。はらのまちから、こんにちは。", "morae": 22 },
    { "ref": "s-13-3#L1", "ids": [ "v-n5-0048", "v-n5-0612", "v-n5-0126", "v-n5-0623", "v-n5-0118", "v-n5-0236", "v-n5-0132" ], "kana": "このはがきのえは、けさのふじさんです。", "morae": 17 },
    { "ref": "s-13-3#L2", "ids": [ "v-n5-0218", "v-n5-0211", "v-n5-0595", "v-n5-0647", "v-n5-0126", "v-n5-0148", "v-n5-0121", "v-n5-0350", "v-n5-0548" ], "kana": "しちがつじゅうしちにち、はれ。たんぼのうえに、おおきなやま。", "morae": 25 },
    { "ref": "s-13-3#L3", "ids": [ "v-n5-0439", "v-n5-0126", "g-n5-033", "v-n5-0647", "v-n5-0131", "v-n5-0302", "v-n5-0276" ], "kana": "あさごはんのまえに、たんぼまではしってみました。", "morae": 22 },
    { "ref": "s-13-3#L4", "ids": [ "v-n5-0277", "g-n5-070", "v-n5-0239", "v-n5-0120", "v-n5-0296", "v-n5-0151", "v-n5-0121", "v-n5-0293" ], "kana": "たべたあとで、にもつをもってそとにでました。", "morae": 20 },
    { "ref": "s-13-3#L5", "ids": [ "v-n5-0118", "v-n5-0548", "v-n5-0120", "v-n5-0276", "v-n5-0409", "v-n5-0278", "v-n5-0273" ], "kana": "ケンはやまをみながら、コーヒーをのんでいました。", "morae": 22 },
    { "ref": "s-13-3#L6", "ids": [ "v-n5-0548", "v-n5-0126", "v-n5-0148", "v-n5-0218", "v-n5-0566", "v-n5-0119", "v-n5-0674", "v-n5-0272" ], "kana": "やまのうえには、しちがつでもゆきがすこしありました。", "morae": 24 },
    { "ref": "s-13-3#L7", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0121", "v-n5-0339", "v-n5-0119", "v-n5-0272", "v-n5-0106" ], "kana": "わたしはふじさんにのぼったことがありません。ケンはいっかいあります。", "morae": 32 },
    { "ref": "s-13-3#L9", "ids": [ "v-n5-0041", "v-n5-0125", "v-n5-0339", "v-n5-0132", "v-n5-0204", "v-n5-0118", "v-n5-0276" ], "kana": "わたしものぼりたいです。でも、ことしはみるだけです。", "morae": 23 },
    { "ref": "s-13-3#L10", "ids": [ "v-n5-0126", "v-n5-0141", "v-n5-0118", "v-n5-0652", "v-n5-0119", "v-n5-0361", "v-n5-0648", "v-n5-0639", "v-n5-0132" ], "kana": "はらのあさは、くうきがつめたくて、ことりがうるさいです。", "morae": 25 },
    { "ref": "s-13-3#L11", "ids": [ "v-n5-0118", "v-n5-0358", "v-n5-0132", "v-n5-0073", "v-n5-0125", "v-n5-0388", "v-n5-0122", "v-n5-0273", "g-n5-051" ], "kana": "よこはまはあついでしょう？みなさんもげんきでいてください。", "morae": 26 },
    { "ref": "s-13-3#L12", "ids": [ "v-n5-0138", "v-n5-0125", "v-n5-0301" ], "kana": "あしたもあるきます。ハナより", "morae": 13 },
    { "ref": "s-13-4#L0", "ids": [ "v-n5-0004", "v-n5-0676", "v-n5-0293", "v-n5-0127" ], "kana": "おはようございます。もうでますか。", "morae": 15 },
    { "ref": "s-13-4#L1", "ids": [ "v-n5-0004", "v-n5-0001", "v-n5-0154", "v-n5-0121" ], "kana": "おはようございます。はい、しちじに。", "morae": 15 },
    { "ref": "s-13-4#L2", "ids": [ "v-n5-0418", "v-n5-0132", "v-n5-0128", "v-n5-0095", "v-n5-0115" ], "kana": "では、おかねですね。ひとりはっせんえんです。", "morae": 19 },
    { "ref": "s-13-4#L3", "ids": [ "v-n5-0096", "v-n5-0122", "v-n5-0115", "v-n5-0132", "v-n5-0128", "v-n5-0001" ], "kana": "ふたりでいちまんろくせんえんですね。はい。", "morae": 19 },
    { "ref": "s-13-4#L4", "ids": [ "v-n5-0010", "v-n5-0045", "v-n5-0535", "v-n5-0132" ], "kana": "ありがとうございます。これ、おにぎりです。", "morae": 18 },
    { "ref": "s-13-4#L5", "ids": [ "v-n5-0010", "v-n5-0150", "v-n5-0118", "v-n5-0054", "v-n5-0132", "v-n5-0127" ], "kana": "ありがとうございます。なかはなんですか。", "morae": 18 },
    { "ref": "s-13-4#L6", "ids": [ "v-n5-0412", "v-n5-0124", "v-n5-0413", "v-n5-0132", "v-n5-0095", "v-n5-0111", "v-n5-0129" ], "kana": "さかなとたまごです。ひとりみっつですよ。", "morae": 18 },
    { "ref": "s-13-4#L7", "ids": [ "v-n5-0048", "v-n5-0412", "v-n5-0118", "v-n5-0126", "v-n5-0494", "v-n5-0132", "v-n5-0127" ], "kana": "このさかなは、ぬまづのいちばのですか。", "morae": 17 },
    { "ref": "s-13-4#L8", "ids": [ "v-n5-0022", "v-n5-0301", "v-n5-0277", "g-n5-051" ], "kana": "そうです。あるきながらたべてください。", "morae": 17 },
    { "ref": "s-13-4#L9", "ids": [ "v-n5-0001", "v-n5-0301", "v-n5-0277", "v-n5-0632", "v-n5-0132" ], "kana": "はい。でも、あるきながらたべるのはにがてです。", "morae": 20 },
    { "ref": "s-13-4#L10", "ids": [ "v-n5-0131", "v-n5-0054", "v-n5-0157", "v-n5-0132", "v-n5-0127" ], "kana": "よしわらまで、なんじかんぐらいですか。", "morae": 17 },
    { "ref": "s-13-4#L11", "ids": [ "v-n5-0301", "v-n5-0033", "v-n5-0157", "v-n5-0132" ], "kana": "あるいて、さんじかんぐらいでしょう。", "morae": 15 },
    { "ref": "s-13-4#L12", "ids": [ "v-n5-0033", "v-n5-0157", "v-n5-0132", "v-n5-0127", "v-n5-0137", "v-n5-0125", "v-n5-0358", "v-n5-0128" ], "kana": "さんじかんですか。きょうもあついでしょうね。", "morae": 18 },
    { "ref": "s-13-4#L16", "ids": [ "v-n5-0182", "v-n5-0121", "v-n5-0136", "v-n5-0118", "v-n5-0183", "v-n5-0132", "v-n5-0128" ], "kana": "ひだりに？いまはみぎですね。", "morae": 12 },
    { "ref": "s-13-4#L17", "ids": [ "v-n5-0182", "v-n5-0126", "v-n5-0120", "v-n5-0276", "v-n5-0119", "v-n5-0272", "v-n5-0127" ], "kana": "ひだりのふじさんをみたことがありますか。", "morae": 19 },
    { "ref": "s-13-4#L18", "ids": [ "v-n5-0002", "v-n5-0272", "v-n5-0305", "v-n5-0130", "v-n5-0276" ], "kana": "いいえ、ありません。ついてから、みます。", "morae": 16 },
    { "ref": "s-13-4#L19", "ids": [ "v-n5-0276", "g-n5-033", "v-n5-0301", "v-n5-0129" ], "kana": "ハナ、みるまえにあるくよ。", "morae": 11 },
    { "ref": "s-13-4#L20", "ids": [ "v-n5-0293", "g-n5-033", "v-n5-0100", "v-n5-0121", "v-n5-0541", "v-n5-0120", "v-n5-0282", "g-n5-051" ], "kana": "でるまえに、ノートになまえをかいてください。", "morae": 20 },
    { "ref": "s-13-4#L21", "ids": [ "v-n5-0001", "v-n5-0124", "v-n5-0125", "v-n5-0282", "v-n5-0128" ], "kana": "はい。ハナと、ケンと。アオもかきますね。", "morae": 16 },
