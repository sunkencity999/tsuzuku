    { "ref": "s-07-1#L10", "ids": [ "v-n5-0056", "v-n5-0130", "v-n5-0275", "v-n5-0127", "v-n5-0132", "v-n5-0030" ], "kana": "「どこからきましたか。」「ふじさわからです。」「そうですか。」", "morae": 22 },
