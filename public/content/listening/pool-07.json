    { "ref": "s-05-4#L4", "ids": [ "v-n5-0050", "v-n5-0013", "v-n5-0267", "v-n5-0118", "v-n5-0074", "v-n5-0132", "v-n5-0127" ], "kana": "あの、すみません。ひがしはどちらですか。", "morae": 17 },
    { "ref": "s-07-1#L0", "ids": [ "v-n5-0218", "v-n5-0211", "v-n5-0141", "v-n5-0118", "v-n5-0154", "v-n5-0121", "v-n5-0277" ], "kana": "しちがつよっか。あさはしちじにたべました。", "morae": 19 },
