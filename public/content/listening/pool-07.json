    { "ref": "s-07-2#L1", "ids": [ "v-n5-0023", "g-n5-028", "g-n5-024", "v-n5-0132" ], "kana": "そうですね。とてもあついです。", "morae": 13 },
    { "ref": "s-07-2#L2", "ids": [ "v-n5-0126", "v-n5-0118", "v-n5-0060", "v-n5-0132", "v-n5-0127" ], "kana": "ひらつかのたなばたはどうですか。", "morae": 15 },
