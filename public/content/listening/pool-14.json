{
  "schema": "tsuzuku.pool/1",
  "station": 14,
  "refs": [
    { "ref": "s-03-1#L15", "ids": [ "v-n5-0041", "v-n5-0686" ], "kana": "わたしは、「アオ、またね。」", "morae": 9 },
    { "ref": "s-09-1#L3", "ids": [ "v-n5-0683", "v-n5-0123", "v-n5-0274" ], "kana": "「たなかさん、いっしょにおだわらじょうへいきませんか。」", "morae": 22 },
    { "ref": "s-09-2#L3", "ids": [ "v-n5-0683", "v-n5-0123", "v-n5-0274" ], "kana": "たなかさん、いっしょにおだわらじょうへいきませんか。", "morae": 22 },
    { "ref": "s-09-2#L16", "ids": [ "v-n5-0041", "v-n5-0125", "v-n5-0412", "v-n5-0119", "v-n5-0392", "v-n5-0132", "v-n5-0123", "v-n5-0683", "v-n5-0274" ], "kana": "わたしもさかながすきです。たなかさん、はこねへもいっしょにいきませんか。", "morae": 32 },
    { "ref": "s-09-4#L9", "ids": [ "v-n5-0125", "v-n5-0683", "v-n5-0274", "v-n5-0127" ], "kana": "たかはしさんもいっしょにいきませんか。", "morae": 17 },
    { "ref": "s-09-5#L7", "ids": [ "v-n5-0683", "v-n5-0148", "v-n5-0121", "v-n5-0274", "v-n5-0127" ], "kana": "ハナさん、いっしょにうえにいきませんか。", "morae": 17 },
    { "ref": "s-10-1#L11", "ids": [ "v-n5-0118", "v-n5-0436", "v-n5-0120", "v-n5-0726", "v-n5-0273", "v-n5-0041", "v-n5-0126", "v-n5-0132", "v-n5-0413" ], "kana": "ケンはしゃしんをとっていました。わたしのしゃしんではありません。たまごのしゃしんです。", "morae": 37 },
    { "ref": "s-10-2#L3", "ids": [ "v-n5-0686", "v-n5-0137", "v-n5-0118", "v-n5-0167", "v-n5-0359", "v-n5-0400", "v-n5-0128" ], "kana": "また？きょうはしろくて、さむくて、たいへんだったね。", "morae": 21 },
    { "ref": "s-10-2#L19", "ids": [ "v-n5-0695", "v-n5-0293", "v-n5-0128", "v-n5-0141", "v-n5-0276" ], "kana": "じゃあ、でないね。でも、あさ、みる。", "morae": 12 },
    { "ref": "s-10-3#L9", "ids": [ "v-n5-0436", "v-n5-0118", "v-n5-0403", "v-n5-0132", "v-n5-0126", "v-n5-0152", "v-n5-0122", "v-n5-0726", "g-n5-051" ], "kana": "しゃしんはだいじょうぶです。あしノこのまえでとってください。", "morae": 26 },
    { "ref": "s-10-4#L15", "ids": [ "v-n5-0259", "v-n5-0120", "v-n5-0313", "v-n5-0436", "v-n5-0726", "v-n5-0273" ], "kana": "きものをきて、しゃしんをとっています。", "morae": 16 },
    { "ref": "s-11-1#L5", "ids": [ "v-n5-0499", "v-n5-0121", "v-n5-0350", "v-n5-0241", "v-n5-0119", "v-n5-0272", "v-n5-0051", "v-n5-0122", "v-n5-0436", "v-n5-0120", "v-n5-0726", "v-n5-0125", "v-n5-0356", "v-n5-0132" ], "kana": "いりぐちにおおきいかみがあります。「ここでしゃしんをとってもいいです。」", "morae": 31 },
    { "ref": "s-11-1#L6", "ids": [ "v-n5-0497", "v-n5-0126", "v-n5-0150", "v-n5-0122", "v-n5-0726", "v-n5-0118", "g-n5-055", "v-n5-0442", "v-n5-0125" ], "kana": "「たてもののなかでとってはいけません。たべものもいけません。」", "morae": 27 },
    { "ref": "s-11-3#L4", "ids": [ "v-n5-0436", "v-n5-0118", "v-n5-0051", "v-n5-0122", "v-n5-0726", "v-n5-0125", "v-n5-0356", "v-n5-0132" ], "kana": "しゃしんはここでとってもいいです。", "morae": 15 },
    { "ref": "s-11-3#L5", "ids": [ "v-n5-0497", "v-n5-0126", "v-n5-0150", "v-n5-0122", "v-n5-0726", "v-n5-0118", "g-n5-055" ], "kana": "でも、たてもののなかでとってはいけません。", "morae": 19 },
    { "ref": "s-11-3#L12", "ids": [ "v-n5-0137", "v-n5-0118", "g-n5-028", "v-n5-0358", "v-n5-0132", "v-n5-0406", "v-n5-0120", "v-n5-0278", "v-n5-0685", "v-n5-0276", "g-n5-051" ], "kana": "きょうはとてもあついです。みずをのんで、ゆっくりみてください。", "morae": 27 },
    { "ref": "s-11-4#L5", "ids": [ "v-n5-0511", "v-n5-0120", "v-n5-0183", "v-n5-0121", "v-n5-0722", "g-n5-051" ], "kana": "しんごうをみぎにまがってください。", "morae": 16 },
    { "ref": "s-11-4#L7", "ids": [ "v-n5-0001", "v-n5-0722", "v-n5-0182", "v-n5-0121", "v-n5-0453", "v-n5-0119", "v-n5-0272" ], "kana": "はい。まがって、ひだりにコンビニがあります。", "morae": 19 },
    { "ref": "s-12-1#L14", "ids": [ "v-n5-0572", "v-n5-0118", "v-n5-0140", "v-n5-0562", "v-n5-0143", "g-n5-028", "v-n5-0717" ], "kana": "でも、あしはまいにちいたい。よるはとてもつかれる。", "morae": 22 },
    { "ref": "s-12-4#L11", "ids": [ "v-n5-0363", "v-n5-0124", "v-n5-0801", "v-n5-0140", "v-n5-0717" ], "kana": "たのしいとおもう。でも、まいにちつかれる。", "morae": 18 },
    { "ref": "s-12-5#L8", "ids": [ "v-n5-0049", "v-n5-0507", "v-n5-0120", "v-n5-0723", "g-n5-051" ], "kana": "そのはしをわたってください。", "morae": 13 },
    { "ref": "s-12-5#L9", "ids": [ "v-n5-0507", "v-n5-0120", "v-n5-0723", "v-n5-0060", "v-n5-0271", "v-n5-0127" ], "kana": "はしをわたって、どうしますか。", "morae": 13 },
    { "ref": "s-12-5#L10", "ids": [ "v-n5-0183", "v-n5-0121", "v-n5-0722", "g-n5-051", "v-n5-0182", "v-n5-0132" ], "kana": "みぎにまがってください。ひだりじゃない、みぎ。", "morae": 19 },
    { "ref": "s-12-5#L12", "ids": [ "v-n5-0022", "v-n5-0722", "v-n5-0155", "v-n5-0301" ], "kana": "そうです。まがって、ごふんぐらいあるきます。", "morae": 19 },
    { "ref": "s-13-4#L14", "ids": [ "v-n5-0001", "v-n5-0436", "v-n5-0120", "v-n5-0726", "v-n5-0318", "v-n5-0271" ], "kana": "はい。しゃしんをとったり、やすんだりします。", "morae": 18 },
    { "ref": "s-14-1#L0", "ids": [ "v-n5-0218", "v-n5-0211", "v-n5-0595", "v-n5-0439", "v-n5-0118", "v-n5-0154", "v-n5-0156", "v-n5-0135" ], "kana": "しちがつじゅうくにち、はれ。あさごはんはろくじはんでした。", "morae": 25 },
    { "ref": "s-14-1#L1", "ids": [ "v-n5-0154", "v-n5-0156", "v-n5-0118", "v-n5-0674", "v-n5-0369", "v-n5-0132", "v-n5-0692", "v-n5-0137", "v-n5-0125", "v-n5-0358" ], "kana": "ろくじはんはすこしはやいです。でも、きょうもあついです。", "morae": 24 },
    { "ref": "s-14-1#L2", "ids": [ "v-n5-0136", "v-n5-0131", "v-n5-0118", "v-n5-0678", "v-n5-0424", "v-n5-0126", "v-n5-0183", "v-n5-0121", "v-n5-0272" ], "kana": "いままで、ふじさんはいつもみちのみぎにありました。", "morae": 23 },
    { "ref": "s-14-1#L3", "ids": [ "v-n5-0692", "v-n5-0122", "v-n5-0424", "v-n5-0119", "v-n5-0722", "v-n5-0182", "v-n5-0121", "v-n5-0275" ], "kana": "でも、よしわらでみちがまがって、ふじさんがひだりにきました。", "morae": 27 },
    { "ref": "s-14-1#L4", "ids": [ "v-n5-0126", "v-n5-0600", "v-n5-0152", "v-n5-0121", "v-n5-0116", "v-n5-0094", "v-n5-0119", "v-n5-0273" ], "kana": "ひだりふじのいしのまえに、ななさいぐらいのおんなのこがいました。", "morae": 30 },
    { "ref": "s-14-1#L5", "ids": [ "v-n5-0541", "v-n5-0118", "v-n5-0802", "v-n5-0132", "v-n5-0084", "v-n5-0067" ], "kana": "なまえはアヤちゃんです。おかあさんはふじたさんです。", "morae": 23 },
    { "ref": "s-14-1#L7", "ids": [ "v-n5-0351", "v-n5-0167", "v-n5-0674", "v-n5-0722", "v-n5-0273" ], "kana": "ちいさくて、しろくて、すこしまがっていました。", "morae": 20 },
    { "ref": "s-14-1#L9", "ids": [ "v-n5-0067", "v-n5-0119", "v-n5-0710", "v-n5-0051", "v-n5-0696", "v-n5-0182", "v-n5-0121", "v-n5-0272" ], "kana": "ふじたさんがせつめいしました。「ここではふじさんがひだりにあります。」", "morae": 31 },
    { "ref": "s-14-1#L10", "ids": [ "v-n5-0697", "v-n5-0051", "v-n5-0118", "v-n5-0132", "v-n5-0391", "v-n5-0498" ], "kana": "だから、ここはひだりふじです。ゆうめいなところです。", "morae": 23 },
    { "ref": "s-14-1#L12", "ids": [ "v-n5-0136", "v-n5-0126", "v-n5-0041", "v-n5-0118", "v-n5-0054", "v-n5-0119", "g-n5-078", "v-n5-0127", "v-n5-0282" ], "kana": "いまのわたしはなにができますか。かきます。", "morae": 19 },
    { "ref": "s-14-1#L13", "ids": [ "v-n5-0513", "v-n5-0119", "v-n5-0281", "v-n5-0157", "v-n5-0125", "v-n5-0279", "v-n5-0136", "v-n5-0118", "v-n5-0143", "v-n5-0126", "v-n5-0154", "v-n5-0155", "v-n5-0132" ], "kana": "メニューがよめます。じかんもいえます。いまはよるのはちじじゅっぷんです。", "morae": 31 },
    { "ref": "s-14-1#L14", "ids": [ "v-n5-0692", "v-n5-0421", "v-n5-0126", "v-n5-0587", "v-n5-0118", "v-n5-0677", "v-n5-0281", "v-n5-0078", "v-n5-0119", "v-n5-0272" ], "kana": "でも、バスのじはまだよめません。ひらがながありません。", "morae": 24 },
    { "ref": "s-14-1#L15", "ids": [ "v-n5-0549", "v-n5-0122", "v-n5-0320", "v-n5-0125", "g-n5-078", "v-n5-0045", "v-n5-0118", "v-n5-0080", "v-n5-0132" ], "kana": "うみでおよぐこともできません。これはにほんごじゃありません。", "morae": 27 },
    { "ref": "s-14-1#L17", "ids": [ "v-n5-0242", "v-n5-0119", "v-n5-0548", "v-n5-0120", "v-n5-0276", "v-n5-0279" ], "kana": "ゆうがた、ケンがやまをみていいました。", "morae": 17 },
    { "ref": "s-14-1#L18", "ids": [ "v-n5-0548", "v-n5-0125", "v-n5-0683", "v-n5-0188", "v-n5-0121", "v-n5-0274" ], "kana": "「やまもいっしょにむこうにいっちゃったな。」", "morae": 17 },
    { "ref": "s-14-1#L19", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0126", "v-n5-0544", "v-n5-0119", "v-n5-0681", "v-n5-0285", "v-n5-0689" ], "kana": "わたしはケンのはなしがぜんぶわかりました。だいたい。", "morae": 24 },
    { "ref": "s-14-2#L0", "ids": [ "v-n5-0276", "v-n5-0119", "v-n5-0182", "v-n5-0121", "v-n5-0272" ], "kana": "ケン、みて。ふじさんがひだりにある。", "morae": 15 },
    { "ref": "s-14-2#L1", "ids": [ "v-n5-0702", "v-n5-0688", "v-n5-0182", "v-n5-0424", "v-n5-0119", "v-n5-0722", "v-n5-0130" ], "kana": "ああ、ほんとうにひだりだ。みちがまがったからな。", "morae": 21 },
    { "ref": "s-14-2#L2", "ids": [ "v-n5-0050", "v-n5-0600", "v-n5-0126", "v-n5-0587", "v-n5-0281" ], "kana": "ケン、あのいしのじ、よめる？", "morae": 11 },
    { "ref": "s-14-2#L3", "ids": [ "v-n5-0682", "v-n5-0355", "v-n5-0587" ], "kana": "ぜんぜん。ふるいじだ。", "morae": 9 },
    { "ref": "s-14-2#L4", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0182", "v-n5-0119", "v-n5-0281" ], "kana": "わたしは「ひだり」がよめる。", "morae": 11 },
    { "ref": "s-14-2#L5", "ids": [ "v-n5-0695", "v-n5-0513", "v-n5-0118" ], "kana": "じゃ、メニューは？", "morae": 5 },
    { "ref": "s-14-2#L6", "ids": [ "v-n5-0513", "v-n5-0118", "v-n5-0681", "v-n5-0281", "v-n5-0693", "v-n5-0157", "v-n5-0125", "v-n5-0279" ], "kana": "メニューはぜんぶよめる。それから、じかんもいえる。", "morae": 21 },
    { "ref": "s-14-2#L7", "ids": [ "v-n5-0136", "v-n5-0175" ], "kana": "いま、なんじ？", "morae": 5 },
    { "ref": "s-14-2#L8", "ids": [ "v-n5-0154", "v-n5-0155" ], "kana": "さんじにじゅっぷん。", "morae": 8 },
    { "ref": "s-14-2#L13", "ids": [ "v-n5-0695", "v-n5-0802", "v-n5-0121", "v-n5-0323" ], "kana": "じゃ、アヤちゃんにならって。", "morae": 10 },
    { "ref": "s-14-2#L14", "ids": [ "v-n5-0136", "v-n5-0130" ], "kana": "いまから？", "morae": 4 },
    { "ref": "s-14-2#L15", "ids": [ "v-n5-0136", "v-n5-0130", "v-n5-0276", "v-n5-0548", "v-n5-0125", "v-n5-0683", "v-n5-0188", "v-n5-0121", "v-n5-0274" ], "kana": "いまから。みて、やまもいっしょにむこうにいっちゃったな。", "morae": 23 },
    { "ref": "s-14-2#L16", "ids": [ "v-n5-0136", "v-n5-0126", "v-n5-0681", "v-n5-0285" ], "kana": "いまの、ぜんぶわかった。", "morae": 10 },
    { "ref": "s-14-2#L17", "ids": [ "v-n5-0681" ], "kana": "ぜんぶ？", "morae": 3 },
    { "ref": "s-14-2#L18", "ids": [ "v-n5-0689" ], "kana": "だいたい。", "morae": 4 },
    { "ref": "s-14-3#L0", "ids": [ "v-n5-0083", "v-n5-0084", "v-n5-0123" ], "kana": "おとうさん、おかあさんへ。", "morae": 11 },
    { "ref": "s-14-3#L1", "ids": [ "v-n5-0388", "v-n5-0132", "v-n5-0127", "v-n5-0118", "v-n5-0358" ], "kana": "げんきですか。よこはまはあついですか。", "morae": 17 },
    { "ref": "s-14-3#L2", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0136", "v-n5-0121", "v-n5-0273", "v-n5-0126", "v-n5-0425", "v-n5-0132" ], "kana": "わたしたちはいま、よしわらにいます。ふじさんのまちです。", "morae": 25 },
    { "ref": "s-14-3#L3", "ids": [ "v-n5-0051", "v-n5-0696", "v-n5-0119", "v-n5-0424", "v-n5-0126", "v-n5-0182", "v-n5-0121", "v-n5-0272" ], "kana": "ここではふじさんがみちのひだりにあります。", "morae": 20 },
    { "ref": "s-14-3#L4", "ids": [ "v-n5-0136", "v-n5-0131", "v-n5-0118", "v-n5-0678", "v-n5-0183", "v-n5-0135", "v-n5-0674", "v-n5-0364", "v-n5-0132" ], "kana": "いままではいつもみぎでした。すこしおもしろいです。", "morae": 23 },
    { "ref": "s-14-3#L5", "ids": [ "v-n5-0612", "v-n5-0126", "v-n5-0623", "v-n5-0118", "v-n5-0132" ], "kana": "はがきのえはひだりふじです。", "morae": 13 },
    { "ref": "s-14-3#L7", "ids": [ "v-n5-0351", "v-n5-0167", "v-n5-0397", "v-n5-0132" ], "kana": "ちいさくて、しろくて、きれいです。", "morae": 14 },
    { "ref": "s-14-3#L9", "ids": [ "v-n5-0136", "v-n5-0041", "v-n5-0118", "v-n5-0513", "v-n5-0119", "v-n5-0281" ], "kana": "いま、わたしはメニューがよめます。", "morae": 14 },
    { "ref": "s-14-3#L10", "ids": [ "v-n5-0157", "v-n5-0125", "v-n5-0279", "v-n5-0692", "v-n5-0320", "v-n5-0118", "v-n5-0677", "g-n5-078" ], "kana": "じかんもいえます。でも、およぐことはまだできません。", "morae": 23 },
    { "ref": "s-14-3#L11", "ids": [ "v-n5-0118", "v-n5-0388", "v-n5-0132", "v-n5-0140", "v-n5-0056", "v-n5-0127", "v-n5-0126", "v-n5-0229", "v-n5-0122", "v-n5-0438", "v-n5-0120", "v-n5-0271", "v-n5-0273" ], "kana": "ケンはげんきです。まいにち、どこかのだいどころでりょうりをしています。", "morae": 31 },
    { "ref": "s-14-3#L12", "ids": [ "v-n5-0138", "v-n5-0118", "v-n5-0131", "v-n5-0301", "g-n5-083", "v-n5-0132" ], "kana": "あしたはかんばらまであるくつもりです。", "morae": 18 },
    { "ref": "s-14-3#L13", "ids": [ "v-n5-0686", "v-n5-0543" ], "kana": "またでんわします。", "morae": 8 },
    { "ref": "s-14-3#L14", "ids": [ "v-n5-0218", "v-n5-0211" ], "kana": "しちがつじゅうくにち、ハナより。", "morae": 13 },
    { "ref": "s-14-4#L1", "ids": [ "v-n5-0802", "v-n5-0686", "v-n5-0291", "v-n5-0128", "v-n5-0084", "v-n5-0118" ], "kana": "アヤちゃん。またあったね。おかあさんは？", "morae": 16 },
    { "ref": "s-14-4#L2", "ids": [ "v-n5-0419", "v-n5-0126", "v-n5-0150", "v-n5-0122", "v-n5-0485", "v-n5-0120", "v-n5-0284", "v-n5-0090", "v-n5-0118" ], "kana": "えきのなかできっぷをかってる。おねえさんは？", "morae": 20 },
    { "ref": "s-14-4#L3", "ids": [ "v-n5-0120", "v-n5-0290", "v-n5-0126", "v-n5-0154", "v-n5-0121", "v-n5-0051", "v-n5-0275" ], "kana": "ケンをまってるの。ごじにここにくる。", "morae": 16 },
    { "ref": "s-14-4#L4", "ids": [ "v-n5-0276", "v-n5-0051", "v-n5-0125", "v-n5-0119", "v-n5-0182", "v-n5-0121", "v-n5-0272", "v-n5-0129" ], "kana": "みて。ここもふじさんがひだりにあるよ。", "morae": 17 },
    { "ref": "s-14-4#L5", "ids": [ "v-n5-0128", "v-n5-0600", "v-n5-0126", "v-n5-0498", "v-n5-0125", "v-n5-0182" ], "kana": "そうだね。いしのところもひだりだったね。", "morae": 18 },
    { "ref": "s-14-4#L7", "ids": [ "v-n5-0320", "v-n5-0682", "v-n5-0549", "v-n5-0118", "v-n5-0392" ], "kana": "およげない。ぜんぜんおよげない。うみはすき。", "morae": 19 },
    { "ref": "s-14-4#L8", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0320", "v-n5-0129", "v-n5-0126", "v-n5-0119", "v-n5-0393" ], "kana": "え、わたしはおよげるよ。およぐのがだいすき。", "morae": 19 },
    { "ref": "s-14-4#L9", "ids": [ "v-n5-0356", "v-n5-0802", "v-n5-0118", "v-n5-0056", "v-n5-0122", "v-n5-0320", "v-n5-0126" ], "kana": "いいな。アヤちゃんはどこでおよいだの？", "morae": 16 },
    { "ref": "s-14-4#L10", "ids": [ "v-n5-0048", "v-n5-0152", "v-n5-0084", "v-n5-0124", "v-n5-0549", "v-n5-0121", "v-n5-0274" ], "kana": "このまえ、おかあさんとうみにいった。", "morae": 16 },
    { "ref": "s-14-4#L11", "ids": [ "v-n5-0549", "v-n5-0127", "v-n5-0356", "v-n5-0128", "v-n5-0802", "v-n5-0118", "v-n5-0587", "v-n5-0125", "v-n5-0281" ], "kana": "うみか、いいね。アヤちゃんは、じもよめる？", "morae": 16 },
    { "ref": "s-14-4#L12", "ids": [ "v-n5-0078", "v-n5-0118", "v-n5-0681", "v-n5-0281", "v-n5-0047" ], "kana": "ひらがなはぜんぶよめる。あれ、よめる？", "morae": 16 },
    { "ref": "s-14-4#L13", "ids": [ "v-n5-0419", "v-n5-0126", "v-n5-0587", "v-n5-0700", "v-n5-0045", "v-n5-0118", "v-n5-0281" ], "kana": "えきのじ？ええと、「よしわら」。これはよめる。", "morae": 17 },
    { "ref": "s-14-4#L15", "ids": [ "v-n5-0692", "v-n5-0365", "v-n5-0587", "v-n5-0118", "v-n5-0677", "v-n5-0672", "v-n5-0281" ], "kana": "でも、むずかしいじはまだあまりよめない。", "morae": 18 },
    { "ref": "s-14-4#L17", "ids": [ "v-n5-0467", "v-n5-0688", "v-n5-0342", "v-n5-0356", "v-n5-0126" ], "kana": "え、おかし？ほんとうにもらっていいの？", "morae": 16 },
    { "ref": "s-14-4#L19", "ids": [ "v-n5-0011", "v-n5-0695", "v-n5-0041", "v-n5-0125", "v-n5-0001", "v-n5-0126", "v-n5-0480" ], "kana": "ありがとう。じゃ、わたしも。はい、はこねのあめ。", "morae": 18 },
    { "ref": "s-14-4#L20", "ids": [ "v-n5-0011", "v-n5-0041", "v-n5-0480", "v-n5-0119", "v-n5-0393" ], "kana": "ありがとう！わたし、あめがだいすき！", "morae": 15 },
    { "ref": "s-14-4#L23", "ids": [ "v-n5-0686", "v-n5-0128", "v-n5-0090", "v-n5-0320", "v-n5-0705" ], "kana": "またね！おねえさん、およぐれんしゅうしてね！", "morae": 18 },
    { "ref": "s-14-5#L1", "ids": [ "v-n5-0136", "v-n5-0431", "v-n5-0121", "v-n5-0273", "v-n5-0419", "v-n5-0126", "v-n5-0185" ], "kana": "いま、ゆうびんきょくにいる。えきのちかくの。", "morae": 18 },
    { "ref": "s-14-5#L2", "ids": [ "v-n5-0431", "v-n5-0066", "v-n5-0119", "v-n5-0673", "v-n5-0730" ], "kana": "ゆうびんきょく、ひとがたくさんならんでた。", "morae": 18 },
    { "ref": "s-14-5#L3", "ids": [ "v-n5-0612", "v-n5-0120", "v-n5-0113", "v-n5-0284", "v-n5-0613", "v-n5-0125" ], "kana": "はがきをさんまいかった。きってもかった。", "morae": 18 },
    { "ref": "s-14-5#L4", "ids": [ "v-n5-0612", "v-n5-0118", "v-n5-0681", "v-n5-0126", "v-n5-0623", "v-n5-0397", "v-n5-0129" ], "kana": "はがきはぜんぶふじさんのえ。きれいだよ。", "morae": 18 },
    { "ref": "s-14-5#L5", "ids": [ "v-n5-0113", "v-n5-0118", "v-n5-0146", "v-n5-0121", "v-n5-0329", "v-n5-0084" ], "kana": "いちまいはうちにおくる。おかあさんに。", "morae": 17 },
    { "ref": "s-14-5#L6", "ids": [ "v-n5-0113", "v-n5-0118", "v-n5-0152", "v-n5-0126", "v-n5-0417", "v-n5-0121", "v-n5-0329" ], "kana": "いちまいはまえのみせにおくる。よこはまの。", "morae": 19 },
    { "ref": "s-14-5#L7", "ids": [ "v-n5-0676", "v-n5-0113", "v-n5-0118", "v-n5-0121", "v-n5-0341", "v-n5-0055", "v-n5-0127", "v-n5-0282" ], "kana": "もういちまいは、ハナにあげる。だれかにかいて。", "morae": 20 },
    { "ref": "s-14-5#L8", "ids": [ "v-n5-0587", "v-n5-0119", "v-n5-0396", "v-n5-0122", "v-n5-0351", "v-n5-0682", "v-n5-0282" ], "kana": "じがへたで、ちいさいじがぜんぜんかけない。", "morae": 19 },
    { "ref": "s-14-5#L9", "ids": [ "v-n5-0697", "v-n5-0146", "v-n5-0126", "v-n5-0612", "v-n5-0118", "g-n5-070", "v-n5-0119", "v-n5-0282" ], "kana": "だから、うちのはがきは、あとでハナがかいて。", "morae": 19 },
    { "ref": "s-14-5#L10", "ids": [ "v-n5-0051", "v-n5-0130", "v-n5-0125", "v-n5-0119", "v-n5-0182", "v-n5-0121", "v-n5-0272", "v-n5-0129" ], "kana": "ここからもふじさんがひだりにあるよ。", "morae": 17 },
    { "ref": "s-14-5#L11", "ids": [ "v-n5-0137", "v-n5-0118", "v-n5-0141", "v-n5-0130", "v-n5-0397", "v-n5-0735" ], "kana": "きょうはあさからきれいにはれてる。", "morae": 15 },
    { "ref": "s-14-5#L12", "ids": [ "v-n5-0436", "v-n5-0125", "v-n5-0113", "v-n5-0726", "g-n5-070", "v-n5-0336" ], "kana": "しゃしんもいちまいとった。あとでみせる。", "morae": 17 },
    { "ref": "s-14-5#L13", "ids": [ "v-n5-0136", "v-n5-0154", "v-n5-0155", "v-n5-0676", "v-n5-0674", "v-n5-0122", "v-n5-0328" ], "kana": "いま、よじじゅっぷん。もうすこしでおわる。", "morae": 17 },
    { "ref": "s-14-5#L14", "ids": [ "v-n5-0154", "v-n5-0121", "v-n5-0126", "v-n5-0419", "v-n5-0122", "v-n5-0291" ], "kana": "ごじによしわらのえきであえる？", "morae": 14 },
    { "ref": "s-14-5#L15", "ids": [ "v-n5-0419", "v-n5-0126", "v-n5-0152", "v-n5-0350", "v-n5-0568", "v-n5-0498", "v-n5-0122", "v-n5-0290" ], "kana": "えきのまえのおおきいきのところでまってる。", "morae": 20 },
    { "ref": "s-14-5#L16", "ids": [ "v-n5-0441", "v-n5-0419", "v-n5-0126", "v-n5-0185", "v-n5-0417", "v-n5-0122", "v-n5-0277" ], "kana": "ばんごはん、えきのちかくのみせでたべない？", "morae": 19 },
    { "ref": "s-14-5#L17", "ids": [ "v-n5-0412", "v-n5-0119", "v-n5-0671", "v-n5-0379", "v-n5-0417", "v-n5-0272" ], "kana": "さかながとてもおいしいみせがある。", "morae": 16 },
    { "ref": "s-14-5#L18", "ids": [ "v-n5-0431", "v-n5-0126", "v-n5-0066", "v-n5-0121", "v-n5-0280", "v-n5-0419", "v-n5-0130", "v-n5-0155" ], "kana": "ゆうびんきょくのひとにきいた。えきからごふん。", "morae": 20 },
    { "ref": "s-14-5#L19", "ids": [ "v-n5-0126", "v-n5-0438", "v-n5-0118", "v-n5-0412" ], "kana": "よしわらのりょうりは、さかなだ。", "morae": 13 },
    { "ref": "s-14-5#L20", "ids": [ "v-n5-0717", "v-n5-0137", "v-n5-0118", "v-n5-0673", "v-n5-0301", "v-n5-0130" ], "kana": "ハナ、つかれた？きょうはたくさんあるいたから。", "morae": 19 },
    { "ref": "s-14-5#L21", "ids": [ "v-n5-0406", "v-n5-0278", "v-n5-0137", "v-n5-0118", "v-n5-0688", "v-n5-0358", "v-n5-0130" ], "kana": "みず、のんで。きょうはほんとうにあついから。", "morae": 18 },
    { "ref": "s-14-5#L22", "ids": [ "v-n5-0695", "v-n5-0154", "v-n5-0121", "v-n5-0419", "v-n5-0122", "v-n5-0711", "v-n5-0290", "v-n5-0129" ], "kana": "じゃ、ごじにえきで。へんじ、まってるよ。", "morae": 15 },
    { "ref": "s-14-5#L23", "ids": [ "v-n5-0695", "v-n5-0128", "v-n5-0676", "v-n5-0729", "v-n5-0129" ], "kana": "じゃあね。もうきるよ。", "morae": 8 },
    { "ref": "g-n5-017#ex3", "ids": [ "g-n5-017", "v-n5-0202", "v-n5-0118", "v-n5-0703", "v-n5-0271" ], "kana": "せんしゅうはべんきょうしませんでした。", "morae": 16 },
    { "ref": "g-n5-018#ex2", "ids": [ "g-n5-018", "v-n5-0118", "v-n5-0436", "v-n5-0120", "v-n5-0726" ], "kana": "ハナさんはしゃしんをとりました。", "morae": 14 },
    { "ref": "g-n5-019#ex0", "ids": [ "g-n5-019", "v-n5-0432", "v-n5-0122", "v-n5-0703", "v-n5-0271" ], "kana": "としょかんでべんきょうします。", "morae": 12 },
    { "ref": "g-n5-022#ex3", "ids": [ "g-n5-022", "v-n5-0124", "v-n5-0433", "v-n5-0122", "v-n5-0704", "v-n5-0120", "v-n5-0271" ], "kana": "たなかさんとこうえんでさんぽをしました。", "morae": 19 },
    { "ref": "g-n5-023#ex4", "ids": [ "g-n5-023", "v-n5-0118", "v-n5-0238", "v-n5-0122", "v-n5-0436", "v-n5-0120", "v-n5-0726" ], "kana": "ハナさんはカメラでしゃしんをとりました。", "morae": 18 },
    { "ref": "g-n5-027#ex0", "ids": [ "g-n5-027", "v-n5-0048", "v-n5-0425", "v-n5-0118", "v-n5-0672", "v-n5-0386", "v-n5-0132" ], "kana": "このまちはあまりしずかじゃないです。", "morae": 16 },
    { "ref": "g-n5-028#ex2", "ids": [ "g-n5-028", "v-n5-0041", "v-n5-0118", "v-n5-0672", "v-n5-0409", "v-n5-0120", "v-n5-0278" ], "kana": "わたしはあまりコーヒーをのみません。", "morae": 17 },
    { "ref": "g-n5-039#ex0", "ids": [ "g-n5-039", "v-n5-0419", "v-n5-0131", "v-n5-0683", "v-n5-0301" ], "kana": "えきまでいっしょにあるきましょう。", "morae": 14 },
    { "ref": "g-n5-039#ex2", "ids": [ "g-n5-039", "v-n5-0201", "v-n5-0686", "v-n5-0291" ], "kana": "らいしゅう、またあいましょう。", "morae": 11 },
    { "ref": "g-n5-040#ex0", "ids": [ "g-n5-040", "v-n5-0683", "v-n5-0440", "v-n5-0120", "v-n5-0277" ], "kana": "いっしょにひるごはんをたべませんか。", "morae": 16 },
    { "ref": "g-n5-049#ex1", "ids": [ "g-n5-049", "v-n5-0118", "v-n5-0708", "v-n5-0271", "v-n5-0273" ], "kana": "たなかさんはけっこんしています。", "morae": 15 },
    { "ref": "g-n5-053#ex2", "ids": [ "g-n5-053", "v-n5-0436", "v-n5-0120", "v-n5-0726", "v-n5-0127" ], "kana": "しゃしんをとりましょうか。", "morae": 10 },
    { "ref": "g-n5-053#ex3", "ids": [ "g-n5-053", "v-n5-0516", "v-n5-0120", "v-n5-0731", "v-n5-0127" ], "kana": "タクシーをよびましょうか。", "morae": 11 },
    { "ref": "g-n5-053#ex4", "ids": [ "g-n5-053", "v-n5-0419", "v-n5-0131", "v-n5-0683", "v-n5-0274", "v-n5-0127" ], "kana": "えきまでいっしょにいきましょうか。", "morae": 14 },
    { "ref": "g-n5-055#ex2", "ids": [ "g-n5-055", "v-n5-0051", "v-n5-0122", "v-n5-0436", "v-n5-0120", "v-n5-0726" ], "kana": "ここでしゃしんをとってはいけません。", "morae": 16 },
    { "ref": "g-n5-056#ex2", "ids": [ "g-n5-056", "v-n5-0681", "v-n5-0277", "v-n5-0125", "v-n5-0356", "v-n5-0132" ], "kana": "ぜんぶたべなくてもいいです。", "morae": 13 },
    { "ref": "g-n5-059#ex3", "ids": [ "g-n5-059", "v-n5-0575", "v-n5-0120", "v-n5-0278", "v-n5-0692", "v-n5-0558", "v-n5-0119", "v-n5-0562", "v-n5-0132" ], "kana": "くすりをのみました。でも、あたまがいたいです。", "morae": 20 },
    { "ref": "g-n5-063#ex4", "ids": [ "g-n5-063", "v-n5-0198", "v-n5-0118", "v-n5-0682", "v-n5-0703", "v-n5-0271" ], "kana": "にちようびはぜんぜんべんきょうしない。", "morae": 17 },
    { "ref": "g-n5-065#ex0", "ids": [ "g-n5-065", "v-n5-0139", "v-n5-0118", "v-n5-0682", "v-n5-0289" ], "kana": "きのうはぜんぜんねなかった。", "morae": 13 },
    { "ref": "g-n5-067#ex0", "ids": [ "g-n5-067", "v-n5-0118", "v-n5-0686", "v-n5-0275", "v-n5-0124", "v-n5-0279" ], "kana": "たなかさんは「またきます」といいました。", "morae": 17 },
    { "ref": "g-n5-069#ex2", "ids": [ "g-n5-069", "v-n5-0434", "v-n5-0123", "v-n5-0275", "g-n5-033", "v-n5-0080", "v-n5-0120", "v-n5-0703", "v-n5-0271" ], "kana": "にほんへくるまえににほんごをべんきょうしました。", "morae": 22 },
    { "ref": "g-n5-072#ex0", "ids": [ "g-n5-072", "v-n5-0555", "v-n5-0120", "v-n5-0280", "v-n5-0373", "v-n5-0703", "v-n5-0271" ], "kana": "おんがくをききながらべんきょうします。", "morae": 17 },
    { "ref": "g-n5-072#ex3", "ids": [ "g-n5-072", "v-n5-0118", "v-n5-0724", "v-n5-0373", "v-n5-0438", "v-n5-0120", "v-n5-0271" ], "kana": "ケンはうたいながらりょうりをします。", "morae": 16 },
    { "ref": "g-n5-077#ex0", "ids": [ "g-n5-077", "v-n5-0041", "v-n5-0118", "v-n5-0674", "v-n5-0080", "v-n5-0119", "v-n5-0283" ], "kana": "わたしはすこしにほんごがはなせます。", "morae": 17 },
    { "ref": "g-n5-077#ex2", "ids": [ "g-n5-077", "v-n5-0141", "v-n5-0369", "v-n5-0288", "v-n5-0127" ], "kana": "あさはやくおきられますか。", "morae": 12 },
    { "ref": "g-n5-077#ex3", "ids": [ "g-n5-077", "v-n5-0138", "v-n5-0118", "v-n5-0275" ], "kana": "あしたはこられません。", "morae": 10 },
    { "ref": "g-n5-077#ex4", "ids": [ "g-n5-077", "v-n5-0118", "v-n5-0320" ], "kana": "ケンはおよげません。", "morae": 9 },
    { "ref": "g-n5-078#ex0", "ids": [ "g-n5-078", "v-n5-0051", "v-n5-0122", "v-n5-0485", "v-n5-0120", "v-n5-0284" ], "kana": "ここできっぷをかうことができます。", "morae": 16 },
    { "ref": "g-n5-078#ex1", "ids": [ "g-n5-078", "v-n5-0041", "v-n5-0118", "v-n5-0320", "v-n5-0119", "v-n5-0122", "v-n5-0275" ], "kana": "わたしはおよぐことができません。", "morae": 15 },
    { "ref": "g-n5-078#ex2", "ids": [ "g-n5-078", "v-n5-0118", "v-n5-0557", "v-n5-0120", "v-n5-0283" ], "kana": "たなかさんはえいごをはなすことができます。", "morae": 20 },
    { "ref": "g-n5-078#ex3", "ids": [ "g-n5-078", "v-n5-0048", "v-n5-0432", "v-n5-0696", "v-n5-0099", "v-n5-0120", "v-n5-0345" ], "kana": "このとしょかんではほんをかりることができます。", "morae": 21 },
    { "ref": "g-n5-079#ex0", "ids": [ "g-n5-079", "v-n5-0041", "v-n5-0118", "v-n5-0082", "v-n5-0121", "v-n5-0551", "v-n5-0120", "v-n5-0341" ], "kana": "わたしはははにはなをあげました。", "morae": 15 },
    { "ref": "g-n5-079#ex3", "ids": [ "g-n5-079", "v-n5-0228", "v-n5-0551", "v-n5-0121", "v-n5-0406", "v-n5-0120", "v-n5-0341" ], "kana": "まいあさはなにみずをあげます。", "morae": 14 },
    { "ref": "g-n5-080#ex0", "ids": [ "g-n5-080", "v-n5-0041", "v-n5-0118", "v-n5-0070", "v-n5-0121", "v-n5-0099", "v-n5-0120", "v-n5-0342" ], "kana": "わたしはともだちにほんをもらいました。", "morae": 18 },
    { "ref": "g-n5-080#ex2", "ids": [ "g-n5-080", "v-n5-0118", "v-n5-0427", "v-n5-0130", "v-n5-0581", "v-n5-0120", "v-n5-0342" ], "kana": "ケンはかいしゃからてがみをもらいました。", "morae": 18 },
    { "ref": "g-n5-081#ex0", "ids": [ "g-n5-081", "v-n5-0070", "v-n5-0119", "v-n5-0041", "v-n5-0121", "v-n5-0099", "v-n5-0120", "v-n5-0343" ], "kana": "ともだちがわたしにほんをくれました。", "morae": 17 },
    { "ref": "g-n5-081#ex1", "ids": [ "g-n5-081", "v-n5-0118", "v-n5-0088", "v-n5-0121", "v-n5-0467", "v-n5-0120", "v-n5-0343" ], "kana": "たなかさんはいもうとにおかしをくれました。", "morae": 20 },
