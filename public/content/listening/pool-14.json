    { "ref": "v-n5-0698#ex1", "ids": [ "v-n5-0698", "v-n5-0137", "v-n5-0118", "v-n5-0051", "v-n5-0131", "v-n5-0132" ], "kana": "それでは、きょうはここまでです。", "morae": 13 },
    { "ref": "v-n5-0699#ex0", "ids": [ "v-n5-0699", "v-n5-0419", "v-n5-0118", "v-n5-0056", "v-n5-0132", "v-n5-0127" ], "kana": "あのう、えきはどこですか。", "morae": 11 },
    { "ref": "v-n5-0699#ex1", "ids": [ "v-n5-0699", "v-n5-0051", "v-n5-0121", "v-n5-0300", "v-n5-0125", "v-n5-0356", "v-n5-0132", "v-n5-0127" ], "kana": "あのう、ここにすわってもいいですか。", "morae": 16 },
    { "ref": "v-n5-0700#ex0", "ids": [ "v-n5-0700", "v-n5-0154", "g-n5-015", "v-n5-0121", "v-n5-0274" ], "kana": "ええと、さんじごろにいきます。", "morae": 13 },
    { "ref": "v-n5-0700#ex1", "ids": [ "v-n5-0700", "v-n5-0541", "v-n5-0118", "v-n5-0054" ], "kana": "ええと、なまえはなんだったかな。", "morae": 14 },
    { "ref": "v-n5-0701#ex0", "ids": [ "v-n5-0701", "v-n5-0277" ], "kana": "さあ、たべましょう。", "morae": 7 },
    { "ref": "v-n5-0701#ex1", "ids": [ "v-n5-0701", "v-n5-0285", "v-n5-0121", "v-n5-0280" ], "kana": "さあ、わからない。たなかさんにきいて。", "morae": 16 },
    { "ref": "v-n5-0702#ex0", "ids": [ "v-n5-0702", "v-n5-0285", "v-n5-0011" ], "kana": "ああ、わかった。ありがとう。", "morae": 11 },
    { "ref": "v-n5-0702#ex1", "ids": [ "v-n5-0702", "v-n5-0132", "v-n5-0127", "v-n5-0020" ], "kana": "ああ、たなかさんですか。おげんきですか。", "morae": 17 },
    { "ref": "v-n5-0703#ex0", "ids": [ "v-n5-0703", "v-n5-0140", "v-n5-0032", "v-n5-0157", "v-n5-0080", "v-n5-0120", "v-n5-0271" ], "kana": "まいにちにじかんにほんごをべんきょうします。", "morae": 20 },
    { "ref": "v-n5-0703#ex1", "ids": [ "v-n5-0703", "v-n5-0088", "v-n5-0118", "v-n5-0136", "v-n5-0557", "v-n5-0126", "v-n5-0120", "v-n5-0271", "v-n5-0273" ], "kana": "いもうとはいまえいごのべんきょうをしています。", "morae": 21 },
    { "ref": "v-n5-0704#ex0", "ids": [ "v-n5-0704", "v-n5-0141", "v-n5-0552", "v-n5-0124", "v-n5-0271" ], "kana": "あさ、いぬとさんぽした。", "morae": 10 },
    { "ref": "v-n5-0704#ex1", "ids": [ "v-n5-0704", "v-n5-0242", "v-n5-0433", "v-n5-0120", "v-n5-0271", "v-n5-0127" ], "kana": "ゆうがた、こうえんをさんぽしませんか。", "morae": 17 },
    { "ref": "v-n5-0705#ex0", "ids": [ "v-n5-0705", "v-n5-0232", "v-n5-0624", "v-n5-0120", "v-n5-0271", "v-n5-0273" ], "kana": "まいばんギターをれんしゅうしています。", "morae": 17 },
    { "ref": "v-n5-0705#ex1", "ids": [ "v-n5-0705", "v-n5-0667", "v-n5-0126", "g-n5-033", "v-n5-0673", "v-n5-0271" ], "kana": "しあいのまえにたくさんれんしゅうしました。", "morae": 19 },
    { "ref": "v-n5-0706#ex0", "ids": [ "v-n5-0706", "v-n5-0198", "v-n5-0121", "v-n5-0147", "v-n5-0120", "v-n5-0271" ], "kana": "にちようびにへやをそうじします。", "morae": 15 },
    { "ref": "v-n5-0706#ex1", "ids": [ "v-n5-0706", "v-n5-0082", "v-n5-0119", "v-n5-0229", "v-n5-0120", "v-n5-0271" ], "kana": "ははがだいどころをそうじした。", "morae": 14 },
    { "ref": "v-n5-0707#ex0", "ids": [ "v-n5-0707", "v-n5-0137", "v-n5-0118", "v-n5-0547", "v-n5-0119", "v-n5-0356", "v-n5-0130", "v-n5-0271" ], "kana": "きょうはてんきがいいから、せんたくする。", "morae": 17 },
    { "ref": "v-n5-0707#ex1", "ids": [ "v-n5-0707", "v-n5-0139", "v-n5-0120", "v-n5-0271", "v-n5-0127" ], "kana": "きのう、せんたくをしましたか。", "morae": 13 },
    { "ref": "v-n5-0708#ex0", "ids": [ "v-n5-0708", "v-n5-0086", "v-n5-0118", "v-n5-0205", "v-n5-0271" ], "kana": "あねはらいねんけっこんします。", "morae": 14 },
    { "ref": "v-n5-0708#ex1", "ids": [ "v-n5-0708", "v-n5-0096", "v-n5-0118", "v-n5-0206", "v-n5-0271" ], "kana": "ふたりはきょねんけっこんしました。", "morae": 15 },
    { "ref": "v-n5-0709#ex0", "ids": [ "v-n5-0709", "v-n5-0199", "v-n5-0121", "v-n5-0106", "v-n5-0271", "v-n5-0273" ], "kana": "しゅうにさんかいうんどうしています。", "morae": 16 },
    { "ref": "v-n5-0709#ex1", "ids": [ "v-n5-0709", "v-n5-0271", "g-n5-070", "v-n5-0406", "v-n5-0120", "v-n5-0673", "v-n5-0278" ], "kana": "うんどうしたあとで、みずをたくさんのんだ。", "morae": 19 },
    { "ref": "v-n5-0710#ex0", "ids": [ "v-n5-0710", "v-n5-0068", "v-n5-0119", "v-n5-0556", "v-n5-0126", "v-n5-0586", "v-n5-0120", "v-n5-0271" ], "kana": "せんせいがことばのいみをせつめいした。", "morae": 18 },
    { "ref": "v-n5-0710#ex1", "ids": [ "v-n5-0710", "v-n5-0437", "v-n5-0122", "v-n5-0424", "v-n5-0120", "v-n5-0271", "v-n5-0127" ], "kana": "ちずでみちをせつめいしましょうか。", "morae": 15 },
    { "ref": "v-n5-0711#ex0", "ids": [ "v-n5-0711", "v-n5-0581", "v-n5-0126", "v-n5-0120", "v-n5-0282" ], "kana": "てがみのへんじをかきました。", "morae": 13 },
    { "ref": "v-n5-0711#ex1", "ids": [ "v-n5-0711", "v-n5-0130", "v-n5-0119", "v-n5-0677", "v-n5-0272" ], "kana": "ケンからへんじがまだありません。", "morae": 15 },
    { "ref": "v-n5-0712#ex1", "ids": [ "v-n5-0712", "v-n5-0445", "v-n5-0126", "v-n5-0118", "v-n5-0139", "v-n5-0328" ], "kana": "りょこうのじゅんびはきのうおわりました。", "morae": 17 },
    { "ref": "v-n5-0713#ex0", "ids": [ "v-n5-0713", "v-n5-0425", "v-n5-0120", "v-n5-0271", "v-n5-0127" ], "kana": "まちをあんないしましょうか。", "morae": 12 },
    { "ref": "v-n5-0713#ex1", "ids": [ "v-n5-0713", "v-n5-0119", "v-n5-0419", "v-n5-0126", "v-n5-0150", "v-n5-0120", "v-n5-0271", "v-n5-0343" ], "kana": "たなかさんがえきのなかをあんないしてくれた。", "morae": 21 },
    { "ref": "v-n5-0714#ex0", "ids": [ "v-n5-0714", "v-n5-0070", "v-n5-0120", "v-n5-0271" ], "kana": "ともだちをしょうかいします。", "morae": 12 },
    { "ref": "v-n5-0714#ex1", "ids": [ "v-n5-0714", "v-n5-0068", "v-n5-0118", "v-n5-0354", "v-n5-0069", "v-n5-0120", "v-n5-0271" ], "kana": "せんせいはあたらしいがくせいをしょうかいしました。", "morae": 23 },
    { "ref": "v-n5-0715#ex0", "ids": [ "v-n5-0715", "v-n5-0403", "v-n5-0271", "v-n5-0122" ], "kana": "だいじょうぶ、しんぱいしないで。", "morae": 13 },
    { "ref": "v-n5-0715#ex1", "ids": [ "v-n5-0715", "v-n5-0138", "v-n5-0126", "v-n5-0547", "v-n5-0119", "v-n5-0132" ], "kana": "あしたのてんきがしんぱいです。", "morae": 14 },
    { "ref": "v-n5-0716#ex0", "ids": [ "v-n5-0716", "v-n5-0081", "v-n5-0118", "v-n5-0422", "v-n5-0126", "v-n5-0119", "v-n5-0395", "v-n5-0132" ], "kana": "ちちはくるまのうんてんがじょうずです。", "morae": 17 },
    { "ref": "v-n5-0716#ex1", "ids": [ "v-n5-0716", "v-n5-0139", "v-n5-0690", "v-n5-0422", "v-n5-0120", "v-n5-0271" ], "kana": "きのう、はじめてくるまをうんてんした。", "morae": 17 },
    { "ref": "v-n5-0717#ex0", "ids": [ "v-n5-0717", "v-n5-0137", "v-n5-0118", "v-n5-0542", "v-n5-0122" ], "kana": "きょうはしごとでつかれた。", "morae": 11 },
    { "ref": "v-n5-0717#ex1", "ids": [ "v-n5-0717", "v-n5-0651", "v-n5-0118", "v-n5-0119", "v-n5-0363", "v-n5-0132" ], "kana": "やまのぼりはつかれますが、たのしいです。", "morae": 18 },
    { "ref": "v-n5-0718#ex1", "ids": [ "v-n5-0718", "v-n5-0173", "v-n5-0119", "v-n5-0273" ], "kana": "かぎがなくて、こまっています。", "morae": 13 },
    { "ref": "v-n5-0719#ex1", "ids": [ "v-n5-0719", "v-n5-0147", "v-n5-0119", "v-n5-0358", "v-n5-0132", "v-n5-0130", "v-n5-0245", "v-n5-0120" ], "kana": "へやがあついですから、ストーブをけしました。", "morae": 20 },
    { "ref": "v-n5-0720#ex1", "ids": [ "v-n5-0720", "v-n5-0614", "v-n5-0120", "v-n5-0555", "v-n5-0280" ], "kana": "ラジオをつけて、おんがくをききます。", "morae": 16 },
    { "ref": "v-n5-0721#ex1", "ids": [ "v-n5-0721", "v-n5-0165", "v-n5-0511", "v-n5-0122", "v-n5-0422", "v-n5-0119" ], "kana": "あかいしんごうでくるまがとまった。", "morae": 16 },
    { "ref": "v-n5-0722#ex0", "ids": [ "v-n5-0722", "v-n5-0050", "v-n5-0510", "v-n5-0120", "v-n5-0183", "v-n5-0121", "g-n5-051" ], "kana": "あのかどをみぎにまがってください。", "morae": 16 },
    { "ref": "v-n5-0722#ex1", "ids": [ "v-n5-0722", "v-n5-0431", "v-n5-0126", "v-n5-0152", "v-n5-0122", "v-n5-0182", "v-n5-0121" ], "kana": "ゆうびんきょくのまえでひだりにまがりました。", "morae": 20 },
    { "ref": "v-n5-0723#ex0", "ids": [ "v-n5-0723", "v-n5-0511", "v-n5-0122", "v-n5-0424", "v-n5-0120" ], "kana": "しんごうでみちをわたります。", "morae": 13 },
    { "ref": "v-n5-0723#ex1", "ids": [ "v-n5-0723", "v-n5-0507", "v-n5-0120", "v-n5-0425", "v-n5-0121", "v-n5-0292" ], "kana": "はしをわたって、まちにはいった。", "morae": 14 },
    { "ref": "v-n5-0724#ex0", "ids": [ "v-n5-0724", "v-n5-0070", "v-n5-0124", "v-n5-0683", "v-n5-0618", "v-n5-0120" ], "kana": "ともだちといっしょにうたをうたった。", "morae": 16 },
    { "ref": "v-n5-0724#ex1", "ids": [ "v-n5-0724", "v-n5-0088", "v-n5-0118", "v-n5-0618", "v-n5-0120", "v-n5-0126", "v-n5-0119", "v-n5-0392", "v-n5-0132" ], "kana": "いもうとはうたをうたうのがすきです。", "morae": 17 },
    { "ref": "v-n5-0725#ex1", "ids": [ "v-n5-0725", "v-n5-0548", "v-n5-0126", "v-n5-0397", "v-n5-0652", "v-n5-0120" ], "kana": "やまのきれいなくうきをすいました。", "morae": 16 },
    { "ref": "v-n5-0726#ex0", "ids": [ "v-n5-0726", "v-n5-0051", "v-n5-0122", "v-n5-0436", "v-n5-0120", "v-n5-0125", "v-n5-0356", "v-n5-0132", "v-n5-0127" ], "kana": "ここでしゃしんをとってもいいですか。", "morae": 16 },
    { "ref": "v-n5-0726#ex1", "ids": [ "v-n5-0726", "v-n5-0653", "v-n5-0126", "v-n5-0436", "v-n5-0120", "v-n5-0673" ], "kana": "さくらのしゃしんをたくさんとった。", "morae": 15 },
    { "ref": "v-n5-0727#ex0", "ids": [ "v-n5-0727", "v-n5-0048", "v-n5-0179", "v-n5-0118", "v-n5-0306" ], "kana": "このドアはひいてあけます。", "morae": 12 },
    { "ref": "v-n5-0727#ex1", "ids": [ "v-n5-0727", "v-n5-0576", "v-n5-0120", "v-n5-0427", "v-n5-0318" ], "kana": "かぜをひいて、かいしゃをやすみました。", "morae": 16 },
    { "ref": "v-n5-0728#ex1", "ids": [ "v-n5-0728", "v-n5-0179", "v-n5-0120", "v-n5-0119", "v-n5-0308" ], "kana": "ドアをおしたが、あかなかった。", "morae": 13 },
    { "ref": "v-n5-0729#ex0", "ids": [ "v-n5-0729", "v-n5-0414", "v-n5-0120", "v-n5-0351" ], "kana": "やさいをちいさくきります。", "morae": 12 },
    { "ref": "v-n5-0729#ex1", "ids": [ "v-n5-0729", "v-n5-0481", "v-n5-0120", "v-n5-0111", "v-n5-0121" ], "kana": "ケーキをむっつにきりました。", "morae": 13 },
    { "ref": "v-n5-0730#ex0", "ids": [ "v-n5-0730", "v-n5-0417", "v-n5-0126", "g-n5-033", "v-n5-0066", "v-n5-0119", "v-n5-0673", "v-n5-0273" ], "kana": "みせのまえにひとがたくさんならんでいる。", "morae": 19 },
    { "ref": "v-n5-0730#ex1", "ids": [ "v-n5-0730", "v-n5-0155", "v-n5-0527", "v-n5-0120", "v-n5-0277" ], "kana": "さんじゅっぷんならんで、ラーメンをたべました。", "morae": 20 },
    { "ref": "v-n5-0731#ex0", "ids": [ "v-n5-0731", "v-n5-0516", "v-n5-0120", "v-n5-0127" ], "kana": "タクシーをよびましょうか。", "morae": 11 },
    { "ref": "v-n5-0731#ex1", "ids": [ "v-n5-0731", "v-n5-0068", "v-n5-0119", "v-n5-0041", "v-n5-0126", "v-n5-0541", "v-n5-0120" ], "kana": "せんせいがわたしのなまえをよびました。", "morae": 18 },
    { "ref": "v-n5-0732#ex0", "ids": [ "v-n5-0732", "v-n5-0137", "v-n5-0118", "v-n5-0380", "v-n5-0567", "v-n5-0119", "v-n5-0273" ], "kana": "きょうはつよいかぜがふいています。", "morae": 15 },
    { "ref": "v-n5-0732#ex1", "ids": [ "v-n5-0732", "v-n5-0602", "v-n5-0122", "v-n5-0361", "v-n5-0567", "v-n5-0119", "v-n5-0273" ], "kana": "かいがんでつめたいかぜがふいていた。", "morae": 17 },
    { "ref": "v-n5-0733#ex0", "ids": [ "v-n5-0733", "v-n5-0141", "v-n5-0569", "v-n5-0119", "v-n5-0273" ], "kana": "あさ、とりがないていた。", "morae": 10 },
    { "ref": "v-n5-0733#ex1", "ids": [ "v-n5-0733", "v-n5-0119", "v-n5-0230", "v-n5-0122", "v-n5-0273" ], "kana": "アオがげんかんでないています。", "morae": 14 },
    { "ref": "v-n5-0734#ex0", "ids": [ "v-n5-0734", "v-n5-0599", "v-n5-0126", "v-n5-0551", "v-n5-0119" ], "kana": "にわのはながさきました。", "morae": 11 },
    { "ref": "v-n5-0734#ex1", "ids": [ "v-n5-0734", "v-n5-0433", "v-n5-0126", "v-n5-0653", "v-n5-0118", "v-n5-0677", "v-n5-0273" ], "kana": "こうえんのさくらはまださいていません。", "morae": 18 },
    { "ref": "v-n5-0735#ex0", "ids": [ "v-n5-0735", "v-n5-0138", "v-n5-0118", "v-n5-0132" ], "kana": "あしたははれるでしょう。", "morae": 10 },
    { "ref": "v-n5-0735#ex1", "ids": [ "v-n5-0735", "v-n5-0139", "v-n5-0118", "v-n5-0680", "v-n5-0273" ], "kana": "きのうはよくはれていた。", "morae": 11 },
    { "ref": "v-n5-0736#ex0", "ids": [ "v-n5-0736", "v-n5-0565", "v-n5-0119", "v-n5-0273", "v-n5-0550" ], "kana": "そらがくもっている。あめかな。", "morae": 13 },
    { "ref": "v-n5-0736#ex1", "ids": [ "v-n5-0736", "v-n5-0137", "v-n5-0118", "v-n5-0141", "v-n5-0130", "v-n5-0273" ], "kana": "きょうはあさからくもっています。", "morae": 14 },
    { "ref": "v-n5-0737#ex0", "ids": [ "v-n5-0737", "v-n5-0354", "v-n5-0120", "v-n5-0284" ], "kana": "あたらしいパソコンをかいました。", "morae": 15 },
    { "ref": "v-n5-0737#ex1", "ids": [ "v-n5-0737", "v-n5-0140", "v-n5-0122", "v-n5-0542", "v-n5-0120", "v-n5-0271", "v-n5-0273" ], "kana": "まいにちパソコンでしごとをしています。", "morae": 18 },
    { "ref": "v-n5-0738#ex0", "ids": [ "v-n5-0738", "v-n5-0228", "v-n5-0583", "v-n5-0122", "v-n5-0120", "v-n5-0276" ], "kana": "まいあさテレビでニュースをみます。", "morae": 15 },
    { "ref": "v-n5-0738#ex1", "ids": [ "v-n5-0738", "v-n5-0236", "v-n5-0126", "v-n5-0118", "v-n5-0676", "v-n5-0280" ], "kana": "けさのニュースはもうきいた？", "morae": 12 },
    { "ref": "v-n5-0802#ex0", "ids": [ "v-n5-0802", "v-n5-0088", "v-n5-0118", "v-n5-0119", "v-n5-0393" ], "kana": "いもうとはアオちゃんがだいすきだ。", "morae": 15 },
    { "ref": "v-n5-0802#ex1", "ids": [ "v-n5-0802", "v-n5-0137", "v-n5-0118", "v-n5-0054", "v-n5-0120", "v-n5-0277" ], "kana": "ハナちゃん、きょうはなにをたべる？", "morae": 13 }
  ]
}
