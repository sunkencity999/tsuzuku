{
  "schema": "tsuzuku.pool/1",
  "station": 10,
  "refs": [
    { "ref": "s-01-2#L12", "ids": [ "v-n5-0480" ], "kana": "あめです。", "morae": 4 },
    { "ref": "s-02-3#L1", "ids": [ "v-n5-0485", "v-n5-0051" ], "kana": "きっぷは、ここです。", "morae": 8 },
    { "ref": "s-03-1#L11", "ids": [ "v-n5-0481", "v-n5-0015" ], "kana": "ケーキ、いただきます。", "morae": 9 },
    { "ref": "s-03-1#L12", "ids": [ "v-n5-0016", "v-n5-0481" ], "kana": "ごちそうさまでした。よこはまは、ケーキ。", "morae": 17 },
    { "ref": "s-03-2#L3", "ids": [ "v-n5-0481", "v-n5-0060" ], "kana": "ケーキも、どうですか。", "morae": 9 },
    { "ref": "s-03-2#L4", "ids": [ "v-n5-0001", "v-n5-0481", "v-n5-0019" ], "kana": "はい、ケーキもおねがいします。", "morae": 13 },
    { "ref": "s-03-2#L5", "ids": [ "v-n5-0481", "v-n5-0062" ], "kana": "ケーキは、いくつですか。", "morae": 10 },
    { "ref": "s-03-2#L7", "ids": [ "v-n5-0041", "v-n5-0481" ], "kana": "わたしも、ケーキを。", "morae": 8 },
    { "ref": "s-03-2#L9", "ids": [ "v-n5-0046", "v-n5-0468" ], "kana": "それと、ジュースを。", "morae": 7 },
    { "ref": "s-03-2#L10", "ids": [ "v-n5-0468", "v-n5-0045", "v-n5-0046", "v-n5-0047" ], "kana": "ジュースは、これと、それと、あれです。", "morae": 14 },
    { "ref": "s-03-3#L2", "ids": [ "v-n5-0032", "v-n5-0462" ], "kana": "に、ミルク、さんびゃく。", "morae": 8 },
    { "ref": "s-03-3#L3", "ids": [ "v-n5-0033", "v-n5-0468" ], "kana": "さん、ジュース、よんひゃく。", "morae": 9 },
    { "ref": "s-03-3#L4", "ids": [ "v-n5-0034", "v-n5-0481" ], "kana": "よん、ケーキ、ごひゃく。", "morae": 8 },
    { "ref": "s-03-3#L8", "ids": [ "v-n5-0462" ], "kana": "アオは、ミルク？", "morae": 6 },
    { "ref": "s-03-3#L13", "ids": [ "v-n5-0481", "v-n5-0016" ], "kana": "ケーキ、ごちそうさまでした。", "morae": 12 },
    { "ref": "s-08-4#L5", "ids": [ "v-n5-0441", "v-n5-0118", "v-n5-0154", "v-n5-0132", "v-n5-0128", "v-n5-0001", "v-n5-0285" ], "kana": "ばんごはんはしちじですね。はい、わかりました。", "morae": 20 },
    { "ref": "s-10-1#L0", "ids": [ "v-n5-0218", "v-n5-0211", "v-n5-0439", "v-n5-0118", "v-n5-0154", "v-n5-0156", "v-n5-0135", "v-n5-0369", "v-n5-0132" ], "kana": "しちがつとおか。あさごはんはろくじはんでした。はやいです。", "morae": 26 },
    { "ref": "s-10-1#L1", "ids": [ "v-n5-0130", "v-n5-0126", "v-n5-0424", "v-n5-0120", "v-n5-0339", "v-n5-0218", "v-n5-0132", "v-n5-0119", "v-n5-0359" ], "kana": "おだわらからはこねのみちをのぼりました。しちがつですが、さむかったです。", "morae": 33 },
    { "ref": "s-10-1#L2", "ids": [ "v-n5-0148", "v-n5-0125", "v-n5-0149", "v-n5-0167", "v-n5-0152", "v-n5-0126", "v-n5-0163", "v-n5-0150", "v-n5-0135" ], "kana": "うえもしたもしろくて、まえのケンもしろのなかでした。", "morae": 24 },
    { "ref": "s-10-1#L3", "ids": [ "v-n5-0159", "v-n5-0154", "v-n5-0121", "v-n5-0305", "v-n5-0118", "v-n5-0152", "v-n5-0272" ], "kana": "ごごいちじにはこねせきしょにつきました。あしノこはまえにあります。", "morae": 30 },
    { "ref": "s-10-1#L4", "ids": [ "v-n5-0125", "v-n5-0163", "v-n5-0126", "v-n5-0150", "v-n5-0132" ], "kana": "でも、あしノこもふじさんもしろのなかです。", "morae": 19 },
    { "ref": "s-10-1#L5", "ids": [ "v-n5-0499", "v-n5-0121", "v-n5-0259", "v-n5-0126", "v-n5-0066", "v-n5-0119", "v-n5-0299", "v-n5-0273", "v-n5-0132" ], "kana": "いりぐちにきもののひとがたっていました。さとうさんです。", "morae": 26 },
    { "ref": "s-10-1#L6", "ids": [ "v-n5-0485", "v-n5-0120", "v-n5-0336", "g-n5-051", "v-n5-0124", "v-n5-0119", "v-n5-0279" ], "kana": "「きっぷをみせてください。」とさとうさんがいいました。", "morae": 23 },
    { "ref": "s-10-1#L7", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0485", "v-n5-0120", "v-n5-0113", "v-n5-0349", "v-n5-0276", "v-n5-0346" ], "kana": "わたしはきっぷをにまいわたしました。さとうさんはみて、かえしました。", "morae": 31 },
    { "ref": "s-10-1#L8", "ids": [ "v-n5-0359", "v-n5-0132", "v-n5-0128", "v-n5-0497", "v-n5-0126", "v-n5-0150", "v-n5-0118", "v-n5-0385", "v-n5-0129", "v-n5-0398", "v-n5-0066" ], "kana": "「さむいですね。たてもののなかはあたたかいですよ。」しんせつなひとです。", "morae": 31 },
    { "ref": "s-10-1#L9", "ids": [ "v-n5-0150", "v-n5-0118", "v-n5-0066", "v-n5-0119", "v-n5-0371", "v-n5-0387", "v-n5-0135", "v-n5-0093", "v-n5-0168", "v-n5-0413", "v-n5-0120", "v-n5-0277", "v-n5-0273" ], "kana": "なかはひとがおおくて、にぎやかでした。おとこのこがくろいたまごをたべていました。", "morae": 37 },
    { "ref": "s-10-1#L10", "ids": [ "v-n5-0126", "v-n5-0168", "v-n5-0413", "v-n5-0118", "v-n5-0391", "v-n5-0132", "v-n5-0041", "v-n5-0125", "v-n5-0111", "v-n5-0277", "v-n5-0449", "v-n5-0122" ], "kana": "はこねのくろいたまごはゆうめいです。わたしもひとつたべました。しおでたべます。", "morae": 36 },
    { "ref": "s-10-1#L14", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0233", "v-n5-0126", "v-n5-0151", "v-n5-0122", "v-n5-0048", "v-n5-0100", "v-n5-0120", "v-n5-0282", "v-n5-0273" ], "kana": "わたしはおふろのそとで、このノートをかいています。", "morae": 23 },
    { "ref": "s-10-1#L15", "ids": [ "v-n5-0178", "v-n5-0126", "v-n5-0151", "v-n5-0120", "v-n5-0167", "v-n5-0119", "v-n5-0268", "v-n5-0130", "v-n5-0267", "v-n5-0123", "v-n5-0301", "v-n5-0273" ], "kana": "まどのそとを、しろいのがにしからひがしへあるいています。", "morae": 26 },
    { "ref": "s-10-1#L17", "ids": [ "v-n5-0118", "v-n5-0122", "v-n5-0279", "v-n5-0138", "v-n5-0126", "v-n5-0141", "v-n5-0293", "v-n5-0129" ], "kana": "たなかさんはおだわらでいいました。「あしたのあさはでますよ。」", "morae": 27 },
    { "ref": "s-10-1#L18", "ids": [ "v-n5-0060", "v-n5-0132", "v-n5-0127", "v-n5-0041", "v-n5-0118", "v-n5-0178", "v-n5-0126", "v-n5-0152", "v-n5-0122", "v-n5-0290", "v-n5-0273" ], "kana": "どうでしょうか。わたしはまどのまえでまっています。", "morae": 22 },
    { "ref": "s-10-2#L0", "ids": [ "v-n5-0360", "v-n5-0356", "v-n5-0233" ], "kana": "あつかった。いいおふろだった。", "morae": 13 },
    { "ref": "s-10-2#L1", "ids": [ "v-n5-0373", "v-n5-0128", "v-n5-0155" ], "kana": "ながかったね。よんじゅっぷん。", "morae": 12 },
    { "ref": "s-10-2#L4", "ids": [ "v-n5-0130", "v-n5-0100", "v-n5-0336" ], "kana": "はこねだから。ノート、みせて。", "morae": 12 },
    { "ref": "s-10-2#L5", "ids": [ "v-n5-0290", "v-n5-0136", "v-n5-0282" ], "kana": "まって。いま、かいてる。", "morae": 9 },
    { "ref": "s-10-2#L6", "ids": [ "v-n5-0054", "v-n5-0282", "v-n5-0126" ], "kana": "なにかいてるの？", "morae": 7 },
    { "ref": "s-10-2#L7", "ids": [ "v-n5-0130", "v-n5-0282" ], "kana": "ケン。「はこねだから」ってかいた。", "morae": 13 },
    { "ref": "s-10-2#L8", "ids": [ "v-n5-0054", "v-n5-0046" ], "kana": "なにそれ。", "morae": 4 },
    { "ref": "s-10-2#L9", "ids": [ "v-n5-0137", "v-n5-0130", "v-n5-0126", "v-n5-0080", "v-n5-0125", "v-n5-0100", "v-n5-0121", "v-n5-0310" ], "kana": "きょうから、ケンのにほんごもノートにいれる。", "morae": 19 },
    { "ref": "s-10-2#L10", "ids": [ "v-n5-0364", "v-n5-0129", "v-n5-0441", "v-n5-0175" ], "kana": "おもしろくないよ。ばんごはん、なんじ？", "morae": 16 },
    { "ref": "s-10-2#L11", "ids": [ "v-n5-0154", "v-n5-0156", "v-n5-0129" ], "kana": "しちじはんだよ。", "morae": 7 },
    { "ref": "s-10-2#L12", "ids": [ "v-n5-0370", "v-n5-0136", "v-n5-0168", "v-n5-0413", "v-n5-0277", "v-n5-0449" ], "kana": "おそい。いま、くろいたまご、たべてる。しお、ない？", "morae": 19 },
    { "ref": "s-10-2#L13", "ids": [ "v-n5-0126", "v-n5-0239", "v-n5-0121", "v-n5-0272", "v-n5-0129" ], "kana": "ない。ケンのにもつにあるよ。", "morae": 12 },
    { "ref": "s-10-2#L14", "ids": [ "v-n5-0147", "v-n5-0368" ], "kana": "へや、とおい。", "morae": 5 },
    { "ref": "s-10-2#L15", "ids": [ "v-n5-0496", "v-n5-0129", "v-n5-0302", "v-n5-0128" ], "kana": "にかいだよ。はしらないでね。", "morae": 12 },
    { "ref": "s-10-2#L16", "ids": [ "v-n5-0292" ], "kana": "はいはい。", "morae": 4 },
    { "ref": "s-10-2#L17", "ids": [ "v-n5-0138", "v-n5-0293" ], "kana": "あした、ふじさん、でるかな。", "morae": 11 },
    { "ref": "s-10-2#L18", "ids": [ "v-n5-0118", "v-n5-0293", "v-n5-0279" ], "kana": "たなかさんは「でる」っていってた。", "morae": 14 },
    { "ref": "s-10-3#L0", "ids": [ "v-n5-0126", "v-n5-0495", "v-n5-0123" ], "kana": "はこねせきしょのおきゃくさんへ。", "morae": 13 },
    { "ref": "s-10-3#L1", "ids": [ "v-n5-0485", "v-n5-0118", "v-n5-0499", "v-n5-0122", "v-n5-0284", "g-n5-051" ], "kana": "きっぷはいりぐちでかってください。", "morae": 16 },
    { "ref": "s-10-3#L2", "ids": [ "v-n5-0485", "v-n5-0118", "v-n5-0115", "v-n5-0132", "v-n5-0071" ], "kana": "きっぷはごひゃくえんです。こどもはにひゃくごじゅうえんです。", "morae": 25 },
    { "ref": "s-10-3#L3", "ids": [ "v-n5-0350", "v-n5-0239", "v-n5-0118", "v-n5-0499", "v-n5-0126", "v-n5-0186", "v-n5-0121", "v-n5-0298", "g-n5-051" ], "kana": "おおきいにもつは、いりぐちのよこにおいてください。", "morae": 23 },
    { "ref": "s-10-3#L4", "ids": [ "v-n5-0073", "v-n5-0051", "v-n5-0122", "v-n5-0290", "g-n5-051", "v-n5-0095", "v-n5-0292" ], "kana": "みなさん、ここでまってください。ひとりずつはいってください。", "morae": 27 },
    { "ref": "s-10-3#L5", "ids": [ "v-n5-0259", "v-n5-0126", "v-n5-0066", "v-n5-0121", "v-n5-0485", "v-n5-0120", "v-n5-0336", "g-n5-051" ], "kana": "きもののひとにきっぷをみせてください。", "morae": 18 },
    { "ref": "s-10-3#L6", "ids": [ "v-n5-0497", "v-n5-0126", "v-n5-0150", "v-n5-0302", "g-n5-051" ], "kana": "たてもののなかでは、はしらないでください。", "morae": 19 },
    { "ref": "s-10-3#L7", "ids": [ "v-n5-0497", "v-n5-0126", "v-n5-0150", "v-n5-0118", "v-n5-0355", "v-n5-0132", "v-n5-0386", "v-n5-0276", "g-n5-051" ], "kana": "たてもののなかはふるいです。しずかにみてください。", "morae": 23 },
    { "ref": "s-10-3#L8", "ids": [ "v-n5-0442", "v-n5-0124", "v-n5-0443", "v-n5-0118", "v-n5-0151", "v-n5-0122", "v-n5-0019" ], "kana": "たべものとのみものは、そとでおねがいします。", "morae": 20 },
    { "ref": "s-10-3#L10", "ids": [ "v-n5-0500", "v-n5-0118", "v-n5-0497", "v-n5-0126", "v-n5-0153", "v-n5-0132" ], "kana": "でぐちはたてもののうしろです。", "morae": 14 },
    { "ref": "s-10-3#L11", "ids": [ "v-n5-0118", "v-n5-0225", "v-n5-0125", "v-n5-0359", "v-n5-0132", "v-n5-0258", "v-n5-0120", "v-n5-0296", "v-n5-0275", "g-n5-051" ], "kana": "はこねはなつもさむいです。うわぎをもってきてください。", "morae": 25 },
    { "ref": "s-10-3#L12", "ids": [ "v-n5-0073", "v-n5-0363", "v-n5-0445", "v-n5-0120" ], "kana": "みなさん、たのしいりょこうを。", "morae": 12 },
    { "ref": "s-10-3#L13", "ids": [], "kana": "はこねせきしょより。", "morae": 8 },
    { "ref": "s-10-4#L2", "ids": [ "v-n5-0001", "v-n5-0045", "v-n5-0132", "v-n5-0096", "v-n5-0122", "v-n5-0113" ], "kana": "はい、これです。ふたりでいちまいです。", "morae": 16 },
    { "ref": "s-10-4#L3", "ids": [ "v-n5-0111", "v-n5-0272", "v-n5-0128", "v-n5-0137", "v-n5-0118", "v-n5-0056", "v-n5-0130", "v-n5-0132", "v-n5-0127" ], "kana": "ここのつありますね。きょうはどこからですか。", "morae": 19 },
    { "ref": "s-10-4#L4", "ids": [ "v-n5-0130", "v-n5-0132", "v-n5-0141", "v-n5-0154", "v-n5-0121", "v-n5-0293" ], "kana": "おだわらからです。あさしちじにでました。", "morae": 18 },
    { "ref": "s-10-4#L5", "ids": [ "v-n5-0126", "v-n5-0424", "v-n5-0120", "v-n5-0301", "v-n5-0154", "v-n5-0121", "v-n5-0305" ], "kana": "はこねのみちをあるいて、いちじにつきました。", "morae": 20 },
    { "ref": "s-10-4#L6", "ids": [ "v-n5-0036", "v-n5-0157", "v-n5-0132", "v-n5-0127", "v-n5-0400", "v-n5-0135", "v-n5-0128" ], "kana": "ろくじかんですか。たいへんでしたね。", "morae": 16 },
    { "ref": "s-10-4#L7", "ids": [ "g-n5-028", "v-n5-0359", "v-n5-0424", "v-n5-0125", "v-n5-0167", "v-n5-0132" ], "kana": "とてもさむくて、みちもしろかったです。", "morae": 17 },
    { "ref": "s-10-4#L8", "ids": [ "v-n5-0003", "v-n5-0137", "v-n5-0118", "v-n5-0125", "v-n5-0293", "v-n5-0273", "v-n5-0128" ], "kana": "ええ。きょうはふじさんもでていませんね。", "morae": 17 },
    { "ref": "s-10-4#L10", "ids": [ "v-n5-0013", "v-n5-0102", "v-n5-0118", "v-n5-0272", "v-n5-0127" ], "kana": "すみません、ペンはありますか。", "morae": 13 },
    { "ref": "s-10-4#L11", "ids": [ "v-n5-0001", "v-n5-0048", "v-n5-0168", "v-n5-0102", "v-n5-0120", "v-n5-0295", "g-n5-051" ], "kana": "はい、このくろいペンをつかってください。", "morae": 18 },
    { "ref": "s-10-4#L12", "ids": [ "v-n5-0377", "v-n5-0132", "v-n5-0128", "v-n5-0239", "v-n5-0120", "v-n5-0296", "v-n5-0127" ], "kana": "おもいですね。にもつをもちましょうか。", "morae": 16 },
    { "ref": "s-10-4#L13", "ids": [ "v-n5-0010", "v-n5-0019" ], "kana": "ありがとうございます。おねがいします。", "morae": 17 },
    { "ref": "s-10-4#L14", "ids": [ "v-n5-0050", "v-n5-0066", "v-n5-0118", "v-n5-0054", "v-n5-0120", "v-n5-0271", "v-n5-0273", "v-n5-0127" ], "kana": "あのひとたちはなにをしていますか。", "morae": 16 },
    { "ref": "s-10-4#L16", "ids": [ "v-n5-0356", "v-n5-0132", "v-n5-0128", "v-n5-0041", "v-n5-0125", "v-n5-0259", "v-n5-0120", "v-n5-0305" ], "kana": "いいですね。わたしもきものをきたいです。", "morae": 18 },
    { "ref": "s-10-4#L17", "ids": [ "v-n5-0356", "v-n5-0132", "v-n5-0129", "v-n5-0151", "v-n5-0121", "v-n5-0259", "v-n5-0126", "v-n5-0417", "v-n5-0119", "v-n5-0272" ], "kana": "いいですよ。そとにきもののみせがあります。", "morae": 19 },
    { "ref": "s-10-4#L18", "ids": [ "v-n5-0282", "v-n5-0041", "v-n5-0118", "v-n5-0129" ], "kana": "ケン、かいて。わたしはかいたよ。", "morae": 13 },
    { "ref": "s-10-4#L19", "ids": [ "v-n5-0282", "v-n5-0045", "v-n5-0122", "v-n5-0356", "v-n5-0132", "v-n5-0127" ], "kana": "かきました。これでいいですか。", "morae": 13 },
    { "ref": "s-10-4#L21", "ids": [ "v-n5-0151", "v-n5-0118", "v-n5-0340", "v-n5-0273", "v-n5-0302", "g-n5-051" ], "kana": "そとはふっています。はしらないでください。", "morae": 19 },
    { "ref": "s-10-4#L22", "ids": [ "v-n5-0001", "v-n5-0258", "v-n5-0120", "v-n5-0313", "v-n5-0457", "v-n5-0123", "v-n5-0274" ], "kana": "はい。うわぎをきて、ホテルへいきます。", "morae": 16 },
    { "ref": "s-10-4#L23", "ids": [ "v-n5-0010" ], "kana": "さとうさん、ありがとうございます。", "morae": 15 },
    { "ref": "s-10-5#L1", "ids": [ "v-n5-0132", "v-n5-0018" ], "kana": "やまぐちです。よろしくおねがいします。", "morae": 17 },
    { "ref": "s-10-5#L2", "ids": [ "v-n5-0096", "v-n5-0118", "v-n5-0136", "v-n5-0121", "v-n5-0273", "v-n5-0127" ], "kana": "ふたりはいま、はこねせきしょにいますか。", "morae": 17 },
