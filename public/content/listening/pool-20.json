{
  "schema": "tsuzuku.pool/1",
  "station": 20,
  "refs": [
    { "ref": "s-12-1#L10", "ids": [ "v-n5-0137", "v-n5-0130", "v-n5-0048", "v-n4-0327", "v-n5-0126", "v-n5-0556", "v-n5-0120", "v-n5-0354", "v-n5-0271" ], "kana": "きょうから、このにっきのことばをあたらしくします。", "morae": 22 },
    { "ref": "s-12-1#L11", "ids": [ "v-n5-0048", "v-n4-0327", "v-n5-0118", "v-n5-0041", "v-n5-0119", "v-n5-0281", "g-n5-060", "v-n5-0132", "v-n5-0124", "v-n5-0133", "v-n5-0120", "v-n5-0282" ], "kana": "このにっきは、わたしだけがよむ。だから、「です」と「ます」をかかない。", "morae": 27 },
    { "ref": "s-12-1#L16", "ids": [ "v-n5-0132", "v-n5-0119", "v-n4-0327", "v-n5-0118", "v-n5-0374", "v-n5-0587", "v-n5-0372", "v-n5-0560", "v-n5-0380" ], "kana": "「です」がないにっきはみじかい。じはすくない。でも、きもちはつよい。", "morae": 28 },
    { "ref": "s-12-2#L16", "ids": [ "v-n5-0137", "v-n5-0126", "v-n5-0438", "v-n5-0118", "v-n5-0045", "v-n4-0327", "v-n5-0121", "v-n5-0282" ], "kana": "きょうのりょうりはこれだ。にっきにかく。", "morae": 16 },
    { "ref": "s-12-2#L17", "ids": [ "v-n5-0137", "v-n5-0126", "v-n4-0327", "v-n5-0132", "v-n5-0119", "v-n5-0128" ], "kana": "きょうのにっき、「です」がないね。", "morae": 12 },
    { "ref": "s-12-4#L17", "ids": [ "v-n4-0327", "v-n5-0336", "v-n5-0041", "v-n5-0126", "v-n5-0130" ], "kana": "にっき。みせない。わたしだけのだから。", "morae": 16 },
    { "ref": "s-13-1#L17", "ids": [ "v-n5-0143", "v-n4-0327", "v-n5-0121", "v-n5-0350", "v-n5-0282", "v-n5-0120", "v-n5-0276" ], "kana": "よる、にっきにおおきくかきました。「ふじさんをみた。」", "morae": 22 },
    { "ref": "s-14-1#L11", "ids": [ "v-n4-0327", "v-n5-0126", "v-n5-0153", "v-n5-0351", "v-n5-0398", "v-n5-0121", "v-n5-0111" ], "kana": "にっきのうしろのちいさなしんせつに、ひとつ。", "morae": 20 },
    { "ref": "s-14-1#L16", "ids": [ "v-n5-0569", "v-n5-0118", "v-n5-0136", "v-n4-0327", "v-n5-0126", "v-n5-0153", "v-n5-0121", "v-n5-0273" ], "kana": "とりはいま、にっきのうしろにいます。", "morae": 16 },
    { "ref": "s-20-1#L0", "ids": [ "v-n5-0219", "v-n5-0211", "v-n5-0596", "v-n5-0439", "v-n5-0118", "v-n5-0154", "v-n5-0135" ], "kana": "はちがつよっか、くもり。あさごはんはしちじでした。", "morae": 22 },
    { "ref": "s-20-1#L1", "ids": [ "v-n5-0154", "v-n5-0118", "v-n5-0674", "v-n5-0370", "v-n5-0132", "v-n5-0141", "v-n5-0130", "v-n5-0358", "v-n5-0652", "v-n5-0119", "v-n5-0377" ], "kana": "しちじはすこしおそいです。あさからあつくて、くうきがおもかったです。", "morae": 31 },
    { "ref": "s-20-1#L2", "ids": [ "v-n5-0126", "v-n5-0425", "v-n5-0120", "v-n5-0293", "v-n5-0723", "v-n5-0424", "v-n5-0118", "v-n5-0548", "v-n5-0187", "v-n5-0121", "v-n5-0292", "v-n5-0274" ], "kana": "しずおかのまちをでて、あべかわをわたりました。みちはやまのあいだにはいっていきます。", "morae": 39 },
    { "ref": "s-20-1#L3", "ids": [ "v-n5-0118", "v-n5-0126", "v-n5-0150", "v-n5-0122", "v-n5-0751", "v-n5-0351", "v-n5-0425", "v-n5-0022" ], "kana": "まりこは、とうかいどうのなかでいちばんちいさいまちだったそうです。", "morae": 31 },
    { "ref": "s-20-1#L4", "ids": [ "v-n5-0136", "v-n5-0125", "v-n5-0424", "v-n5-0118", "v-n5-0376", "v-n5-0183", "v-n5-0182", "v-n5-0684", "v-n5-0548", "v-n5-0132", "v-n5-0567", "v-n5-0119", "v-n5-0657", "v-n5-0721" ], "kana": "いまもみちはせまくて、みぎもひだりもすぐやまです。かぜがなくて、あせがとまりませんでした。", "morae": 41 },
    { "ref": "s-20-1#L5", "ids": [ "v-n5-0142", "v-n5-0118", "v-n5-0126", "v-n5-0417", "v-n5-0121", "v-n5-0292", "v-n5-0203", "v-n5-0152", "v-n5-0130", "v-n5-0272", "v-n5-0022" ], "kana": "ひるは、とろろじるのみせにはいりました。よんひゃくねんまえからあるみせだそうです。", "morae": 37 },
    { "ref": "s-20-1#L6", "ids": [ "v-n5-0355", "v-n5-0497", "v-n5-0122", "v-n5-0150", "v-n5-0118", "v-n5-0643", "v-n5-0563", "v-n5-0132", "v-n5-0657", "v-n5-0119", "v-n5-0684", "v-n5-0121", "v-n5-0727" ], "kana": "ふるいたてもので、なかはくらくて、すずしかったです。あせがすぐにひきました。", "morae": 34 },
    { "ref": "s-20-1#L9", "ids": [ "v-n5-0417", "v-n5-0126", "v-n5-0118", "v-n5-0545", "v-n5-0119", "v-n5-0680", "v-n4-0182", "g-n4-044", "v-n5-0120", "v-n5-0229", "v-n5-0121", "v-n5-0310", "v-n5-0343" ], "kana": "みせのあおきさんは、てがよくみえるように、ケンをだいどころにいれてくれました。", "morae": 36 },
    { "ref": "s-20-1#L11", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0178", "v-n5-0126", "v-n5-0498", "v-n5-0121", "v-n5-0300", "v-n4-0327", "v-n5-0120", "v-n5-0282" ], "kana": "わたしはまどのところにすわって、にっきをかきました。", "morae": 24 },
    { "ref": "s-20-1#L13", "ids": [ "v-n5-0513", "v-n5-0119", "v-n5-0281", "g-n4-044", "v-n5-0078", "g-n5-056", "v-n5-0689" ], "kana": "メニューがよめるようになりました。ひらがながなくても、だいたいよめます。", "morae": 32 },
    { "ref": "s-20-1#L15", "ids": [ "v-n5-0417", "v-n5-0122", "v-n5-0096", "v-n5-0126", "v-n5-0438", "v-n5-0120", "v-n5-0041", "v-n5-0095", "v-n4-0210", "g-n4-044" ], "kana": "みせで、ふたりのりょうりをわたしひとりでたのめるようになりました。", "morae": 30 },
    { "ref": "s-20-1#L16", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0054", "v-n5-0126", "v-n4-0206", "v-n5-0301", "v-n5-0273", "v-n5-0132", "v-n4-0327", "v-n5-0137", "v-n5-0046", "v-n5-0119", "v-n5-0680", "v-n5-0285" ], "kana": "わたしはなんのためにあるいているのでしょう。にっきのためにあるいています。きょう、それがよくわかりました。", "morae": 47 },
    { "ref": "s-20-1#L17", "ids": [ "v-n5-0143", "v-n5-0119", "v-n5-0041", "v-n5-0126", "v-n4-0327", "v-n5-0751", "v-n5-0153", "v-n5-0745", "v-n5-0121", "v-n5-0294", "v-n5-0120", "v-n5-0282" ], "kana": "よる、ケンがわたしのにっきのいちばんうしろのページに、とろろじるのつくりかたをかきました。", "morae": 42 },
    { "ref": "s-20-1#L18", "ids": [ "v-n5-0041", "v-n5-0121", "v-n5-0280", "v-n5-0282", "v-n5-0125", "v-n5-0054", "v-n5-0279" ], "kana": "わたしにきかないでかきました。わたしも、なにもいいませんでした。", "morae": 29 },
    { "ref": "s-20-1#L19", "ids": [ "v-n5-0048", "v-n4-0327", "v-n5-0122", "v-n5-0126", "v-n5-0587", "v-n5-0118", "v-n5-0690", "v-n5-0132", "v-n5-0351", "v-n5-0674", "v-n5-0722", "v-n5-0273" ], "kana": "このにっきで、ケンのじははじめてです。ちいさくて、すこしまがっています。", "morae": 32 },
    { "ref": "s-20-2#L0", "ids": [ "v-n5-0688", "v-n5-0323", "g-n4-046", "v-n5-0126" ], "kana": "ケン、ほんとうにならうことにしたの？", "morae": 16 },
    { "ref": "s-20-2#L2", "ids": [ "v-n5-0054", "v-n5-0126", "v-n4-0206" ], "kana": "なんのために？", "morae": 6 },
    { "ref": "s-20-2#L3", "ids": [ "v-n5-0765", "v-n4-0001", "v-n5-0126", "v-n5-0417", "v-n5-0122", "v-n5-0294", "g-n4-044" ], "kana": "いつか、じぶんのみせでつくれるように。", "morae": 17 },
    { "ref": "s-20-2#L4", "ids": [ "v-n5-0417", "v-n5-0056", "v-n5-0126" ], "kana": "みせって、どこのみせ？", "morae": 9 },
    { "ref": "s-20-2#L5", "ids": [ "v-n5-0765", "v-n5-0126", "v-n5-0417" ], "kana": "いつかのみせ。", "morae": 6 },
    { "ref": "s-20-2#L6", "ids": [ "v-n5-0054", "v-n5-0046" ], "kana": "なにそれ。", "morae": 4 },
    { "ref": "s-20-2#L8", "ids": [ "v-n5-0424", "v-n5-0122", "v-n5-0323", "v-n5-0438" ], "kana": "みちでならったりょうりって？", "morae": 12 },
    { "ref": "s-20-2#L9", "ids": [ "v-n5-0126", "v-n5-0351", "v-n5-0412", "v-n5-0051" ], "kana": "えのしまのちいさいさかな、えじりのさかな、ここのとろろじる。", "morae": 27 },
    { "ref": "s-20-2#L10", "ids": [ "v-n5-0681", "v-n5-0324", "v-n5-0126" ], "kana": "ぜんぶ、おぼえてるの？", "morae": 9 },
    { "ref": "s-20-2#L11", "ids": [ "v-n5-0558", "v-n5-0126", "v-n5-0150", "v-n5-0121", "v-n5-0282", "v-n5-0272" ], "kana": "あたまのなかにかいてある。", "morae": 12 },
    { "ref": "s-20-2#L12", "ids": [ "v-n5-0241", "v-n5-0121", "v-n5-0282", "g-n5-089", "v-n5-0129" ], "kana": "かみにかいたほうがいいよ。", "morae": 12 },
    { "ref": "s-20-2#L13", "ids": [ "v-n5-0695", "v-n5-0126", "v-n4-0327", "v-n5-0675", "v-n5-0344" ], "kana": "じゃ、ハナのにっき、ちょっとかして。", "morae": 13 },
    { "ref": "s-20-2#L14", "ids": [ "v-n4-0229", "v-n4-0327", "v-n5-0118", "v-n5-0344" ], "kana": "だめ。にっきはかさない。", "morae": 10 },
    { "ref": "s-20-2#L15", "ids": [ "v-n5-0695", "v-n5-0756" ], "kana": "じゃ、あとで。", "morae": 4 },
    { "ref": "s-20-2#L16", "ids": [ "v-n5-0545", "v-n5-0119", "v-n5-0721", "v-n5-0129" ], "kana": "ケンさん、てがとまってるよ。", "morae": 12 },
    { "ref": "s-20-2#L17", "ids": [ "v-n5-0001" ], "kana": "はい。", "morae": 2 },
    { "ref": "s-20-2#L18", "ids": [ "v-n5-0119", "v-n5-0001", "v-n5-0279", "v-n5-0690", "v-n5-0280" ], "kana": "ケンが「はい」っていった。はじめてきいた。", "morae": 17 },
    { "ref": "s-20-2#L19", "ids": [ "v-n5-0639", "v-n5-0276", "v-n4-0344" ], "kana": "うるさい。みてないで、てつだって。", "morae": 14 },
    { "ref": "s-20-3#L0", "ids": [ "v-n5-0126", "v-n5-0417", "v-n5-0513", "v-n5-0132" ], "kana": "まりこのとろろじるのみせのメニューです。", "morae": 18 },
    { "ref": "s-20-3#L2", "ids": [ "v-n5-0071", "v-n5-0126", "v-n5-0526", "v-n5-0115" ], "kana": "こどものとろろじるていしょく、はっぴゃくえん。", "morae": 19 },
    { "ref": "s-20-3#L4", "ids": [ "v-n5-0126", "v-n5-0277" ], "kana": "とろろじるのたべかた。", "morae": 10 },
    { "ref": "s-20-3#L6", "ids": [ "v-n5-0693", "v-n5-0120", "v-n5-0407", "v-n5-0126", "v-n5-0148", "v-n5-0121", "v-n5-0673", "v-n5-0331" ], "kana": "それから、とろろをごはんのうえにたくさんかけます。", "morae": 23 },
    { "ref": "s-20-3#L8", "ids": [ "v-n5-0407", "v-n5-0124", "v-n5-0683", "v-n5-0278", "g-n4-044", "v-n5-0277", "v-n4-0248" ], "kana": "ごはんといっしょに、のむようにたべてください。", "morae": 20 },
    { "ref": "s-20-3#L9", "ids": [ "v-n5-0571", "v-n5-0121", "v-n4-0162", "v-n4-0019", "g-n4-007", "v-n4-0248", "v-n4-0004", "v-n5-0022" ], "kana": "くちについても、きにしないでください。みんな、そうです。", "morae": 24 },
    { "ref": "s-20-3#L10", "ids": [ "v-n5-0118", "v-n5-0185", "v-n5-0126", "v-n5-0601", "v-n5-0122", "v-n4-0166", "v-n5-0273" ], "kana": "とろろは、ちかくのはたけでそだてています。", "morae": 19 },
    { "ref": "s-20-3#L11", "ids": [ "v-n5-0203", "v-n5-0152", "v-n5-0130", "v-n5-0294", "v-n5-0118", "v-n4-0136", "v-n5-0273" ], "kana": "よんひゃくねんまえから、つくりかたはかわっていません。", "morae": 24 },
    { "ref": "s-20-3#L12", "ids": [ "v-n4-0345", "v-n5-0118", "v-n5-0195", "v-n5-0132", "v-n5-0158", "v-n5-0154", "v-n5-0130", "v-n5-0159", "v-n5-0131" ], "kana": "きゅうじつはもくようびです。ごぜんじゅういちじからごごさんじまでです。", "morae": 31 },
    { "ref": "s-20-3#L13", "ids": [ "v-n5-0685", "v-n4-0251", "v-n4-0248" ], "kana": "ゆっくりめしあがってください。", "morae": 14 },
    { "ref": "s-20-4#L0", "ids": [ "v-n5-0417", "v-n5-0119", "v-n5-0386", "v-n5-0121", "v-n5-0806", "v-n5-0128" ], "kana": "ケンさん、ハナさん、みせがしずかになりましたね。", "morae": 21 },
    { "ref": "s-20-4#L1", "ids": [ "v-n5-0408", "v-n5-0120", "v-n5-0278", "v-n5-0373", "v-n5-0126", "v-n5-0544", "v-n5-0280", "v-n4-0248" ], "kana": "おちゃをのみながら、とろろじるのはなしをきいてください。", "morae": 25 },
    { "ref": "s-20-4#L2", "ids": [ "v-n5-0120", "v-n5-0301", "v-n5-0066", "v-n5-0118", "v-n4-0004", "v-n5-0048", "v-n5-0122", "v-n5-0318", "v-n5-0275" ], "kana": "とうかいどうをあるくひとは、みんなこのまりこでやすんできました。", "morae": 30 },
    { "ref": "s-20-4#L3", "ids": [ "v-n5-0717", "v-n5-0066", "v-n5-0119", "v-n5-0686", "v-n5-0301", "g-n4-044", "v-n5-0048", "v-n5-0417", "v-n5-0118", "v-n5-0120", "v-n5-0311", "v-n5-0275" ], "kana": "つかれたひとが、またあるけるように、このみせはとろろじるをだしてきました。", "morae": 34 },
    { "ref": "s-20-4#L7", "ids": [ "v-n5-0696", "v-n5-0294", "v-n5-0132", "v-n5-0118", "v-n5-0548", "v-n5-0126", "v-n5-0601", "v-n5-0122", "v-n5-0297", "v-n5-0373", "v-n5-0167", "v-n5-0414" ], "kana": "では、つくりかたです。とろろは、やまのはたけでとれる、ながくてしろいやさいです。", "morae": 35 },
    { "ref": "s-20-4#L8", "ids": [ "v-n5-0749", "v-n5-0120", "v-n5-0680", "v-n5-0312", "v-n4-0222", "v-n5-0271", "v-n5-0045", "v-n5-0119", "v-n5-0751", "v-n5-0400", "v-n5-0132" ], "kana": "まず、とろろをよくあらって、こまかくします。これがいちばんたいへんです。", "morae": 32 },
    { "ref": "s-20-4#L9", "ids": [ "v-n5-0545", "v-n5-0122", "v-n5-0373", "v-n5-0157", "v-n4-0169", "v-n5-0130", "v-n4-0064", "v-n5-0119", "v-n5-0717", "v-n5-0129" ], "kana": "てでながいじかんまわしますから、うでがつかれますよ。", "morae": 24 },
    { "ref": "s-20-4#L12", "ids": [ "v-n5-0045", "v-n5-0122", "v-n5-0167", "v-n4-0236", "v-n5-0119", "g-n5-078" ], "kana": "これで、しろくてやわらかいとろろじるができます。", "morae": 22 },
    { "ref": "s-20-4#L13", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0048", "v-n5-0417", "v-n5-0122", "v-n5-0203", "v-n5-0120", "v-n5-0294", "v-n5-0273" ], "kana": "わたしは、このみせでさんじゅうねん、とろろじるをつくっています。", "morae": 28 },
    { "ref": "s-20-4#L15", "ids": [ "v-n4-0015", "v-n5-0126", "v-n5-0084", "v-n5-0119", "v-n5-0228", "v-n5-0229", "v-n5-0122", "v-n5-0322", "v-n5-0343" ], "kana": "おっとのおかあさんが、まいあさだいどころでおしえてくれました。", "morae": 29 },
    { "ref": "s-20-4#L16", "ids": [ "v-n5-0323", "v-n5-0327", "v-n5-0203", "v-n5-0118", "v-n4-0064", "v-n5-0119", "v-n5-0562", "v-n5-0140", "v-n4-0161", "v-n5-0806" ], "kana": "ならいはじめたとしは、うでがいたくて、まいにちやめたくなりました。", "morae": 30 },
    { "ref": "s-20-4#L17", "ids": [ "v-n5-0692", "v-n5-0106", "v-n5-0294", "v-n5-0095", "v-n5-0122", "g-n4-044" ], "kana": "でも、ひゃっかいくらいつくって、ひとりでつくれるようになりました。", "morae": 29 },
    { "ref": "s-20-4#L18", "ids": [ "v-n5-0136", "v-n5-0118", "v-n5-0545", "v-n5-0119", "v-n5-0324", "v-n5-0273", "v-n4-0021", "v-n5-0294" ], "kana": "いまは、てがおぼえています。かんがえなくても、つくれます。", "morae": 25 },
    { "ref": "s-20-4#L19", "ids": [ "v-n5-0354", "v-n5-0294", "v-n5-0120", "v-n4-0021", "v-n5-0356", "v-n5-0124", "v-n5-0279", "v-n5-0125", "v-n5-0272" ], "kana": "あたらしいつくりかたをかんがえたらいいと、いわれたこともあります。", "morae": 31 },
    { "ref": "s-20-4#L20", "ids": [ "v-n5-0692", "v-n5-0041", "v-n5-0118", "v-n5-0355", "v-n5-0294", "v-n5-0120", "v-n4-0135", "g-n4-046" ], "kana": "でも、わたしは、ふるいつくりかたをかえないことにしました。", "morae": 26 },
    { "ref": "s-20-4#L21", "ids": [ "v-n5-0203", "v-n5-0152", "v-n5-0126", "v-n5-0066", "v-n5-0124", "v-n5-0803", "v-n5-0120", "v-n5-0277", "v-n5-0424", "v-n5-0301" ], "kana": "よんひゃくねんまえのひととおなじとろろじるをたべて、おなじみちをあるく。", "morae": 33 },
    { "ref": "s-20-4#L22", "ids": [ "v-n5-0046", "v-n5-0119", "v-n5-0356", "v-n5-0124", "v-n5-0801", "v-n5-0137", "v-n5-0125", "v-n5-0141", "v-n5-0154", "v-n5-0130", "v-n5-0294", "v-n5-0273" ], "kana": "それがいいとおもって、きょうもあさごじからつくっています。", "morae": 26 },
    { "ref": "s-20-4#L23", "ids": [ "v-n4-0064", "v-n5-0119", "v-n5-0717", "v-n5-0131", "v-n5-0705", "v-n4-0248", "v-n5-0128" ], "kana": "ケンさん、うでがつかれるまでれんしゅうしてくださいね。", "morae": 24 },
    { "ref": "s-20-5#L0", "ids": [ "v-n5-0073", "v-n5-0189", "v-n5-0118", "v-n5-0126", "v-n5-0421", "v-n5-0713", "v-n5-0132" ], "kana": "みなさん、こちらはまりこのバスのあんないです。", "morae": 21 },
    { "ref": "s-20-5#L1", "ids": [ "v-n5-0421", "v-n5-0118", "v-n5-0126", "v-n5-0417", "v-n5-0152", "v-n5-0121", "v-n5-0721" ], "kana": "バスは、とろろじるのみせのまえにとまります。", "morae": 20 },
    { "ref": "s-20-5#L3", "ids": [ "v-n5-0419", "v-n5-0131", "v-n5-0118", "v-n5-0155", "v-n5-0132" ], "kana": "しずおかえきまでは、さんじゅっぷんぐらいです。", "morae": 20 },
    { "ref": "s-20-5#L4", "ids": [ "v-n5-0421", "v-n5-0118", "v-n5-0155", "v-n5-0121", "v-n5-0114", "v-n5-0154", "v-n5-0124", "v-n4-0138" ], "kana": "バスはよんじゅっぷんにいっぽん、ごじ、ごじよんじゅっぷんとつづきます。", "morae": 30 },
    { "ref": "s-20-5#L6", "ids": [ "v-n5-0419", "v-n5-0131", "v-n4-0007", "v-n5-0118", "v-n5-0115", "v-n5-0071", "v-n5-0132" ], "kana": "しずおかえきまで、おとなはよんひゃくえん、こどもはにひゃくえんです。", "morae": 29 },
    { "ref": "s-20-5#L8", "ids": [ "v-n5-0421", "v-n5-0119", "v-n5-0275", "v-n5-0545", "v-n5-0120", "v-n5-0341", "v-n4-0248", "v-n5-0124", "v-n5-0118", "v-n5-0721" ], "kana": "バスがきたら、てをあげてください。てをあげないと、バスはとまりません。", "morae": 31 },
    { "ref": "s-20-5#L9", "ids": [ "v-n5-0424", "v-n5-0119", "v-n5-0376", "v-n5-0421", "v-n5-0118", "v-n5-0051", "v-n5-0122", "v-n4-0168", "g-n4-047" ], "kana": "みちがせまいので、バスはここでまわることになっています。", "morae": 26 },
    { "ref": "s-20-5#L10", "ids": [ "v-n5-0421", "v-n5-0119", "v-n4-0168", "g-n4-044", "v-n5-0424", "v-n5-0293", "v-n5-0568", "v-n5-0126", "v-n5-0149", "v-n5-0122", "v-n5-0290", "v-n4-0248" ], "kana": "バスがまわれるように、みちにはでないで、きのしたでまってください。", "morae": 30 },
    { "ref": "s-20-5#L11", "ids": [ "v-n5-0137", "v-n5-0118", "v-n5-0671", "v-n5-0358", "v-n5-0406", "v-n5-0408", "v-n5-0120", "v-n5-0278", "g-n4-045", "v-n4-0248" ], "kana": "きょうはとてもあついので、みずやおちゃをのむようにしてください。", "morae": 28 },
    { "ref": "s-20-5#L12", "ids": [ "v-n5-0558", "v-n5-0119", "v-n5-0562", "g-n5-084", "v-n5-0684", "v-n5-0121", "v-n5-0417", "v-n5-0126", "v-n5-0066", "v-n5-0279", "v-n4-0248" ], "kana": "あたまがいたくなったら、すぐにみせのひとにいってください。", "morae": 27 },
    { "ref": "s-20-5#L13", "ids": [ "v-n5-0693", "v-n5-0126", "v-n5-0417", "v-n5-0130", "v-n5-0125", "v-n5-0713", "v-n5-0119", "v-n5-0272" ], "kana": "それから、とろろじるのみせからも、あんないがあります。", "morae": 24 },
    { "ref": "s-20-5#L15", "ids": [ "v-n5-0678", "v-n5-0118", "v-n5-0154", "v-n5-0131", "v-n5-0132", "v-n5-0119", "v-n5-0137", "v-n5-0031", "v-n5-0157", "v-n5-0369", "v-n5-0307" ], "kana": "いつもはさんじまでですが、きょうはいちじかんはやくしめます。", "morae": 27 },
    { "ref": "s-20-5#L16", "ids": [ "v-n5-0120", "v-n5-0277", "v-n4-0053", "v-n5-0118", "v-n5-0309", "v-n5-0152", "v-n5-0121", "v-n5-0417", "v-n5-0292", "v-n4-0248" ], "kana": "とろろじるをたべたいかたは、しまるまえにみせにはいってください。", "morae": 30 },
    { "ref": "s-20-5#L17", "ids": [ "v-n5-0417", "v-n5-0126", "v-n5-0152", "v-n5-0121", "v-n5-0423", "v-n5-0120", "v-n5-0298", "v-n4-0248", "v-n5-0421", "v-n5-0119", "v-n5-0722", "v-n5-0806" ], "kana": "みせのまえにじてんしゃをおかないでください。バスがまがれなくなります。", "morae": 32 },
    { "ref": "s-20-5#L18", "ids": [ "v-n5-0253", "v-n5-0171", "v-n5-0126", "v-n5-0325", "v-n5-0119", "v-n5-0371", "v-n5-0806", "v-n5-0273", "v-n4-0037", "v-n4-0248" ], "kana": "ぼうしやかさのわすれものがおおくなっています。きをつけてください。", "morae": 31 },
    { "ref": "s-20-5#L19", "ids": [ "v-n5-0325", "v-n5-0118", "v-n5-0126", "v-n5-0417", "v-n5-0121", "v-n5-0298", "v-n5-0272" ], "kana": "わすれものは、とろろじるのみせにおいてあります。", "morae": 22 },
    { "ref": "s-20-5#L20", "ids": [ "v-n5-0698", "v-n5-0568", "v-n5-0126", "v-n5-0149", "v-n5-0122", "v-n5-0685", "v-n5-0290", "v-n5-0273", "v-n4-0248" ], "kana": "それでは、きのしたで、ゆっくりまっていてください。", "morae": 22 },
    { "ref": "s-20-5#L21", "ids": [ "v-n5-0358", "v-n5-0150", "v-n5-0010", "v-n4-0037", "v-n5-0025" ], "kana": "あついなか、ありがとうございます。きをつけて、いってらっしゃい。", "morae": 27 },
    { "ref": "g-n4-001#ex2", "ids": [ "g-n4-001", "v-n5-0147", "v-n5-0126", "v-n4-0294", "v-n5-0119", "v-n4-0163", "v-n5-0273", "v-n5-0129" ], "kana": "へやのでんきがきえているよ。", "morae": 13 },
    { "ref": "g-n4-001#ex3", "ids": [ "g-n4-001", "v-n5-0330", "g-n5-033", "v-n4-0294", "v-n5-0120", "v-n5-0719" ], "kana": "でかけるまえにでんきをけした。", "morae": 14 },
    { "ref": "g-n4-023#ex1", "ids": [ "g-n4-023", "v-n4-0272", "v-n5-0118", "v-n5-0354", "v-n5-0066", "v-n5-0121", "v-n5-0373", "v-n4-0326", "v-n5-0120", "v-n5-0282" ], "kana": "ぶちょうはあたらしいひとにながいレポートをかかせました。", "morae": 26 },
    { "ref": "g-n4-028#ex0", "ids": [ "g-n4-028", "v-n5-0205", "v-n5-0434", "v-n5-0121", "v-n4-0316", "v-n5-0271", "v-n5-0124", "v-n5-0801", "v-n5-0273" ], "kana": "らいねん、にほんにりゅうがくしようとおもっています。", "morae": 23 },
    { "ref": "g-n4-041#ex0", "ids": [ "g-n4-041", "v-n5-0153", "v-n5-0126", "v-n5-0066", "v-n5-0121", "v-n5-0125", "v-n4-0183", "g-n4-044", "v-n5-0350", "v-n5-0589", "v-n5-0122", "v-n5-0283" ], "kana": "うしろのひとにもきこえるようにおおきいこえではなした。", "morae": 26 },
    { "ref": "g-n4-041#ex2", "ids": [ "g-n4-041", "v-n5-0080", "v-n5-0119", "v-n5-0283", "g-n4-044", "v-n5-0140", "v-n5-0705", "v-n5-0271", "v-n5-0273" ], "kana": "にほんごがはなせるようにまいにちれんしゅうしています。", "morae": 25 },
    { "ref": "g-n4-042#ex0", "ids": [ "g-n4-042", "v-n5-0354", "v-n5-0238", "v-n5-0120", "v-n5-0284", "v-n4-0206", "v-n5-0663", "v-n5-0271", "v-n5-0273" ], "kana": "あたらしいカメラをかうために、アルバイトをしています。", "morae": 25 },
    { "ref": "g-n4-042#ex1", "ids": [ "g-n4-042", "v-n5-0077", "v-n5-0126", "v-n4-0206", "v-n5-0140", "v-n5-0438", "v-n5-0120", "v-n5-0294" ], "kana": "かぞくのために、まいにちりょうりをつくる。", "morae": 18 },
    { "ref": "g-n4-042#ex2", "ids": [ "g-n4-042", "v-n5-0434", "v-n5-0122", "v-n5-0317", "v-n4-0206", "v-n5-0080", "v-n5-0120", "v-n5-0703", "v-n5-0271", "v-n5-0273" ], "kana": "にほんではたらくために、にほんごをべんきょうしている。", "morae": 24 },
    { "ref": "g-n4-042#ex3", "ids": [ "g-n4-042", "v-n5-0559", "v-n5-0126", "v-n4-0206", "v-n5-0228", "v-n5-0419", "v-n5-0131", "v-n5-0301", "v-n5-0273" ], "kana": "からだのために、まいあさえきまであるいています。", "morae": 22 },
    { "ref": "g-n4-043#ex0", "ids": [ "g-n4-043", "v-n5-0566", "v-n5-0126", "v-n4-0206", "v-n5-0420", "v-n5-0119", "v-n5-0721" ], "kana": "ゆきのために、でんしゃがとまりました。", "morae": 16 },
    { "ref": "g-n4-043#ex2", "ids": [ "g-n4-043", "v-n5-0576", "v-n5-0126", "v-n4-0206", "v-n5-0579", "v-n5-0120", "v-n5-0318" ], "kana": "かぜのために、かいぎをやすんだ。", "morae": 14 },
    { "ref": "g-n4-044#ex1", "ids": [ "g-n4-044", "v-n5-0071", "v-n5-0119", "v-n5-0095", "v-n5-0122", "v-n5-0169", "v-n5-0120", "v-n5-0305" ], "kana": "こどもがひとりでふくをきられるようになりました。", "morae": 23 },
    { "ref": "g-n4-044#ex3", "ids": [ "g-n4-044", "v-n5-0434", "v-n5-0121", "v-n5-0275", "v-n5-0412", "v-n5-0120", "v-n5-0680", "v-n5-0277" ], "kana": "にほんにきて、さかなをよくたべるようになりました。", "morae": 23 },
    { "ref": "g-n4-045#ex0", "ids": [ "g-n4-045", "v-n5-0140", "v-n5-0414", "v-n5-0120", "v-n5-0277", "v-n5-0273" ], "kana": "まいにち、やさいをたべるようにしています。", "morae": 19 },
    { "ref": "g-n4-045#ex1", "ids": [ "g-n4-045", "v-n5-0289", "v-n5-0152", "v-n5-0118", "v-n5-0583", "v-n5-0120", "v-n5-0276", "v-n5-0273" ], "kana": "ねるまえはテレビをみないようにしている。", "morae": 19 },
    { "ref": "g-n4-045#ex2", "ids": [ "g-n4-045", "v-n5-0138", "v-n5-0118", "v-n4-0208", "v-n4-0248" ], "kana": "あしたはおくれないようにしてください。", "morae": 18 },
    { "ref": "g-n4-045#ex3", "ids": [ "g-n4-045", "v-n5-0045", "v-n5-0130", "v-n5-0118", "v-n5-0228", "v-n5-0369", "v-n5-0288" ], "kana": "これからはまいあさはやくおきるようにします。", "morae": 21 },
    { "ref": "g-n4-046#ex1", "ids": [ "g-n4-046", "v-n5-0137", "v-n5-0130", "v-n5-0470", "v-n5-0120", "v-n5-0278" ], "kana": "きょうから、おさけをのまないことにした。", "morae": 17 },
    { "ref": "g-n4-046#ex2", "ids": [ "g-n4-046", "v-n5-0228", "v-n5-0419", "v-n5-0131", "v-n5-0301", "v-n5-0273" ], "kana": "まいあさ、えきまであるくことにしている。", "morae": 18 },
    { "ref": "g-n4-046#ex3", "ids": [ "g-n4-046", "v-n5-0550", "v-n5-0697", "v-n5-0137", "v-n5-0118", "v-n5-0145", "v-n5-0121", "v-n5-0273" ], "kana": "あめだから、きょうはいえにいることにします。", "morae": 19 },
    { "ref": "g-n4-047#ex1", "ids": [ "g-n4-047", "v-n5-0124", "v-n5-0683", "v-n5-0301" ], "kana": "たなかさんといっしょにあるくことになった。", "morae": 19 },
    { "ref": "g-n4-047#ex2", "ids": [ "g-n4-047", "v-n5-0048", "v-n5-0417", "v-n5-0696", "v-n5-0170", "v-n5-0120", "v-n5-0314", "v-n5-0273" ], "kana": "このみせでは、くつをぬぐことになっています。", "morae": 20 },
    { "ref": "g-n4-047#ex3", "ids": [ "g-n4-047", "v-n5-0579", "v-n5-0118", "v-n5-0201", "v-n5-0121", "v-n5-0271", "v-n5-0806" ], "kana": "かいぎはらいしゅうにすることになった。", "morae": 17 },
    { "ref": "g-n4-048#ex0", "ids": [ "g-n4-048", "v-n5-0221", "v-n5-0121", "v-n5-0806", "v-n5-0141", "v-n5-0118", "v-n5-0359" ], "kana": "じゅうがつになって、あさはさむくなりました。", "morae": 19 },
    { "ref": "g-n4-048#ex1", "ids": [ "g-n4-048", "v-n5-0575", "v-n5-0120", "v-n5-0278", "v-n5-0674", "v-n5-0680", "v-n5-0806" ], "kana": "くすりをのんで、すこしよくなった。", "morae": 15 },
    { "ref": "g-n4-048#ex2", "ids": [ "g-n4-048", "v-n5-0088", "v-n5-0118", "v-n5-0205", "v-n4-0323", "v-n5-0121", "v-n5-0806" ], "kana": "いもうとはらいねん、だいがくせいになります。", "morae": 20 },
    { "ref": "g-n4-048#ex3", "ids": [ "g-n4-048", "v-n5-0143", "g-n4-044", "v-n5-0124", "v-n5-0048", "v-n4-0195", "v-n5-0118", "v-n5-0386" ], "kana": "よるになると、このとおりはしずかになる。", "morae": 18 },
    { "ref": "g-n4-049#ex0", "ids": [ "g-n4-049", "v-n5-0804", "v-n5-0120", "v-n5-0674", "v-n5-0351", "v-n4-0248" ], "kana": "おとをすこしちいさくしてください。", "morae": 16 },
    { "ref": "g-n4-049#ex1", "ids": [ "g-n4-049", "v-n5-0147", "v-n5-0120", "v-n5-0397", "v-n5-0121", "v-n5-0271", "v-n5-0130", "v-n5-0330" ], "kana": "へやをきれいにしてから、でかけた。", "morae": 15 },
    { "ref": "g-n4-049#ex2", "ids": [ "g-n4-049", "v-n5-0041", "v-n5-0118", "v-n5-0443", "v-n5-0408", "v-n5-0121", "v-n5-0271" ], "kana": "わたしはのみものはおちゃにします。", "morae": 15 },
    { "ref": "g-n4-049#ex3", "ids": [ "g-n4-049", "v-n5-0591", "v-n5-0120", "v-n5-0374", "v-n5-0225", "v-n5-0118", "v-n5-0358", "v-n5-0130" ], "kana": "かみをみじかくした。なつはあついから。", "morae": 17 },
    { "ref": "g-n4-050#ex0", "ids": [ "g-n4-050", "v-n5-0419", "v-n5-0131", "v-n5-0274", "v-n5-0285" ], "kana": "えきまでいくのに、さんじゅっぷんかかります。", "morae": 19 },
    { "ref": "g-n4-050#ex2", "ids": [ "g-n4-050", "v-n5-0354", "v-n5-0145", "v-n5-0120", "v-n4-0164", "v-n5-0033", "v-n5-0203", "v-n5-0127", "g-n5-042" ], "kana": "あたらしいいえをたてるのに、さんねんかかった。", "morae": 21 },
    { "ref": "g-n4-050#ex3", "ids": [ "g-n4-050", "v-n5-0434", "v-n5-0122", "v-n5-0317", "v-n5-0054", "v-n5-0119", "v-n4-0213", "v-n5-0132", "v-n5-0127" ], "kana": "にほんではたらくのに、なにがひつようですか。", "morae": 20 },
    { "ref": "g-n5-051#ex1", "ids": [ "g-n5-051", "v-n4-0294", "v-n5-0120", "v-n5-0719", "v-n4-0248" ], "kana": "でんきをけさないでください。", "morae": 13 },
    { "ref": "g-n5-087#ex4", "ids": [ "g-n5-087", "v-n5-0401", "v-n4-0344", "v-n4-0248" ], "kana": "ひまなら、てつだってください。", "morae": 13 },
    { "ref": "g-n5-088#ex3", "ids": [ "g-n5-088", "v-n5-0202", "v-n5-0118", "v-n4-0326", "v-n5-0120", "v-n5-0282" ], "kana": "せんしゅうはレポートをかかなければなりませんでした。", "morae": 24 },
