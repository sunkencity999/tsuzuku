    { "ref": "s-02-3#L7", "ids": [ "v-n5-0154" ], "kana": "くじです。", "morae": 4 },
    { "ref": "s-02-3#L8", "ids": [ "v-n5-0154" ], "kana": "じゅうじです。", "morae": 5 },
    { "ref": "s-03-1#L8", "ids": [ "v-n5-0177", "v-n5-0031", "v-n5-0032", "v-n5-0033" ], "kana": "いす、いち、に、さん。", "morae": 7 },
