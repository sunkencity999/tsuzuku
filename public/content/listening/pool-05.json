    { "ref": "v-n5-0195#ex0", "ids": [ "v-n5-0195", "v-n5-0137", "v-n5-0118", "v-n5-0132", "v-n5-0128" ], "kana": "きょうはもくようびですね。", "morae": 11 },
    { "ref": "v-n5-0196#ex0", "ids": [ "v-n5-0196", "v-n5-0126", "v-n5-0143", "v-n5-0118", "v-n5-0054", "v-n5-0120", "v-n5-0127" ], "kana": "きんようびのよるはなにをしますか。", "morae": 16 },
    { "ref": "v-n5-0197#ex1", "ids": [ "v-n5-0197", "v-n5-0126", "v-n5-0141", "v-n5-0118", "v-n5-0154", "g-n5-015", "v-n5-0131", "v-n5-0180", "v-n5-0121" ], "kana": "どようびのあさはじゅうじごろまでベッドにいます。", "morae": 22 },
    { "ref": "v-n5-0198#ex1", "ids": [ "v-n5-0198", "v-n5-0139", "v-n5-0118", "v-n5-0135" ], "kana": "きのうはにちようびでした。", "morae": 12 },
    { "ref": "v-n5-0199#ex1", "ids": [ "v-n5-0199", "v-n5-0080", "v-n5-0118", "v-n5-0121", "v-n5-0106", "v-n5-0132" ], "kana": "にほんごはしゅうににかいです。", "morae": 13 },
