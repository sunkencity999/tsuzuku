    { "ref": "s-04-4#L7", "ids": [ "v-n5-0046", "v-n5-0132", "v-n5-0129", "v-n5-0045", "v-n5-0118", "v-n5-0126", "v-n5-0173" ], "kana": "それですよ。これは、ケンさんのかぎです。", "morae": 17 },
