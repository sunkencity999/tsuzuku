{
  "schema": "tsuzuku.pool/1",
  "station": 12,
  "refs": [
    { "ref": "s-05-1#L6", "ids": [ "v-n5-0154", "v-n5-0132", "v-n5-0565", "v-n5-0118", "v-n5-0162", "v-n5-0124", "v-n5-0164" ], "kana": "ごじです。そらはあおとくろです。", "morae": 14 },
    { "ref": "s-05-1#L7", "ids": [ "v-n5-0154", "v-n5-0155", "v-n5-0565", "v-n5-0126", "v-n5-0160", "v-n5-0118", "v-n5-0161", "v-n5-0124", "v-n5-0163", "v-n5-0187", "v-n5-0132" ], "kana": "ごじじゅっぷん。そらのいろはあかとしろのあいだです。", "morae": 23 },
    { "ref": "s-05-5#L12", "ids": [ "v-n5-0154", "g-n5-015", "v-n5-0130", "v-n5-0565", "v-n5-0118", "v-n5-0164", "v-n5-0163", "v-n5-0131", "v-n5-0132" ], "kana": "ごじごろから、そらはくろからしろまでです。", "morae": 19 },
    { "ref": "s-08-1#L9", "ids": [ "v-n5-0265", "v-n5-0600", "v-n5-0120", "v-n5-0111", "v-n5-0297", "v-n5-0167", "v-n5-0132" ], "kana": "まるいいしをいつつとりました。しろいです。", "morae": 19 },
    { "ref": "s-08-1#L15", "ids": [ "v-n5-0137", "v-n5-0118", "v-n5-0600", "v-n5-0119", "v-n5-0111", "v-n5-0066", "v-n5-0112" ], "kana": "きょうは、いしがいつつ、ひとがさんにん。", "morae": 16 },
    { "ref": "s-10-1#L16", "ids": [ "v-n5-0118", "v-n5-0052", "v-n5-0121", "v-n5-0273", "v-n5-0573", "v-n5-0120", "v-n5-0336", "v-n5-0132" ], "kana": "ふじさんはそこにいます。かおをみせないだけです。", "morae": 22 },
    { "ref": "s-11-1#L2", "ids": [ "v-n5-0425", "v-n5-0126", "v-n5-0150", "v-n5-0121", "v-n5-0351", "v-n5-0564", "v-n5-0119", "v-n5-0272" ], "kana": "まちのなかにちいさいかわがあります。", "morae": 17 },
    { "ref": "s-11-1#L3", "ids": [ "v-n5-0564", "v-n5-0126", "v-n5-0406", "v-n5-0118", "v-n5-0122", "v-n5-0225", "v-n5-0125", "v-n5-0227", "v-n5-0361", "v-n5-0132" ], "kana": "かわのみずはふじさんのみずで、なつもふゆもつめたいです。", "morae": 26 },
    { "ref": "s-11-1#L9", "ids": [ "v-n5-0406", "v-n5-0121", "v-n5-0572", "v-n5-0120", "v-n5-0310", "v-n5-0125", "v-n5-0356", "v-n5-0132", "v-n5-0129", "v-n5-0560" ], "kana": "「でも、みずにあしをいれてもいいですよ。きもちいいですよ。」", "morae": 25 },
    { "ref": "s-11-1#L10", "ids": [ "v-n5-0564", "v-n5-0121", "v-n5-0274", "v-n5-0170", "v-n5-0124", "v-n5-0252", "v-n5-0120", "v-n5-0314" ], "kana": "かわにいって、くつとくつしたをぬぎました。", "morae": 19 },
    { "ref": "s-11-1#L11", "ids": [ "v-n5-0572", "v-n5-0120", "v-n5-0310", "g-n5-028", "v-n5-0361", "v-n5-0132", "v-n5-0119", "v-n5-0560", "v-n5-0356" ], "kana": "あしをいれました。とてもつめたいですが、きもちいいです。", "morae": 25 },
    { "ref": "s-11-1#L12", "ids": [ "v-n5-0440", "v-n5-0118", "v-n5-0564", "v-n5-0126", "v-n5-0185", "v-n5-0417", "v-n5-0122", "v-n5-0361", "v-n5-0476", "v-n5-0120", "v-n5-0277" ], "kana": "ひるごはんは、かわのちかくのみせでつめたいそばをたべました。", "morae": 28 },
    { "ref": "s-11-1#L19", "ids": [ "v-n5-0572", "v-n5-0118", "v-n5-0406", "v-n5-0126", "v-n5-0150", "v-n5-0138", "v-n5-0125", "v-n5-0301", "v-n5-0412", "v-n5-0119", "v-n5-0290", "v-n5-0273", "v-n5-0130" ], "kana": "あしはみずのなか。あしたもあるきます。さかながまっていますから。", "morae": 29 },
    { "ref": "s-11-2#L2", "ids": [ "v-n5-0572", "v-n5-0310", "v-n5-0125", "v-n5-0356" ], "kana": "あし、いれてもいい？", "morae": 8 },
    { "ref": "s-11-4#L2", "ids": [ "v-n5-0048", "v-n5-0425", "v-n5-0126", "v-n5-0351", "v-n5-0564", "v-n5-0121", "v-n5-0274", "v-n5-0132" ], "kana": "このまちのちいさいかわにいきたいです。", "morae": 18 },
    { "ref": "s-11-4#L3", "ids": [ "v-n5-0507", "v-n5-0119", "v-n5-0371", "v-n5-0564", "v-n5-0132", "v-n5-0128", "v-n5-0356", "v-n5-0498", "v-n5-0129" ], "kana": "はしがおおいかわですね。いいところですよ。", "morae": 19 },
    { "ref": "s-11-4#L9", "ids": [ "v-n5-0507", "v-n5-0126", "v-n5-0149", "v-n5-0119", "v-n5-0564", "v-n5-0132", "v-n5-0397", "v-n5-0406", "v-n5-0129" ], "kana": "はしのしたがかわです。きれいなみずですよ。", "morae": 19 },
    { "ref": "s-11-4#L12", "ids": [ "v-n5-0433", "v-n5-0126", "v-n5-0564", "v-n5-0125", "v-n5-0356", "v-n5-0132", "v-n5-0119", "v-n5-0155" ], "kana": "こうえんのかわもいいですが、じゅうごふんです。", "morae": 20 },
    { "ref": "s-11-4#L13", "ids": [ "v-n5-0137", "v-n5-0118", "v-n5-0367", "v-n5-0564", "v-n5-0121", "v-n5-0274" ], "kana": "では、きょうはちかいかわにいきます。", "morae": 15 },
    { "ref": "s-11-4#L14", "ids": [ "v-n5-0564", "v-n5-0126", "v-n5-0406", "v-n5-0118", "v-n5-0278", "v-n5-0125", "v-n5-0356", "v-n5-0132", "v-n5-0127" ], "kana": "かわのみずはのんでもいいですか。", "morae": 15 },
    { "ref": "s-11-4#L19", "ids": [ "g-n5-028", "v-n5-0351", "v-n5-0564", "v-n5-0132", "v-n5-0130" ], "kana": "とてもちいさいかわですから。", "morae": 13 },
    { "ref": "s-11-4#L20", "ids": [ "v-n5-0564", "v-n5-0121", "v-n5-0292", "v-n5-0125", "v-n5-0356", "v-n5-0132", "v-n5-0129" ], "kana": "でも、かわにはいってもいいですよ。", "morae": 15 },
    { "ref": "s-12-1#L0", "ids": [ "v-n5-0218", "v-n5-0211", "v-n5-0595", "v-n5-0439", "v-n5-0118", "v-n5-0154", "v-n5-0135" ], "kana": "しちがつじゅうごにち、はれ。あさごはんはしちじでした。", "morae": 23 },
    { "ref": "s-12-1#L1", "ids": [ "v-n5-0141", "v-n5-0154", "v-n5-0121", "v-n5-0124", "v-n5-0126", "v-n5-0494", "v-n5-0123", "v-n5-0274" ], "kana": "あさごじに、ケンとぬまづのいちばへいきました。", "morae": 21 },
    { "ref": "s-12-1#L2", "ids": [ "v-n5-0518", "v-n5-0126", "v-n5-0152", "v-n5-0494", "v-n5-0132", "v-n5-0154", "g-n5-061", "v-n5-0358" ], "kana": "ふねのまえのいちばです。ごじでも、もうあつかったです。", "morae": 24 },
    { "ref": "s-12-1#L3", "ids": [ "v-n5-0350", "v-n5-0412", "v-n5-0351", "v-n5-0165", "v-n5-0119", "g-n5-028", "v-n5-0371", "v-n5-0132" ], "kana": "おおきいさかな、ちいさいさかな、あかいさかな。さかながとてもおおかったです。", "morae": 34 },
    { "ref": "s-12-1#L4", "ids": [ "v-n5-0541", "v-n5-0120", "v-n5-0286", "v-n5-0412", "v-n5-0125", "v-n5-0273", "v-n5-0546", "v-n5-0119", "g-n5-028", "v-n5-0350", "v-n5-0132" ], "kana": "なまえをしらないさかなもいました。めがとてもおおきいさかなです。", "morae": 30 },
    { "ref": "s-12-1#L6", "ids": [ "v-n5-0118", "v-n5-0449", "v-n5-0124", "v-n5-0567", "v-n5-0119", "v-n5-0412", "v-n5-0120", "v-n5-0379", "v-n5-0271", "v-n5-0279" ], "kana": "おおのさんは「しおとかぜがさかなをおいしくする」といいました。", "morae": 28 },
    { "ref": "s-12-1#L7", "ids": [ "v-n5-0118", "v-n5-0124", "v-n5-0373", "v-n5-0283", "v-n5-0412", "v-n5-0120", "v-n5-0111", "v-n5-0284" ], "kana": "ケンはおおのさんとながくはなして、さかなをみっつかいました。", "morae": 28 },
    { "ref": "s-12-1#L8", "ids": [ "v-n5-0126", "v-n5-0239", "v-n5-0118", "v-n5-0137", "v-n5-0125", "v-n5-0377", "v-n5-0132", "v-n5-0378", "v-n5-0124", "v-n5-0279" ], "kana": "ケンのにもつはきょうもおもいです。でも、ケンは「かるい」といいました。", "morae": 29 },
    { "ref": "s-12-1#L12", "ids": [ "v-n5-0137", "v-n5-0118", "v-n5-0494", "v-n5-0120", "v-n5-0301", "v-n5-0412", "v-n5-0276", "v-n5-0126", "v-n5-0277" ], "kana": "きょうはいちばをあるいた。さかなをみた。ケンのさかなをたべた。", "morae": 27 },
    { "ref": "s-12-1#L13", "ids": [ "v-n5-0301", "v-n5-0363", "v-n5-0124", "v-n5-0801", "v-n5-0140", "v-n5-0354", "v-n5-0425" ], "kana": "あるくのはたのしいとおもう。まいにち、あたらしいまちだ。", "morae": 25 },
    { "ref": "s-12-1#L15", "ids": [ "v-n5-0118", "v-n5-0438", "v-n5-0119", "v-n5-0395", "v-n5-0124", "v-n5-0801", "v-n5-0236", "v-n5-0126", "v-n5-0412", "v-n5-0379" ], "kana": "ケンはりょうりがじょうずだとおもう。けさのさかなはおいしかった。", "morae": 28 },
    { "ref": "s-12-1#L17", "ids": [ "v-n5-0138", "v-n5-0118", "v-n5-0120", "v-n5-0276", "v-n5-0124", "v-n5-0801" ], "kana": "あしたはふじさんをみるとおもう。", "morae": 15 },
    { "ref": "s-12-1#L18", "ids": [ "v-n5-0276", "v-n5-0132", "v-n5-0120", "v-n5-0282" ], "kana": "みるでしょう。ふじさんには、「です」をかきます。", "morae": 18 },
    { "ref": "s-12-2#L0", "ids": [ "v-n5-0045", "v-n5-0356", "v-n5-0124", "v-n5-0801" ], "kana": "ハナ、これ。これ、いいとおもう。", "morae": 12 },
    { "ref": "s-12-2#L1", "ids": [ "v-n5-0350", "v-n5-0128", "v-n5-0054", "v-n5-0126", "v-n5-0412" ], "kana": "おおきいね。なんのさかな？", "morae": 11 },
    { "ref": "s-12-2#L3", "ids": [ "v-n5-0236", "v-n5-0126", "v-n5-0412", "v-n5-0127", "v-n5-0546", "v-n5-0119", "v-n5-0397", "v-n5-0128" ], "kana": "けさのさかなか。めがきれいだね。", "morae": 14 },
    { "ref": "s-12-2#L4", "ids": [ "v-n5-0111", "v-n5-0061" ], "kana": "ひとつ、いくら？", "morae": 6 },
    { "ref": "s-12-2#L5", "ids": [ "v-n5-0111", "v-n5-0115", "v-n5-0122", "v-n5-0129" ], "kana": "ひとつよんひゃくえん。みっつでせんえんだよ。", "morae": 19 },
    { "ref": "s-12-2#L6", "ids": [ "v-n5-0111", "v-n5-0115", "v-n5-0352", "v-n5-0129" ], "kana": "ひとつよんひゃくえん？たかいよ。", "morae": 13 },
    { "ref": "s-12-2#L7", "ids": [ "v-n5-0352", "v-n5-0129", "v-n5-0236", "v-n5-0126", "v-n5-0412" ], "kana": "そう？たかくないよ。けさのさかなだよ。", "morae": 16 },
    { "ref": "s-12-2#L8", "ids": [ "v-n5-0089", "v-n5-0285", "v-n5-0128" ], "kana": "おにいさん、わかってるね。", "morae": 11 },
    { "ref": "s-12-2#L9", "ids": [ "v-n5-0111", "g-n5-051", "v-n5-0439", "v-n5-0121", "v-n5-0294" ], "kana": "みっつください。あさごはんにつくる。", "morae": 16 },
    { "ref": "s-12-2#L10", "ids": [ "v-n5-0001", "v-n5-0115", "v-n5-0449", "v-n5-0118", "g-n5-061", "v-n5-0335", "v-n5-0129" ], "kana": "はい、せんえん。しおはもういらないよ。", "morae": 16 },
    { "ref": "s-12-2#L11", "ids": [ "v-n5-0001", "v-n5-0439", "v-n5-0360", "v-n5-0129" ], "kana": "はい、あさごはん。あついよ。", "morae": 11 },
    { "ref": "s-12-2#L12", "ids": [ "v-n5-0015", "v-n5-0379", "v-n5-0449", "v-n5-0124", "v-n5-0567" ], "kana": "いただきます。おいしい！しおとかぜだけ？", "morae": 17 },
    { "ref": "s-12-2#L13", "ids": [ "v-n5-0449", "v-n5-0124", "v-n5-0567", "v-n5-0126", "v-n5-0412", "v-n5-0118", "v-n5-0356", "v-n5-0129" ], "kana": "しおとかぜだけ。おおのさんのさかなはいいよ。", "morae": 20 },
    { "ref": "s-12-2#L14", "ids": [ "v-n5-0118", "v-n5-0438", "v-n5-0119", "v-n5-0395", "v-n5-0128" ], "kana": "ケンはりょうりがじょうずだね。", "morae": 12 },
    { "ref": "s-12-2#L19", "ids": [ "v-n5-0356", "v-n5-0124", "v-n5-0801", "v-n5-0587", "v-n5-0118", "v-n5-0351" ], "kana": "いいとおもう。じはちいさいけど。", "morae": 14 },
    { "ref": "s-12-3#L0", "ids": [ "v-n5-0120", "v-n5-0301", "v-n5-0273", "v-n5-0126", "v-n5-0425", "v-n5-0121", "v-n5-0305" ], "kana": "とうかいどうをあるいている。じゅうにのまち、ぬまづについた。", "morae": 26 },
    { "ref": "s-12-3#L1", "ids": [ "v-n5-0137", "v-n5-0118", "v-n5-0595", "v-n5-0141", "v-n5-0154", "v-n5-0121", "v-n5-0288", "v-n5-0549", "v-n5-0126", "v-n5-0494", "v-n5-0123", "v-n5-0274" ], "kana": "きょうははれ。あさごじにおきて、うみのいちばへいった。", "morae": 23 },
    { "ref": "s-12-3#L2", "ids": [ "v-n5-0412", "v-n5-0119", "v-n5-0371", "v-n5-0165", "v-n5-0546", "v-n5-0350", "v-n5-0541", "v-n5-0120", "v-n5-0286" ], "kana": "さかながおおい。あかいさかな、めがおおきいさかな、なまえをしらないさかな。", "morae": 33 },
    { "ref": "s-12-3#L5", "ids": [ "v-n5-0111", "v-n5-0115", "v-n5-0352", "v-n5-0124", "v-n5-0801" ], "kana": "ひとつよんひゃくえん。たかいとおもった。でも、たかくなかった。", "morae": 26 },
    { "ref": "s-12-3#L6", "ids": [ "v-n5-0417", "v-n5-0126", "v-n5-0043", "v-n5-0118", "v-n5-0449", "v-n5-0124", "v-n5-0567", "v-n5-0279" ], "kana": "みせのおじさんは「しおとかぜだけだ」といった。", "morae": 20 },
    { "ref": "s-12-3#L7", "ids": [ "v-n5-0438", "v-n5-0119", "v-n5-0395", "v-n5-0066", "v-n5-0124", "v-n5-0301", "v-n5-0273", "v-n5-0439", "v-n5-0118", "v-n5-0049", "v-n5-0294" ], "kana": "りょうりがじょうずなひととあるいている。あさごはんはそのひとがつくる。", "morae": 31 },
    { "ref": "s-12-3#L8", "ids": [ "v-n5-0572", "v-n5-0118", "v-n5-0140", "v-n5-0562", "v-n5-0301", "v-n5-0363" ], "kana": "あしはまいにちいたい。でも、あるくのはたのしい。", "morae": 21 },
    { "ref": "s-12-3#L9", "ids": [ "v-n5-0118", "g-n5-061", "v-n5-0276", "v-n5-0273" ], "kana": "ふじさんは、まだみていない。", "morae": 12 },
    { "ref": "s-12-3#L10", "ids": [ "v-n5-0605", "v-n5-0138", "v-n5-0125", "v-n5-0595", "v-n5-0118", "v-n5-0131", "v-n5-0301" ], "kana": "てんきよほうでは、あしたもはれだ。あしたははらまであるく。", "morae": 26 },
    { "ref": "s-12-3#L11", "ids": [ "v-n5-0436", "v-n5-0118", "v-n5-0113", "v-n5-0412", "v-n5-0124", "v-n5-0518", "v-n5-0565" ], "kana": "しゃしんはさんまい。さかなと、ふねと、そら。", "morae": 17 },
    { "ref": "s-12-3#L12", "ids": [ "v-n5-0584", "v-n5-0118", "v-n5-0149", "v-n5-0121", "v-n5-0282", "v-n5-0585", "v-n5-0143" ], "kana": "しつもんはしたにかいて。こたえはよるにかく。", "morae": 20 },
    { "ref": "s-12-4#L0", "ids": [ "v-n5-0051", "v-n5-0121", "v-n5-0300", "v-n5-0567", "v-n5-0119", "v-n5-0563", "v-n5-0129" ], "kana": "ハナ、ここにすわる？かぜがすずしいよ。", "morae": 16 },
    { "ref": "s-12-4#L2", "ids": [ "v-n5-0356", "v-n5-0494", "v-n5-0128", "v-n5-0546", "v-n5-0119", "v-n5-0350", "v-n5-0412", "v-n5-0276" ], "kana": "いいいちばだったね。めがおおきいさかな、みた？", "morae": 20 },
    { "ref": "s-12-4#L3", "ids": [ "v-n5-0276", "v-n5-0541", "v-n5-0118", "v-n5-0286", "v-n5-0054", "v-n5-0126", "v-n5-0412" ], "kana": "みた。なまえはしらない。なんのさかな？", "morae": 16 },
    { "ref": "s-12-4#L4", "ids": [ "v-n5-0286", "v-n5-0379", "v-n5-0124", "v-n5-0801" ], "kana": "しらない。でも、おいしいとおもう。", "morae": 14 },
    { "ref": "s-12-4#L5", "ids": [ "v-n5-0569", "v-n5-0126", "v-n5-0589", "v-n5-0125", "v-n5-0350", "v-n5-0128" ], "kana": "とりのこえもおおのさんのこえもおおきいね。", "morae": 20 },
    { "ref": "s-12-4#L6", "ids": [ "v-n5-0494", "v-n5-0126", "v-n5-0589", "v-n5-0570", "v-n5-0119", "v-n5-0562" ], "kana": "いちばのこえだ。みみがいたくなかった？", "morae": 17 },
    { "ref": "s-12-4#L7", "ids": [ "v-n5-0562", "v-n5-0364", "v-n5-0066", "v-n5-0128" ], "kana": "いたくなかった。おもしろいひとだったね。", "morae": 18 },
    { "ref": "s-12-4#L8", "ids": [ "v-n5-0118", "v-n5-0228", "v-n5-0154", "v-n5-0121", "v-n5-0288" ], "kana": "おおのさんはまいあささんじにおきるって。", "morae": 19 },
    { "ref": "s-12-4#L9", "ids": [ "v-n5-0154", "v-n5-0494", "v-n5-0126", "v-n5-0141", "v-n5-0118", "v-n5-0369", "v-n5-0128" ], "kana": "さんじ？いちばのあさははやいね。", "morae": 14 },
    { "ref": "s-12-4#L10", "ids": [ "v-n5-0126", "v-n5-0425", "v-n5-0120", "v-n5-0301", "v-n5-0060", "v-n5-0801" ], "kana": "ハナ、じゅうにのまちをあるいた。どうおもう？", "morae": 18 },
    { "ref": "s-12-4#L12", "ids": [ "v-n5-0118", "v-n5-0141", "v-n5-0119", "v-n5-0381", "v-n5-0130" ], "kana": "ハナはあさがよわいから。", "morae": 11 },
    { "ref": "s-12-4#L13", "ids": [ "v-n5-0381", "v-n5-0236", "v-n5-0118", "v-n5-0154", "v-n5-0121", "v-n5-0288" ], "kana": "よわくない！けさはごじにおきた。", "morae": 14 },
    { "ref": "s-12-4#L14", "ids": [ "v-n5-0285", "v-n5-0126", "v-n5-0549", "v-n5-0166", "v-n5-0128" ], "kana": "わかった。ぬまづのうみ、あおいね。", "morae": 14 },
    { "ref": "s-12-4#L15", "ids": [ "v-n5-0567", "v-n5-0125", "v-n5-0560", "v-n5-0356", "v-n5-0425", "v-n5-0124", "v-n5-0801" ], "kana": "かぜもきもちいい。いいまちだとおもう。", "morae": 17 },
    { "ref": "s-12-4#L16", "ids": [ "v-n5-0066", "v-n5-0125", "v-n5-0388", "v-n5-0054", "v-n5-0120", "v-n5-0282", "v-n5-0273", "v-n5-0126" ], "kana": "ひともげんきだ。ハナ、なにをかいているの？", "morae": 18 },
    { "ref": "s-12-4#L18", "ids": [ "v-n5-0281", "v-n5-0129", "v-n5-0054", "v-n5-0120", "v-n5-0282", "v-n5-0412" ], "kana": "よまないよ。なにをかいた？さかな？", "morae": 14 },
    { "ref": "s-12-4#L19", "ids": [ "v-n5-0412", "v-n5-0124", "v-n5-0569", "v-n5-0572" ], "kana": "さかなと、とりと、あし。", "morae": 9 },
    { "ref": "s-12-4#L20", "ids": [ "v-n5-0572", "v-n5-0118", "v-n5-0282", "v-n5-0356", "v-n5-0129" ], "kana": "あし？あしはかかなくてもいいよ。", "morae": 14 },
    { "ref": "s-12-4#L21", "ids": [ "v-n5-0282", "v-n5-0137", "v-n5-0126", "v-n5-0572", "v-n5-0118", "v-n5-0400" ], "kana": "かく。きょうのあしはたいへんだった。", "morae": 15 },
    { "ref": "s-12-4#L22", "ids": [ "v-n5-0001", "v-n5-0439", "v-n5-0120", "v-n5-0294", "v-n5-0299" ], "kana": "はいはい。あさごはんをつくる。たって。", "morae": 16 },
    { "ref": "s-12-4#L23", "ids": [ "v-n5-0561", "v-n5-0572", "v-n5-0118", "v-n5-0562", "v-n5-0594", "v-n5-0388" ], "kana": "うれしい。あしはいたい。でも、おなかはげんきだ。", "morae": 20 },
    { "ref": "s-12-5#L0", "ids": [ "v-n5-0013", "v-n5-0421", "v-n5-0118", "v-n5-0056", "v-n5-0132", "v-n5-0127" ], "kana": "おおのさん、すみません。バスはどこですか。", "morae": 18 },
    { "ref": "s-12-5#L1", "ids": [ "v-n5-0421", "v-n5-0056", "v-n5-0123", "v-n5-0274", "v-n5-0126" ], "kana": "バス？どこへいくの？", "morae": 8 },
    { "ref": "s-12-5#L2", "ids": [ "v-n5-0419", "v-n5-0126", "v-n5-0185", "v-n5-0457", "v-n5-0123", "v-n5-0287" ], "kana": "えきのちかくのホテルへかえります。", "morae": 16 },
    { "ref": "s-12-5#L3", "ids": [ "v-n5-0419", "v-n5-0132", "v-n5-0127", "v-n5-0301", "v-n5-0155", "v-n5-0129" ], "kana": "えきですか。あるいてさんじゅっぷんですよ。", "morae": 18 },
    { "ref": "s-12-5#L4", "ids": [ "v-n5-0572", "v-n5-0119", "v-n5-0562", "v-n5-0132", "v-n5-0421", "v-n5-0121", "v-n5-0303" ], "kana": "あしがいたいです。バスにのりたいです。", "morae": 17 },
    { "ref": "s-12-5#L7", "ids": [ "v-n5-0549", "v-n5-0126", "v-n5-0148", "v-n5-0121", "v-n5-0350", "v-n5-0507", "v-n5-0119", "v-n5-0272", "v-n5-0129" ], "kana": "うみのうえにおおきいはしがありますよ。", "morae": 18 },
    { "ref": "s-12-5#L11", "ids": [ "v-n5-0183", "v-n5-0132", "v-n5-0128", "v-n5-0421", "v-n5-0118", "v-n5-0052", "v-n5-0121", "v-n5-0272", "v-n5-0127" ], "kana": "みぎですね。バスはそこにありますか。", "morae": 16 },
    { "ref": "s-12-5#L13", "ids": [ "v-n5-0421", "v-n5-0118", "v-n5-0154", "v-n5-0155", "v-n5-0121", "v-n5-0293", "v-n5-0129" ], "kana": "バスはろくじじゅっぷんにでますよ。", "morae": 15 },
    { "ref": "s-12-5#L14", "ids": [ "v-n5-0154", "v-n5-0155", "v-n5-0132", "v-n5-0128", "v-n5-0136", "v-n5-0175", "v-n5-0127" ], "kana": "ろくじじゅっぷんですね。いま、なんじですか。", "morae": 18 },
    { "ref": "s-12-5#L15", "ids": [ "v-n5-0154", "v-n5-0132", "v-n5-0155", "v-n5-0122", "v-n5-0305", "v-n5-0129" ], "kana": "ろくじです。ごふんでつきますよ。", "morae": 14 },
    { "ref": "s-12-5#L16", "ids": [ "v-n5-0518", "v-n5-0126", "v-n5-0498", "v-n5-0121", "v-n5-0292", "v-n5-0125", "v-n5-0356", "v-n5-0132", "v-n5-0127" ], "kana": "ふねのところにはいってもいいですか。", "morae": 17 },
    { "ref": "s-12-5#L17", "ids": [ "v-n5-0518", "v-n5-0126", "v-n5-0498", "v-n5-0121", "v-n5-0292", "v-n5-0118", "g-n5-055", "v-n5-0129" ], "kana": "ふねのところにはいってはいけませんよ。", "morae": 18 },
    { "ref": "s-12-5#L18", "ids": [ "v-n5-0542", "v-n5-0126", "v-n5-0066", "v-n5-0498", "v-n5-0132", "v-n5-0130" ], "kana": "しごとのひとのところですから。", "morae": 14 },
    { "ref": "s-12-5#L19", "ids": [ "v-n5-0507", "v-n5-0126", "v-n5-0148", "v-n5-0122", "v-n5-0436", "v-n5-0118", "v-n5-0356", "v-n5-0132", "v-n5-0127" ], "kana": "はしのうえでしゃしんはいいですか。", "morae": 15 },
    { "ref": "s-12-5#L20", "ids": [ "v-n5-0356", "v-n5-0132", "v-n5-0129", "v-n5-0118", "v-n5-0225", "v-n5-0130" ], "kana": "いいですよ。でも、ふじさんはないよ。なつだから。", "morae": 20 },
    { "ref": "s-12-5#L21", "ids": [ "v-n5-0138", "v-n5-0118", "v-n5-0595", "v-n5-0124", "v-n5-0801", "v-n5-0129" ], "kana": "あしたははれだとおもいますよ。", "morae": 14 },
    { "ref": "s-12-5#L22", "ids": [ "v-n5-0010", "v-n5-0302" ], "kana": "ありがとうございます。はしります！", "morae": 15 },
    { "ref": "s-12-5#L23", "ids": [ "v-n5-0302", "v-n5-0356", "v-n5-0132", "v-n5-0129" ], "kana": "はしらなくてもいいですよ。", "morae": 12 },
    { "ref": "g-n5-001#ex1", "ids": [ "g-n5-001", "v-n5-0118", "v-n5-0611", "v-n5-0132" ], "kana": "ハナさんはにほんじんです。", "morae": 12 },
    { "ref": "g-n5-003#ex2", "ids": [ "g-n5-003", "v-n5-0137", "v-n5-0118", "v-n5-0578", "v-n5-0132", "v-n5-0127" ], "kana": "きょうはやすみですか。", "morae": 9 },
    { "ref": "g-n5-004#ex3", "ids": [ "g-n5-004", "v-n5-0138", "v-n5-0125", "v-n5-0578", "v-n5-0132" ], "kana": "あしたもやすみです。", "morae": 9 },
    { "ref": "g-n5-010#ex1", "ids": [ "g-n5-010", "v-n5-0579", "v-n5-0118", "v-n5-0159", "v-n5-0154", "v-n5-0156", "v-n5-0132" ], "kana": "かいぎはごごにじはんです。", "morae": 12 },
    { "ref": "g-n5-011#ex1", "ids": [ "g-n5-011", "v-n5-0578", "v-n5-0118", "v-n5-0197", "v-n5-0130", "v-n5-0192", "v-n5-0131", "v-n5-0132" ], "kana": "やすみはどようびからげつようびまでです。", "morae": 19 },
    { "ref": "g-n5-012#ex4", "ids": [ "g-n5-012", "v-n5-0068", "v-n5-0118", "v-n5-0611", "v-n5-0132" ], "kana": "せんせいはにほんじんじゃありませんでした。", "morae": 19 },
    { "ref": "g-n5-015#ex1", "ids": [ "g-n5-015", "v-n5-0579", "v-n5-0118", "v-n5-0154", "v-n5-0131", "v-n5-0132" ], "kana": "かいぎはさんじごろまでです。", "morae": 13 },
    { "ref": "g-n5-016#ex2", "ids": [ "g-n5-016", "v-n5-0578", "v-n5-0118", "v-n5-0197", "v-n5-0124", "v-n5-0198", "v-n5-0132" ], "kana": "やすみはどようびとにちようびです。", "morae": 16 },
    { "ref": "g-n5-016#ex3", "ids": [ "g-n5-016", "v-n5-0124", "v-n5-0118", "v-n5-0611", "v-n5-0132" ], "kana": "ハナさんとケンさんはにほんじんです。", "morae": 17 },
    { "ref": "g-n5-020#ex2", "ids": [ "g-n5-020", "v-n5-0579", "v-n5-0118", "v-n5-0154", "v-n5-0121", "v-n5-0326" ], "kana": "かいぎはさんじにはじまります。", "morae": 14 },
    { "ref": "g-n5-044#ex3", "ids": [ "g-n5-044", "v-n5-0041", "v-n5-0118", "v-n5-0618", "v-n5-0119", "v-n5-0396", "v-n5-0132" ], "kana": "わたしはうたがへたです。", "morae": 11 },
    { "ref": "g-n5-046#ex0", "ids": [ "g-n5-046", "v-n5-0141", "v-n5-0288", "v-n5-0573", "v-n5-0120", "v-n5-0312" ], "kana": "あさおきて、かおをあらいます。", "morae": 13 },
    { "ref": "g-n5-049#ex2", "ids": [ "g-n5-049", "v-n5-0048", "v-n5-0556", "v-n5-0126", "v-n5-0586", "v-n5-0120", "v-n5-0286", "v-n5-0273", "v-n5-0127" ], "kana": "このことばのいみをしっていますか。", "morae": 16 },
    { "ref": "g-n5-058#ex3", "ids": [ "g-n5-058", "v-n5-0139", "v-n5-0118", "v-n5-0550", "v-n5-0135", "v-n5-0119", "v-n5-0137", "v-n5-0595", "v-n5-0132" ], "kana": "きのうはあめでしたが、きょうははれです。", "morae": 17 },
    { "ref": "g-n5-062#ex0", "ids": [ "g-n5-062", "v-n5-0138", "v-n5-0070", "v-n5-0124", "v-n5-0554", "v-n5-0120", "v-n5-0276" ], "kana": "あした、ともだちとえいがをみる。", "morae": 14 },
    { "ref": "g-n5-062#ex1", "ids": [ "g-n5-062", "v-n5-0228", "v-n5-0154", "v-n5-0121", "v-n5-0288" ], "kana": "まいあさろくじにおきる。", "morae": 11 },
    { "ref": "g-n5-062#ex2", "ids": [ "g-n5-062", "v-n5-0137", "v-n5-0118", "v-n5-0054", "v-n5-0120", "v-n5-0271" ], "kana": "きょうはなにをする？", "morae": 8 },
    { "ref": "g-n5-062#ex3", "ids": [ "g-n5-062", "v-n5-0234", "v-n5-0125", "v-n5-0275" ], "kana": "こんばん、たなかさんもくる。", "morae": 12 },
    { "ref": "g-n5-062#ex4", "ids": [ "g-n5-062", "v-n5-0198", "v-n5-0118", "v-n5-0057", "v-n5-0125", "v-n5-0433", "v-n5-0120", "v-n5-0302" ], "kana": "にちようびはいつもこうえんをはしる。", "morae": 17 },
    { "ref": "g-n5-063#ex0", "ids": [ "g-n5-063", "v-n5-0137", "v-n5-0118", "v-n5-0054", "v-n5-0125", "v-n5-0277" ], "kana": "きょうはなにもたべない。", "morae": 10 },
    { "ref": "g-n5-063#ex1", "ids": [ "g-n5-063", "v-n5-0138", "v-n5-0118", "v-n5-0097", "v-n5-0123", "v-n5-0274" ], "kana": "あしたはがっこうへいかない。", "morae": 13 },
    { "ref": "g-n5-063#ex2", "ids": [ "g-n5-063", "v-n5-0118", "v-n5-0470", "v-n5-0120", "v-n5-0278" ], "kana": "ケンはおさけをのまない。", "morae": 11 },
    { "ref": "g-n5-063#ex3", "ids": [ "g-n5-063", "v-n5-0157", "v-n5-0119", "v-n5-0130", "v-n5-0439", "v-n5-0118", "v-n5-0277" ], "kana": "じかんがないから、あさごはんはたべない。", "morae": 18 },
    { "ref": "g-n5-064#ex0", "ids": [ "g-n5-064", "v-n5-0139", "v-n5-0070", "v-n5-0124", "v-n5-0554", "v-n5-0120", "v-n5-0276" ], "kana": "きのう、ともだちとえいがをみた。", "morae": 14 },
    { "ref": "g-n5-064#ex1", "ids": [ "g-n5-064", "v-n5-0439", "v-n5-0121", "v-n5-0410", "v-n5-0120", "v-n5-0277" ], "kana": "あさごはんにパンをたべた。", "morae": 12 },
    { "ref": "g-n5-064#ex2", "ids": [ "g-n5-064", "v-n5-0202", "v-n5-0549", "v-n5-0123", "v-n5-0274" ], "kana": "せんしゅう、うみへいった。", "morae": 10 },
    { "ref": "g-n5-064#ex3", "ids": [ "g-n5-064", "v-n5-0139", "v-n5-0126", "v-n5-0143", "v-n5-0118", "v-n5-0154", "v-n5-0121", "v-n5-0289" ], "kana": "きのうのよるはじゅういちじにねた。", "morae": 15 },
    { "ref": "g-n5-064#ex4", "ids": [ "g-n5-064", "v-n5-0118", "v-n5-0419", "v-n5-0122", "v-n5-0582", "v-n5-0120", "v-n5-0284" ], "kana": "ケンはえきでしんぶんをかった。", "morae": 14 },
    { "ref": "g-n5-065#ex1", "ids": [ "g-n5-065", "v-n5-0236", "v-n5-0582", "v-n5-0120", "v-n5-0281" ], "kana": "けさ、しんぶんをよまなかった。", "morae": 13 },
    { "ref": "g-n5-065#ex3", "ids": [ "g-n5-065", "v-n5-0198", "v-n5-0118", "v-n5-0054", "v-n5-0125", "v-n5-0271" ], "kana": "にちようびはなにもしなかった。", "morae": 14 },
    { "ref": "g-n5-065#ex4", "ids": [ "g-n5-065", "v-n5-0418", "v-n5-0119", "v-n5-0130", "v-n5-0284" ], "kana": "おかねがなかったから、かわなかった。", "morae": 16 },
    { "ref": "g-n5-066#ex0", "ids": [ "g-n5-066", "v-n5-0138", "v-n5-0118", "v-n5-0550", "v-n5-0119", "v-n5-0340", "v-n5-0124", "v-n5-0801" ], "kana": "あしたはあめがふるとおもいます。", "morae": 15 },
    { "ref": "g-n5-066#ex2", "ids": [ "g-n5-066", "v-n5-0118", "v-n5-0137", "v-n5-0275", "v-n5-0124", "v-n5-0801" ], "kana": "たなかさんはきょうこないとおもいます。", "morae": 17 },
    { "ref": "g-n5-066#ex3", "ids": [ "g-n5-066", "v-n5-0434", "v-n5-0126", "v-n5-0420", "v-n5-0118", "v-n5-0389", "v-n5-0124", "v-n5-0801" ], "kana": "にほんのでんしゃはべんりだとおもいます。", "morae": 18 },
    { "ref": "g-n5-066#ex4", "ids": [ "g-n5-066", "v-n5-0118", "g-n5-061", "v-n5-0289", "v-n5-0124", "v-n5-0801" ], "kana": "ケンはもうねたとおもいます。", "morae": 13 },
    { "ref": "g-n5-067#ex1", "ids": [ "g-n5-067", "v-n5-0118", "v-n5-0379", "v-n5-0124", "v-n5-0279" ], "kana": "ケンは「おいしい」といいました。", "morae": 13 },
    { "ref": "g-n5-067#ex3", "ids": [ "g-n5-067", "v-n5-0118", "v-n5-0201", "v-n5-0318", "v-n5-0124", "v-n5-0279" ], "kana": "ハナはらいしゅうやすむといいました。", "morae": 16 },
    { "ref": "g-n5-067#ex4", "ids": [ "g-n5-067", "v-n5-0082", "v-n5-0121", "v-n5-0137", "v-n5-0118", "v-n5-0287", "v-n5-0124", "v-n5-0279" ], "kana": "ははに「きょうはかえらない」といいました。", "morae": 17 },
    { "ref": "g-n5-068#ex0", "ids": [ "g-n5-068", "v-n5-0137", "v-n5-0118", "v-n5-0578" ], "kana": "きょうはやすみだ。", "morae": 7 },
    { "ref": "g-n5-068#ex2", "ids": [ "g-n5-068", "v-n5-0048", "v-n5-0147", "v-n5-0118", "v-n5-0446", "v-n5-0397", "v-n5-0132" ], "kana": "このへやはあまりきれいじゃない。", "morae": 14 },
    { "ref": "g-n5-068#ex3", "ids": [ "g-n5-068", "v-n5-0202", "v-n5-0118", "v-n5-0401", "v-n5-0132" ], "kana": "せんしゅうはひまじゃなかった。", "morae": 12 },
    { "ref": "g-n5-068#ex4", "ids": [ "g-n5-068", "v-n5-0139", "v-n5-0118", "v-n5-0124", "v-n5-0359" ], "kana": "きのうはとてもさむかった。", "morae": 12 },
