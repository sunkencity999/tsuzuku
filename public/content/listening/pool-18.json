    { "ref": "v-n4-0162#ex1", "ids": [ "v-n4-0162", "v-n5-0526", "v-n5-0120", "v-n4-0210", "v-n5-0124", "v-n5-0512", "v-n5-0119" ], "kana": "ていしょくをたのむと、みそしるがつきます。", "morae": 18 },
    { "ref": "v-n4-0163#ex1", "ids": [ "v-n4-0163", "v-n5-0599", "v-n5-0126", "v-n5-0566", "v-n5-0119", "v-n5-0224", "v-n5-0275", "v-n5-0128" ], "kana": "にわのゆきがきえて、はるがきたね。", "morae": 15 },
    { "ref": "v-n4-0164#ex0", "ids": [ "v-n4-0164", "v-n5-0085", "v-n5-0118", "v-n5-0205", "v-n5-0145", "v-n5-0120" ], "kana": "あにはらいねん、いえをたてるそうだ。", "morae": 16 },
