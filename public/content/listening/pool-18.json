{
  "schema": "tsuzuku.pool/1",
  "station": 18,
  "refs": [
    { "ref": "s-13-1#L3", "ids": [ "v-n5-0647", "v-n5-0126", "v-n5-0188", "v-n5-0121", "v-n5-0119", "v-n4-0182" ], "kana": "たんぼのむこうに、ふじさんがみえました。", "morae": 18 },
    { "ref": "s-13-2#L0", "ids": [ "v-n5-0276", "v-n5-0647", "v-n5-0126", "v-n5-0188", "v-n5-0121", "v-n5-0119", "v-n4-0182", "v-n5-0129" ], "kana": "ケン、みた？たんぼのむこうにふじさんがみえるよ。", "morae": 21 },
    { "ref": "s-13-2#L3", "ids": [ "v-n5-0137", "v-n5-0118", "v-n5-0397", "v-n4-0182", "v-n5-0128", "v-n5-0566", "v-n5-0119", "v-n5-0674", "v-n5-0272", "v-n5-0132" ], "kana": "きょうはきれいにみえるね。ゆきがすこしあるでしょう？", "morae": 22 },
    { "ref": "s-13-4#L15", "ids": [ "v-n5-0119", "v-n5-0182", "v-n5-0121", "v-n4-0182", "v-n5-0129" ], "kana": "よしわらでは、ふじさんがひだりにみえますよ。", "morae": 20 },
    { "ref": "s-15-1#L11", "ids": [ "v-n5-0693", "v-n5-0126", "v-n5-0239", "v-n5-0120", "v-n4-0158", "v-n5-0806" ], "kana": "それから、ケンのにもつをなおさなければなりません。", "morae": 23 },
    { "ref": "s-15-2#L19", "ids": [ "v-n5-0756", "v-n4-0158", "v-n5-0136", "v-n5-0118", "v-n5-0412", "v-n5-0735", "v-n5-0548" ], "kana": "あとでなおす。いまはさかな。はれたら、やま。", "morae": 18 },
    { "ref": "s-15-3#L12", "ids": [ "v-n5-0138", "v-n5-0125", "v-n5-0550", "g-n5-068", "v-n5-0676", "v-n5-0248", "v-n4-0203", "v-n5-0356", "v-n5-0132", "v-n5-0147", "v-n5-0118", "v-n5-0272" ], "kana": "あしたもあめだったら、もういちにちとまってもいいです。へやはあります。", "morae": 32 },
    { "ref": "s-16-1#L12", "ids": [ "v-n5-0548", "v-n5-0126", "v-n5-0148", "v-n5-0121", "v-n5-0305", "v-n5-0149", "v-n5-0549", "v-n5-0119", "v-n4-0182", "v-n5-0118", "v-n5-0565", "v-n5-0166", "v-n5-0132" ], "kana": "やまのうえにつきました。したにうみがみえます。うみはそらよりあおかったです。", "morae": 35 },
    { "ref": "s-16-2#L7", "ids": [ "v-n5-0397", "v-n5-0125", "v-n4-0182", "v-n5-0686", "v-n5-0183", "v-n5-0121", "v-n5-0272" ], "kana": "きれい。ふじさんもみえる。またみぎにある。", "morae": 18 },
    { "ref": "s-17-1#L10", "ids": [ "v-n5-0499", "v-n5-0126", "v-n5-0186", "v-n5-0121", "v-n5-0350", "v-n5-0587", "v-n5-0119", "v-n5-0282", "v-n5-0272", "v-n5-0599", "v-n5-0292", "v-n5-0302", "v-n5-0600", "v-n4-0192" ], "kana": "いりぐちのよこに、おおきいじがかいてありました。「にわにはいるな。はしるな。いしにさわるな。」", "morae": 40 },
    { "ref": "s-17-3#L4", "ids": [ "v-n5-0568", "v-n5-0551", "v-n5-0121", "v-n4-0192", "v-n5-0436", "v-n5-0118", "v-n5-0726", "v-n5-0125", "v-n5-0356", "v-n5-0132" ], "kana": "きやはなにさわるな。しゃしんはとってもいいです。", "morae": 21 },
    { "ref": "s-17-5#L3", "ids": [ "v-n5-0355", "v-n5-0568", "v-n5-0600", "v-n5-0121", "v-n4-0192", "g-n5-051" ], "kana": "ふるいきやいしに、さわらないでください。", "morae": 18 },
    { "ref": "s-18-1#L0", "ids": [ "v-n5-0218", "v-n5-0211", "v-n5-0595", "v-n5-0439", "v-n5-0118", "v-n5-0154", "v-n5-0135", "v-n5-0750", "v-n5-0356", "v-n5-0157", "v-n5-0132" ], "kana": "しちがつにじゅうくにち、はれ。あさごはんはしちじでした。ちょうどいいじかんです。", "morae": 34 },
    { "ref": "s-18-1#L1", "ids": [ "v-n5-0118", "v-n5-0139", "v-n5-0138", "v-n5-0567", "v-n5-0119", "v-n5-0132", "v-n5-0124", "v-n5-0279" ], "kana": "たなかさんはきのう、「あしたはかぜがないでしょう」といいました。", "morae": 27 },
    { "ref": "s-18-1#L2", "ids": [ "v-n5-0692", "v-n5-0137", "v-n5-0118", "v-n5-0141", "v-n5-0130", "v-n5-0567", "v-n5-0119", "v-n5-0671", "v-n5-0380", "v-n5-0132", "v-n5-0126", "v-n5-0547", "v-n5-0544", "v-n5-0678", "v-n5-0338" ], "kana": "でも、きょうはあさからかぜがとてもつよいです。たなかさんのてんきのはなしは、いつもちがいます。", "morae": 42 },
    { "ref": "s-18-1#L3", "ids": [ "v-n5-0118", "v-n5-0136", "v-n5-0126", "v-n5-0132", "v-n5-0549", "v-n5-0185", "v-n5-0355", "v-n5-0425" ], "kana": "えじりは、いまのしみずです。うみのちかくのふるいまちです。", "morae": 26 },
    { "ref": "s-18-1#L4", "ids": [ "v-n5-0126", "v-n5-0131", "v-n5-0301", "v-n5-0568", "v-n5-0118", "g-n5-009", "v-n5-0567", "v-n5-0122", "v-n5-0722", "v-n5-0273" ], "kana": "みほのまつばらまであるきました。まつばらのきは、どれもかぜでまがっています。", "morae": 35 },
    { "ref": "s-18-1#L5", "ids": [ "v-n5-0549", "v-n5-0130", "v-n5-0380", "v-n5-0567", "v-n5-0119", "v-n5-0732", "v-n5-0275", "v-n5-0041", "v-n5-0118", "v-n5-0253", "v-n5-0120", "v-n5-0297" ], "kana": "うみからつよいかぜがふいてきて、わたしはぼうしをとられました。", "morae": 29 },
    { "ref": "s-18-1#L6", "ids": [ "v-n5-0253", "v-n5-0118", "v-n5-0565", "v-n5-0123", "v-n5-0334", "v-n5-0549", "v-n5-0126", "v-n5-0148", "v-n5-0131", "v-n5-0274", "v-n5-0676", "v-n4-0182" ], "kana": "ぼうしはそらへとんで、うみのうえまでいってしまって、もうみえません。", "morae": 31 },
    { "ref": "s-18-1#L7", "ids": [ "v-n5-0152", "v-n5-0120", "v-n5-0301", "v-n5-0273", "v-n5-0066", "v-n5-0126", "v-n5-0545", "v-n5-0130", "v-n5-0125", "v-n5-0241", "v-n5-0119", "v-n5-0113", "v-n5-0565", "v-n5-0123", "v-n5-0334" ], "kana": "まえをあるいていたひとのてからも、かみがさんまい、そらへとびました。", "morae": 31 },
    { "ref": "s-18-1#L8", "ids": [ "v-n5-0048", "v-n5-0425", "v-n5-0126", "v-n5-0391", "v-n5-0623", "v-n5-0118", "v-n5-0567", "v-n5-0132", "v-n5-0137", "v-n5-0041", "v-n5-0049", "v-n5-0150", "v-n5-0121", "v-n5-0273" ], "kana": "このまちのゆうめいなえは、かぜのえです。きょう、わたしたちはそのえのなかにいました。", "morae": 37 },
    { "ref": "s-18-1#L10", "ids": [ "v-n5-0137", "v-n5-0118", "v-n5-0438", "v-n5-0126", "v-n5-0066", "v-n5-0119", "v-n5-0578", "v-n5-0132", "v-n5-0124", "v-n5-0279", "v-n5-0239", "v-n5-0120", "v-n5-0276" ], "kana": "「きょうはりょうりのひとがやすみです」とはやしさんはいって、ケンのにもつをみました。", "morae": 36 },
    { "ref": "s-18-1#L11", "ids": [ "v-n5-0691", "v-n5-0118", "v-n5-0121", "v-n5-0441", "v-n5-0120", "v-n5-0294", "v-n5-0495", "v-n5-0681", "v-n5-0122", "v-n5-0112", "v-n5-0132" ], "kana": "そして、はやしさんはケンにばんごはんをつくらせました。おきゃくさんはぜんぶでじゅうににんです。", "morae": 42 },
    { "ref": "s-18-1#L12", "ids": [ "v-n5-0118", "v-n5-0412", "v-n5-0120", "v-n5-0284", "v-n5-0121", "v-n5-0494", "v-n5-0123", "v-n5-0274", "v-n5-0692", "v-n5-0567", "v-n5-0122", "v-n5-0518", "v-n5-0119", "v-n4-0208", "v-n5-0031", "v-n5-0157", "v-n5-0290" ], "kana": "ケンはさかなをかいにいちばへいこうとしました。でも、かぜでふねがおくれて、いちじかんまたされました。", "morae": 46 },
    { "ref": "s-18-1#L13", "ids": [ "v-n5-0441", "v-n5-0118", "v-n4-0170", "v-n5-0412", "v-n5-0124", "v-n5-0414", "v-n5-0126", "v-n5-0534", "v-n5-0407", "v-n5-0135", "v-n5-0373", "v-n5-0181", "v-n5-0122", "v-n4-0004", "v-n5-0277" ], "kana": "ばんごはんは、やいたさかなとやさいのスープと、ごはんでした。ながいテーブルで、みんなでたべました。", "morae": 44 },
    { "ref": "s-18-1#L14", "ids": [ "v-n5-0118", "v-n4-0004", "v-n5-0121", "v-n5-0379", "v-n5-0124", "v-n5-0279", "v-n5-0125", "v-n4-0118" ], "kana": "ケンはみんなに「おいしい」といわれて、はやしさんにもほめられました。", "morae": 30 },
    { "ref": "s-18-1#L16", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0425", "v-n5-0126", "v-n5-0417", "v-n5-0122", "v-n5-0354", "v-n5-0253", "v-n5-0120", "v-n5-0284", "v-n5-0166", "v-n5-0132", "v-n5-0567", "v-n5-0119", "v-n5-0380", "v-n5-0545", "v-n5-0296" ], "kana": "わたしはまちのみせで、あたらしいぼうしをかいました。あおいぼうしです。かぜがつよかったら、てでもちます。", "morae": 47 },
    { "ref": "s-18-1#L17", "ids": [ "v-n5-0143", "v-n5-0118", "v-n5-0229", "v-n5-0122", "v-n5-0461", "v-n5-0120", "v-n5-0312", "v-n5-0279", "v-n5-0686", "v-n5-0294", "v-n5-0418", "v-n5-0297", "v-n5-0129" ], "kana": "よる、ケンはだいどころでさらをあらいながらいいました。「またつくらされたら、おかねをとるよ」", "morae": 41 },
    { "ref": "s-18-1#L19", "ids": [ "v-n5-0118", "v-n4-0022", "v-n5-0138", "v-n5-0126", "v-n5-0141", "v-n5-0322", "v-n5-0341", "v-n5-0124", "v-n5-0332", "v-n5-0439", "v-n5-0761", "v-n5-0369", "v-n5-0132" ], "kana": "はやしさんはわらって、「あしたのあさ、おしえてあげます」とこたえました。あしたのあさごはんは、きっとはやいです。", "morae": 49 },
    { "ref": "s-18-2#L0", "ids": [ "v-n5-0137", "v-n5-0253", "v-n5-0567", "v-n5-0121", "v-n5-0297" ], "kana": "ケン、きょう、ぼうし、かぜにとられちゃった。", "morae": 16 },
    { "ref": "s-18-2#L1", "ids": [ "v-n5-0276", "v-n5-0549", "v-n5-0126", "v-n5-0148", "v-n5-0131", "v-n5-0334", "v-n5-0369" ], "kana": "みてた。うみのうえまでとんでった。はやかったな。", "morae": 21 },
    { "ref": "s-18-2#L2", "ids": [ "v-n5-0354", "v-n5-0126", "v-n5-0284", "v-n5-0166" ], "kana": "あたらしいの、かおうかな。あおいの。", "morae": 15 },
    { "ref": "s-18-2#L3", "ids": [ "v-n5-0162", "v-n5-0127", "v-n5-0356" ], "kana": "あおか。いいな。", "morae": 6 },
    { "ref": "s-18-2#L5", "ids": [ "v-n5-0294", "v-n5-0412", "v-n5-0125", "v-n5-0284", "v-n5-0121", "v-n5-0274", "v-n5-0518", "v-n5-0119", "v-n4-0208", "v-n5-0031", "v-n5-0157", "v-n5-0290" ], "kana": "つくらされた。さかなもかいにいかされた。ふねがおくれて、いちじかんまたされた。", "morae": 35 },
    { "ref": "s-18-2#L6", "ids": [ "v-n5-0031", "v-n5-0157", "v-n5-0125", "v-n5-0400", "v-n5-0128" ], "kana": "いちじかんも？たいへんだったね。", "morae": 14 },
    { "ref": "s-18-2#L7", "ids": [ "v-n5-0692", "v-n5-0412", "v-n5-0118", "v-n5-0356", "v-n5-0236", "v-n4-0156" ], "kana": "でも、さかなはよかった。けさとどいたさかなだった。", "morae": 22 },
    { "ref": "s-18-2#L8", "ids": [ "v-n5-0692", "v-n4-0004", "v-n5-0121", "v-n4-0118", "g-n5-076", "v-n5-0561" ], "kana": "でも、みんなにほめられたでしょ。うれしかったでしょ。", "morae": 21 },
    { "ref": "s-18-2#L10", "ids": [ "v-n5-0573", "v-n5-0121", "v-n5-0282", "v-n5-0272", "v-n5-0129", "v-n5-0570", "v-n5-0165" ], "kana": "かおにかいてあったよ。みみ、あかかったし。", "morae": 18 },
    { "ref": "s-18-2#L11", "ids": [ "v-n5-0229", "v-n5-0119", "v-n5-0358" ], "kana": "だいどころがあつかっただけだ。", "morae": 14 },
    { "ref": "s-18-2#L13", "ids": [ "v-n5-0294", "v-n5-0676", "v-n5-0280", "v-n5-0138", "v-n5-0126", "v-n5-0141", "v-n5-0322", "v-n5-0342" ], "kana": "つくりかた、もうきいた。あしたのあさ、おしえてもらう。", "morae": 23 },
    { "ref": "s-18-2#L14", "ids": [ "v-n5-0130", "v-n4-0210", "v-n5-0126" ], "kana": "ケンからたのんだの？", "morae": 9 },
    { "ref": "s-18-2#L15", "ids": [ "v-n5-0154", "v-n5-0121", "v-n4-0184", "v-n5-0461", "v-n5-0677", "v-n5-0272", "v-n5-0130", "v-n5-0766", "v-n5-0289" ], "kana": "ろくじにおこされる。さら、まだあるから、さきにねろ。", "morae": 22 },
    { "ref": "s-18-2#L16", "ids": [ "v-n5-0138", "v-n5-0118", "v-n5-0154", "v-n5-0156", "v-n5-0132", "v-n5-0129", "v-n4-0184", "v-n5-0121", "v-n5-0274", "v-n5-0130", "v-n5-0128" ], "kana": "ケンさん、あしたはごじはんですよ。おこしにいきますからね。", "morae": 26 },
    { "ref": "s-18-2#L17", "ids": [ "v-n5-0695", "v-n5-0138", "v-n5-0126", "v-n5-0439", "v-n5-0118", "v-n5-0369", "v-n5-0128", "v-n5-0766", "v-n5-0289", "v-n5-0129" ], "kana": "じゃあ、あしたのあさごはんははやいね。さきにねるよ。", "morae": 22 },
    { "ref": "s-18-2#L18", "ids": [ "v-n5-0138", "v-n5-0118", "v-n5-0438", "v-n5-0126", "v-n5-0066", "v-n5-0119", "v-n4-0187", "v-n5-0356" ], "kana": "あしたはりょうりのひとがもどるって。よかった。", "morae": 20 },
    { "ref": "s-18-2#L19", "ids": [ "v-n5-0688" ], "kana": "ほんとうに？", "morae": 5 },
    { "ref": "s-18-3#L1", "ids": [ "v-n5-0095", "v-n5-0126", "v-n5-0445", "v-n5-0135", "v-n5-0118", "v-n5-0567", "v-n5-0119", "v-n5-0671", "v-n5-0380", "v-n5-0132" ], "kana": "ひとりのりょこうでした。しみずは、かぜがとてもつよかったです。", "morae": 27 },
    { "ref": "s-18-3#L2", "ids": [ "v-n5-0549", "v-n5-0126", "v-n5-0122", "v-n5-0041", "v-n5-0118", "v-n5-0545", "v-n5-0150", "v-n5-0437", "v-n5-0120", "v-n5-0567", "v-n5-0121", "v-n5-0297", "v-n5-0113", "v-n5-0681", "v-n5-0132" ], "kana": "うみのまつばらで、わたしはてのなかのちずをかぜにとられました。さんまい、ぜんぶです。", "morae": 38 },
    { "ref": "s-18-3#L3", "ids": [ "v-n5-0253", "v-n5-0120", "v-n5-0297", "v-n5-0382", "v-n5-0076", "v-n5-0126", "v-n5-0066", "v-n5-0125", "v-n5-0273", "v-n4-0004", "v-n5-0565", "v-n5-0276", "v-n4-0022" ], "kana": "ぼうしをとられたわかいおんなのひともいました。みんな、そらをみてわらいました。", "morae": 36 },
    { "ref": "s-18-3#L5", "ids": [ "v-n5-0137", "v-n5-0118", "v-n5-0495", "v-n5-0126", "v-n5-0150", "v-n5-0438", "v-n5-0066", "v-n5-0121", "v-n5-0294", "v-n5-0403", "v-n5-0132", "v-n5-0129" ], "kana": "「きょうは、おきゃくさんのなかのりょうりのひとにつくらせます。だいじょうぶですよ」", "morae": 33 },
    { "ref": "s-18-3#L6", "ids": [ "v-n5-0688", "v-n5-0438", "v-n5-0126", "v-n5-0542", "v-n5-0120", "v-n5-0271", "v-n5-0273", "v-n5-0382", "v-n5-0075", "v-n5-0066", "v-n5-0119", "v-n5-0441", "v-n5-0294" ], "kana": "ほんとうに、りょうりのしごとをしているわかいおとこのひとが、ばんごはんをつくらされました。", "morae": 41 },
    { "ref": "s-18-3#L7", "ids": [ "v-n5-0049", "v-n5-0066", "v-n5-0118", "v-n5-0494", "v-n5-0123", "v-n5-0412", "v-n5-0120", "v-n5-0284", "v-n5-0121", "v-n5-0274", "v-n5-0567", "v-n5-0122", "v-n5-0031", "v-n5-0157", "v-n5-0290", "v-n5-0124", "v-n5-0279", "v-n5-0273" ], "kana": "そのひとはいちばへさかなをかいにいかされて、かぜでいちじかんまたされたといっていました。", "morae": 42 },
    { "ref": "s-18-3#L8", "ids": [ "v-n5-0692", "v-n5-0441", "v-n5-0118", "v-n4-0216", "v-n5-0135", "v-n4-0170", "v-n5-0412", "v-n5-0124", "v-n5-0414", "v-n5-0126", "v-n5-0534", "v-n5-0049", "v-n5-0141", "v-n5-0518", "v-n5-0122", "v-n4-0156", "v-n5-0280" ], "kana": "でも、ばんごはんはとくべつでした。やいたさかなとやさいのスープ。さかなは、そのあさ、ふねでとどいたとききました。", "morae": 50 },
    { "ref": "s-18-3#L9", "ids": [ "v-n5-0373", "v-n5-0181", "v-n5-0122", "v-n5-0495", "v-n5-0118", "v-n4-0004", "v-n5-0379", "v-n5-0124", "v-n5-0279", "v-n4-0002", "v-n5-0673", "v-n4-0118" ], "kana": "ながいテーブルで、おきゃくさんはみんな「おいしい」といいました。かれはたくさんほめられました。", "morae": 41 },
    { "ref": "s-18-3#L11", "ids": [ "v-n5-0048", "v-n5-0445", "v-n5-0122", "v-n5-0751", "v-n5-0126", "v-n5-0441", "v-n5-0135", "v-n5-0050", "v-n5-0066", "v-n5-0417", "v-n5-0119", "v-n5-0308", "v-n5-0761", "v-n5-0274" ], "kana": "このりょこうでいちばんのばんごはんでした。あのひとのみせがあいたら、きっといきます。", "morae": 38 },
    { "ref": "s-18-3#L12", "ids": [ "v-n5-0287", "g-n5-033", "v-n5-0118", "v-n5-0041", "v-n5-0121", "v-n5-0354", "v-n5-0437", "v-n5-0120", "v-n5-0343", "v-n5-0439", "v-n5-0154", "v-n5-0122", "v-n5-0750", "v-n5-0356", "v-n5-0132" ], "kana": "かえるまえに、はやしさんはわたしにあたらしいちずをくれました。あさごはんはしちじで、ちょうどいいです。", "morae": 46 },
    { "ref": "s-18-3#L13", "ids": [ "v-n5-0073", "v-n5-0125", "v-n5-0567", "v-n5-0119", "v-n5-0380", "v-n5-0253", "v-n5-0124", "v-n5-0437", "v-n5-0121", "v-n4-0037", "g-n5-051" ], "kana": "みなさんも、かぜがつよかったら、ぼうしとちずにきをつけてください。", "morae": 30 },
    { "ref": "s-18-4#L1", "ids": [ "v-n5-0118", "v-n5-0139", "v-n5-0138", "v-n5-0567", "v-n5-0119", "v-n5-0132", "v-n5-0124", "v-n5-0279", "v-n5-0128" ], "kana": "たなかさんはきのう、「あしたはかぜがないでしょう」といいましたね。", "morae": 28 },
    { "ref": "s-18-4#L2", "ids": [ "v-n5-0692", "v-n5-0141", "v-n5-0130", "v-n5-0549", "v-n5-0126", "v-n5-0567", "v-n5-0119", "v-n5-0671", "v-n5-0380", "v-n5-0132" ], "kana": "でも、あさからうみのかぜがとてもつよかったです。", "morae": 22 },
    { "ref": "s-18-4#L3", "ids": [ "v-n5-0767", "v-n5-0128", "v-n5-0041", "v-n5-0118", "v-n5-0126", "v-n5-0131", "v-n5-0301" ], "kana": "それでね、わたしたちはみほのまつばらまであるきました。", "morae": 25 },
    { "ref": "s-18-4#L4", "ids": [ "v-n5-0567", "v-n5-0126", "v-n5-0804", "v-n5-0119", "v-n5-0350", "v-n5-0589", "v-n5-0125", "v-n4-0183" ], "kana": "かぜのおとがおおきくて、ケンのこえもきこえませんでした。", "morae": 26 },
    { "ref": "s-18-4#L5", "ids": [ "v-n5-0691", "v-n5-0380", "v-n5-0567", "v-n5-0119", "v-n5-0732", "v-n5-0275", "v-n5-0041", "v-n5-0118", "v-n5-0253", "v-n5-0120", "v-n5-0334" ], "kana": "そして、つよいかぜがふいてきて、わたしはぼうしをとばされました。", "morae": 29 },
    { "ref": "s-18-4#L6", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0297", "v-n5-0119", "v-n4-0207" ], "kana": "わたしはとろうとしましたが、まにあいませんでした。", "morae": 23 },
    { "ref": "s-18-4#L7", "ids": [ "v-n5-0253", "v-n5-0118", "v-n5-0565", "v-n5-0123", "v-n4-0176", "v-n5-0549", "v-n5-0126", "v-n5-0148", "v-n5-0131", "v-n5-0334", "v-n5-0274" ], "kana": "ぼうしはそらへあがって、うみのうえまでとんでいきました。", "morae": 26 },
    { "ref": "s-18-4#L8", "ids": [ "v-n5-0569", "v-n5-0124", "v-n5-0683", "v-n5-0334", "v-n5-0676", "v-n5-0056", "v-n5-0121", "v-n5-0125", "v-n4-0182" ], "kana": "とりといっしょにとんで、もうどこにもみえませんでした。", "morae": 24 },
    { "ref": "s-18-4#L9", "ids": [ "v-n5-0041", "v-n5-0126", "v-n5-0152", "v-n5-0121", "v-n5-0273", "v-n5-0066", "v-n5-0125", "v-n5-0567", "v-n5-0437", "v-n5-0120", "v-n5-0113", "v-n5-0334" ], "kana": "わたしのまえにいたひとも、かぜにちずをさんまい、とばされました。", "morae": 29 },
    { "ref": "s-18-4#L10", "ids": [ "v-n5-0437", "v-n5-0118", "v-n5-0568", "v-n5-0126", "v-n5-0187", "v-n5-0120", "v-n5-0334", "v-n5-0274", "v-n4-0187", "v-n5-0275" ], "kana": "ちずはきのあいだをとんでいって、もどってきませんでした。", "morae": 26 },
    { "ref": "s-18-4#L11", "ids": [ "v-n4-0004", "v-n5-0122", "v-n5-0565", "v-n5-0120", "v-n5-0276", "v-n5-0350", "v-n5-0589", "v-n4-0022" ], "kana": "みんなでそらをみて、おおきいこえでわらいました。", "morae": 22 },
    { "ref": "s-18-4#L12", "ids": [ "v-n5-0242", "v-n5-0567", "v-n5-0126", "v-n5-0150", "v-n5-0120", "v-n5-0301", "v-n5-0498", "v-n5-0121", "v-n5-0305" ], "kana": "ゆうがた、かぜのなかをあるいて、はやしさんのところにつきました。", "morae": 29 },
    { "ref": "s-18-4#L13", "ids": [ "v-n5-0438", "v-n5-0126", "v-n5-0066", "v-n5-0119", "v-n5-0137", "v-n5-0578", "v-n5-0122", "v-n5-0118", "v-n5-0718", "v-n5-0273" ], "kana": "りょうりのひとがきょう、やすみで、はやしさんはこまっていました。", "morae": 27 },
    { "ref": "s-18-4#L14", "ids": [ "v-n5-0767", "v-n5-0128", "v-n5-0118", "v-n5-0121", "v-n5-0441", "v-n5-0120", "v-n5-0294" ], "kana": "それでね、はやしさんはケンにばんごはんをつくらせました。", "morae": 26 },
    { "ref": "s-18-4#L15", "ids": [ "v-n5-0495", "v-n5-0118", "v-n5-0112", "v-n5-0125", "v-n5-0273", "v-n4-0092" ], "kana": "おきゃくさんはじゅうににんもいるので、ケンはおどろいていました。", "morae": 28 },
    { "ref": "s-18-4#L16", "ids": [ "v-n5-0118", "v-n5-0412", "v-n5-0120", "v-n5-0284", "v-n5-0121", "v-n5-0494", "v-n5-0123", "v-n5-0274" ], "kana": "ケンはさかなをかいにいちばへいかされました。", "morae": 21 },
    { "ref": "s-18-4#L17", "ids": [ "v-n5-0692", "v-n5-0567", "v-n5-0122", "v-n5-0518", "v-n5-0119", "v-n4-0208", "v-n5-0031", "v-n5-0157", "v-n5-0125", "v-n5-0290" ], "kana": "でも、かぜでふねがおくれて、いちじかんもまたされました。", "morae": 25 },
    { "ref": "s-18-4#L18", "ids": [ "v-n5-0136", "v-n5-0118", "v-n5-0229", "v-n5-0122", "v-n4-0004", "v-n5-0126", "v-n5-0412", "v-n5-0120", "v-n4-0170", "v-n5-0273" ], "kana": "いま、ケンはだいどころで、みんなのさかなをやいています。", "morae": 25 },
    { "ref": "s-18-4#L19", "ids": [ "v-n5-0674", "v-n4-0024", "v-n5-0273", "v-n5-0119", "v-n5-0761", "v-n4-0004", "v-n5-0121", "v-n4-0118", "v-n5-0129" ], "kana": "すこしおこっていますが、きっとみんなにほめられますよ。", "morae": 25 },
    { "ref": "s-18-4#L20", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0136", "v-n5-0130", "v-n5-0425", "v-n5-0123", "v-n5-0274", "v-n5-0354", "v-n5-0253", "v-n5-0120", "v-n5-0284", "v-n5-0124", "v-n5-0801" ], "kana": "わたしはいまからまちへいって、あたらしいぼうしをかおうとおもいます。", "morae": 32 },
    { "ref": "s-18-4#L21", "ids": [ "v-n5-0166", "v-n5-0126", "v-n5-0120", "v-n4-0189", "v-n5-0124", "v-n5-0801", "v-n5-0273", "v-n5-0549", "v-n5-0565", "v-n5-0160", "v-n5-0132" ], "kana": "あおいのをえらぼうとおもっています。うみとそらのいろです。", "morae": 27 },
    { "ref": "s-18-4#L22", "ids": [ "v-n5-0767", "v-n5-0138", "v-n5-0126", "v-n5-0547", "v-n5-0118", "v-n5-0060", "v-n5-0806", "v-n5-0132", "v-n5-0127" ], "kana": "それで、たなかさん。あしたのてんきはどうなるでしょうか。", "morae": 24 },
    { "ref": "s-18-4#L23", "ids": [ "v-n5-0119", "v-n5-0595", "v-n5-0124", "v-n5-0279", "v-n5-0041", "v-n5-0118", "v-n5-0171", "v-n5-0120", "v-n5-0296", "v-n5-0274" ], "kana": "たなかさんが「はれ」といったら、わたしはかさをもっていきます。", "morae": 27 },
    { "ref": "s-18-5#L1", "ids": [ "v-n5-0132", "v-n5-0127", "v-n5-0234", "v-n4-0203", "v-n5-0498", "v-n5-0126" ], "kana": "ケンさんですか。こんばんとまるところの、はやしです。", "morae": 23 },
    { "ref": "s-18-5#L2", "ids": [ "v-n5-0702", "v-n5-0006", "v-n5-0136", "v-n5-0124", "v-n5-0126", "v-n5-0549", "v-n5-0121", "v-n5-0273" ], "kana": "ああ、はやしさん。こんにちは。いま、ハナとみほのうみにいます。", "morae": 26 },
    { "ref": "s-18-5#L3", "ids": [ "v-n5-0567", "v-n5-0119", "v-n5-0380", "v-n5-0132", "v-n5-0253", "v-n5-0120", "v-n5-0334", "g-n5-051", "v-n5-0128" ], "kana": "かぜがつよいでしょう。ぼうしをとばされないでくださいね。", "morae": 25 },
    { "ref": "s-18-5#L4", "ids": [ "v-n5-0676", "v-n5-0370", "v-n5-0132", "v-n5-0126", "v-n5-0253", "v-n5-0118", "v-n5-0763", "v-n5-0549", "v-n5-0123", "v-n5-0334", "v-n5-0274" ], "kana": "もうおそいです。ハナのぼうしは、さっきうみへとんでいきました。", "morae": 28 },
    { "ref": "s-18-5#L5", "ids": [ "v-n5-0046", "v-n5-0118", "v-n5-0400", "v-n5-0135", "v-n5-0128", "v-n5-0785", "v-n5-0119", "v-n5-0272", "v-n5-0543", "v-n5-0271" ], "kana": "それはたいへんでしたね。ケンさん、おねがいがあって、でんわしました。", "morae": 30 },
    { "ref": "s-18-5#L6", "ids": [ "v-n5-0001", "v-n5-0054", "v-n5-0132", "v-n5-0127" ], "kana": "はい、なんでしょうか。", "morae": 8 },
    { "ref": "s-18-5#L7", "ids": [ "v-n5-0137", "v-n5-0146", "v-n5-0126", "v-n5-0438", "v-n5-0066", "v-n5-0121", "v-n5-0318", "v-n5-0718", "v-n5-0273" ], "kana": "きょう、うちのりょうりのひとにやすまれてしまって、こまっています。", "morae": 28 },
    { "ref": "s-18-5#L8", "ids": [ "v-n5-0003" ], "kana": "ええ。", "morae": 2 },
    { "ref": "s-18-5#L9", "ids": [ "v-n5-0118", "v-n5-0438", "v-n5-0126", "v-n5-0066", "v-n5-0132", "v-n5-0543", "v-n5-0122", "v-n5-0229", "v-n5-0120", "v-n5-0673", "v-n5-0280", "v-n5-0129" ], "kana": "ケンさんは、りょうりのひとですよね。でんわでだいどころのことを、たくさんきかれましたよ。", "morae": 39 },
    { "ref": "s-18-5#L10", "ids": [ "v-n5-0001", "v-n5-0132" ], "kana": "はい、そうです。", "morae": 6 },
    { "ref": "s-18-5#L11", "ids": [ "v-n5-0767", "v-n5-0234", "v-n5-0495", "v-n5-0126", "v-n5-0441", "v-n5-0120", "v-n5-0294", "v-n5-0342", "v-n5-0127" ], "kana": "それで、こんばん、おきゃくさんのばんごはんをつくってもらえませんか。", "morae": 30 },
    { "ref": "s-18-5#L12", "ids": [ "v-n5-0441", "v-n5-0132", "v-n5-0127", "v-n5-0495", "v-n5-0118", "v-n5-0054", "v-n5-0066" ], "kana": "ばんごはんですか。おきゃくさんはなんにんですか。", "morae": 21 },
    { "ref": "s-18-5#L13", "ids": [ "v-n4-0007", "v-n5-0119", "v-n5-0112", "v-n5-0124", "v-n5-0071", "v-n5-0096", "v-n5-0132", "v-n5-0681", "v-n5-0122", "v-n5-0128" ], "kana": "おとながじゅうにんと、こどもがふたりです。ぜんぶでじゅうににんですね。", "morae": 30 },
    { "ref": "s-18-5#L14", "ids": [ "v-n5-0112", "v-n5-0132", "v-n5-0127", "v-n5-0229", "v-n5-0136", "v-n5-0054", "v-n5-0119", "v-n5-0272" ], "kana": "じゅうににんですか。だいどころには、いま、なにがありますか。", "morae": 25 },
    { "ref": "s-18-5#L15", "ids": [ "v-n5-0414", "v-n5-0124", "v-n5-0413", "v-n5-0118", "v-n5-0673", "v-n5-0272", "v-n5-0692", "v-n5-0412", "v-n5-0119", "v-n5-0677" ], "kana": "やさいとたまごはたくさんあります。でも、さかながまだありません。", "morae": 29 },
    { "ref": "s-18-5#L16", "ids": [ "v-n5-0567", "v-n5-0122", "v-n5-0518", "v-n5-0119", "v-n4-0208", "v-n5-0273", "v-n5-0412", "v-n5-0118", "v-n5-0154", "g-n5-015", "v-n5-0494", "v-n5-0121", "v-n4-0156" ], "kana": "かぜでふねがおくれていて、さかなはよじごろいちばにとどきます。", "morae": 29 },
    { "ref": "s-18-5#L17", "ids": [ "v-n5-0132", "v-n5-0127", "v-n5-0567", "v-n5-0118", "v-n5-0677", "v-n5-0380", "v-n5-0130", "v-n5-0128" ], "kana": "そうですか。かぜは、まだつよいですからね。", "morae": 18 },
    { "ref": "s-18-5#L18", "ids": [ "v-n5-0494", "v-n5-0696", "v-n5-0674", "v-n5-0290", "v-n5-0124", "v-n5-0801", "v-n5-0013", "v-n5-0128" ], "kana": "いちばでは、すこしまたされるとおもいます。すみませんね。", "morae": 25 },
    { "ref": "s-18-5#L19", "ids": [ "v-n5-0403", "v-n5-0132", "v-n5-0695", "v-n5-0234", "v-n5-0126", "v-n5-0441", "v-n5-0118", "v-n4-0005", "v-n5-0121", "v-n5-0294", "g-n5-051" ], "kana": "だいじょうぶです。じゃあ、こんばんのばんごはんは、ぼくにつくらせてください。", "morae": 32 },
    { "ref": "s-18-5#L20", "ids": [ "v-n5-0702", "v-n5-0356", "v-n5-0010", "v-n5-0229", "v-n5-0118", "v-n5-0681", "v-n5-0295", "g-n5-051", "v-n5-0128" ], "kana": "ああ、よかった。ありがとうございます。だいどころは、ぜんぶつかってくださいね。", "morae": 34 },
    { "ref": "s-18-5#L21", "ids": [ "v-n5-0154", "v-n5-0121", "v-n5-0494", "v-n5-0123", "v-n5-0274", "v-n5-0412", "v-n5-0120", "v-n5-0284", "v-n5-0131", "v-n5-0190", "v-n5-0305" ], "kana": "よじにいちばへいって、さかなをかって、ごじまでにはそちらにつきます。", "morae": 31 },
    { "ref": "s-18-5#L22", "ids": [ "v-n5-0285", "v-n5-0121", "v-n5-0125", "v-n4-0209", "v-n5-0298", "g-n5-051", "v-n5-0128" ], "kana": "わかりました。ハナさんにも、つたえておいてくださいね。", "morae": 24 },
    { "ref": "s-18-5#L23", "ids": [ "v-n5-0001", "v-n5-0696", "v-n5-0028" ], "kana": "はい。では、しつれいします。", "morae": 11 },
    { "ref": "g-n4-002#ex3", "ids": [ "g-n4-002", "v-n5-0174", "v-n5-0119", "v-n5-0424", "v-n5-0121", "v-n4-0150", "v-n5-0273", "v-n5-0126", "v-n5-0120", "v-n4-0140" ], "kana": "さいふがみちにおちているのをみつけた。", "morae": 18 },
    { "ref": "g-n4-004#ex3", "ids": [ "g-n4-004", "v-n4-0214", "v-n5-0238", "v-n5-0120", "v-n4-0151", "v-n4-0153" ], "kana": "だいじなカメラをおとしてこわしてしまった。", "morae": 20 },
    { "ref": "g-n4-021#ex0", "ids": [ "g-n4-021", "v-n5-0137", "v-n5-0068", "v-n5-0121", "v-n4-0118" ], "kana": "きょう、せんせいにほめられました。", "morae": 14 },
    { "ref": "g-n4-021#ex1", "ids": [ "g-n4-021", "v-n5-0419", "v-n5-0122", "v-n5-0286", "v-n5-0066", "v-n5-0121", "v-n5-0424", "v-n5-0120", "v-n5-0280" ], "kana": "えきでしらないひとにみちをきかれた。", "morae": 17 },
    { "ref": "g-n4-022#ex0", "ids": [ "g-n4-022", "v-n5-0287", "v-n5-0121", "v-n5-0550", "v-n5-0340", "v-n5-0400" ], "kana": "かえりにあめにふられて、たいへんだった。", "morae": 18 },
    { "ref": "g-n4-022#ex1", "ids": [ "g-n4-022", "v-n5-0420", "v-n5-0122", "v-n5-0174", "v-n5-0120" ], "kana": "でんしゃでさいふをぬすまれました。", "morae": 15 },
    { "ref": "g-n4-022#ex2", "ids": [ "g-n4-022", "v-n5-0087", "v-n5-0121", "v-n5-0041", "v-n5-0126", "v-n5-0481", "v-n5-0120", "v-n5-0277" ], "kana": "おとうとにわたしのケーキをたべられた。", "morae": 18 },
    { "ref": "g-n4-022#ex3", "ids": [ "g-n4-022", "v-n5-0143", "g-n5-033", "v-n5-0070", "v-n5-0121", "v-n5-0275", "v-n5-0289" ], "kana": "よなかにともだちにこられて、ねられなかった。", "morae": 20 },
    { "ref": "g-n4-023#ex0", "ids": [ "g-n4-023", "v-n5-0082", "v-n5-0118", "v-n5-0087", "v-n5-0121", "v-n5-0414", "v-n5-0120", "v-n5-0277" ], "kana": "はははおとうとにやさいをたべさせた。", "morae": 17 },
    { "ref": "g-n4-023#ex2", "ids": [ "g-n4-023", "v-n5-0068", "v-n5-0118", "v-n5-0069", "v-n5-0120", "v-n5-0369", "v-n5-0287" ], "kana": "せんせいはがくせいをはやくかえらせた。", "morae": 18 },
    { "ref": "g-n4-023#ex4", "ids": [ "g-n4-023", "v-n5-0071", "v-n5-0120", "v-n5-0095", "v-n5-0122", "v-n5-0445", "v-n5-0121", "v-n5-0274", "v-n5-0126", "v-n5-0118", "v-n5-0715" ], "kana": "こどもをひとりでりょこうにいかせるのはしんぱいだ。", "morae": 23 },
    { "ref": "g-n4-024#ex1", "ids": [ "g-n4-024", "v-n5-0071", "v-n4-0142", "v-n5-0082", "v-n5-0121", "v-n5-0140", "v-n5-0414", "v-n5-0120", "v-n5-0277" ], "kana": "こどものころ、ははにまいにちやさいをたべさせられた。", "morae": 24 },
    { "ref": "g-n4-024#ex2", "ids": [ "g-n4-024", "v-n5-0419", "v-n5-0122", "v-n5-0070", "v-n5-0121", "v-n5-0031", "v-n5-0157", "v-n5-0125", "v-n5-0290" ], "kana": "えきでともだちにいちじかんもまたされました。", "morae": 21 },
    { "ref": "g-n4-024#ex3", "ids": [ "g-n4-024", "v-n5-0740", "v-n5-0122", "v-n5-0470", "v-n5-0120", "v-n5-0673", "v-n5-0278" ], "kana": "パーティーでおさけをたくさんのまされた。", "morae": 18 },
    { "ref": "g-n4-025#ex0", "ids": [ "g-n4-025", "v-n5-0137", "v-n5-0118", "v-n5-0577", "v-n5-0119", "v-n5-0272", "v-n5-0318", "g-n5-051" ], "kana": "きょうはねつがあるので、やすませてください。", "morae": 19 },
    { "ref": "g-n4-025#ex2", "ids": [ "g-n4-025", "v-n5-0404", "v-n5-0122", "v-n5-0674", "v-n4-0021", "g-n5-051" ], "kana": "たいせつなことなので、すこしかんがえさせてください。", "morae": 24 },
    { "ref": "g-n4-025#ex3", "ids": [ "g-n4-025", "v-n5-0239", "v-n5-0119", "v-n5-0377", "v-n5-0023", "v-n5-0296", "g-n5-051" ], "kana": "にもつがおもそうですね。もたせてください。", "morae": 19 },
    { "ref": "g-n4-025#ex4", "ids": [ "g-n4-025", "v-n5-0138", "v-n5-0126", "v-n5-0579", "v-n5-0121", "v-n5-0118", "v-n5-0041", "v-n5-0125", "v-n5-0293", "g-n5-051" ], "kana": "あしたのかいぎにはわたしもでさせてください。", "morae": 21 },
    { "ref": "g-n4-026#ex0", "ids": [ "g-n4-026", "v-n5-0137", "v-n5-0118", "v-n5-0041", "v-n5-0119", "v-n5-0710", "v-n5-0593", "v-n5-0545", "v-n5-0015" ], "kana": "きょうはわたしがせつめいさせていただきます。", "morae": 20 },
    { "ref": "g-n4-026#ex1", "ids": [ "g-n4-026", "v-n5-0201", "v-n5-0211", "v-n5-0318", "v-n5-0126", "v-n5-0132", "v-n5-0119" ], "kana": "らいしゅう、みっかほどやすませていただきたいのですが。", "morae": 24 },
    { "ref": "g-n4-026#ex2", "ids": [ "g-n4-026", "v-n5-0436", "v-n5-0120", "v-n5-0726", "v-n5-0273" ], "kana": "しゃしんをとらせていただけませんか。", "morae": 16 },
    { "ref": "g-n4-026#ex3", "ids": [ "g-n4-026", "v-n5-0696", "v-n5-0766", "v-n4-0102", "v-n5-0593", "v-n5-0545", "v-n5-0015" ], "kana": "では、さきにしつれいさせていただきます。", "morae": 18 },
    { "ref": "g-n4-026#ex4", "ids": [ "g-n4-026", "v-n5-0579", "v-n5-0126", "v-n5-0157", "v-n5-0120", "v-n4-0135" ], "kana": "かいぎのじかんをかえさせていただきました。", "morae": 20 },
    { "ref": "g-n4-027#ex0", "ids": [ "g-n4-027", "v-n5-0137", "v-n5-0118", "v-n5-0717", "v-n5-0130", "v-n5-0676", "v-n5-0287" ], "kana": "きょうはつかれたから、もうかえろう。", "morae": 15 },
    { "ref": "g-n4-027#ex2", "ids": [ "g-n4-027", "v-n5-0208", "v-n5-0130", "v-n5-0687", "v-n5-0080", "v-n5-0120", "v-n5-0703", "v-n5-0271" ], "kana": "らいげつから、もっとにほんごをべんきょうしよう。", "morae": 21 },
    { "ref": "g-n4-027#ex3", "ids": [ "g-n4-027", "v-n5-0547", "v-n5-0119", "v-n5-0356", "v-n5-0130", "v-n5-0433", "v-n5-0122", "v-n5-0459", "v-n5-0120", "v-n5-0277" ], "kana": "てんきがいいから、こうえんでおべんとうをたべよう。", "morae": 23 },
    { "ref": "g-n4-027#ex4", "ids": [ "g-n4-027", "v-n5-0138", "v-n5-0118", "v-n5-0369", "v-n5-0288", "v-n5-0302" ], "kana": "あしたははやくおきて、はしろう。", "morae": 14 },
    { "ref": "g-n4-028#ex1", "ids": [ "g-n4-028", "v-n5-0137", "v-n5-0118", "v-n5-0369", "v-n5-0289", "v-n5-0124", "v-n5-0801" ], "kana": "きょうははやくねようとおもう。", "morae": 13 },
    { "ref": "g-n4-028#ex2", "ids": [ "g-n4-028", "v-n5-0354", "v-n5-0737", "v-n5-0120", "v-n5-0284", "v-n5-0124", "v-n5-0801" ], "kana": "あたらしいパソコンをかおうとおもっているんだ。", "morae": 22 },
    { "ref": "g-n4-028#ex3", "ids": [ "g-n4-028", "v-n5-0225", "v-n5-0578", "v-n5-0121", "v-n5-0054", "v-n5-0120", "v-n5-0271", "v-n5-0124", "v-n5-0801", "v-n5-0273", "v-n5-0127" ], "kana": "なつやすみになにをしようとおもっていますか。", "morae": 21 },
    { "ref": "g-n4-029#ex0", "ids": [ "g-n4-029", "v-n5-0178", "v-n5-0120", "v-n5-0306", "v-n5-0119", "v-n5-0308" ], "kana": "まどをあけようとしたが、あかなかった。", "morae": 17 },
    { "ref": "g-n4-029#ex1", "ids": [ "g-n4-029", "v-n5-0145", "v-n5-0120", "v-n5-0293", "v-n5-0124", "v-n5-0271", "v-n5-0568", "v-n5-0543", "v-n5-0119", "v-n4-0137" ], "kana": "いえをでようとしたとき、でんわがなった。", "morae": 18 },
    { "ref": "g-n4-029#ex3", "ids": [ "g-n4-029", "v-n5-0553", "v-n5-0119", "v-n5-0412", "v-n5-0120", "v-n5-0297", "v-n5-0273" ], "kana": "ねこがさかなをとろうとしている。", "morae": 15 },
    { "ref": "g-n4-029#ex4", "ids": [ "g-n4-029", "v-n5-0420", "v-n5-0121", "v-n5-0303", "v-n5-0179", "v-n5-0119", "v-n5-0309" ], "kana": "でんしゃにのろうとしたら、ドアがしまってしまった。", "morae": 22 },
    { "ref": "g-n4-030#ex1", "ids": [ "g-n4-030", "v-n5-0239", "v-n5-0377", "v-n5-0128", "v-n5-0296", "v-n5-0127" ], "kana": "にもつ、おもそうだね。もとうか？", "morae": 13 },
    { "ref": "g-n4-030#ex2", "ids": [ "g-n4-030", "v-n5-0137", "v-n5-0126", "v-n5-0441", "v-n5-0054", "v-n5-0121", "v-n5-0271", "v-n5-0127" ], "kana": "きょうのばんごはん、なににしようか。", "morae": 15 },
    { "ref": "g-n4-030#ex4", "ids": [ "g-n4-030", "v-n5-0285", "v-n5-0683", "v-n4-0021" ], "kana": "わからないなら、いっしょにかんがえようか？", "morae": 18 },
