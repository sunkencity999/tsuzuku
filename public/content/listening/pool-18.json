    { "ref": "v-n4-0150#ex0", "ids": [ "v-n4-0150", "v-n5-0176", "v-n5-0130", "v-n5-0102", "v-n5-0119", "v-n5-0129" ], "kana": "つくえからペンがおちたよ。", "morae": 12 },
