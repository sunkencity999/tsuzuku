    { "ref": "v-n4-0160#ex1", "ids": [ "v-n4-0160", "v-n5-0550", "v-n5-0119", "v-n5-0380", "v-n5-0662", "v-n5-0118", "v-n5-0421", "v-n5-0120" ], "kana": "あめがつよくて、うんてんしゅはバスをとめた。", "morae": 19 },
    { "ref": "v-n4-0161#ex0", "ids": [ "v-n4-0161", "v-n5-0427", "v-n5-0120" ], "kana": "たなかさん、かいしゃをやめるんだって。", "morae": 16 },
    { "ref": "v-n4-0161#ex1", "ids": [ "v-n4-0161", "v-n4-0115", "v-n5-0126", "v-n5-0120", "v-n4-0021", "v-n5-0470" ], "kana": "けんこうのことをかんがえて、おさけをやめました。", "morae": 22 },
