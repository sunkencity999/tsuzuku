    { "ref": "v-n4-0084#ex0", "ids": [ "v-n4-0084", "v-n5-0358", "v-n5-0122", "v-n5-0066", "v-n5-0119", "v-n4-0146", "v-n5-0273", "v-n5-0022" ], "kana": "あつさでたおれるひとがふえているそうです。", "morae": 20 },
    { "ref": "v-n4-0145#ex0", "ids": [ "v-n4-0145", "v-n5-0087", "v-n5-0118", "v-n5-0355", "v-n5-0613", "v-n5-0120", "v-n5-0273" ], "kana": "おとうとはふるいきってをあつめている。", "morae": 18 },
