    { "ref": "v-n4-0165#ex0", "ids": [ "v-n4-0165", "v-n5-0419", "v-n5-0126", "v-n5-0185", "v-n5-0121", "v-n5-0354", "v-n5-0457", "v-n5-0119" ], "kana": "えきのちかくにあたらしいホテルがたちました。", "morae": 21 },
