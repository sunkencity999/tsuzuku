    { "ref": "v-n4-0147#ex0", "ids": [ "v-n4-0147", "v-n5-0205", "v-n5-0118", "v-n5-0578", "v-n5-0120" ], "kana": "らいねんはやすみをふやしたい。", "morae": 14 },
