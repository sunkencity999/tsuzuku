{
  "schema": "tsuzuku.pool/1",
  "station": 17,
  "refs": [
    { "ref": "s-06-1#L17", "ids": [ "v-n5-0149", "v-n5-0121", "v-n5-0166", "v-n5-0102", "v-n5-0122", "v-n5-0282", "v-n5-0225", "v-n4-0138" ], "kana": "したにあおいペンでかきました。「なつに、つづく」。", "morae": 20 },
    { "ref": "s-17-1#L0", "ids": [ "v-n5-0218", "v-n5-0211", "v-n5-0595", "v-n5-0439", "v-n5-0118", "v-n5-0154", "v-n5-0156", "v-n5-0135" ], "kana": "しちがつにじゅうしちにち、はれ。あさごはんはろくじはんでした。", "morae": 27 },
    { "ref": "s-17-1#L1", "ids": [ "v-n5-0154", "v-n5-0156", "v-n5-0118", "v-n5-0674", "v-n5-0369", "v-n5-0692", "v-n5-0567", "v-n5-0119", "v-n5-0676", "v-n5-0358", "v-n5-0132" ], "kana": "ろくじはんはすこしはやすぎます。でも、かぜがなくて、もうあついです。", "morae": 30 },
    { "ref": "s-17-1#L2", "ids": [ "v-n5-0126", "v-n5-0549", "v-n5-0118", "v-n5-0386", "v-n5-0546", "v-n5-0119", "v-n5-0562", "v-n5-0642", "v-n5-0132" ], "kana": "おきつのうみはしずかで、めがいたいほどあかるいです。", "morae": 24 },
    { "ref": "s-17-1#L6", "ids": [ "v-n5-0063", "v-n5-0067", "v-n5-0118", "v-n5-0678", "v-n5-0041", "v-n5-0766", "v-n5-0273", "v-n5-0126", "v-n5-0132", "v-n5-0585", "v-n5-0420", "v-n5-0122" ], "kana": "なぜたなかさんはいつもわたしたちよりさきにいるのでしょう。こたえはいつも「でんしゃで」だけです。", "morae": 42 },
    { "ref": "s-17-1#L7", "ids": [ "v-n5-0136", "v-n5-0154", "v-n5-0155", "v-n5-0132", "v-n5-0300", "v-n5-0406", "v-n5-0120", "v-n5-0278" ], "kana": "「いま、くじじゅうにふんです。すわりなさい。みずをのみなさい。」", "morae": 25 },
    { "ref": "s-17-1#L8", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0300", "v-n5-0278", "v-n5-0420", "v-n5-0119", "v-n5-0302", "v-n5-0124", "v-n5-0067", "v-n5-0172", "v-n5-0120", "v-n5-0276", "v-n5-0674", "v-n4-0022" ], "kana": "わたしたちはすわって、のみました。でんしゃがはしると、たなかさんはとけいをみて、すこしわらいました。", "morae": 44 },
    { "ref": "s-17-1#L9", "ids": [ "v-n5-0067", "v-n5-0118", "v-n4-0106", "v-n5-0132", "v-n5-0692", "v-n5-0049", "v-n4-0107" ], "kana": "たなかさんはきびしいです。でも、そのきびしさはやさしさです。", "morae": 27 },
    { "ref": "s-17-1#L11", "ids": [ "v-n4-0106", "v-n5-0587", "v-n5-0132", "v-n5-0118", "v-n5-0351", "v-n5-0589", "v-n5-0122", "v-n5-0067", "v-n5-0126", "v-n5-0124", "v-n5-0279" ], "kana": "きびしいじです。ケンはちいさいこえで「たなかさんのじ？」といいました。", "morae": 30 },
    { "ref": "s-17-1#L13", "ids": [ "v-n5-0225", "v-n5-0121", "v-n5-0537", "v-n5-0067", "v-n5-0118", "v-n5-0277", "g-n4-015", "v-n5-0124", "v-n5-0279", "v-n5-0111", "v-n5-0343" ], "kana": "なつにみかん？しみずさんは「たべてみなさい」といって、ひとつくれました。", "morae": 31 },
    { "ref": "s-17-1#L14", "ids": [ "v-n5-0351", "v-n5-0361", "v-n5-0672", "v-n5-0446", "v-n5-0132", "v-n5-0692", "v-n5-0137", "v-n5-0118", "v-n5-0045", "v-n5-0122", "v-n5-0750", "v-n5-0356" ], "kana": "ちいさくて、つめたくて、あまりあまくないです。でも、きょうはこれでちょうどいいです。", "morae": 35 },
    { "ref": "s-17-1#L15", "ids": [ "v-n5-0067", "v-n5-0118", "v-n5-0279", "v-n5-0537", "v-n5-0227", "v-n5-0119", "v-n5-0751", "v-n5-0132", "v-n5-0129", "v-n5-0131", "v-n5-0290" ], "kana": "しみずさんはいいました。「みかんはふゆがいちばんですよ。ふゆまでまちなさい。」", "morae": 34 },
    { "ref": "s-17-1#L16", "ids": [ "v-n5-0358", "v-n5-0547", "v-n5-0119", "v-n4-0138", "v-n5-0275", "v-n5-0692", "v-n5-0674", "v-n4-0120", "v-n5-0045", "v-n5-0130", "v-n5-0125", "v-n5-0274" ], "kana": "あついてんきがつづいてきました。でも、すこしずつなれてきました。これからもなれていきます。", "morae": 41 },
    { "ref": "s-17-1#L17", "ids": [ "v-n5-0126", "v-n5-0442", "v-n5-0118", "v-n5-0225", "v-n5-0537", "v-n5-0121", "v-n4-0133" ], "kana": "おきつのたべものは、なつのみかんにきめました。", "morae": 21 },
    { "ref": "s-17-1#L18", "ids": [ "v-n5-0242", "v-n5-0067", "v-n5-0119", "v-n5-0279", "v-n5-0138", "v-n5-0118", "v-n5-0369", "v-n5-0293", "v-n5-0567", "v-n5-0386", "v-n5-0132" ], "kana": "ゆうがた、たなかさんがいいました。「あしたははやくでなさい。かぜはしずかでしょう。」", "morae": 35 },
    { "ref": "s-17-1#L19", "ids": [ "v-n5-0697", "v-n5-0138", "v-n5-0118", "v-n5-0567", "v-n5-0132", "v-n5-0253", "v-n5-0120", "v-n5-0296", "v-n5-0274" ], "kana": "だから、あしたはかぜです。ぼうしをもっていきます。", "morae": 22 },
    { "ref": "s-17-2#L0", "ids": [ "v-n5-0225", "v-n5-0126", "v-n5-0537", "v-n5-0111", "v-n5-0277", "v-n5-0276", "v-n5-0361", "v-n5-0129" ], "kana": "なつのみかん、ひとつたべてみて。つめたいよ。", "morae": 19 },
    { "ref": "s-17-2#L1", "ids": [ "v-n5-0225", "v-n5-0121", "v-n5-0537", "v-n5-0695", "v-n5-0111", "v-n5-0015" ], "kana": "なつにみかん？じゃあ、ひとつ。いただきます。", "morae": 17 },
    { "ref": "s-17-2#L2", "ids": [ "v-n5-0067", "v-n4-0005", "v-n5-0121", "v-n5-0125", "v-n5-0111" ], "kana": "しみずさん、ぼくにもひとつ。", "morae": 12 },
    { "ref": "s-17-2#L4", "ids": [ "v-n5-0225", "v-n5-0126", "v-n5-0118", "v-n5-0677", "v-n5-0382", "v-n5-0227", "v-n5-0131", "v-n5-0290", "v-n5-0687", "v-n5-0446", "v-n5-0129" ], "kana": "そうだろう。なつのはまだわかい。ふゆまでまてば、もっとあまいよ。", "morae": 28 },
    { "ref": "s-17-2#L5", "ids": [ "v-n5-0382", "v-n5-0126", "v-n5-0125", "v-n5-0357", "v-n5-0438", "v-n5-0121", "v-n5-0295" ], "kana": "わかいのもわるくない。りょうりにつかえる。", "morae": 18 },
    { "ref": "s-17-2#L6", "ids": [ "v-n5-0702", "v-n5-0438", "v-n5-0120", "v-n5-0271", "v-n5-0066", "v-n5-0127", "v-n5-0695", "v-n5-0117", "v-n5-0296", "v-n4-0087", "v-n5-0353", "v-n5-0129" ], "kana": "ああ、りょうりをするひとか。じゃあ、じゅっこもっていきなさい。やすくするよ。", "morae": 30 },
    { "ref": "s-17-2#L7", "ids": [ "v-n5-0681", "v-n5-0277", "v-n5-0129", "v-n5-0041", "v-n5-0126", "v-n5-0125", "v-n4-0143", "v-n5-0298" ], "kana": "ケン、ぜんぶたべるなよ。わたしのものこしておいて。", "morae": 22 },
    { "ref": "s-17-2#L8", "ids": [ "v-n5-0285" ], "kana": "わかってるって。", "morae": 7 },
    { "ref": "s-17-2#L9", "ids": [ "v-n5-0136", "v-n5-0154", "v-n5-0155", "v-n5-0132", "v-n5-0417", "v-n5-0126", "v-n5-0172", "v-n5-0118", "v-n5-0338", "v-n5-0128" ], "kana": "いま、じゅうじよんぷんです。みせのとけいはいっぷんちがいますね。", "morae": 28 },
    { "ref": "s-17-2#L10", "ids": [ "v-n5-0172", "v-n5-0118", "v-n5-0355", "v-n5-0130", "v-n5-0692", "v-n5-0752", "v-n5-0125", "v-n5-0721", "v-n5-0119" ], "kana": "とけいはふるいから。でも、いちどもとまったことがない。", "morae": 24 },
    { "ref": "s-17-2#L11", "ids": [ "v-n5-0046", "v-n5-0118", "v-n4-0108", "v-n5-0172", "v-n5-0132" ], "kana": "それはえらいとけいです。", "morae": 11 },
    { "ref": "s-17-2#L13", "ids": [ "v-n5-0696", "v-n5-0015", "v-n5-0702", "v-n5-0382", "v-n5-0132", "v-n5-0128", "v-n5-0227", "v-n5-0121", "v-n5-0686", "v-n5-0275" ], "kana": "では、いただきます。ああ、わかいですね。ふゆにまたきなさい。", "morae": 25 },
    { "ref": "s-17-2#L14", "ids": [ "v-n5-0227", "v-n5-0121", "v-n5-0686", "v-n5-0275" ], "kana": "ケン、ふゆにまたこられる？", "morae": 11 },
    { "ref": "s-17-2#L15", "ids": [ "v-n5-0227", "v-n5-0118", "v-n5-0129" ], "kana": "ふゆはきょうとだよ。", "morae": 8 },
    { "ref": "s-17-2#L16", "ids": [ "v-n5-0126", "v-n5-0537", "v-n5-0119", "v-n5-0446", "v-n5-0129", "v-n5-0227", "v-n5-0121", "v-n5-0329", "v-n5-0341" ], "kana": "きょうとのみかんより、おきつのがあまいよ。ふゆにおくってあげる。", "morae": 28 },
    { "ref": "s-17-2#L17", "ids": [ "v-n5-0688", "v-n5-0010", "v-n5-0227", "v-n5-0119", "v-n4-0032", "v-n5-0132" ], "kana": "ほんとうに？ありがとうございます。ふゆがたのしみです。", "morae": 24 },
    { "ref": "s-17-2#L18", "ids": [ "v-n5-0117", "v-n4-0005", "v-n5-0126", "v-n5-0239", "v-n5-0121", "v-n5-0310", "v-n5-0378" ], "kana": "じゅっこ、ぼくのにもつにいれた。かるいかるい。", "morae": 19 },
    { "ref": "s-17-3#L0", "ids": [ "v-n5-0121", "v-n5-0292", "v-n5-0066", "v-n5-0123" ], "kana": "せいけんじにはいるひとへ。", "morae": 12 },
    { "ref": "s-17-3#L2", "ids": [ "v-n5-0600", "v-n5-0126", "v-n5-0599", "v-n5-0121", "v-n5-0292", "v-n5-0151", "v-n5-0130", "v-n5-0276" ], "kana": "いしのにわにはいるな。そとからみなさい。", "morae": 18 },
    { "ref": "s-17-3#L3", "ids": [ "v-n5-0302", "v-n5-0600", "v-n5-0126", "v-n5-0148", "v-n5-0118", "v-n5-0301", "v-n5-0132" ], "kana": "はしるな。いしのうえはあるきにくいです。", "morae": 18 },
    { "ref": "s-17-3#L5", "ids": [ "v-n5-0598", "v-n5-0126", "v-n5-0412", "v-n5-0121", "v-n5-0442", "v-n5-0120", "v-n5-0341" ], "kana": "いけのさかなにたべものをあげるな。", "morae": 16 },
    { "ref": "s-17-3#L6", "ids": [ "v-n5-0350", "v-n5-0589", "v-n5-0122", "v-n5-0283", "v-n5-0386", "v-n5-0301" ], "kana": "おおきいこえではなすな。しずかにあるきなさい。", "morae": 21 },
    { "ref": "s-17-3#L7", "ids": [ "v-n5-0599", "v-n5-0122", "v-n5-0459", "v-n5-0120", "v-n5-0277", "v-n5-0118", "g-n5-088" ], "kana": "にわでべんとうをたべてはいけません。", "morae": 17 },
    { "ref": "s-17-3#L8", "ids": [ "v-n5-0420", "v-n5-0119", "v-n5-0275", "v-n5-0721", "v-n5-0118", "v-n5-0248", "v-n5-0121", "v-n5-0673" ], "kana": "でんしゃがきたら、とまれ。でんしゃはいちにちにたくさんきます。", "morae": 26 },
    { "ref": "s-17-3#L10", "ids": [ "v-n5-0073", "v-n5-0126", "v-n4-0115", "v-n5-0120", "v-n4-0117" ], "kana": "みなさんのけんこうをいのります。", "morae": 15 },
    { "ref": "s-17-3#L13", "ids": [ "v-n5-0048", "v-n5-0424", "v-n5-0120", "v-n5-0301", "v-n5-0066", "v-n5-0118", "v-n4-0037", "v-n5-0274" ], "kana": "このみちをあるくひとは、きをつけていきなさい。", "morae": 21 },
    { "ref": "s-17-4#L0", "ids": [ "v-n5-0701", "v-n5-0051", "v-n5-0121", "v-n5-0300", "v-n5-0136", "v-n5-0154", "v-n5-0155", "v-n5-0132" ], "kana": "さあ、ここにすわりなさい。いま、さんじじゅっぷんです。", "morae": 22 },
    { "ref": "s-17-4#L1", "ids": [ "v-n5-0137", "v-n5-0118", "v-n5-0358", "v-n5-0128", "v-n5-0692", "v-n5-0051", "v-n5-0549", "v-n5-0130", "v-n5-0126", "v-n5-0567", "v-n5-0119", "v-n5-0275", "v-n4-0114", "v-n5-0132", "v-n5-0129" ], "kana": "きょうはあつすぎますね。でも、ここはうみからのかぜがくるので、らくですよ。", "morae": 32 },
    { "ref": "s-17-4#L3", "ids": [ "v-n5-0120", "v-n5-0301", "v-n5-0066", "v-n5-0118", "v-n4-0004", "v-n5-0052", "v-n5-0122", "v-n5-0721" ], "kana": "とうかいどうをあるくひとは、みんなそこでとまりました。", "morae": 25 },
    { "ref": "s-17-4#L4", "ids": [ "v-n5-0541", "v-n5-0120", "v-n5-0282", "v-n5-0241", "v-n5-0336", "v-n5-0130", "v-n5-0686", "v-n5-0301" ], "kana": "なまえをかいたかみをみせてから、またあるきはじめました。", "morae": 26 },
    { "ref": "s-17-4#L5", "ids": [ "v-n4-0106", "v-n5-0498", "v-n5-0135", "v-n5-0119", "v-n5-0051", "v-n5-0120", "v-n4-0131", "v-n5-0274" ], "kana": "きびしいところでしたが、ここをすぎなければ、きょうとへはいけませんでした。", "morae": 33 },
    { "ref": "s-17-4#L6", "ids": [ "v-n5-0373", "v-n5-0187", "v-n5-0419", "v-n5-0122", "v-n5-0317", "v-n5-0273", "v-n5-0130", "v-n5-0048", "v-n5-0424", "v-n5-0126", "v-n5-0544", "v-n5-0118", "v-n5-0680", "v-n5-0286" ], "kana": "ながいあいだ、えきではたらいていましたから、このみちのはなしは、よくしっています。", "morae": 37 },
    { "ref": "s-17-4#L7", "ids": [ "v-n5-0767", "v-n5-0128", "v-n5-0424", "v-n5-0118", "v-n5-0674", "v-n4-0136", "v-n5-0274" ], "kana": "それでね、みちはすこしずつかわっていきました。", "morae": 21 },
    { "ref": "s-17-4#L8", "ids": [ "v-n5-0118", "v-n5-0600", "v-n5-0121", "v-n5-0806", "v-n5-0420", "v-n5-0119", "v-n5-0302" ], "kana": "きよみがせきはいしだけになって、でんしゃがはしりはじめました。", "morae": 28 },
    { "ref": "s-17-4#L9", "ids": [ "v-n5-0152", "v-n5-0118", "v-n5-0248", "v-n5-0121", "v-n5-0114", "v-n5-0135", "v-n5-0136", "v-n5-0275" ], "kana": "まえは、いちにちににじゅっぽんぐらいでした。いまは、にひゃっぽんぐらいきます。", "morae": 33 },
    { "ref": "s-17-4#L10", "ids": [ "v-n5-0774", "v-n5-0420", "v-n5-0119", "v-n5-0275", "v-n5-0129", "v-n5-0804", "v-n5-0120", "v-n5-0280" ], "kana": "あっ、でんしゃがきましたよ。おとをききなさい。", "morae": 19 },
    { "ref": "s-17-4#L11", "ids": [ "v-n5-0126", "v-n5-0599", "v-n5-0150", "v-n5-0120", "v-n5-0420", "v-n5-0119", "v-n5-0302", "v-n5-0274", "v-n5-0364", "v-n5-0132" ], "kana": "せいけんじのにわのなかを、でんしゃがはしっていくのは、おもしろいでしょう。", "morae": 32 },
    { "ref": "s-17-4#L12", "ids": [ "v-n5-0693", "v-n5-0537", "v-n5-0126", "v-n5-0544", "v-n5-0120", "v-n5-0271" ], "kana": "それから、みかんのはなしをしましょう。", "morae": 16 },
    { "ref": "s-17-4#L13", "ids": [ "v-n5-0051", "v-n5-0126", "v-n5-0066", "v-n5-0119", "v-n5-0368", "v-n5-0498", "v-n5-0130", "v-n5-0537", "v-n5-0568", "v-n5-0120", "v-n5-0296", "v-n5-0275" ], "kana": "ここのひとが、とおいところから、みかんのきをもってきました。", "morae": 27 },
    { "ref": "s-17-4#L14", "ids": [ "v-n5-0568", "v-n5-0118", "v-n5-0549", "v-n5-0126", "v-n5-0185", "v-n5-0548", "v-n5-0122", "v-n5-0674", "v-n5-0371", "v-n5-0806", "v-n5-0274" ], "kana": "きは、うみのちかくのやまで、すこしずつおおくなっていきました。", "morae": 28 },
    { "ref": "s-17-4#L15", "ids": [ "v-n5-0227", "v-n5-0537", "v-n5-0120", "v-n5-0518", "v-n5-0121", "v-n5-0310", "v-n5-0368", "v-n5-0425", "v-n5-0123", "v-n5-0296", "v-n5-0274" ], "kana": "ふゆには、みかんをふねにいれて、とおいまちへもっていきました。", "morae": 28 },
    { "ref": "s-17-4#L16", "ids": [ "v-n5-0537", "v-n5-0118", "v-n5-0368", "v-n5-0498", "v-n5-0130", "v-n5-0275", "v-n5-0686", "v-n5-0123", "v-n5-0293", "v-n5-0274" ], "kana": "みかんは、とおいところからきて、またとおいところへでていきました。", "morae": 30 },
    { "ref": "s-17-4#L17", "ids": [ "v-n5-0136", "v-n5-0118", "v-n5-0225", "v-n5-0132", "v-n5-0130", "v-n5-0548", "v-n5-0126", "v-n5-0537", "v-n5-0677", "v-n5-0166", "v-n5-0351" ], "kana": "いまはなつですから、やまのみかんは、まだあおくてちいさいです。", "morae": 28 },
    { "ref": "s-17-4#L18", "ids": [ "v-n5-0692", "v-n5-0149", "v-n5-0126", "v-n5-0067", "v-n5-0417", "v-n5-0121", "v-n5-0225", "v-n5-0537", "v-n5-0119", "v-n5-0272", "v-n5-0129" ], "kana": "でも、したのしみずさんのみせに、なつのみかんがありますよ。", "morae": 26 },
    { "ref": "s-17-4#L19", "ids": [ "v-n5-0672", "v-n5-0446", "v-n5-0132", "v-n5-0119", "v-n5-0361", "v-n5-0379", "v-n5-0111", "v-n5-0277", "g-n4-015" ], "kana": "あまりあまくないですが、つめたくておいしいです。ひとつ、たべてみなさい。", "morae": 32 },
    { "ref": "s-17-4#L20", "ids": [ "v-n5-0701", "v-n5-0406", "v-n5-0120", "v-n5-0278", "v-n5-0154", "v-n5-0121", "g-n5-084", "v-n5-0686", "v-n5-0301" ], "kana": "さあ、みずをのみなさい。よじになったら、またあるきなさい。", "morae": 25 },
    { "ref": "s-17-4#L21", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0420", "v-n5-0122", "v-n5-0766", "v-n5-0274", "v-n5-0242", "v-n5-0686", "v-n5-0291" ], "kana": "わたしはでんしゃでさきにいきます。ゆうがた、またあいましょう。", "morae": 26 },
    { "ref": "s-17-4#L22", "ids": [ "v-n5-0136", "v-n5-0154", "v-n5-0155", "v-n5-0132", "v-n5-0050", "v-n5-0172", "v-n5-0118", "v-n5-0137", "v-n5-0125", "v-n5-0338", "v-n5-0128" ], "kana": "いま、さんじじゅうにふんです。あのとけいは、きょうもいっぷんちがいますね。", "morae": 31 },
    { "ref": "s-17-5#L0", "ids": [ "v-n5-0073", "v-n5-0006", "v-n5-0130", "v-n5-0126", "v-n5-0713", "v-n5-0132" ], "kana": "みなさん、こんにちは。せいけんじからのあんないです。", "morae": 23 },
    { "ref": "s-17-5#L1", "ids": [ "v-n5-0137", "v-n5-0118", "v-n5-0671", "v-n5-0358", "v-n5-0132", "v-n5-0406", "v-n5-0120", "v-n5-0673", "v-n5-0278", "g-n5-051" ], "kana": "きょうはとてもあついです。みずをたくさんのんでください。", "morae": 25 },
    { "ref": "s-17-5#L2", "ids": [ "v-n5-0600", "v-n5-0126", "v-n5-0599", "v-n5-0292", "g-n5-051", "v-n5-0118", "v-n5-0151", "v-n5-0130", "v-n5-0276" ], "kana": "いしのにわには、はいらないでください。にわは、そとからみてください。", "morae": 30 },
    { "ref": "s-17-5#L4", "ids": [ "v-n5-0436", "v-n5-0118", "v-n5-0726", "v-n5-0125", "v-n5-0356", "v-n5-0132", "v-n5-0119", "v-n5-0350", "v-n5-0589", "v-n5-0122", "v-n5-0283", "g-n5-051" ], "kana": "しゃしんはとってもいいですが、おおきいこえではなさないでください。", "morae": 30 },
    { "ref": "s-17-5#L5", "ids": [ "v-n5-0126", "v-n5-0150", "v-n5-0696", "v-n5-0302", "g-n5-051", "v-n5-0685", "v-n5-0301" ], "kana": "せいけんじのなかでは、はしらないでください。ゆっくりあるいてください。", "morae": 32 },
    { "ref": "s-17-5#L7", "ids": [ "v-n5-0136", "v-n5-0118", "v-n5-0159", "v-n5-0154", "v-n5-0156", "v-n5-0132", "v-n5-0121", "v-n5-0309" ], "kana": "いまは、ごごさんじはんです。せいけんじは、ごじにしまります。", "morae": 26 },
    { "ref": "s-17-5#L8", "ids": [ "v-n5-0503", "v-n5-0118", "v-n5-0499", "v-n5-0126", "v-n5-0183", "v-n5-0121", "v-n5-0272", "v-n5-0406", "v-n5-0125", "v-n5-0052", "v-n5-0122", "v-n5-0278", "v-n5-0119", "g-n5-078" ], "kana": "おてあらいは、いりぐちのみぎにあります。みずも、そこでのむことができます。", "morae": 33 },
    { "ref": "s-17-5#L9", "ids": [ "v-n5-0166", "v-n5-0253", "v-n5-0120", "v-n5-0325", "v-n4-0053", "v-n5-0118", "v-n5-0499", "v-n5-0131", "v-n5-0275", "g-n5-051" ], "kana": "あおいぼうしをわすれたかたは、いりぐちまできてください。", "morae": 26 },
    { "ref": "s-17-5#L10", "ids": [ "v-n5-0599", "v-n5-0121", "v-n5-0553", "v-n5-0119", "v-n5-0273", "v-n5-0442", "v-n5-0120", "v-n5-0341", "g-n5-051" ], "kana": "にわにねこがいますが、たべものをあげないでください。", "morae": 24 },
    { "ref": "s-17-5#L11", "ids": [ "v-n5-0693", "v-n5-0149", "v-n5-0126", "v-n5-0424", "v-n5-0121", "v-n5-0272", "v-n5-0067", "v-n5-0537", "v-n5-0417", "v-n5-0130", "v-n5-0713", "v-n5-0132" ], "kana": "それから、したのみちにある、しみずさんのみかんのみせからのあんないです。", "morae": 33 },
    { "ref": "s-17-5#L12", "ids": [ "v-n5-0137", "v-n5-0118", "v-n5-0225", "v-n5-0126", "v-n5-0537", "v-n5-0120", "v-n5-0348", "v-n5-0273", "v-n5-0361", "v-n5-0379", "v-n5-0132", "v-n5-0129" ], "kana": "きょうは、なつのみかんをうっています。つめたくて、おいしいですよ。", "morae": 28 },
    { "ref": "s-17-5#L14", "ids": [ "v-n5-0417", "v-n5-0126", "v-n5-0152", "v-n5-0122", "v-n5-0537", "v-n5-0120", "v-n5-0111", "v-n5-0277", "v-n5-0276", "g-n5-051", "v-n5-0418", "v-n5-0118", "v-n5-0335" ], "kana": "みせのまえで、みかんをひとつ、たべてみてください。おかねはいりません。", "morae": 31 },
    { "ref": "s-17-5#L15", "ids": [ "v-n5-0095", "v-n5-0111", "v-n5-0131", "v-n5-0132", "v-n5-0071", "v-n5-0125", "v-n4-0007" ], "kana": "ひとり、ひとつまでです。こどももおとなも、ひとつずつです。", "morae": 25 },
    { "ref": "s-17-5#L16", "ids": [ "v-n5-0537", "v-n5-0120", "v-n5-0277", "v-n5-0276", "v-n5-0154", "v-n5-0131", "v-n5-0132", "v-n4-0131", "v-n5-0417", "v-n5-0122", "v-n5-0284", "g-n5-051" ], "kana": "みかんをたべてみるのは、よじまでです。よじをすぎたら、みせでかってください。", "morae": 34 },
    { "ref": "s-17-5#L17", "ids": [ "v-n5-0227", "v-n5-0126", "v-n5-0537", "v-n5-0118", "v-n5-0329", "v-n5-0125", "g-n5-078", "v-n5-0417", "v-n5-0122", "v-n5-0280", "g-n5-051" ], "kana": "ふゆのみかんは、おくることもできます。みせできいてください。", "morae": 27 },
    { "ref": "s-17-5#L19", "ids": [ "v-n5-0676", "v-n5-0752", "v-n5-0279", "v-n5-0118", "v-n5-0154", "v-n5-0121", "v-n5-0309", "v-n5-0131", "v-n5-0293", "g-n5-051" ], "kana": "もういちどいいます。せいけんじはごじにしまります。ごじまでにでてください。", "morae": 34 },
    { "ref": "s-17-5#L20", "ids": [ "v-n5-0067", "v-n5-0126", "v-n5-0417", "v-n5-0118", "v-n5-0154", "v-n5-0131", "v-n5-0308", "v-n5-0273" ], "kana": "しみずさんのみせは、ろくじまであいています。", "morae": 20 },
    { "ref": "s-17-5#L21", "ids": [ "v-n5-0358", "v-n5-0547", "v-n5-0119", "v-n4-0138", "v-n5-0273", "v-n5-0073", "v-n5-0559", "v-n5-0121", "v-n4-0037", "g-n5-051" ], "kana": "あついてんきがつづいています。みなさん、からだにきをつけてください。", "morae": 31 },
    { "ref": "s-17-5#L22", "ids": [ "v-n5-0045", "v-n5-0122", "v-n5-0130", "v-n5-0126", "v-n5-0713", "v-n5-0120", "v-n5-0328" ], "kana": "これで、せいけんじからのあんないをおわります。", "morae": 21 },
    { "ref": "g-n4-007#ex3", "ids": [ "g-n4-007", "v-n5-0055", "v-n5-0121", "v-n5-0125", "v-n5-0279", "v-n5-0095", "v-n5-0122", "v-n4-0133" ], "kana": "だれにもいわないで、ひとりできめてしまった。", "morae": 20 },
    { "ref": "g-n4-011#ex0", "ids": [ "g-n4-011", "v-n5-0138", "v-n5-0126", "v-n5-0740", "v-n5-0121", "v-n5-0531", "v-n5-0120", "v-n5-0296", "v-n5-0274" ], "kana": "あしたのパーティーにワインをもっていきます。", "morae": 20 },
    { "ref": "g-n4-011#ex3", "ids": [ "g-n4-011", "v-n5-0045", "v-n5-0130", "v-n5-0125", "v-n5-0080", "v-n5-0126", "v-n5-0703", "v-n5-0120", "v-n4-0139", "v-n5-0274", "g-n5-083" ], "kana": "これからもにほんごのべんきょうをつづけていくつもりです。", "morae": 26 },
    { "ref": "g-n4-011#ex4", "ids": [ "g-n4-011", "v-n5-0675", "v-n5-0453", "v-n5-0122", "v-n5-0443", "v-n5-0120", "v-n5-0284", "v-n5-0275", "v-n5-0128" ], "kana": "ちょっとコンビニでのみものをかってくるね。", "morae": 19 },
    { "ref": "g-n4-012#ex0", "ids": [ "g-n4-012", "v-n5-0048", "v-n5-0170", "v-n5-0315", "v-n5-0276", "v-n5-0125", "v-n5-0356", "v-n5-0132", "v-n5-0127" ], "kana": "このくつ、はいてみてもいいですか。", "morae": 15 },
    { "ref": "g-n4-012#ex1", "ids": [ "g-n4-012", "v-n5-0690", "v-n5-0434", "v-n5-0126", "v-n5-0438", "v-n5-0120", "v-n5-0294", "v-n5-0276" ], "kana": "はじめてにほんのりょうりをつくってみました。", "morae": 20 },
    { "ref": "g-n4-012#ex2", "ids": [ "g-n4-012", "v-n5-0285", "v-n5-0068", "v-n5-0121", "v-n5-0280" ], "kana": "わからなかったら、せんせいにきいてみたら？", "morae": 19 },
    { "ref": "g-n4-013#ex0", "ids": [ "g-n4-013", "v-n5-0667", "v-n4-0004" ], "kana": "しあいだ。みんな、がんばれ！", "morae": 11 },
    { "ref": "g-n4-013#ex1", "ids": [ "g-n4-013", "v-n5-0424", "v-n5-0121", "v-n5-0721", "v-n5-0124", "v-n5-0282", "v-n5-0272" ], "kana": "みちに「とまれ」とかいてある。", "morae": 12 },
    { "ref": "g-n4-013#ex2", "ids": [ "g-n4-013", "v-n5-0081", "v-n5-0121", "v-n5-0369", "v-n5-0288", "v-n5-0124", "v-n5-0279" ], "kana": "ちちに「はやくおきろ」といわれた。", "morae": 14 },
    { "ref": "g-n4-014#ex3", "ids": [ "g-n4-014", "v-n5-0179", "v-n5-0121", "v-n5-0306", "v-n5-0124", "v-n5-0282", "v-n5-0272" ], "kana": "ドアに「あけるな」とかいてあった。", "morae": 14 },
    { "ref": "g-n4-014#ex4", "ids": [ "g-n4-014", "v-n5-0068", "v-n5-0121", "v-n5-0302", "v-n5-0124", "v-n5-0279" ], "kana": "せんせいに「はしるな」といわれた。", "morae": 14 },
    { "ref": "g-n4-015#ex0", "ids": [ "g-n4-015", "v-n5-0676", "v-n5-0154", "v-n5-0129", "v-n5-0369", "v-n5-0289" ], "kana": "もうじゅうじよ。はやくねなさい。", "morae": 13 },
    { "ref": "g-n4-015#ex2", "ids": [ "g-n4-015", "v-n5-0414", "v-n5-0125", "v-n5-0681", "v-n5-0277" ], "kana": "やさいもぜんぶたべなさい。", "morae": 12 },
    { "ref": "g-n4-015#ex3", "ids": [ "g-n4-015", "v-n5-0151", "v-n5-0122", "v-n5-0319", "g-n5-033", "v-n5-0105", "v-n5-0120" ], "kana": "そとであそぶまえに、しゅくだいをしなさい。", "morae": 18 },
    { "ref": "g-n4-016#ex0", "ids": [ "g-n4-016", "v-n5-0070", "v-n5-0121", "v-n5-0080", "v-n5-0120", "v-n5-0322", "v-n5-0342" ], "kana": "ともだちににほんごをおしえてもらいました。", "morae": 20 },
    { "ref": "g-n4-016#ex1", "ids": [ "g-n4-016", "v-n5-0119", "v-n5-0419", "v-n5-0131", "v-n5-0329", "v-n5-0343" ], "kana": "たなかさんがえきまでおくってくれた。", "morae": 17 },
    { "ref": "g-n4-016#ex3", "ids": [ "g-n4-016", "v-n5-0675", "v-n5-0436", "v-n5-0120", "v-n5-0726", "v-n5-0343", "v-n5-0127" ], "kana": "ちょっとしゃしんをとってくれませんか。", "morae": 16 },
    { "ref": "g-n4-016#ex4", "ids": [ "g-n4-016", "v-n5-0424", "v-n5-0119", "v-n5-0285", "v-n5-0608", "v-n5-0126", "v-n5-0066", "v-n5-0121", "v-n5-0322", "v-n5-0342" ], "kana": "みちがわからなくて、けいさつのひとにおしえてもらった。", "morae": 25 },
    { "ref": "g-n4-017#ex1", "ids": [ "g-n4-017", "v-n5-0099", "v-n5-0120", "v-n5-0281", "v-n5-0328", "v-n5-0344", "v-n5-0128" ], "kana": "ほんをよみおわったら、かしてね。", "morae": 14 },
    { "ref": "g-n4-017#ex2", "ids": [ "g-n4-017", "v-n4-0002", "v-n5-0118", "v-n5-0203", "v-n5-0187", "v-n5-0048", "v-n5-0417", "v-n5-0122", "v-n5-0317", "v-n4-0139", "v-n5-0273" ], "kana": "かれはさんじゅうねんかん、このみせではたらきつづけている。", "morae": 26 },
    { "ref": "g-n4-017#ex4", "ids": [ "g-n4-017", "v-n4-0004", "v-n5-0119", "v-n5-0277", "v-n5-0328", "v-n5-0131", "v-n5-0290" ], "kana": "みんながたべおわるまでまちましょう。", "morae": 16 },
    { "ref": "g-n4-018#ex1", "ids": [ "g-n4-018", "v-n5-0565", "v-n5-0119", "v-n5-0643", "v-n5-0550", "v-n5-0304", "v-n5-0311" ], "kana": "そらがくらくなって、あめがふりだしました。", "morae": 19 },
    { "ref": "g-n4-018#ex4", "ids": [ "g-n4-018", "v-n5-0544", "v-n5-0120", "v-n5-0280", "v-n4-0004", "v-n5-0119", "v-n4-0022", "v-n5-0311" ], "kana": "はなしをきいて、みんながわらいだした。", "morae": 17 },
    { "ref": "g-n4-019#ex0", "ids": [ "g-n4-019", "v-n5-0139", "v-n5-0118", "v-n5-0278", "v-n5-0558", "v-n5-0119", "v-n5-0562" ], "kana": "きのうはのみすぎて、あたまがいたい。", "morae": 16 },
    { "ref": "g-n4-019#ex1", "ids": [ "g-n4-019", "v-n5-0048", "v-n5-0127", "v-n5-0144", "v-n5-0118", "v-n5-0041", "v-n5-0121", "v-n5-0350" ], "kana": "このかばんはわたしにはおおきすぎます。", "morae": 18 },
    { "ref": "g-n4-019#ex2", "ids": [ "g-n4-019", "v-n5-0542", "v-n5-0119", "v-n5-0371", "v-n5-0140", "v-n5-0287", "v-n5-0370" ], "kana": "しごとがおおすぎて、まいにちかえりがおそい。", "morae": 20 },
    { "ref": "g-n4-019#ex4", "ids": [ "g-n4-019", "v-n5-0277", "v-n4-0131", "v-n5-0121", "v-n4-0037", "g-n5-051" ], "kana": "たべすぎにきをつけてください。", "morae": 14 },
    { "ref": "g-n4-020#ex1", "ids": [ "g-n4-020", "v-n5-0068", "v-n5-0126", "v-n5-0587", "v-n5-0118", "v-n5-0351", "v-n5-0281" ], "kana": "せんせいのじはちいさくてよみにくい。", "morae": 17 },
    { "ref": "g-n4-020#ex2", "ids": [ "g-n4-020", "v-n5-0048", "v-n5-0425", "v-n5-0118", "v-n5-0424", "v-n5-0119", "v-n5-0375", "v-n5-0301", "v-n5-0353" ], "kana": "このまちはみちがひろくてあるきやすい。", "morae": 18 },
    { "ref": "g-n4-020#ex4", "ids": [ "g-n4-020", "v-n5-0354", "v-n5-0170", "v-n5-0118", "v-n5-0301" ], "kana": "あたらしいくつはあるきにくかった。", "morae": 16 },
    { "ref": "v-n4-0001#ex0", "ids": [ "v-n4-0001", "v-n5-0126", "v-n5-0118", "v-n5-0122", "v-n4-0133" ], "kana": "じぶんのことはじぶんできめたい。", "morae": 15 },
    { "ref": "v-n4-0005#ex1", "ids": [ "v-n4-0005", "v-n5-0118", "v-n5-0071", "v-n4-0142", "v-n5-0621", "v-n5-0119", "v-n5-0393" ], "kana": "ぼくはこどものころ、やきゅうがだいすきだった。", "morae": 20 },
    { "ref": "v-n4-0073#ex0", "ids": [ "v-n4-0073", "v-n5-0081", "v-n5-0118", "v-n5-0119", "v-n5-0301", "v-n5-0382", "v-n5-0276" ], "kana": "ちちはひげがあるほうがわかくみえる。", "morae": 17 },
    { "ref": "v-n4-0074#ex0", "ids": [ "v-n4-0074", "v-n5-0576", "v-n5-0132", "v-n5-0127", "v-n4-0031", "v-n5-0271", "v-n5-0122" ], "kana": "かぜですか。むりしないで、おだいじに。", "morae": 16 },
    { "ref": "v-n4-0074#ex1", "ids": [ "v-n4-0074", "v-n5-0575", "v-n5-0118", "v-n5-0248", "v-n5-0106", "v-n5-0132", "v-n5-0271", "g-n5-051" ], "kana": "くすりはいちにちさんかいです。おだいじにしてください。", "morae": 25 },
