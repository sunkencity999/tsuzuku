    { "ref": "v-n4-0119#ex1", "ids": [ "v-n4-0119", "v-n5-0087", "v-n5-0120", "v-n5-0756", "v-n5-0674", "v-n5-0279", "v-n5-0124", "v-n5-0801" ], "kana": "おとうとをしかったあとで、すこしいいすぎたとおもった。", "morae": 25 },
    { "ref": "v-n4-0120#ex0", "ids": [ "v-n4-0120", "v-n5-0354", "v-n5-0542", "v-n5-0121", "v-n5-0118", "v-n5-0676", "v-n5-0127" ], "kana": "あたらしいしごとにはもうなれましたか。", "morae": 18 },
    { "ref": "v-n4-0120#ex1", "ids": [ "v-n4-0120", "v-n5-0434", "v-n5-0126", "v-n5-0225", "v-n5-0358", "v-n5-0121", "v-n5-0118", "v-n5-0677" ], "kana": "にほんのなつのあつさには、まだなれない。", "morae": 18 },
    { "ref": "v-n4-0121#ex0", "ids": [ "v-n4-0121", "v-n5-0140", "v-n5-0803", "v-n5-0459", "v-n5-0122", "v-n5-0676" ], "kana": "まいにちおなじべんとうで、もうあきた。", "morae": 17 },
    { "ref": "v-n4-0121#ex1", "ids": [ "v-n4-0121", "v-n4-0014", "v-n5-0118", "v-n5-0354", "v-n5-0377", "v-n5-0121", "v-n5-0684" ], "kana": "むすこはあたらしいおもちゃにすぐあきてしまいます。", "morae": 23 },
    { "ref": "v-n4-0122#ex0", "ids": [ "v-n4-0122", "v-n5-0140", "v-n5-0705", "v-n5-0271", "v-n5-0136", "v-n5-0118", "v-n5-0119", "v-n5-0272" ], "kana": "まいにちれんしゅうしたので、いまはじしんがあります。", "morae": 23 },
    { "ref": "v-n4-0122#ex1", "ids": [ "v-n4-0122", "v-n5-0557", "v-n5-0122", "v-n5-0283", "v-n5-0126", "v-n5-0118", "v-n5-0677", "v-n5-0119" ], "kana": "えいごではなすのは、まだじしんがない。", "morae": 17 },
    { "ref": "v-n4-0124#ex0", "ids": [ "v-n4-0124", "v-n5-0068", "v-n5-0126", "v-n5-0122", "v-n5-0080", "v-n5-0119", "v-n5-0395", "v-n5-0121", "v-n5-0806" ], "kana": "せんせいのおかげで、にほんごがじょうずになりました。", "morae": 23 },
    { "ref": "v-n4-0125#ex0", "ids": [ "v-n4-0125", "v-n5-0068", "v-n5-0126", "v-n5-0544", "v-n5-0118", "v-n5-0678", "v-n5-0373" ], "kana": "こうちょうせんせいのはなしはいつもながい。", "morae": 19 },
    { "ref": "v-n4-0125#ex1", "ids": [ "v-n4-0125", "v-n4-0013", "v-n5-0126", "v-n5-0097", "v-n5-0118", "v-n5-0677", "v-n5-0116", "v-n5-0022" ], "kana": "むすめのがっこうのこうちょうは、まだよんじゅっさいだそうです。", "morae": 27 },
    { "ref": "v-n4-0126#ex1", "ids": [ "v-n4-0126", "v-n5-0636", "v-n5-0122", "v-n5-0070", "v-n5-0124", "v-n5-0271" ], "kana": "つまらないことでともだちとけんかしてしまった。", "morae": 22 },
    { "ref": "v-n4-0127#ex0", "ids": [ "v-n4-0127", "v-n5-0674", "v-n5-0370", "v-n5-0125", "v-n5-0129" ], "kana": "すこしぐらいおそくなってもかまわないよ。", "morae": 19 },
    { "ref": "v-n4-0127#ex1", "ids": [ "v-n4-0127", "v-n5-0362", "v-n5-0136", "v-n5-0118", "v-n5-0553", "v-n5-0120" ], "kana": "いそがしいので、いまはねこをかまってあげられません。", "morae": 24 },
    { "ref": "v-n4-0128#ex1", "ids": [ "v-n4-0128", "v-n5-0690", "v-n5-0126", "v-n4-0044", "v-n5-0697", "v-n4-0011", "v-n5-0118", "v-n5-0671", "v-n5-0273" ], "kana": "はじめてのまごだから、りょうしんはとてもかわいがっている。", "morae": 26 },
    { "ref": "v-n4-0129#ex0", "ids": [ "v-n4-0129", "v-n5-0145", "v-n5-0121", "v-n5-0287", "v-n5-0130", "v-n5-0127", "v-n5-0144", "v-n5-0119" ], "kana": "いえにかえってから、かばんがないことにきがついた。", "morae": 23 },
    { "ref": "v-n4-0129#ex1", "ids": [ "v-n4-0129", "v-n5-0555", "v-n5-0120", "v-n5-0280", "v-n5-0273", "v-n5-0419", "v-n5-0121", "v-n5-0305" ], "kana": "おんがくをきいていて、えきについたことにきがつきませんでした。", "morae": 29 },
    { "ref": "v-n4-0130#ex0", "ids": [ "v-n4-0130", "v-n5-0424", "v-n5-0119", "v-n5-0285", "v-n5-0121", "v-n5-0280" ], "kana": "みちがわからなくて、おまわりさんにききました。", "morae": 21 },
    { "ref": "v-n4-0130#ex1", "ids": [ "v-n4-0130", "v-n5-0520", "v-n5-0122", "v-n5-0119", "v-n5-0071", "v-n5-0121", "v-n5-0511", "v-n5-0126", "v-n5-0349", "v-n4-0053", "v-n5-0120", "v-n5-0322", "v-n5-0273" ], "kana": "えきまえでおまわりさんがこどもたちにしんごうのわたりかたをおしえていた。", "morae": 35 },
    { "ref": "v-n4-0131#ex0", "ids": [ "v-n4-0131", "v-n5-0676", "v-n5-0154", "v-n5-0120", "v-n5-0130", "v-n5-0289" ], "kana": "もうじゅうにじをすぎましたから、ねましょう。", "morae": 18 },
    { "ref": "v-n4-0131#ex1", "ids": [ "v-n4-0131", "v-n5-0139", "v-n5-0118", "v-n5-0277", "v-n5-0594", "v-n5-0119", "v-n5-0562" ], "kana": "きのうはたべすぎて、おなかがいたい。", "morae": 16 },
    { "ref": "v-n4-0132#ex1", "ids": [ "v-n4-0132", "v-n5-0225", "v-n5-0118", "v-n5-0169", "v-n5-0119", "v-n5-0684", "v-n5-0128" ], "kana": "なつはふくがすぐかわきますね。", "morae": 14 },
    { "ref": "v-n4-0133#ex1", "ids": [ "v-n4-0133", "v-n5-0354", "v-n5-0737", "v-n5-0120", "v-n5-0284", "v-n5-0121" ], "kana": "あたらしいパソコンをかうことにきめました。", "morae": 20 },
    { "ref": "v-n4-0134#ex0", "ids": [ "v-n4-0134", "v-n5-0579", "v-n5-0126", "v-n5-0157", "v-n5-0119" ], "kana": "かいぎのじかんがきまりました。", "morae": 14 },
    { "ref": "v-n4-0134#ex1", "ids": [ "v-n4-0134", "v-n5-0205", "v-n5-0126", "v-n5-0445", "v-n5-0118", "v-n5-0677", "v-n5-0273" ], "kana": "らいねんのりょこうはまだきまっていない。", "morae": 18 },
    { "ref": "v-n4-0135#ex1", "ids": [ "v-n4-0135", "v-n5-0086", "v-n5-0118", "v-n5-0680", "v-n5-0591", "v-n5-0126", "v-n5-0160", "v-n5-0120" ], "kana": "あねはよくかみのいろをかえる。", "morae": 14 },
    { "ref": "v-n4-0136#ex0", "ids": [ "v-n4-0136", "v-n5-0419", "v-n5-0126", "v-n5-0152", "v-n5-0118", "v-n5-0759", "v-n5-0128" ], "kana": "えきのまえはずいぶんかわったね。", "morae": 15 },
    { "ref": "v-n4-0136#ex1", "ids": [ "v-n4-0136", "v-n5-0547", "v-n5-0119", "v-n5-0353", "v-n5-0171", "v-n5-0120", "v-n5-0296", "v-n5-0274" ], "kana": "てんきがかわりやすいので、かさをもっていきます。", "morae": 22 },
    { "ref": "v-n4-0137#ex0", "ids": [ "v-n4-0137", "v-n5-0543", "v-n5-0119", "v-n5-0273", "v-n5-0129" ], "kana": "でんわがなっていますよ。", "morae": 11 },
    { "ref": "v-n4-0138#ex1", "ids": [ "v-n4-0138", "v-n5-0579", "v-n5-0118", "v-n5-0033", "v-n5-0157", "v-n5-0125" ], "kana": "かいぎはさんじかんもつづきました。", "morae": 16 },
    { "ref": "v-n4-0139#ex0", "ids": [ "v-n4-0139", "v-n5-0140", "v-n5-0674", "v-n5-0709", "v-n5-0120", "v-n5-0273" ], "kana": "まいにちすこしずつうんどうをつづけています。", "morae": 21 },
    { "ref": "v-n4-0139#ex1", "ids": [ "v-n4-0139", "v-n5-0717", "v-n5-0705", "v-n5-0120" ], "kana": "つかれたけど、れんしゅうをつづけた。", "morae": 15 },
    { "ref": "v-n4-0140#ex0", "ids": [ "v-n4-0140", "v-n5-0356", "v-n5-0741", "v-n5-0120", "v-n5-0129" ], "kana": "いいアパートをみつけたよ。", "morae": 12 },
    { "ref": "v-n4-0140#ex1", "ids": [ "v-n4-0140", "v-n5-0419", "v-n5-0122", "v-n5-0174", "v-n5-0120", "v-n5-0658", "v-n5-0121", "v-n5-0349", "g-n5-051" ], "kana": "えきでさいふをみつけたら、えきいんにわたしてください。", "morae": 25 },
    { "ref": "v-n4-0141#ex0", "ids": [ "v-n4-0141", "v-n5-0271", "v-n5-0173", "v-n5-0119" ], "kana": "なくしたかぎがみつかりました。", "morae": 14 },
    { "ref": "v-n4-0141#ex1", "ids": [ "v-n4-0141", "v-n5-0542", "v-n5-0119", "v-n5-0760" ], "kana": "しごとがなかなかみつからない。", "morae": 14 },
    { "ref": "v-n4-0142#ex0", "ids": [ "v-n4-0142", "v-n5-0438", "v-n5-0119", "v-n5-0673" ], "kana": "りょうりがたくさんのこっちゃった。", "morae": 14 },
    { "ref": "v-n4-0142#ex1", "ids": [ "v-n4-0142", "v-n5-0137", "v-n5-0118", "v-n5-0542", "v-n5-0119", "v-n5-0328", "v-n5-0427", "v-n5-0121" ], "kana": "きょうはしごとがおわらないので、かいしゃにのこります。", "morae": 23 },
    { "ref": "v-n4-0143#ex0", "ids": [ "v-n4-0143", "v-n5-0414", "v-n5-0120", "v-n4-0142", "v-n5-0277", "g-n5-051" ], "kana": "やさいをのこさないでたべてください。", "morae": 17 },
    { "ref": "v-n4-0143#ex1", "ids": [ "v-n4-0143", "v-n5-0118", "v-n5-0412", "v-n5-0287" ], "kana": "ケンはさかなだけのこしてかえった。", "morae": 16 },
    { "ref": "v-n4-0144#ex0", "ids": [ "v-n4-0144", "v-n5-0154", "v-n5-0121", "v-n5-0419", "v-n5-0126", "g-n5-033" ], "kana": "はちじにえきのまえにあつまりましょう。", "morae": 17 },
    { "ref": "v-n4-0144#ex1", "ids": [ "v-n4-0144", "v-n5-0433", "v-n5-0121", "v-n5-0071", "v-n5-0119", "v-n5-0673", "v-n5-0273" ], "kana": "こうえんにこどもたちがたくさんあつまっている。", "morae": 22 },
    { "ref": "v-n5-0064#ex0", "ids": [ "v-n5-0064", "v-n4-0102", "v-n5-0132", "v-n5-0119", "v-n5-0127" ], "kana": "しつれいですが、どなたですか。", "morae": 13 }
