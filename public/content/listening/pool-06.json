  "refs": [
    { "ref": "s-02-2#L15", "ids": [ "v-n5-0023", "v-n5-0224" ], "kana": "そうですね。はるですね。", "morae": 10 },
    { "ref": "s-04-2#L13", "ids": [ "v-n5-0046", "v-n5-0118", "v-n5-0233", "v-n5-0132", "v-n5-0127" ], "kana": "それは、おふろですか。", "morae": 9 },
    { "ref": "s-04-3#L7", "ids": [ "v-n5-0118", "v-n5-0136", "v-n5-0233", "v-n5-0132" ], "kana": "ケンは、いま、おふろです。", "morae": 10 },
    { "ref": "s-05-3#L4", "ids": [ "v-n5-0233", "v-n5-0118", "v-n5-0158", "v-n5-0154", "v-n5-0130", "v-n5-0159", "v-n5-0131", "v-n5-0132" ], "kana": "おふろはごぜんろくじからごごじゅういちじまでです。", "morae": 23 },
    { "ref": "s-05-3#L5", "ids": [ "v-n5-0233", "v-n5-0118", "v-n5-0168", "v-n5-0179", "v-n5-0126", "v-n5-0188", "v-n5-0132" ], "kana": "おふろはくろいドアのむこうです。", "morae": 15 },
    { "ref": "s-06-1#L0", "ids": [ "v-n5-0215", "v-n5-0211", "v-n5-0141", "v-n5-0118", "v-n5-0154", "v-n5-0121", "v-n5-0277" ], "kana": "しがつよっか、ふじさわ。あさはしちじにたべました。", "morae": 22 },
    { "ref": "s-06-1#L1", "ids": [ "v-n5-0137", "v-n5-0118", "v-n5-0166", "v-n5-0248", "v-n5-0135" ], "kana": "きょうはあおいいちにちでした。", "morae": 13 },
    { "ref": "s-06-1#L5", "ids": [ "v-n5-0167", "v-n5-0243", "v-n5-0120", "v-n5-0276", "v-n5-0115", "g-n5-017" ], "kana": "しろいハンカチをみました。さんぜんえん。かいませんでした。", "morae": 26 },
    { "ref": "s-06-1#L8", "ids": [ "v-n5-0118", "v-n5-0218", "v-n5-0131", "v-n5-0095", "v-n5-0132" ], "kana": "やまもとさんはしちがつまでひとりです。", "morae": 18 },
    { "ref": "s-06-1#L9", "ids": [ "v-n5-0118", "v-n5-0138", "v-n5-0130", "v-n5-0051", "v-n5-0122", "g-n5-017", "v-n5-0127", "v-n5-0124", "v-n5-0279" ], "kana": "やまもとさんは「あしたから、ここではたらきますか」といいました。", "morae": 28 },
    { "ref": "s-06-1#L10", "ids": [ "v-n5-0118", "v-n5-0001", "v-n5-0124", "v-n5-0279", "v-n5-0046", "v-n5-0135" ], "kana": "ケンは「はい」といいました。それだけでした。", "morae": 18 },
    { "ref": "s-06-1#L11", "ids": [ "v-n5-0242", "v-n5-0118", "v-n5-0145", "v-n5-0126", "v-n5-0066", "v-n5-0229", "v-n5-0120", "g-n5-017" ], "kana": "ゆうがた、ケンはいえのひとのだいどころをかりました。", "morae": 24 },
    { "ref": "s-06-1#L15", "ids": [ "v-n5-0041", "v-n5-0125", "v-n5-0218", "v-n5-0131", "v-n5-0051", "v-n5-0122", "g-n5-017" ], "kana": "わたしたちもしちがつまで、ここでやすみます。", "morae": 20 },
    { "ref": "s-06-1#L16", "ids": [ "v-n5-0138", "v-n5-0118", "v-n5-0154", "v-n5-0121", "g-n5-017" ], "kana": "あしたはごじにおきます。ごじ！", "morae": 13 },
    { "ref": "s-06-2#L1", "ids": [ "v-n5-0006", "v-n5-0045", "v-n5-0118", "v-n5-0054", "v-n5-0132", "v-n5-0127" ], "kana": "こんにちは。これはなんですか。", "morae": 13 },
    { "ref": "s-06-2#L4", "ids": [ "v-n5-0111", "v-n5-0115", "v-n5-0132" ], "kana": "ひとつごひゃくえんです。", "morae": 10 },
    { "ref": "s-06-2#L5", "ids": [ "v-n5-0111", "v-n5-0019" ], "kana": "ふたつ、おねがいします。", "morae": 10 },
    { "ref": "s-06-2#L6", "ids": [ "v-n5-0001", "v-n5-0111", "v-n5-0122", "v-n5-0115", "v-n5-0132", "v-n5-0010" ], "kana": "はい、ふたつでせんえんです。ありがとうございます。", "morae": 22 },
    { "ref": "s-06-2#L7", "ids": [ "v-n5-0056", "v-n5-0122", "v-n5-0277", "v-n5-0127" ], "kana": "どこでたべますか。", "morae": 8 },
    { "ref": "s-06-2#L8", "ids": [ "v-n5-0234", "v-n5-0145", "v-n5-0126", "v-n5-0229", "v-n5-0122", "g-n5-017" ], "kana": "こんばん、いえのだいどころでつくります。", "morae": 18 },
    { "ref": "s-06-2#L9", "ids": [ "v-n5-0030", "v-n5-0055", "v-n5-0119", "g-n5-017", "v-n5-0127" ], "kana": "そうですか。だれがつくりますか。", "morae": 14 },
    { "ref": "s-06-2#L12", "ids": [ "v-n5-0138", "v-n5-0118", "v-n5-0175", "v-n5-0130", "v-n5-0132", "v-n5-0127" ], "kana": "やまもとさん、あしたはなんじからですか。", "morae": 18 },
    { "ref": "s-06-2#L14", "ids": [ "v-n5-0154", "v-n5-0132", "v-n5-0127" ], "kana": "ごじですか。", "morae": 5 },
    { "ref": "s-06-2#L15", "ids": [ "v-n5-0001", "v-n5-0138", "v-n5-0154", "v-n5-0121", "v-n5-0275" ], "kana": "はい。あした、ごじにきます。", "morae": 11 },
    { "ref": "s-06-2#L16", "ids": [ "v-n5-0010", "v-n5-0138", "v-n5-0154", "v-n5-0121" ], "kana": "ありがとうございます。あした、ごじに。", "morae": 16 },
    { "ref": "s-06-2#L17", "ids": [ "v-n5-0010", "v-n5-0138", "v-n5-0041", "v-n5-0125", "v-n5-0275" ], "kana": "ありがとうございます。あした、わたしもきます。", "morae": 20 },
    { "ref": "s-06-3#L0", "ids": [ "v-n5-0073", "v-n5-0123", "v-n5-0215", "v-n5-0211", "v-n5-0130" ], "kana": "みなさんへ。しがつよっか、ふじさわから。", "morae": 17 },
    { "ref": "s-06-3#L1", "ids": [ "v-n5-0020", "v-n5-0189", "v-n5-0118", "v-n5-0224", "v-n5-0132" ], "kana": "おげんきですか。こちらははるです。", "morae": 15 },
    { "ref": "s-06-3#L4", "ids": [ "g-n5-017", "v-n5-0071", "v-n5-0118" ], "kana": "およぎませんでした。こどもはおよぎました。", "morae": 19 },
    { "ref": "s-06-3#L6", "ids": [ "v-n5-0243", "v-n5-0118", "g-n5-017", "v-n5-0115", "v-n5-0135" ], "kana": "ハンカチはかいませんでした。さんぜんえんでした。", "morae": 22 },
    { "ref": "s-06-3#L9", "ids": [ "v-n5-0041", "v-n5-0118", "v-n5-0218", "v-n5-0131", "v-n5-0132" ], "kana": "わたしたちはしちがつまでふじさわです。", "morae": 18 },
