    { "ref": "s-06-5#L10", "ids": [ "v-n5-0001", "v-n5-0111", "v-n5-0124", "v-n5-0114", "v-n5-0122", "v-n5-0115", "v-n5-0132", "v-n5-0129" ], "kana": "はい。ふたつとにほんで、はっぴゃくえんですよ。", "morae": 19 },
