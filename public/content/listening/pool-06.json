    { "ref": "s-06-5#L5", "ids": [ "v-n5-0115", "v-n5-0132", "v-n5-0127", "v-n5-0111", "v-n5-0019" ], "kana": "さんびゃくえんですか。ふたつ、おねがいします。", "morae": 19 },
    { "ref": "s-06-5#L6", "ids": [ "v-n5-0001", "v-n5-0111", "v-n5-0132", "v-n5-0128", "v-n5-0115" ], "kana": "はい、ふたつですね。ろっぴゃくえんです。", "morae": 16 },
