    { "ref": "s-06-3#L11", "ids": [ "v-n5-0140", "v-n5-0100", "v-n5-0121", "v-n5-0282" ], "kana": "まいにち、ノートにかきます。", "morae": 12 },
    { "ref": "s-06-3#L12", "ids": [ "v-n5-0218", "v-n5-0121", "v-n5-0125", "v-n5-0282" ], "kana": "しちがつにもかきます。", "morae": 10 },
    { "ref": "s-06-3#L13", "ids": [], "kana": "ハナより", "morae": 4 },
    { "ref": "s-06-4#L0", "ids": [ "v-n5-0006" ], "kana": "ケンさん、ハナさん、こんにちは。", "morae": 13 },
    { "ref": "s-06-4#L1", "ids": [ "v-n5-0132", "v-n5-0018" ], "kana": "やまもとです。よろしくおねがいします。", "morae": 17 },
    { "ref": "s-06-4#L3", "ids": [ "v-n5-0077", "v-n5-0118", "v-n5-0116", "v-n5-0126", "v-n5-0082", "v-n5-0124", "v-n5-0041", "v-n5-0132" ], "kana": "かぞくは、はちじゅっさいのははとわたしです。", "morae": 19 },
    { "ref": "s-06-4#L7", "ids": [ "v-n5-0154", "v-n5-0121", "v-n5-0051", "v-n5-0123", "v-n5-0275", "v-n5-0131", "v-n5-0132", "v-n5-0129" ], "kana": "しちじに、ここへきます。さんじまでですよ。", "morae": 18 },
