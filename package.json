{
  "name": "japanlangrace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "A gamified path from zero to fluent Japanese — static web app for GitHub Pages.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "content:validate": "node scripts/validate-content.ts",
    "content:assign": "node scripts/assign-stations.ts",
    "content:index": "node scripts/build-content-index.ts",
    "content:report": "node scripts/listening-report.ts",
    "content:all": "npm run content:validate && npm run content:assign && npm run content:index && npm run content:report && npm run content:validate -- --strict --listening-release",
    "audio:render": "node scripts/audio/render-audio.ts",
    "audio:pack": "node scripts/audio/pack.ts",
    "audio:publish": "node scripts/audio/publish.ts --dry-run",
    "audio:fetch": "node scripts/audio/fetch-audio-pack.ts",
    "audio:check": "node scripts/audio/check-audio.ts"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "preact": "10.29.8",
    "wanakana": "5.3.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
